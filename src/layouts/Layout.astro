---
import '../styles/global.css';
import CustomCursor from '../components/CustomCursor';
import Header from '../components/Header.astro';
import BackgroundAnimation from '../components/BackgroundAnimation.astro';
import Preloader from '../components/Preloader.astro';
import { getConfig } from '../utils/getConfig';
import { ClientRouter } from 'astro:transitions';
import MobileBottomBar from '../components/MobileBottomBar.astro';

interface Props {
  hideHeader?: boolean;
  title?: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  ogType?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogUrl?: string;
  ogImage?: string;
  googleSiteVerification?: string;
  schemaMarkup?: string | string[];
}

const config = getConfig();
const { 
  hideHeader = false,
  title = config.site_meta.title,
  description = config.site_meta.description,
  keywords = "dentist in hennur, dental clinic horamavu, root canal treatment bengaluru, clear aligners hennur, dental implants, teeth whitening, best dentist near me, kalyan nagar dentist",
  canonical = "https://www.aurevadental.com/",
  ogType = "website",
  ogTitle = title,
  ogDescription = description,
  ogUrl = canonical,
  ogImage = "https://www.aurevadental.com/assets/og-image.jpg",
  googleSiteVerification = config.site_meta?.google_site_verification || "",
  schemaMarkup
} = Astro.props;
---

<!doctype html>
<html lang="en" class="custom-cursor-active">
	<head>
		<!-- Google tag (gtag.js) -->
		<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-18385058775"></script>
		<script is:inline>
		  window.dataLayer = window.dataLayer || [];
		  function gtag(){dataLayer.push(arguments);}
		  gtag('js', new Date());

		  gtag('config', 'AW-18385058775');

		  function gtag_report_conversion(url) {
		    var callback = function () {
		      if (typeof(url) != 'undefined') {
		        window.location = url;
		      }
		    };
		    gtag('event', 'conversion', {
		        'send_to': 'AW-18385058775/c0YWCIGTj-8cENf31r5E',
		        'value': 1.0,
		        'currency': 'INR',
		        'event_callback': callback
		    });
		    return false;
		  }
		</script>
		<ClientRouter />
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#F5F2EB" />

		<link rel="icon" type="image/png" href="/logo.png" />
		<link rel="apple-touch-icon" href="/logo.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Google Search Console Verification Tag (if token provided) -->
		{googleSiteVerification && (
			<meta name="google-site-verification" content={googleSiteVerification} />
		)}

		<!-- Theme toggle prevention of flash (FOUC) -->
		<script is:inline>
			const themeSetup = () => {
				const savedTheme = localStorage.getItem('theme');
				if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
					document.documentElement.classList.add('dark');
				} else {
					document.documentElement.classList.remove('dark');
				}
			};
			themeSetup();
			document.addEventListener('astro:after-swap', themeSetup);
		</script>

		<!-- Primary SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		{keywords && <meta name="keywords" content={keywords} />}
		{canonical && <link rel="canonical" href={canonical} />}
		<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

		<!-- Local Geo Meta Tags for Google Local Search & Maps -->
		<meta name="geo.region" content="IN-KA" />
		<meta name="geo.placename" content="Bengaluru" />
		<meta name="geo.position" content="13.033;77.650" />
		<meta name="ICBM" content="13.033, 77.650" />
		
		<!-- Open Graph / Facebook / WhatsApp -->
		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={ogTitle} />
		<meta property="og:description" content={ogDescription} />
		{ogUrl && <meta property="og:url" content={ogUrl} />}
		<meta property="og:site_name" content="Aureva Dental - Luxury Smile Studio" />
		<meta property="og:locale" content="en_IN" />
		{ogImage && <meta property="og:image" content={ogImage} />}
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Aureva Dental Studio - Hennur, Bengaluru" />

		<!-- Open Graph Local Business & Contact Signals -->
		<meta property="business:contact_data:street_address" content="2nd Floor, No. 11/4, Horamavu Agara Road, Near Nayara Petrol Bunk, Hennur Bande" />
		<meta property="business:contact_data:locality" content="Bengaluru" />
		<meta property="business:contact_data:region" content="Karnataka" />
		<meta property="business:contact_data:postal_code" content="560043" />
		<meta property="business:contact_data:country_name" content="India" />
		<meta property="business:contact_data:phone_number" content="+917349701002" />
		<meta property="business:contact_data:email" content="aurevadentalclinic@gmail.com" />
		
		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:site" content="@aurevadental" />
		<meta property="twitter:title" content={ogTitle} />
		<meta property="twitter:description" content={ogDescription} />
		{ogImage && <meta property="twitter:image" content={ogImage} />}
		<meta property="twitter:image:alt" content="Aureva Dental Studio - Hennur, Bengaluru" />

		<!-- Structured Data (JSON-LD) -->
		{Array.isArray(schemaMarkup) ? (
			schemaMarkup.map((schema) => (
				<script type="application/ld+json" set:html={schema} />
			))
		) : schemaMarkup ? (
			<script type="application/ld+json" set:html={schemaMarkup} />
		) : null}

		<!-- Preconnect to critical domains for lightning-fast loads -->
		<link rel="preconnect" href="https://maps.googleapis.com" />
		<link rel="preconnect" href="https://maps.gstatic.com" />

		<!-- Asynchronous Google Fonts Loading for zero-render blocking -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link 
			rel="preload" 
			as="style" 
			href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap" 
		/>
		<link 
			rel="stylesheet" 
			href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap" 
			media="print" 
			onload="this.media='all'" 
		/>
		<noscript>
			<link 
				rel="stylesheet" 
				href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap" 
			/>
		</noscript>
	</head>
	<body class="bg-japandi-cream text-japandi-charcoal font-sans antialiased selection:bg-japandi-clay selection:text-japandi-charcoal min-h-screen flex flex-col relative z-0 pb-20 md:pb-0">
		<!-- Splash Screen / Preloader -->
		<Preloader />

		<!-- Soothing Background UI Animation -->
		<BackgroundAnimation />

		<!-- Custom Interactive Cursor Component -->
		<CustomCursor client:only="react" />
		
		<!-- Sticky Header Component -->
		{!hideHeader && <Header />}
		
		<!-- Main Content Slot -->
		<main class="flex-grow">
			<slot />
		</main>

		<!-- Sticky Mobile Bottom Bar -->
		<MobileBottomBar />
	</body>
</html>

<style is:global define:vars={{
	lightBgPrimary: config.theme_colors.light.bg_primary,
	lightBgSecondary: config.theme_colors.light.bg_secondary,
	lightBorder: config.theme_colors.light.border_color,
	lightText: config.theme_colors.light.text_primary,
	lightMoss: config.theme_colors.light.accent_moss,
	lightEarth: config.theme_colors.light.accent_earth,
	
	darkBgPrimary: config.theme_colors.dark.bg_primary,
	darkBgSecondary: config.theme_colors.dark.bg_secondary,
	darkBorder: config.theme_colors.dark.border_color,
	darkText: config.theme_colors.dark.text_primary,
	darkMoss: config.theme_colors.dark.accent_moss,
	darkEarth: config.theme_colors.dark.accent_earth
}}>
	:root {
		--color-bg-primary: var(--lightBgPrimary);
		--color-bg-secondary: var(--lightBgSecondary);
		--color-border: var(--lightBorder);
		--color-text-primary: var(--lightText);
		--color-accent-moss: var(--lightMoss);
		--color-accent-earth: var(--lightEarth);
	}

	html.dark {
		--color-bg-primary: var(--darkBgPrimary);
		--color-bg-secondary: var(--darkBgSecondary);
		--color-border: var(--darkBorder);
		--color-text-primary: var(--darkText);
		--color-accent-moss: var(--darkMoss);
		--color-accent-earth: var(--darkEarth);
	}
</style>
