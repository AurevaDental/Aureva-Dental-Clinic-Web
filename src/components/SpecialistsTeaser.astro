---
const departments = [
  "Endodontics (Conservative Dentistry)",
  "Prosthodontics",
  "Periodontics",
  "Oral and Maxillofacial Surgery",
  "Orthodontics",
  "Paediatric Dentistry",
  "Oral Medicine and Radiology"
];
---

<section class="py-16 md:py-24 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/40">
  <div class="max-w-7xl mx-auto space-y-8">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
      <div class="max-w-2xl">
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Specialist departments
        </h2>
        <p class="text-sm sm:text-base text-japandi-earth font-light mt-2">
          Visiting MDS specialists in all 7 dental fields at one clinic in Hennur Bande.
        </p>
      </div>
      <a 
        href="/our-specialists"
        class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-japandi-moss hover:text-japandi-charcoal transition-colors self-start sm:self-auto"
      >
        <span>View all specialist departments</span>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {departments.map((dept) => (
        <a 
          href="/our-specialists"
          class="p-5 rounded-2xl bg-japandi-sand/50 hover:bg-japandi-sand border border-japandi-clay/40 hover:border-japandi-moss/50 transition-all duration-300 flex items-center justify-between gap-3 group"
        >
          <span class="text-xs sm:text-sm font-medium text-japandi-charcoal group-hover:text-japandi-moss transition-colors">
            {dept}
          </span>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-japandi-moss opacity-70 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all shrink-0">
            <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
          </svg>
        </a>
      ))}
    </div>
  </div>
</section>
