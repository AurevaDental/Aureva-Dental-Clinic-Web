---
import { getConfig } from '../utils/getConfig';
import { supabase } from '../lib/supabase';

const config = getConfig();
const { locations_section, social_proof } = config;

let reviews: any[] = [];
try {
  if (supabase) {
    const { data, error } = await supabase
      .from('reviews')
      .select('*')
      .order('created_at', { ascending: false });
      
    if (error) {
      throw new Error(error.message);
    }
    
    if (data) {
      reviews = data;
    }
  } else {
    console.warn("Supabase client is not configured. Falling back to verified Google reviews.");
  }
} catch (err) {
  console.error("Failed to fetch reviews", err);
}

const defaultReviews = [
  {
    name: "Priya Ramesh",
    role: "Hennur Resident • Google Review",
    text: "Absolutely the best dental clinic experience in Hennur! Dr. Shweta was so gentle and patient during my root canal treatment. Zero pain and the studio atmosphere instantly relieves all anxiety.",
    rating: 5
  },
  {
    name: "Vikram Nambiar",
    role: "Horamavu Resident • Google Review",
    text: "Got my smile consultation and clear aligners planned at Aureva Dental. Completely transparent pricing, state-of-the-art digital scans, and unmatched professionalism. 5-star experience!",
    rating: 5
  },
  {
    name: "Sneha Mukherjee",
    role: "Kalyan Nagar Resident • Google Review",
    text: "I had severe dental anxiety before visiting Aureva. Dr. Agniss and the team made the entire cleaning and restorative care soothing and pain-free. A true sanctuary for oral wellness.",
    rating: 5
  }
];

const displayReviews = reviews && reviews.length > 0 ? reviews : defaultReviews;
---

<section id="location" class="py-24 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/40 relative">
  <div id="contact" class="absolute -top-12 left-0 pointer-events-none"></div>
  <div id="locations" class="absolute -top-12 left-0 pointer-events-none"></div>
  <!-- Subtle line decoration -->
  <div class="absolute top-0 left-2/3 -translate-x-1/2 w-[1px] h-12 bg-japandi-clay"></div>

  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-start">
      
      <!-- Locations Block (Column Left) -->
      <div class="lg:col-span-5 flex flex-col space-y-10 animate-slow-fade">
        <div>
          <p class="text-xs font-semibold text-japandi-earth uppercase tracking-widest mb-3">
            {locations_section.subtitle}
          </p>
          <h2 class="text-3xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
            {locations_section.title}
          </h2>
        </div>

        <div class="flex flex-col gap-6">
          {locations_section.locations_list.map((loc) => (
            <div class="bg-japandi-sand/55 border border-japandi-clay/45 rounded-3xl p-8 hover:bg-japandi-sand transition-all duration-300 hover:shadow-lg hover:shadow-japandi-charcoal/5">
              <div class="flex items-center justify-between gap-4 mb-3">
                <h3 class="text-xl font-serif text-japandi-charcoal font-medium">{loc.name}</h3>
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-japandi-moss/10 text-japandi-moss text-[10px] font-semibold uppercase tracking-wider">
                  <span class="w-1.5 h-1.5 rounded-full bg-japandi-moss"></span>
                  Bengaluru Studio
                </span>
              </div>
              
              <!-- Address Deep Link with Landmark -->
              <div class="mb-4">
                <a 
                  href={loc.google_maps_url} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="group inline-flex items-start text-sm text-japandi-earth hover:text-japandi-charcoal transition-colors duration-300 leading-relaxed"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 mr-2.5 mt-0.5 text-japandi-moss flex-shrink-0">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                  </svg>
                  <span class="border-b border-japandi-clay group-hover:border-japandi-charcoal transition-all">
                    {loc.address}
                  </span>
                </a>
              </div>

              <!-- Interactive Responsive Google Maps Embed -->
              <div class="mt-4 mb-5 rounded-2xl overflow-hidden border border-japandi-clay/60 shadow-inner aspect-[16/10] w-full relative bg-japandi-clay/20 group/map">
                <iframe
                  title="Aureva Dental Studio Google Maps Location"
                  src={`https://maps.google.com/maps?q=${loc.latitude || 13.0381741},${loc.longitude || 77.6416031}+(Aureva+Dental)&t=&z=16&ie=UTF8&iwloc=B&output=embed`}
                  width="100%"
                  height="100%"
                  style="border:0;"
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  class="w-full h-full"
                ></iframe>
              </div>

              <!-- Quick Action Navigation Buttons -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 mb-6">
                <a
                  href={`https://www.google.com/maps/dir/?api=1&destination=${loc.latitude || 13.0381741},${loc.longitude || 77.6416031}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-japandi-sand/80 border border-japandi-clay text-xs font-medium text-japandi-charcoal hover:bg-japandi-moss hover:text-japandi-cream transition-all duration-300 group"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-4 h-4 text-japandi-moss group-hover:text-japandi-cream transition-colors">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498 4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.284a1.875 1.875 0 0 0-1.678 0L3.328 5.532c-.443.222-.728.67-.728 1.166v12.287c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.902 2.441Z" />
                  </svg>
                  <span>Get Driving Directions</span>
                </a>
                <a
                  href="https://wa.me/917349701002"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-japandi-moss text-japandi-cream text-xs font-semibold hover:bg-japandi-charcoal transition-all duration-300"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-3.5 h-3.5">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                  </svg>
                  <span>Chat on WhatsApp</span>
                </a>
              </div>

              <!-- Contact & Operating Information -->
              <div class="space-y-3 pt-6 border-t border-japandi-clay/35 text-xs text-japandi-charcoal">
                <div class="flex items-center">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 mr-3 text-japandi-earth">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
                  </svg>
                  <a 
                    href="tel:+917349701002"
                    onclick="return gtag_report_conversion('tel:+917349701002');" 
                    class="hover:text-japandi-moss font-semibold transition-colors"
                  >+91 73497 01002</a>
                </div>
                {loc.email && (
                  <div class="flex items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 mr-3 text-japandi-earth">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.909A2.25 2.25 0 0 1 2.25 6.993V6.75m19.5 0v.243m0-1.06-9 5.541-9-5.541" />
                    </svg>
                    <a href={`mailto:${loc.email}`} class="hover:text-japandi-moss transition-colors">{loc.email}</a>
                  </div>
                )}
                <div class="flex items-start">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 mr-3 text-japandi-earth mt-0.5 shrink-0">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                  </svg>
                  <div class="flex flex-col">
                    <span class="font-medium text-japandi-charcoal">Operating Hours:</span>
                    <span class="text-japandi-earth">Monday: 4:00 PM – 9:00 PM (16:00 – 21:00)</span>
                    <span class="text-japandi-earth">Tuesday – Sunday: 9:30 AM – 9:00 PM (09:30 – 21:00)</span>
                  </div>
                </div>
                {loc.parking && (
                  <div class="flex items-start">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 mr-3 text-japandi-earth mt-0.5 flex-shrink-0">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75V4.5h6.75a3.75 3.75 0 1 1 0 7.5H8.25m0 0h6.75" />
                    </svg>
                    <span>{loc.parking}</span>
                  </div>
                )}
              </div>

              <!-- Neighborhoods Served Signal for Local SEO -->
              <div class="mt-6 pt-5 border-t border-japandi-clay/35">
                <p class="text-[10px] font-semibold text-japandi-earth uppercase tracking-wider mb-2.5">
                  Neighborhoods We Proudly Serve:
                </p>
                <div class="flex flex-wrap gap-1.5">
                  {[
                    "Hennur",
                    "Horamavu",
                    "Hennur Bande",
                    "Babusapalya",
                    "Kalyan Nagar",
                    "HRBR Layout",
                    "Kammanahalli",
                    "Banaswadi",
                    "Ramamurthy Nagar",
                    "Chelekere",
                    "North Bengaluru"
                  ].map((area) => (
                    <span class="px-2.5 py-1 rounded-full bg-japandi-sand/80 border border-japandi-clay/60 text-[10px] text-japandi-charcoal">
                      {area}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Testimonials Block (Column Right) -->
      <div class="lg:col-span-7 flex flex-col space-y-10 animate-slow-fade" style="animation-delay: 0.15s;">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
          <div>
            <p class="text-xs font-semibold text-japandi-earth uppercase tracking-widest mb-3">
              {social_proof.subtitle}
            </p>
            <h2 class="text-3xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
              {social_proof.title}
            </h2>
          </div>

          <!-- Google Reviews Verified Badge -->
          <a
            href={locations_section.locations_list[0]?.google_maps_url || "https://maps.app.goo.gl/dhU4UySs9WFkHAzYA"}
            target="_blank"
            rel="noopener noreferrer"
            title={`Read ${config.site_meta?.review_count || 29} 5-star Google Reviews`}
            class="inline-flex items-center gap-2.5 px-4 py-2 rounded-2xl bg-japandi-sand/70 hover:bg-japandi-sand border border-japandi-clay/60 hover:border-japandi-moss/40 text-xs text-japandi-charcoal transition-all duration-300 group shadow-sm shrink-0"
          >
            <div class="flex items-center text-amber-500 text-xs tracking-tight">
              ★ ★ ★ ★ ★
            </div>
            <span class="font-bold">5.0</span>
            <span class="text-japandi-earth text-[11px] font-normal">({config.site_meta?.review_count || 29} Google Reviews)</span>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3.5 h-3.5 text-japandi-moss group-hover:translate-x-0.5 transition-transform">
              <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 0 0 1.06 0l7.22-7.22v5.69a.75.75 0 0 0 1.5 0v-7.5a.75.75 0 0 0-.75-.75h-7.5a.75.75 0 0 0 0 1.5h5.69l-7.22 7.22a.75.75 0 0 0 0 1.06Z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>

        <div class="flex flex-col gap-6">
          {displayReviews.map((test) => (
            <div class="bg-japandi-sand/35 border border-japandi-clay/45 rounded-3xl p-8 relative flex flex-col justify-between hover:bg-japandi-sand/55 transition-all duration-300">
              <!-- Rating Stars -->
              <div class="flex items-center gap-1 mb-5">
                {Array.from({ length: test.rating || 5 }).map(() => (
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 text-amber-500">
                    <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z" clip-rule="evenodd" />
                  </svg>
                ))}
              </div>

              <!-- Quote Text -->
              <p class="text-japandi-charcoal font-light leading-relaxed mb-6 italic text-sm md:text-base">
                "{test.text}"
              </p>

              <!-- Author Info -->
              <div class="flex items-center pt-4 border-t border-japandi-clay/35">
                <div class="w-8 h-8 rounded-full bg-japandi-moss/10 flex items-center justify-center mr-3 text-xs font-semibold text-japandi-moss">
                  {test.name.split(' ').map((n: string) => n[0]).join('')}
                </div>
                <div>
                  <h4 class="text-xs font-semibold text-japandi-charcoal">{test.name}</h4>
                  <p class="text-[10px] text-japandi-earth tracking-wide">{test.role}</p>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Feedback & Review Links -->
        <div class="pt-2 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-japandi-earth border-t border-japandi-clay/30">
          <span>Visited Aureva Dental recently?</span>
          <div class="flex items-center gap-3">
            <a 
              href={locations_section.locations_list[0]?.google_maps_url || "https://maps.app.goo.gl/dhU4UySs9WFkHAzYA"} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="hover:text-japandi-moss font-medium underline underline-offset-4 transition-colors"
            >
              Review on Google Maps
            </a>
            <span>•</span>
            <a 
              href="/feedback" 
              class="hover:text-japandi-moss font-medium underline underline-offset-4 transition-colors"
            >
              Share Website Feedback
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
