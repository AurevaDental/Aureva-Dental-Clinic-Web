---
import { getConfig } from '../utils/getConfig';
import { supabase } from '../lib/supabase';

const config = getConfig();
const { locations_section, social_proof } = config;

let reviews: any[] = [];
try {
  const { data, error } = await supabase
    .from('reviews')
    .select('*')
    .order('created_at', { ascending: false });
    
  if (error) {
    throw new Error(error.message);
  }
  
  if (data) {
    reviews = data;
  }
} catch (err) {
  console.error("Failed to fetch reviews", err);
}
---

<section id="locations" class="py-24 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/40 relative">
  <!-- Subtle line decoration -->
  <div class="absolute top-0 left-2/3 -translate-x-1/2 w-[1px] h-12 bg-japandi-clay"></div>

  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-start">
      
      <!-- Locations Block (Column Left) -->
      <div class="lg:col-span-5 flex flex-col space-y-10 animate-slow-fade">
        <div>
          <p class="text-xs font-semibold text-japandi-earth uppercase tracking-widest mb-3">
            {locations_section.subtitle}
          </p>
          <h2 class="text-3xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
            {locations_section.title}
          </h2>
        </div>

        <div class="flex flex-col gap-6">
          {locations_section.locations_list.map((loc) => (
            <div class="bg-japandi-sand/55 border border-japandi-clay/45 rounded-3xl p-8 hover:bg-japandi-sand transition-all duration-300 hover:shadow-lg hover:shadow-japandi-charcoal/5">
              <h3 class="text-xl font-serif text-japandi-charcoal font-medium mb-3">{loc.name}</h3>
              
              <!-- Address Deep Link (No Heavy Iframes) -->
              <a 
                href={loc.google_maps_url} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="group inline-flex items-start text-sm text-japandi-earth hover:text-japandi-charcoal transition-colors duration-300 mb-6 leading-relaxed"
              >
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 mr-2.5 mt-0.5 text-japandi-moss flex-shrink-0">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                </svg>
                <span class="border-b border-japandi-clay group-hover:border-japandi-charcoal transition-all">
                  {loc.address}
                </span>
              </a>

              <div class="space-y-3 pt-6 border-t border-japandi-clay/35 text-xs text-japandi-charcoal">
                <div class="flex items-center">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 mr-3 text-japandi-earth">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
                  </svg>
                  <a href={`tel:${loc.phone.replace(/[^0-9+]/g, '')}`} class="hover:text-japandi-moss transition-colors">{loc.phone}</a>
                </div>
                {loc.email && (
                  <div class="flex items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 mr-3 text-japandi-earth">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.909A2.25 2.25 0 0 1 2.25 6.993V6.75m19.5 0v.243m0-1.06-9 5.541-9-5.541" />
                    </svg>
                    <a href={`mailto:${loc.email}`} class="hover:text-japandi-moss transition-colors">{loc.email}</a>
                  </div>
                )}
                <div class="flex items-center">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 mr-3 text-japandi-earth">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                  </svg>
                  <span>{loc.hours}</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Testimonials Block (Column Right) -->
      <div class="lg:col-span-7 flex flex-col space-y-10 animate-slow-fade" style="animation-delay: 0.15s;">
        <div>
          <p class="text-xs font-semibold text-japandi-earth uppercase tracking-widest mb-3">
            {social_proof.subtitle}
          </p>
          <h2 class="text-3xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
            {social_proof.title}
          </h2>
        </div>

        <div class="flex flex-col gap-6">
          {reviews.map((test) => (
            <div class="bg-japandi-sand/35 border border-japandi-clay/45 rounded-3xl p-8 relative flex flex-col justify-between">
              <!-- Rating Stars -->
              <div class="flex items-center gap-1 mb-5">
                {Array.from({ length: test.rating }).map(() => (
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 text-japandi-moss">
                    <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z" clip-rule="evenodd" />
                  </svg>
                ))}
              </div>

              <!-- Quote Text -->
              <p class="text-japandi-charcoal font-light leading-relaxed mb-6 italic text-sm md:text-base">
                "{test.text}"
              </p>

              <!-- Author Info -->
              <div class="flex items-center pt-4 border-t border-japandi-clay/35">
                <div class="w-8 h-8 rounded-full bg-japandi-moss/10 flex items-center justify-center mr-3 text-xs font-semibold text-japandi-moss">
                  {test.name.split(' ').map(n => n[0]).join('')}
                </div>
                <div>
                  <h4 class="text-xs font-semibold text-japandi-charcoal">{test.name}</h4>
                  <p class="text-[10px] text-japandi-earth tracking-wide">{test.role}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
