---
import { getConfig } from '../utils/getConfig';

const config = getConfig();
const { why_us_section } = config;

// Simple icon map for Tailwind/Heroicons
const icons = {
  leaf: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 15L12 18.75 15.75 15m-7.5-6L12 5.25 15.75 9" /></svg>`,
  heart: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" /></svg>`,
  shield: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>`,
  star: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" /></svg>`
};
---

<section class="py-24 px-6 lg:px-24 bg-japandi-cream border-t border-japandi-clay/40">
  <div class="max-w-7xl mx-auto flex flex-col lg:flex-row gap-16 items-center">
    
    <div class="lg:w-1/3 animate-slow-fade">
      <p class="text-xs font-semibold text-japandi-earth uppercase tracking-widest mb-3">
        {why_us_section.subtitle}
      </p>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif text-japandi-charcoal font-medium tracking-tight mb-8">
        {why_us_section.title}
      </h2>
      <p class="text-japandi-earth font-light leading-relaxed text-sm mb-8">
        We believe that a trip to the dentist shouldn't be stressful. We've completely redesigned the patient experience to prioritize comfort, aesthetics, and overall well-being.
      </p>
    </div>

    <div class="lg:w-2/3 grid grid-cols-1 sm:grid-cols-2 gap-8 w-full">
      {why_us_section.reasons.map((reason, index) => (
        <div 
          class="p-6 rounded-[2rem] bg-japandi-sand/30 border border-japandi-clay/30 flex gap-4 items-start transition-all duration-300 hover:bg-japandi-sand/60 hover:-translate-y-1 animate-slow-fade"
          style={`animation-delay: ${index * 0.15}s;`}
        >
          <div class="w-12 h-12 rounded-full bg-japandi-moss/10 text-japandi-moss flex items-center justify-center shrink-0" set:html={icons[reason.icon as keyof typeof icons] || icons.leaf}>
          </div>
          <div>
            <h3 class="text-lg font-serif text-japandi-charcoal font-medium mb-2">
              {reason.title}
            </h3>
            <p class="text-japandi-earth font-light leading-relaxed text-sm">
              {reason.description}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
