---
import { getConfig } from '../utils/getConfig';

const config = getConfig();
const { site_meta } = config;
const whatsappNumber = site_meta.whatsapp_number || "917349701002";
const phoneLink = `tel:+${whatsappNumber}`;

// The specific message requested:
// Hello, I would like to book an appointment at Aureva Dental.
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=Hello%2C%20I%20would%20like%20to%20book%20an%20appointment%20at%20Aureva%20Dental.`;
---

<div class="md:hidden fixed bottom-0 left-0 right-0 z-50 bg-japandi-cream/90 backdrop-blur-md border-t border-japandi-clay/45 px-4 py-3.5 shadow-[0_-8px_30px_rgb(0,0,0,0.03)] flex items-center justify-between gap-3 animate-slow-fade">
  <!-- Call Button (Elegant outline button) -->
  <a 
    href={phoneLink}
    onclick={`return gtag_report_conversion('${phoneLink}');`}
    class="flex-1 flex items-center justify-center gap-2 py-3 px-4 border border-japandi-moss text-japandi-moss hover:bg-japandi-moss/5 active:bg-japandi-moss/10 font-semibold rounded-full text-xs uppercase tracking-widest transition-all duration-300 cursor-none"
  >
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 shrink-0">
      <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
    </svg>
    Call Clinic
  </a>

  <!-- Book Visit Interactive Modal Trigger Button -->
  <button 
    type="button"
    data-open-booking
    class="flex-1 flex items-center justify-center gap-2 py-3 px-4 bg-japandi-moss text-japandi-cream hover:bg-japandi-charcoal active:bg-japandi-charcoal/90 font-semibold rounded-full text-xs uppercase tracking-widest transition-all duration-300 shadow-md shadow-japandi-moss/10 cursor-none"
  >
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 shrink-0">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
    </svg>
    Book Visit
  </button>
</div>
