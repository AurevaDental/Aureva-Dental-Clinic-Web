---
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const servicesLink = isHome ? '#services' : '/#services';
const teamLink = isHome ? '#team' : '/#team';
const locationsLink = isHome ? '#locations' : '/#locations';
const faqLink = isHome ? '#faq' : '/#faq';
const whatsappUrl = "https://wa.me/917349701002?text=Hello%2C%20I%20would%20like%20to%20book%20an%20appointment%20at%20Aureva%20Dental.";
---

<header class="sticky top-0 z-50 w-full border-b border-japandi-clay/20 bg-japandi-cream/80 backdrop-blur-md px-6 py-4 lg:px-24">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <!-- Logo and Title -->
    <a href="/" class="flex items-center gap-2.5 group" aria-label="Aureva Dental Homepage">
      <img 
        src="/logo.png" 
        alt="Aureva Dental - Luxury Smile Studio" 
        class="h-20 w-auto object-contain transition-all duration-300 group-hover:scale-105 dark:invert dark:brightness-125 dark:hue-rotate-180" 
      />
    </a>

    <!-- Navigation and Toggle -->
    <nav class="flex items-center gap-6 lg:gap-8">
      <div class="hidden md:flex items-center gap-6 lg:gap-8 text-xs font-medium uppercase tracking-widest text-japandi-earth">
        <a href={servicesLink} class="hover:text-japandi-charcoal transition-colors py-1 relative after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[1px] after:bg-japandi-moss hover:after:w-full after:transition-all after:duration-300">Services</a>
        <a href={teamLink} class="hover:text-japandi-charcoal transition-colors py-1 relative after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[1px] after:bg-japandi-moss hover:after:w-full after:transition-all after:duration-300">Artisans</a>
        <a href={locationsLink} class="hover:text-japandi-charcoal transition-colors py-1 relative after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[1px] after:bg-japandi-moss hover:after:w-full after:transition-all after:duration-300">Sanctuaries</a>
        <a href={faqLink} class="hover:text-japandi-charcoal transition-colors py-1 relative after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[1px] after:bg-japandi-moss hover:after:w-full after:transition-all after:duration-300">FAQ</a>
        <a href="/feedback" class="hover:text-japandi-charcoal transition-colors py-1 relative after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[1px] after:bg-japandi-moss hover:after:w-full after:transition-all after:duration-300">Feedback</a>
      </div>

      <div class="flex items-center gap-3 sm:gap-4">
        <!-- Desktop Direct Appointment CTA Button for High Patient Conversion -->
        <a 
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-japandi-moss text-japandi-cream hover:bg-japandi-charcoal text-xs font-semibold uppercase tracking-widest transition-all duration-300 shadow-sm shadow-japandi-moss/10 cursor-none"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-3.5 h-3.5">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          <span>Book Visit</span>
        </a>

        <!-- Mobile/Compact feedback icon link -->
        <a href="/feedback" class="md:hidden p-2 text-japandi-moss hover:text-japandi-charcoal hover:bg-japandi-sand/30 rounded-full transition-all" aria-label="Feedback Form">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 0 1 .865-.501 48.172 48.172 0 0 0 3.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z" />
          </svg>
        </a>

        <!-- Premium Minimalist Theme Toggle Switch -->
        <button id="theme-toggle" class="p-2.5 rounded-full border border-japandi-clay/45 bg-japandi-sand/40 hover:bg-japandi-sand/75 text-japandi-moss hover:text-japandi-charcoal transition-all cursor-none focus:outline-none" aria-label="Toggle Dark Mode">
          <!-- Sun Icon (Visible in light mode, hidden in dark mode) -->
          <svg id="theme-toggle-light-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 dark:hidden">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m0 13.5V21M5.25 5.25l1.5 1.5m10.5 10.5l1.5 1.5M3 12h2.25m13.5 0H21M5.25 18.75l1.5-1.5m10.5-10.5l1.5-1.5M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z" />
          </svg>
          <!-- Moon Icon (Hidden in light mode, visible in dark mode) -->
          <svg id="theme-toggle-dark-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 hidden dark:block">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
          </svg>
        </button>
      </div>
    </nav>
  </div>
</header>

<script>
  function setupThemeToggle() {
    const themeToggle = document.getElementById('theme-toggle');
    if (themeToggle) {
      themeToggle.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    }
  }

  // Run on page load
  setupThemeToggle();

  // Handle Astro page transitions if custom routing is ever used
  document.addEventListener('astro:after-swap', setupThemeToggle);
</script>
