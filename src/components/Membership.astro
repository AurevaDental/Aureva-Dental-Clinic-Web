---
import { CANONICAL_PRICES } from '../data/prices';

const membershipPlans = [
  {
    name: "Aureva Essential",
    subtitle: "Individual",
    price: CANONICAL_PRICES.membership_essential,
    badge: "Annual Plan",
    features: [
      "Priority booking",
      "2 consultations with digital X-ray",
      "10% off all dental treatments"
    ]
  },
  {
    name: "Aureva Privilege",
    subtitle: "Family",
    price: CANONICAL_PRICES.membership_privilege,
    badge: "Most Popular",
    popular: true,
    features: [
      "Family priority booking",
      "4 consultations with digital X-ray",
      "15% off all dental treatments",
      "In-clinic teeth whitening for one family member"
    ]
  },
  {
    name: "Aureva Royalty",
    subtitle: "VIP",
    price: CANONICAL_PRICES.membership_royalty,
    badge: "VIP Tier",
    vip: true,
    features: [
      "Concierge booking access",
      "Unlimited consultations with digital X-ray",
      "20% off all dental treatments",
      "Dedicated wedding smile coach"
    ]
  }
];

const bridalPackages = [
  {
    name: "Couple Consultation",
    price: CANONICAL_PRICES.bridal_couple_consultation,
    desc: "Comprehensive dual smile assessment & digital imaging for couples."
  },
  {
    name: "The Express Glow",
    price: CANONICAL_PRICES.bridal_express_glow,
    desc: "Ultrasonic scaling, air polishing & express shade enhancement."
  },
  {
    name: "The Signature Bride / Groom",
    price: CANONICAL_PRICES.bridal_signature,
    desc: "Full in-office LED/laser brightening with enamel micro-polishing."
  },
  {
    name: "The Luxury Couture Smile",
    price: CANONICAL_PRICES.bridal_luxury_couture,
    desc: "Comprehensive aesthetic smile design with custom contouring."
  },
  {
    name: "Couple's Wedding Radiance Pass",
    price: CANONICAL_PRICES.bridal_couple_radiance,
    desc: "Complete dual bridal & groom aesthetic package."
  }
];
---

<section id="membership" class="py-16 md:py-24 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/40">
  <div class="max-w-7xl mx-auto space-y-16">
    
    <!-- Membership Plans Header -->
    <div class="space-y-10">
      <div class="max-w-2xl">
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Annual membership plans
        </h2>
        <p class="text-sm sm:text-base text-japandi-earth font-light mt-2">
          Structured preventive care with priority scheduling and treatment fee privileges.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch">
        {membershipPlans.map((plan) => {
          let cardClass = "bg-japandi-sand/55 hover:bg-japandi-sand border border-japandi-clay/50";
          let badgeClass = "bg-japandi-clay/35 text-japandi-earth";
          let btnClass = "border border-japandi-moss text-japandi-moss hover:bg-japandi-moss hover:text-japandi-cream";

          if (plan.vip) {
            cardClass = "bg-japandi-charcoal text-japandi-cream border border-japandi-earth/40 shadow-xl";
            badgeClass = "bg-japandi-earth/25 text-japandi-earth";
            btnClass = "bg-japandi-earth hover:bg-japandi-cream hover:text-japandi-charcoal text-japandi-cream";
          } else if (plan.popular) {
            cardClass = "bg-japandi-sand/85 border-2 border-japandi-moss/70 shadow-lg relative md:-translate-y-2";
            badgeClass = "bg-japandi-moss/20 text-japandi-moss";
            btnClass = "bg-japandi-moss hover:bg-japandi-charcoal text-japandi-cream";
          }

          return (
            <div class={`rounded-3xl p-7 sm:p-8 flex flex-col justify-between transition-all duration-300 ${cardClass}`}>
              <div>
                <div class="flex justify-between items-center mb-4">
                  <span class={`text-[9px] font-semibold uppercase tracking-widest px-3 py-1 rounded-full ${badgeClass}`}>
                    {plan.badge}
                  </span>
                  <span class={`text-xs ${plan.vip ? 'text-japandi-cream/70' : 'text-japandi-earth'}`}>
                    {plan.subtitle}
                  </span>
                </div>

                <h3 class={`text-xl font-serif font-medium mb-3 ${plan.vip ? 'text-japandi-cream' : 'text-japandi-charcoal'}`}>
                  {plan.name}
                </h3>

                <div class="flex items-baseline mb-6">
                  <span class="text-3xl sm:text-4xl font-serif font-semibold tracking-tight">
                    {plan.price}
                  </span>
                  <span class={`text-xs ml-2 uppercase tracking-widest ${plan.vip ? 'text-japandi-cream/70' : 'text-japandi-earth'}`}>
                    / year
                  </span>
                </div>

                <div class={`h-[1px] w-full mb-6 ${plan.vip ? 'bg-japandi-cream/15' : 'bg-japandi-clay/35'}`}></div>

                <ul class="space-y-3 mb-8">
                  {plan.features.map((feature) => (
                    <li class="flex items-start gap-2.5 text-xs sm:text-sm">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class={`w-4 h-4 mt-0.5 shrink-0 ${plan.vip ? 'text-japandi-earth' : 'text-japandi-moss'}`}>
                        <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                      </svg>
                      <span class={`font-light leading-relaxed ${plan.vip ? 'text-japandi-cream/90' : 'text-japandi-charcoal/90'}`}>
                        {feature}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>

              <button
                type="button"
                data-open-booking
                class={`w-full py-3 px-4 rounded-full text-xs font-semibold uppercase tracking-wider transition-all duration-300 ${btnClass}`}
              >
                Inquire About Plan
              </button>
            </div>
          );
        })}
      </div>
    </div>

    <!-- Bridal Packages Header -->
    <div class="space-y-8 pt-6 border-t border-japandi-clay/30">
      <div class="max-w-2xl">
        <h2 class="text-2xl sm:text-3xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Bridal & groom packages
        </h2>
        <p class="text-sm sm:text-base text-japandi-earth font-light mt-2">
          Curated smile brightening and cosmetic enhancement packages for weddings and milestone occasions.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {bridalPackages.map((pkg) => (
          <div class="p-6 rounded-2xl bg-japandi-sand/50 border border-japandi-clay/50 flex flex-col justify-between gap-4">
            <div>
              <div class="flex items-start justify-between gap-3 mb-2">
                <h3 class="text-sm sm:text-base font-serif font-medium text-japandi-charcoal">
                  {pkg.name}
                </h3>
                <span class="text-xs sm:text-sm font-semibold text-japandi-moss shrink-0">
                  {pkg.price}
                </span>
              </div>
              <p class="text-xs text-japandi-earth font-light leading-relaxed">
                {pkg.desc}
              </p>
            </div>
            <button
              type="button"
              data-open-booking
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-japandi-moss hover:text-japandi-charcoal self-start transition-colors"
            >
              <span>Book consultation</span>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
              </svg>
            </button>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
