---
import { getConfig } from '../utils/getConfig';

const config = getConfig();
const { specialized_services_section } = config;
---

<section class="py-24 px-6 lg:px-24 bg-japandi-sand/10 border-t border-japandi-clay/40">
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="max-w-3xl mb-16 animate-slow-fade">
      <p class="text-xs font-semibold text-japandi-earth uppercase tracking-widest mb-3">
        {specialized_services_section.subtitle}
      </p>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif text-japandi-charcoal font-medium tracking-tight">
        {specialized_services_section.title}
      </h2>
    </div>

    <!-- Specialized Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {specialized_services_section.services_list.map((service, index) => (
        <div 
          class="group bg-japandi-sand/55 backdrop-blur-md hover:bg-japandi-sand border border-japandi-clay/45 rounded-[2rem] overflow-hidden transition-all duration-500 transform hover:-translate-y-2 hover:shadow-xl hover:shadow-japandi-charcoal/5 animate-slow-fade"
          style={`animation-delay: ${index * 0.15}s;`}
        >
          <div class="h-48 w-full overflow-hidden">
            <img 
              src={service.image_url} 
              alt={service.title} 
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
          </div>
          <div class="p-8">
            <h3 class="text-2xl font-serif text-japandi-charcoal font-medium mb-3">
              {service.title}
            </h3>
            <p class="text-japandi-earth font-light leading-relaxed text-sm">
              {service.description}
            </p>
            <div class="mt-6 pt-6 border-t border-japandi-clay/30">
              <a href="#contact" class="text-xs font-semibold uppercase tracking-widest text-japandi-moss hover:text-japandi-charcoal transition-colors flex items-center gap-2">
                Discover More
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3 h-3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
