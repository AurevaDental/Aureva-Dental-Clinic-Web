---
// BackgroundAnimation.astro - Soothing Sparkles (Dental Theme)
---

<div class="fixed inset-0 pointer-events-none overflow-hidden z-[0]" aria-hidden="true">
  
  <!-- Tooth Background Image -->
  <div class="absolute inset-0 w-full h-full flex items-center justify-center transition-opacity duration-1000 z-[-1]">
    <!-- Displaying the exact original image without color alteration, but using a mask to fade the square edges into a soft aura -->
    <img src="/tooth-bg.png" alt="Tooth Background" class="w-full h-full object-cover sm:object-contain sm:max-h-[90%] opacity-[0.23] dark:opacity-[0.20] transition-all duration-700" style="-webkit-mask-image: radial-gradient(ellipse at center, black 35%, transparent 75%); mask-image: radial-gradient(ellipse at center, black 35%, transparent 75%);" />
  </div>

  <!-- 1. Gentle Sparkles (Cleanliness/Dental theme) -->
  <div class="sparkle-container">
    {Array.from({ length: 18 }).map((_, i) => {
      // Position sparkles directly ON the center tooth
      const angle = (i / 18) * Math.PI * 2;
      // Tighter distribution: 0-10% horizontally, 0-18% vertically from center
      const radiusX = (i % 3) * 4 + Math.random() * 2; 
      const radiusY = (i % 4) * 4 + Math.random() * 4; 
      
      // Shifted the vertical center up to 40% so sparkles are on the upper section of the tooth
      const top = `calc(40% + ${Math.sin(angle) * radiusY}%)`;
      const left = `calc(50% + ${Math.cos(angle) * radiusX}%)`;
      const delay = `${i * 0.4}s`;
      const duration = `${4 + (i % 3) * 1.5}s`;
      const scale = 0.6 + (i % 4) * 0.2; // Varied sizes
      return (
        <svg 
          class="gentle-sparkle" 
          style={`top: ${top}; left: ${left}; --base-scale: ${scale}; animation-delay: ${delay}; animation-duration: ${duration};`}
          viewBox="0 0 24 24" 
          fill="none" 
          stroke="currentColor" 
          stroke-width="1.2" 
          stroke-linecap="round" 
          stroke-linejoin="round"
        >
          <path d="M12 3v18M3 12h18" />
          <path d="M8 8l8 8M8 16l8-8" opacity="0.5" stroke-dasharray="1 1" />
        </svg>
      );
    })}
  </div>
</div>

<style>
  /* Base Container */
  .sparkle-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Gentle Sparkles */
  .gentle-sparkle {
    position: absolute;
    width: 20px; /* Small base size */
    height: 20px;
    color: #FFFFFF; /* Forced white sparkles */
    opacity: 0;
    --sparkle-opacity: 0.95; /* Super bright for light theme */
    --sparkle-filter: drop-shadow(0 0 2px rgba(0, 0, 0, 0.2)); /* Slight dark shadow so white pops on light bg */
    will-change: transform, opacity;
    animation: sparkle-fade ease-in-out infinite;
  }

  :global(.dark) .gentle-sparkle {
    --sparkle-opacity: 0.5; /* Dimmer for dark theme */
    --sparkle-filter: drop-shadow(0 0 3px currentColor); /* Bright white glow on dark bg */
  }

  /* Keyframe Animations */
  @keyframes sparkle-fade {
    0%, 100% {
      opacity: 0;
      transform: translate(-50%, -50%) rotate(0deg) scale(calc(var(--base-scale, 1) * 0.6));
    }
    50% {
      opacity: var(--sparkle-opacity);
      transform: translate(-50%, -50%) rotate(45deg) scale(calc(var(--base-scale, 1) * 1.1));
      filter: var(--sparkle-filter);
    }
  }

  /* Mobile Optimization */
  @media (max-width: 768px) {
    .gentle-sparkle:nth-child(odd) {
      display: none;
    }
    .gentle-sparkle {
      width: 16px;
      height: 16px;
    }
  }
</style>
