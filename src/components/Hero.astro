---
import { getConfig } from '../utils/getConfig';
import { clinicConfig, GOOGLE_RATING, GOOGLE_REVIEW_COUNT, GOOGLE_REVIEWS_LABEL } from '../config/clinic';
import { CANONICAL_PRICES } from '../data/prices';

const config = getConfig();
const { hero_section, site_meta } = config;

const whatsappUrl = "https://wa.me/917349701002";
const phoneCallUrl = "tel:+917349701002";
---

<header id="book" class="relative min-h-[85vh] flex items-center px-6 py-16 md:py-24 lg:px-24 overflow-hidden">
  <!-- HTML5 Background Video Container -->
  <div class="absolute inset-0 w-full h-full z-0 overflow-hidden">
    <video 
      id="hero-bg-video"
      data-src={hero_section.video_url} 
      poster="/hero-poster.webp"
      loop 
      muted 
      playsinline
      class="w-full h-full object-cover filter brightness-[0.7] contrast-[0.95]"
      preload="none"
    >
    </video>
    <!-- Soft warm Japandi overlay for maximum readability and visual aesthetic -->
    <div class="absolute inset-0 bg-gradient-to-r from-japandi-cream via-japandi-cream/90 to-japandi-sand/60 mix-blend-normal"></div>
  </div>

  <div class="max-w-7xl mx-auto w-full relative z-10">
    <div class="max-w-3xl flex flex-col items-start space-y-6 sm:space-y-8">
      
      <!-- Review Pill & Status -->
      <div class="flex flex-wrap items-center gap-2.5">
        {GOOGLE_RATING > 0 && GOOGLE_REVIEW_COUNT > 0 && (
          <a 
            href={site_meta.google_maps_url || "https://maps.app.goo.gl/dhU4UySs9WFkHAzYA"} 
            target="_blank" 
            rel="noopener noreferrer" 
            title={`View ${GOOGLE_REVIEWS_LABEL} on Google Maps`}
            class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-japandi-clay bg-japandi-sand/75 hover:bg-japandi-sand text-[10px] md:text-xs font-semibold text-japandi-moss tracking-wider transition-all duration-300 group shadow-sm hover:shadow"
          >
            <span class="flex items-center text-amber-500 text-xs tracking-tight">
              ★ ★ ★ ★ ★
            </span>
            <span class="font-bold text-japandi-charcoal">{GOOGLE_RATING.toFixed(1)}</span>
            <span class="text-japandi-earth font-normal group-hover:text-japandi-moss transition-colors">({GOOGLE_REVIEW_COUNT} Google Reviews)</span>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3 h-3 text-japandi-moss opacity-70 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all">
              <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 0 0 1.06 0l7.22-7.22v5.69a.75.75 0 0 0 1.5 0v-7.5a.75.75 0 0 0-.75-.75h-7.5a.75.75 0 0 0 0 1.5h5.69l-7.22 7.22a.75.75 0 0 0 0 1.06Z" clip-rule="evenodd" />
            </svg>
          </a>
        )}
      </div>
      
      <!-- Exact H1 Heading -->
      <h1 class="text-3xl sm:text-5xl md:text-6xl font-serif text-japandi-charcoal leading-[1.18] font-medium tracking-tight">
        Specialist dental clinic in Hennur Bande
      </h1>
      
      <!-- Subline -->
      <p class="text-base sm:text-lg text-japandi-earth font-light leading-relaxed">
        Every dental specialist, one clinic, open till 9.
      </p>
      
      <!-- Three Short Facts Row -->
      <div class="flex flex-wrap items-center gap-2.5 sm:gap-3 text-xs sm:text-sm font-medium text-japandi-charcoal">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-japandi-sand/85 border border-japandi-clay/60">
          <span class="w-1.5 h-1.5 rounded-full bg-japandi-moss shrink-0"></span>
          <span>{CANONICAL_PRICES.consultation} consultation with digital X-ray</span>
        </div>
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-japandi-sand/85 border border-japandi-clay/60">
          <span class="w-1.5 h-1.5 rounded-full bg-japandi-moss shrink-0"></span>
          <span>Open 7 days till 9 PM</span>
        </div>
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-japandi-sand/85 border border-japandi-clay/60">
          <span class="w-1.5 h-1.5 rounded-full bg-japandi-moss shrink-0"></span>
          <span>2nd floor with lift</span>
        </div>
      </div>

      <!-- Action Buttons: Book visit, WhatsApp, Call -->
      <div class="pt-2 flex flex-wrap items-center gap-3 w-full sm:w-auto">
        <button 
          type="button"
          data-open-booking
          class="inline-flex items-center justify-center px-7 py-3.5 bg-japandi-moss text-japandi-cream hover:bg-japandi-charcoal font-medium rounded-full transition-all duration-300 shadow-md shadow-japandi-moss/10 cursor-none text-xs sm:text-sm uppercase tracking-wider"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 mr-2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
          </svg>
          Book visit
        </button>

        <a 
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-6 py-3.5 bg-emerald-600 hover:bg-emerald-700 text-white font-medium rounded-full transition-all duration-300 shadow-sm text-xs sm:text-sm uppercase tracking-wider"
          title="Chat with Aureva Dental on WhatsApp"
          aria-label="Chat with Aureva Dental on WhatsApp"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-4 h-4 mr-2">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          WhatsApp
        </a>

        <a 
          href={phoneCallUrl}
          class="inline-flex items-center justify-center px-6 py-3.5 border border-japandi-clay bg-japandi-sand/80 hover:bg-japandi-sand text-japandi-charcoal font-medium rounded-full transition-all duration-300 text-xs sm:text-sm uppercase tracking-wider"
          title="Call Aureva Dental Reception"
          aria-label="Call Aureva Dental Reception"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 mr-2 text-japandi-moss">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
          </svg>
          Call
        </a>
      </div>

    </div>
  </div>
</header>

<script is:inline>
  (function() {
    function loadHeroVideo() {
      var conn = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
      if (conn) {
        if (conn.saveData) return;
        var slowTypes = ['slow-2g', '2g', '3g'];
        if (conn.effectiveType && slowTypes.indexOf(conn.effectiveType) !== -1) return;
      }

      var video = document.getElementById('hero-bg-video');
      if (!video) return;
      if (video.getAttribute('src')) return;

      var src = video.getAttribute('data-src');
      if (src) {
        video.src = src;
        video.load();
        var playPromise = video.play();
        if (playPromise !== undefined) {
          playPromise.catch(function() {});
        }
      }
    }

    function scheduleHeroVideo() {
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(loadHeroVideo, { timeout: 2500 });
      } else {
        setTimeout(loadHeroVideo, 1200);
      }
    }

    if (document.readyState === 'complete') {
      scheduleHeroVideo();
    } else {
      window.addEventListener('load', scheduleHeroVideo);
    }

    document.addEventListener('astro:page-load', function() {
      var video = document.getElementById('hero-bg-video');
      if (video && !video.getAttribute('src')) {
        scheduleHeroVideo();
      }
    });
  })();
</script>
