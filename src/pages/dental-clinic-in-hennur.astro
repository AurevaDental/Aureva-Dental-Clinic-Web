---
import Layout from '../layouts/Layout.astro';
import { generateBreadcrumbSchema, generateFaqSchema } from '../utils/seoSchemas';
import { GOOGLE_REVIEWS_LABEL, GOOGLE_RATING, GOOGLE_REVIEW_COUNT } from '../config/clinic';
import { CANONICAL_PRICES } from '../data/prices';

const pageTitle = "Visit Aureva Dental Clinic, Hennur Bande | Photos, Directions, Hours";
const pageDescription = "Photos, directions, hours and facilities at Aureva Dental in Hennur Bande. Private treatment rooms, single-use instrument kits, parking, lift, open till 9 PM.";
const canonicalUrl = "https://aurevadental.com/dental-clinic-in-hennur";
const phoneCallUrl = "tel:+917349701002";
const whatsappUrl = "https://wa.me/917349701002?text=Hello%20Aureva%20Dental%2C%20I%20would%20like%20directions%20or%20to%20visit%20the%20clinic.";

const breadcrumbs = [
  { name: "Home", url: "https://aurevadental.com/" },
  { name: "Visit the Clinic", url: canonicalUrl }
];

const faqs = [
  {
    question: "Where is Aureva Dental located?",
    answer: "Aureva Dental is located at 2nd floor, No.11, 4, Horamavu Agara Rd, near Nayara Petrol Bunk, Hennur Bande, Hennur Gardens, Bengaluru, Karnataka 560043. The clinic is on the 2nd floor with lift access."
  },
  {
    question: "Is vehicle parking available at the clinic?",
    answer: "Parking available for 4-wheelers and 2-wheelers."
  },
  {
    question: "What are your operating hours?",
    answer: "We are open Monday 4–9 PM, and Tuesday to Sunday 9:30 AM–9 PM. Walk-ins are welcome till 9 PM daily."
  },
  {
    question: "What hygiene and sterilization protocols are followed?",
    answer: "Every instrument is cleaned and autoclaved between patients. Sealed single-use instrument kits are opened in front of you."
  },
  {
    question: "Where can I view treatment prices?",
    answer: `Every price is published on our website. Please see our complete price list at /prices. New patient consultations are ${CANONICAL_PRICES.consultation} including digital RVG X-rays valid for 6 months.`
  }
];

const breadcrumbSchema = JSON.stringify(generateBreadcrumbSchema(breadcrumbs));
const faqSchema = JSON.stringify(generateFaqSchema(faqs));

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogUrl: canonicalUrl,
  schemaMarkup: [breadcrumbSchema, faqSchema]
};

const clinicPhotos = [
  {
    src: "/assets/hero-card-800.webp",
    alt: "Private treatment room and dental operatory at Aureva Dental in Hennur Bande",
    caption: "Private treatment operatory with digital sensor imaging"
  },
  {
    src: "/assets/near-me/reception_desk_aureva.webp",
    alt: "Welcoming reception desk and calm lounge at Aureva Dental",
    caption: "Welcoming reception and check-in desk"
  },
  {
    src: "/assets/near-me/treatment_operatory_chair.webp",
    alt: "Ergonomic dental chair and clean treatment operatory at Aureva Dental",
    caption: "Ergonomic treatment suite"
  },
  {
    src: "/assets/near-me/corridor_arch_tooth_sign.webp",
    alt: "Clinic corridor with architectural illuminated tooth symbol at Aureva Dental",
    caption: "Tranquil corridor and patient walkway"
  },
  {
    src: "/assets/clinic-exterior-800.webp",
    alt: "Aureva Dental clinic building exterior on Horamavu Agara Road near Nayara Petrol Bunk",
    caption: "Clinic building exterior on Horamavu Agara Road"
  }
];
---

<Layout {...seoProps}>
  <!-- Breadcrumb Navigation -->
  <nav class="bg-japandi-sand/30 border-b border-japandi-clay/20 py-3.5 px-6 lg:px-24 text-xs font-light text-japandi-earth" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <a href="/" class="hover:text-japandi-moss transition-colors">Home</a>
        <span>/</span>
        <span class="text-japandi-charcoal font-medium">Visit the Clinic</span>
      </div>
      <a href="/prices" class="inline-flex items-center gap-1 text-xs font-semibold text-japandi-moss hover:underline">
        Treatment Prices &rarr;
      </a>
    </div>
  </nav>

  <!-- Hero Header -->
  <section class="py-12 md:py-20 px-6 lg:px-24 bg-transparent border-b border-japandi-clay/30">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <div class="lg:col-span-7 flex flex-col items-start space-y-4 md:space-y-6 animate-slow-fade">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-japandi-clay bg-japandi-sand/80 text-[10px] sm:text-xs font-semibold text-japandi-moss tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full bg-japandi-moss animate-pulse"></span>
          <span>Aureva Dental &bull; Hennur Bande, Bangalore</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Visit the clinic
        </h1>

        <div class="space-y-2 text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
          <p class="flex items-center gap-2 text-japandi-charcoal font-medium">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-japandi-moss shrink-0">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
            <span>Mon 4–9 PM, Tue–Sun 9:30 AM–9 PM</span>
          </p>
          <p class="flex items-start gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-japandi-moss shrink-0 mt-0.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
            </svg>
            <span>2nd floor, No.11, 4, Horamavu Agara Rd, near Nayara Petrol Bunk, Hennur Bande, Hennur Gardens, Bengaluru, Karnataka 560043</span>
          </p>
          <p class="flex items-center gap-2 text-japandi-moss font-semibold">
            <span class="w-2 h-2 rounded-full bg-japandi-moss shrink-0"></span>
            Parking available for 4-wheelers and 2-wheelers.
          </p>
          <p class="flex items-center gap-2 text-japandi-charcoal">
            <span class="w-2 h-2 rounded-full bg-japandi-moss shrink-0"></span>
            2nd floor with lift
          </p>
        </div>

        <p class="text-sm sm:text-base text-japandi-earth font-light leading-relaxed max-w-2xl">
          A tranquil, sound-damped dental studio designed for calm focus. Step inside to see our private treatment rooms, strict sterilisation and straightforward directions from nearby neighbourhoods.
        </p>

        <!-- Action Buttons -->
        <div class="pt-2 flex flex-wrap items-center gap-3 w-full sm:w-auto">
          <button 
            type="button" 
            data-open-booking 
            class="px-7 py-3.5 rounded-full bg-japandi-moss hover:bg-japandi-charcoal text-japandi-cream text-xs font-semibold uppercase tracking-wider transition-all duration-300 shadow-sm"
          >
            Book Appointment
          </button>
          <a 
            href={whatsappUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="px-6 py-3.5 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold uppercase tracking-wider transition-all duration-300 shadow-sm"
          >
            WhatsApp Us
          </a>
          <a 
            href={phoneCallUrl} 
            class="px-6 py-3.5 rounded-full border border-japandi-clay bg-japandi-sand/80 hover:bg-japandi-sand text-japandi-charcoal text-xs font-semibold uppercase tracking-wider transition-all duration-300"
          >
            Call +91 73497 01002
          </a>
        </div>
      </div>

      <!-- Hero Clinic Photo -->
      <div class="lg:col-span-5 relative">
        <div class="rounded-3xl overflow-hidden border border-japandi-clay/60 shadow-xl bg-japandi-sand/30 aspect-[4/3]">
          <img 
            src="/assets/hero-card-800.webp" 
            alt="Aureva Dental consultation room and private treatment operatory in Hennur Bande" 
            width="800" 
            height="600" 
            loading="eager" 
            decoding="async" 
            class="w-full h-full object-cover" 
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Clinic Photos Gallery -->
  <section class="py-14 md:py-20 px-6 lg:px-24 bg-japandi-sand/20 border-b border-japandi-clay/30">
    <div class="max-w-7xl mx-auto space-y-8">
      <div>
        <h2 class="text-2xl sm:text-3xl font-serif text-japandi-charcoal font-medium">
          Inside the clinic
        </h2>
        <p class="text-xs sm:text-sm text-japandi-earth font-light mt-1">
          Explore our private operatories, welcoming lounge, and clinical facilities.
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
        {clinicPhotos.map((photo) => (
          <div class="space-y-2 group">
            <div class="rounded-2xl overflow-hidden border border-japandi-clay/50 aspect-[4/3] bg-japandi-clay/20">
              <img 
                src={photo.src}
                alt={photo.alt}
                width="400"
                height="300"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </div>
            <p class="text-[11px] text-japandi-earth font-light leading-tight">
              {photo.caption}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Facilities: Private Rooms & Single-Use Sealed Kits -->
  <section class="py-14 md:py-20 px-6 lg:px-24 bg-transparent border-b border-japandi-clay/30">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8">
      
      <div class="p-8 rounded-3xl bg-japandi-sand/55 border border-japandi-clay/50 space-y-4">
        <div class="w-10 h-10 rounded-2xl bg-japandi-moss/10 text-japandi-moss flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
          </svg>
        </div>
        <h2 class="text-xl sm:text-2xl font-serif text-japandi-charcoal font-medium">
          Private treatment rooms
        </h2>
        <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
          Every operatory is fully enclosed and sound-damped. You receive treatments in a calm, private room away from corridor noise or waiting area traffic, ensuring comfortable consultations and confidential discussions.
        </p>
      </div>

      <div class="p-8 rounded-3xl bg-japandi-sand/55 border border-japandi-clay/50 space-y-4">
        <div class="w-10 h-10 rounded-2xl bg-japandi-moss/10 text-japandi-moss flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
          </svg>
        </div>
        <h2 class="text-xl sm:text-2xl font-serif text-japandi-charcoal font-medium">
          Sealed single-use instrument kits
        </h2>
        <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
          Infection control is rigorous and transparent. Instruments are cleaned in an ultrasonic bath and autoclaved between patients. Sealed single-use instrument kits are opened in front of you at the start of your appointment.
        </p>
      </div>

    </div>
  </section>

  <!-- Directions & Commute Times from Local Neighbourhoods -->
  <section class="py-14 md:py-20 px-6 lg:px-24 bg-japandi-sand/20 border-b border-japandi-clay/30">
    <div class="max-w-5xl mx-auto space-y-8">
      <div>
        <h2 class="text-2xl sm:text-3xl font-serif text-japandi-charcoal font-medium">
          How to reach Aureva Dental
        </h2>
        <p class="text-sm sm:text-base text-japandi-earth font-light mt-1">
          Convenient transit times from key residential areas across North-East Bangalore. Drive times change with traffic.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 text-xs sm:text-sm text-japandi-earth font-light">
        <div class="p-6 rounded-2xl bg-japandi-sand/60 border border-japandi-clay/50 space-y-3">
          <h3 class="text-base font-serif font-medium text-japandi-charcoal">From Hennur Main Road</h3>
          <p class="leading-relaxed">
            A 5-minute drive via Hennur Bande Road with minimal traffic. Proceed past Hennur Cross onto Horamavu Agara Road until Nayara Petrol Bunk.
          </p>
          <span class="inline-block text-[11px] font-semibold text-japandi-moss bg-japandi-moss/10 px-2.5 py-1 rounded-full">
            ~5 min drive
          </span>
        </div>

        <div class="p-6 rounded-2xl bg-japandi-sand/60 border border-japandi-clay/50 space-y-3">
          <h3 class="text-base font-serif font-medium text-japandi-charcoal">From Horamavu</h3>
          <p class="leading-relaxed">
            Direct 3 to 5 minutes drive from Horamavu Ring Road junction, Kalkere, and Babusapalya along Horamavu Agara Main Road.
          </p>
          <span class="inline-block text-[11px] font-semibold text-japandi-moss bg-japandi-moss/10 px-2.5 py-1 rounded-full">
            ~3–5 min drive
          </span>
        </div>

        <div class="p-6 rounded-2xl bg-japandi-sand/60 border border-japandi-clay/50 space-y-3">
          <h3 class="text-base font-serif font-medium text-japandi-charcoal">From Kalyan Nagar & HRBR</h3>
          <p class="leading-relaxed">
            2.7 km (about 12 minutes drive). Head north on Hennur Main Road towards Hennur Bande, then turn onto Horamavu Agara Road near Nayara Petrol Bunk.
          </p>
          <span class="inline-block text-[11px] font-semibold text-japandi-moss bg-japandi-moss/10 px-2.5 py-1 rounded-full">
            2.7 km &bull; ~12 min drive
          </span>
        </div>
      </div>

      <!-- Map Embed -->
      <div class="rounded-3xl overflow-hidden border border-japandi-clay/60 aspect-[16/10] w-full relative bg-japandi-clay/20 shadow-sm">
        <iframe
          title="Aureva Dental Google Maps Location in Hennur Bande"
          src="https://maps.google.com/maps?q=13.0381741,77.6416031+(Aureva+Dental)&t=&z=16&ie=UTF8&iwloc=B&output=embed"
          width="100%"
          height="100%"
          style="border:0;"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="w-full h-full"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- Link to Prices Section (Replacing old price table) -->
  <section class="py-14 md:py-20 px-6 lg:px-24 bg-transparent border-b border-japandi-clay/30 text-center">
    <div class="max-w-3xl mx-auto space-y-6">
      <h2 class="text-2xl sm:text-3xl font-serif text-japandi-charcoal font-medium">
        Looking for treatment prices?
      </h2>
      <p class="text-sm sm:text-base text-japandi-earth font-light leading-relaxed">
        Every treatment price at Aureva Dental is organized into one transparent list. Consultations with digital X-ray are {CANONICAL_PRICES.consultation}, valid for 6 months.
      </p>
      <div>
        <a 
          href="/prices" 
          class="inline-flex items-center gap-2 px-8 py-4 rounded-full bg-japandi-moss hover:bg-japandi-charcoal text-japandi-cream text-xs uppercase font-semibold tracking-wider transition-all duration-300 shadow-sm"
        >
          <span>View All Treatment Prices</span>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQs Section -->
  <section class="py-14 md:py-20 px-6 lg:px-24 bg-japandi-sand/20">
    <div class="max-w-4xl mx-auto space-y-8">
      <div>
        <h2 class="text-2xl sm:text-3xl font-serif text-japandi-charcoal font-medium">
          Frequently asked questions about visiting the clinic
        </h2>
      </div>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <div class="p-6 rounded-2xl bg-japandi-sand/60 border border-japandi-clay/50 space-y-2">
            <h3 class="text-sm sm:text-base font-serif font-medium text-japandi-charcoal">
              {faq.question}
            </h3>
            <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
