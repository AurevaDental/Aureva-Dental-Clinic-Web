---
import Layout from '../layouts/Layout.astro';
import { generateBreadcrumbSchema, generateFaqSchema } from '../utils/seoSchemas';

export const prerender = false;

const pageTitle = "Dental Clinic in Hennur Bangalore | Aureva Dental";
const pageDescription = "Visit Aureva Dental clinic in Hennur, Bangalore. Digital X-rays, gentle root canals, dental implants & family dentistry. Call +91 73497 01002.";
const canonicalUrl = "https://aurevadental.com/dental-clinic-in-hennur";
const phoneCallUrl = "tel:+917349701002";
const whatsappUrl = "https://wa.me/917349701002";

const breadcrumbs = [
  { name: "Home", url: "https://aurevadental.com/" },
  { name: "Dental Clinic in Hennur", url: canonicalUrl }
];

const faqs = [
  {
    question: "What makes Aureva Dental different from other dental clinics in Hennur?",
    answer: "Aureva Dental is built around a tranquil Japandi architectural philosophy combining warm minimalist aesthetics with careful clinical precision. Unlike noisy, crowded clinics, our studio is sound-damped and free of chemical odors. We utilize computerized local anesthesia, low-radiation digital RVG sensors, autoclave sterilization, and intraoral cameras so you experience a comfortable visit and total transparency throughout."
  },
  {
    question: "What diagnostic technologies are available at your Hennur dental clinic?",
    answer: "Our Hennur studio is outfitted with high-frequency digital X-ray units paired with high-definition RVG sensors, intraoral digital video cameras, computerized apex locators for microscopic root canals, motorized rotary endodontic consoles, ultrasonic dental scalers with micro-tip irrigation, and LED curing systems for durable composite restorations."
  },
  {
    question: "Is Aureva Dental clinic open on weekends and Sundays?",
    answer: "Yes, Aureva Dental is fully operational on Sundays from 9:30 AM to 9:00 PM, and on Saturdays from 9:30 AM to 9:00 PM. We understand that working professionals and busy families find weekdays challenging, so our full team of doctors is available throughout the weekend for elective treatments as well as sudden emergencies."
  },
  {
    question: "Do you offer parking at the clinic?",
    answer: "Yes, free parking downstairs for 2 cars and 5 to 8 bikes is available directly within the SLV Nilaya building premises on Horamavu Agara Road. Our clinic is located on the 2nd floor with direct lift access."
  },
  {
    question: "What safety and sterilization guidelines are practiced?",
    answer: "All instruments are thoroughly cleaned, sealed in sterilization pouches and autoclaved, with single-use items such as disposable barriers, gloves, masks, and suction tips discarded after each patient."
  },
  {
    question: "Which localities are closest to your dental clinic in Hennur?",
    answer: "We are centrally situated on Horamavu Agara Road near Nayara Petrol Bunk, making us within 5 to 10 minutes of Hennur Bande, Hennur Main Road, Horamavu, Babusapalya, Kalyan Nagar, HRBR Layout, Kammanahalli, Geddalahalli, Kothanur, and Byrathi."
  }
];

const breadcrumbSchema = JSON.stringify(generateBreadcrumbSchema(breadcrumbs));
const faqSchema = JSON.stringify(generateFaqSchema(faqs));

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogUrl: canonicalUrl,
  schemaMarkup: [breadcrumbSchema, faqSchema]
};
---

<Layout {...seoProps}>
  <!-- Preload Critical Above-the-fold Hero Image -->
  <link rel="preload" as="image" href="/assets/hero-card-800.webp" imagesrcset="/assets/hero-card-400.webp 400w, /assets/hero-card-800.webp 800w" imagesizes="(max-width: 640px) 400px, 800px" type="image/webp" fetchpriority="high" slot="head" />

  <!-- Breadcrumb Navigation -->
  <nav class="bg-japandi-sand/30 border-b border-japandi-clay/20 py-3.5 px-6 lg:px-24 text-xs font-light text-japandi-earth" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <a href="/" class="hover:text-japandi-moss transition-colors">Home</a>
        <span>/</span>
        <span class="text-japandi-charcoal font-medium">Dental Clinic in Hennur</span>
      </div>
      <!-- Near the top Prices quick link -->
      <a href="#pricing" class="inline-flex items-center gap-1 text-xs font-semibold text-japandi-moss hover:underline">
        Prices &darr;
      </a>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="py-12 md:py-20 px-6 lg:px-24 bg-transparent relative overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <div class="lg:col-span-7 flex flex-col items-start space-y-4 md:space-y-6 animate-slow-fade">
        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-japandi-clay/60 bg-japandi-sand/70 text-[10px] font-semibold text-japandi-moss uppercase tracking-widest">
            Smile Studio &bull; Hennur Bande, Bengaluru
          </span>
          <a href="#pricing" class="inline-flex items-center gap-1 px-3 py-1 rounded-full border border-japandi-moss/40 bg-japandi-moss/10 hover:bg-japandi-moss/20 text-[10px] font-semibold text-japandi-moss uppercase tracking-wider transition-colors">
            View Price List &darr;
          </a>
        </div>
        
        <!-- Primary Search H1 -->
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif text-japandi-charcoal leading-tight font-medium tracking-tight">
          Dental Clinic in Hennur
        </h1>

        <!-- One Line on Hours (Above fold on mobile) -->
        <p class="text-xs sm:text-sm font-medium text-japandi-moss flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 shrink-0">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
          <span>Open Tue–Sun 9:30 AM–9 PM · Mon 4–9 PM · Sundays open</span>
        </p>

        <!-- One Line on Address (Above fold on mobile) -->
        <p class="text-xs sm:text-sm text-japandi-earth font-light flex items-start gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-japandi-moss shrink-0 mt-0.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
          </svg>
          <span>2nd Floor, SLV Nilaya, Horamavu Agara Road, near Nayara Petrol Bunk, Hennur Bande</span>
        </p>

        <p class="text-sm sm:text-base text-japandi-earth font-light leading-relaxed max-w-2xl">
          Discover modern, unhurried dentistry crafted for comfort and careful clinical care. At Aureva Dental, we blend Japanese minimalist design with Scandinavian warmth, providing gentle root canals, clear aligners, dental implants, and family care on Horamavu Agara Road.
        </p>

        <!-- Action Call and WhatsApp Buttons (Plain <a> tags for GTM tracking) -->
        <div class="pt-2 flex flex-row items-center gap-3 w-full sm:w-auto">
          <a 
            href={phoneCallUrl}
            class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-japandi-moss text-japandi-cream hover:bg-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 shadow-md shadow-japandi-moss/15"
            aria-label="Call Aureva Dental Reception Desk"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
            </svg>
            <span>Call +91 73497 01002</span>
          </a>

          <a 
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 shadow-md shadow-emerald-600/20"
            aria-label="Chat with Aureva Dental on WhatsApp"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-4 h-4">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            <span>WhatsApp</span>
          </a>
        </div>
      </div>

      <!-- Real Clinic Photo (Hero Image) -->
      <div class="lg:col-span-5 relative">
        <div class="relative rounded-3xl overflow-hidden border border-japandi-clay/60 shadow-xl bg-japandi-sand/30">
          <img 
            src="/assets/hero-card-800.webp" 
            srcset="/assets/hero-card-400.webp 400w, /assets/hero-card-800.webp 800w, /assets/hero-card.webp 1376w" 
            sizes="(max-width: 640px) 400px, 800px" 
            alt="Aureva Dental - Calm Mind. Healthy Smile." 
            width="800" 
            height="447" 
            fetchpriority="high" 
            decoding="async" 
            class="w-full h-auto object-cover" 
          />
          <div class="p-5 space-y-2">
            <span class="text-[10px] font-semibold uppercase tracking-widest text-japandi-moss block">5.0 (40+ Google Reviews)</span>
            <h3 class="text-lg font-serif text-japandi-charcoal font-medium">Aureva Dental Clinic &amp; Studio, Hennur</h3>
            <p class="text-xs text-japandi-earth font-light leading-relaxed">
              Modern dental care in SLV Nilaya on Horamavu Agara Road with low-radiation digital RVG diagnostics and on-site parking.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Deep Dive: Inside Aureva Dental Clinic in Hennur -->
  <section class="py-16 px-6 lg:px-24 bg-japandi-sand/25 border-y border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-12">
      
      <div class="space-y-4">
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          A Dental Clinic in Hennur Designed for Comfort, Precision, and Trust
        </h2>
        <p class="text-sm sm:text-base text-japandi-earth font-light leading-relaxed">
          For decades, visiting the dentist was synonymous with clinical white walls, pungent chemical odors, noisy handpieces, and intimidating equipment. When creating Aureva Dental on Horamavu Agara Road, our objective was clear: transform the dental clinic from a place of dread into a restorative sanctuary where patients feel comfortable. Every architectural detail—from the soft timber finishes and warm lighting to noise-damped treatment operatory suites—was deliberately selected to soothe the nervous system.
        </p>
        <p class="text-sm sm:text-base text-japandi-earth font-light leading-relaxed">
          Yet beneath this serene exterior lies a modern digital dental clinic. Founded by Dr. Shweta Singh (Founder & Clinical Director, The Oxford Dental College, Bangalore) alongside Co-Founder and Dental Surgeon Dr. Agniss Mishra, our clinic integrates computer-guided technologies that make procedures faster, more biologically conservative, and genuinely comfortable.
        </p>
      </div>

      <!-- Technological Infrastructure Section -->
      <div class="space-y-6">
        <h3 class="text-xl sm:text-2xl font-serif text-japandi-charcoal font-medium">
          Advanced Diagnostic &amp; Treatment Technology at Our Clinic
        </h3>
        <p class="text-sm text-japandi-earth font-light leading-relaxed">
          Accurate diagnosis is the foundation of enduring dental health. We have invested in modern diagnostic equipment that empowers our clinical team to diagnose micro-pathologies before they escalate into painful emergencies:
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="p-6 rounded-2xl bg-japandi-cream/80 border border-japandi-clay/40 space-y-2.5">
            <h4 class="font-serif text-base text-japandi-charcoal font-medium">1. High-Frequency Digital RVG Sensor</h4>
            <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
              Our clinic utilizes digital Radiovisiography sensors that reduce radiation dose by over 85% compared to photographic dental film. The images appear within seconds on chairside monitors, allowing micro-fractures, interproximal decay, and bone contours to be magnified with clear detail.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-japandi-cream/80 border border-japandi-clay/40 space-y-2.5">
            <h4 class="font-serif text-base text-japandi-charcoal font-medium">2. High-Definition Intraoral Camera</h4>
            <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
              We believe patients should be fully empowered partners in their treatment choices. Our high-definition intraoral camera projects live color views of your teeth directly onto your screen, showing you cracked fillings, plaque margins, or enamel wear before we ever begin treatment.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-japandi-cream/80 border border-japandi-clay/40 space-y-2.5">
            <h4 class="font-serif text-base text-japandi-charcoal font-medium">3. Motorized Endodontic Rotary Consoles</h4>
            <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
              Say goodbye to manual root canal drilling. Our computerized rotary endodontic motors paired with flexible nickel-titanium (NiTi) micro-files clean and shape curved root canals with gentle precision and smoothness, preserving maximum natural tooth root structure.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-japandi-cream/80 border border-japandi-clay/40 space-y-2.5">
            <h4 class="font-serif text-base text-japandi-charcoal font-medium">4. Ultrasonic Piezo Scalers with Micro-Mist</h4>
            <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
              Professional prophylaxis and calculus removal at Aureva Dental is gentle on enamel and gums. Our piezoelectric scalers vibrate at microscopic frequencies with warm water mist, lifting hardened tartar and coffee stains with gentle care.
            </p>
          </div>
        </div>
      </div>

      <!-- Transparent Treatment Fee Schedule Section -->
      <div id="pricing" class="space-y-6 pt-6 border-t border-japandi-clay/30">
        <div class="space-y-2">
          <span class="text-xs font-semibold uppercase tracking-widest text-japandi-moss">Transparent Care</span>
          <h3 class="text-xl sm:text-3xl font-serif text-japandi-charcoal font-medium">
            Standard Treatment Pricing in Hennur
          </h3>
          <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
            All treatment plans are confirmed in writing following a comprehensive clinical examination and digital RVG radiograph. Zero hidden facility surcharges.
          </p>
        </div>

        <div class="overflow-x-auto rounded-2xl border border-japandi-clay/40 bg-japandi-sand/30">
          <table class="w-full text-left text-xs sm:text-sm text-japandi-earth font-light">
            <thead class="bg-japandi-sand/80 text-japandi-charcoal font-medium border-b border-japandi-clay/40">
              <tr>
                <th class="p-4">Dental Treatment</th>
                <th class="p-4">Clinical Description</th>
                <th class="p-4">Published Fee (INR)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-japandi-clay/20">
              <tr>
                <td class="p-4 font-medium text-japandi-charcoal">New Patient Consultation</td>
                <td class="p-4">Oral exam + low-radiation digital RVG X-ray</td>
                <td class="p-4 text-japandi-moss font-semibold">₹600</td>
              </tr>
              <tr>
                <td class="p-4 font-medium text-japandi-charcoal">Routine Scaling &amp; Polishing</td>
                <td class="p-4">Ultrasonic tartar removal &amp; prophylactic buffing</td>
                <td class="p-4 text-japandi-moss font-semibold">₹2,000 – ₹5,000</td>
              </tr>
              <tr>
                <td class="p-4 font-medium text-japandi-charcoal">Deep Periodontal Scaling</td>
                <td class="p-4">Subgingival ultrasonic debridement for inflamed gums</td>
                <td class="p-4 text-japandi-moss font-semibold">₹8,000 – ₹15,000</td>
              </tr>
              <tr>
                <td class="p-4 font-medium text-japandi-charcoal">Tooth-Colored Filling</td>
                <td class="p-4">Biomimetic nano-hybrid composite restoration</td>
                <td class="p-4 text-japandi-moss font-semibold">₹1,500 – ₹4,000</td>
              </tr>
              <tr>
                <td class="p-4 font-medium text-japandi-charcoal">Root Canal Treatment (RCT)</td>
                <td class="p-4">Rotary endodontics (anterior to molar)</td>
                <td class="p-4 text-japandi-moss font-semibold">₹4,000 – ₹10,000</td>
              </tr>
              <tr>
                <td class="p-4 font-medium text-japandi-charcoal">Dental Crown (PFM)</td>
                <td class="p-4">Porcelain-fused-to-metal restoration</td>
                <td class="p-4 text-japandi-moss font-semibold">₹4,000 – ₹6,000</td>
              </tr>
              <tr>
                <td class="p-4 font-medium text-japandi-charcoal">Dental Crown (Ceramic)</td>
                <td class="p-4">All-ceramic aesthetic restoration</td>
                <td class="p-4 text-japandi-moss font-semibold">₹6,000 – ₹10,000</td>
              </tr>
              <tr>
                <td class="p-4 font-medium text-japandi-charcoal">Monolithic Zirconia Crown</td>
                <td class="p-4">CAD/CAM milled metal-free ceramic crown</td>
                <td class="p-4 text-japandi-moss font-semibold">₹10,000 – ₹18,000</td>
              </tr>
              <tr>
                <td class="p-4 font-medium text-japandi-charcoal">Dental Implant (Per Fixture)</td>
                <td class="p-4">Surgical placement of grade-4 titanium fixture</td>
                <td class="p-4 text-japandi-moss font-semibold">₹35,000 – ₹60,000</td>
              </tr>
              <tr>
                <td class="p-4 font-medium text-japandi-charcoal">Wisdom Tooth Removal</td>
                <td class="p-4">Simple extraction to surgical impaction release</td>
                <td class="p-4 text-japandi-moss font-semibold">₹4,000 – ₹10,000</td>
              </tr>
              <tr>
                <td class="p-4 font-medium text-japandi-charcoal">In-Office LED/Laser Teeth Whitening</td>
                <td class="p-4">4–8 shades brighter with gingival barrier isolation</td>
                <td class="p-4 text-japandi-moss font-semibold">₹8,000 – ₹15,000</td>
              </tr>
              <tr>
                <td class="p-4 font-medium text-japandi-charcoal">Clear Aligners (Full Arch Series)</td>
                <td class="p-4">Computerized orthodontic aligner series</td>
                <td class="p-4 text-japandi-moss font-semibold">₹80,000 – ₹2,50,000</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Comprehensive Clinical Care Spectrum -->
      <div class="space-y-6">
        <h3 class="text-xl sm:text-2xl font-serif text-japandi-charcoal font-medium">
          Comprehensive Dental Disciplines Offered Under One Roof
        </h3>
        <p class="text-sm text-japandi-earth font-light leading-relaxed">
          Families in Hennur, Horamavu, and Kalyan Nagar no longer need to travel to multiple specialized centers for comprehensive oral health. Our clinic provides end-to-end dental solutions:
        </p>

        <div class="space-y-4 text-sm text-japandi-earth font-light">
          <div class="p-5 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 space-y-2">
            <h4 class="font-serif text-base text-japandi-charcoal font-medium">
              <a href="/treatments/root-canal-treatment" class="text-japandi-moss hover:underline">Microscopic Root Canal Therapy &rarr;</a>
            </h4>
            <p class="leading-relaxed">
              Specialized single-sitting and multi-sitting root canal procedures to eliminate nerve infection, relieve severe dental toothaches, and salvage natural teeth. Read our dedicated guide on <a href="/root-canal-treatment-hennur" class="text-japandi-moss underline">root canal treatment in Hennur</a>.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 space-y-2">
            <h4 class="font-serif text-base text-japandi-charcoal font-medium">
              <a href="/treatments/dental-implants" class="text-japandi-moss hover:underline">Titanium &amp; Zirconia Dental Implants &rarr;</a>
            </h4>
            <p class="leading-relaxed">
              Biocompatible root replacements that restore single missing teeth, multiple teeth bridges, or full-mouth restorations with enduring stability. Explore our <a href="/dental-implants-hennur" class="text-japandi-moss underline">dental implants in Hennur</a>.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 space-y-2">
            <h4 class="font-serif text-base text-japandi-charcoal font-medium">
              <a href="/treatments/clear-aligners" class="text-japandi-moss hover:underline">Digital Orthodontics &amp; Invisible Aligners &rarr;</a>
            </h4>
            <p class="leading-relaxed">
              Straighten misaligned teeth, eliminate spacing, and resolve bite irregularities with transparent, removable aligner trays. Read our in-depth resource on <a href="/invisible-aligners-hennur" class="text-japandi-moss underline">invisible aligners in Hennur</a>.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 space-y-2">
            <h4 class="font-serif text-base text-japandi-charcoal font-medium">
              <a href="/treatments/teeth-whitening" class="text-japandi-moss hover:underline">LED/Laser Teeth Whitening &amp; Bridal Smile Radiance &rarr;</a>
            </h4>
            <p class="leading-relaxed">
              Safe, pH-neutral in-office LED/Laser whitening that lightens enamel by 4 to 8 shades in a single 45-minute appointment. See our <a href="/teeth-whitening-hennur" class="text-japandi-moss underline">teeth whitening in Hennur</a> page.
            </p>
