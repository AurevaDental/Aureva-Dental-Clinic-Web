---
import Layout from '../layouts/Layout.astro';
import { GOOGLE_RATING, GOOGLE_REVIEW_COUNT, GOOGLE_REVIEWS_LABEL } from '../config/clinic';
import { CANONICAL_PRICES } from '../data/prices';

const pageTitle = "Dentist in Kothanur, Bengaluru | Aureva Dental, 2.4 km away";
const pageDescription = `Dentist near Kothanur & Hennur–Bagalur Road, 2.4 km away. Open 7 days with ${CANONICAL_PRICES.consultation} consultation including digital X-ray. Walk in or call to book.`;
const canonicalUrl = "https://aurevadental.com/dentist-in-kothanur";
const phoneCallUrl = "tel:+917349701002";
const whatsappUrl = "https://wa.me/917349701002?text=Hi%20Aureva%20Dental%2C%20I%20am%20visiting%20from%20Kothanur%20and%20would%20like%20to%20consult.";
const directionsUrl = "https://www.google.com/maps/dir/?api=1&origin=Kothanur,+Bengaluru&destination=Aureva+Dental,+Horamavu+Agara+Rd,+Hennur+Bande,+Bengaluru";
const canonicalAddress = "2nd floor, No.11, 4, Horamavu Agara Rd, near Nayara Petrol Bunk, Hennur Bande, Hennur Gardens, Bengaluru, Karnataka 560043";

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  robots: "index, follow",
  hideHeader: false,
  hideFooter: false,
  hideMobileBottomBar: false
};

const treatmentPricing = [
  { name: "Consultation & Digital RVG X-Ray", price: CANONICAL_PRICES.consultation, note: "Valid for 6 months" },
  { name: "Scaling & Polishing (Hygiene)", price: CANONICAL_PRICES.scaling_routine, note: "Ultrasonic tartar removal" },
  { name: "Composite Tooth Filling", price: CANONICAL_PRICES.tooth_filling, note: "Tooth-colored biomimetic resin" },
  { name: "Root Canal Treatment (Rotary RCT)", price: CANONICAL_PRICES.rct_overall, note: "Gentle single or multi-visit" },
  { name: "Crowns & Caps (PFM, Ceramic, Zirconia)", price: CANONICAL_PRICES.crown_overall, note: "Custom laboratory fabricated" },
  { name: "Tooth Extraction", price: CANONICAL_PRICES.extraction_overall, note: "Simple & surgical" },
  { name: "Wisdom Tooth Removal", price: CANONICAL_PRICES.wisdom_overall, note: "Simple & surgical impactions" },
  { name: "Teeth Whitening", price: CANONICAL_PRICES.whitening_laser, note: "In-office LED brightening" },
  { name: "Kids Dentistry (Pediatric Care)", price: CANONICAL_PRICES.kids_dentistry_summary, note: "Gentle cavity care & sealants" },
  { name: "Dental Implants", price: CANONICAL_PRICES.implant_single_fixture, note: "Titanium replacement tooth" },
  { name: "Clear Aligners", price: CANONICAL_PRICES.clear_aligners_overall, note: "Custom 3D invisible trays" }
];

const faqs = [
  {
    q: "Is there a dentist open in the evening near Hennur–Bagalur Road?",
    a: "Yes. Aureva Dental is open every evening until 9:00 PM from Tuesday through Sunday, as well as Monday afternoons from 4:00 PM to 9:00 PM. Residents commuting home along Hennur–Bagalur Road find our location just off the main road ideal for evening dental visits, emergency toothache evaluations, and routine procedures after regular work hours."
  },
  {
    q: "How far is Aureva Dental from Kothanur Bengaluru?",
    a: "Our clinic is 2.4 km from Kothanur, taking approximately 14 minutes by car or two-wheeler. Simply travel south along Hennur–Bagalur Main Road (New Airport Road) towards Hennur Bande, then branch onto Horamavu Agara Road until you see our building near Nayara Petrol Bunk. Drive times change with traffic. The clinic is on the 2nd floor with lift access. Parking available for 4-wheelers and 2-wheelers."
  },
  {
    q: "Is there a kids dentist near Kothanur for children's dental care?",
    a: `Yes. Aureva Dental provides child-focused dental check-ups for ${CANONICAL_PRICES.kids_checkup} including digital X-rays. For complex pediatric conditions, early interceptive alignment, or full-mouth cavity management, an MDS paedodontist visits our clinic on a scheduled case basis to provide attentive, gentle care in a non-threatening environment.`
  },
  {
    q: "How long does a root canal take to complete?",
    a: "A root canal treatment is typically completed in 1 to 2 clinical sittings, depending on the severity of pulp infection, root canal curvature, and tooth location. Simple anterior single-canal teeth are often completed in a single sitting, whereas complex molars may require an interim medicated dressing to ensure infection clearance. A definitive timeline is outlined following your clinical examination and digital RVG radiograph."
  },
  {
    q: "Can I walk in for immediate emergency tooth pain relief?",
    a: "Yes. Walk-ins are welcomed until 9:00 PM across our regular operating days. If you experience severe throbbing pain, a cracked tooth, or facial swelling, you can arrive directly at our Horamavu Agara Road clinic for immediate evaluation, pain-relief dressing, or urgent drainage. Notifying us via phone or WhatsApp enables our clinical team to prepare an operatory promptly."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};
---

<Layout {...seoProps} schemaMarkup={[JSON.stringify(faqSchema)]}>
  <main class="min-h-screen bg-japandi-cream text-japandi-charcoal">
    <!-- Hero Section -->
    <section class="px-4 sm:px-6 lg:px-24 pt-12 pb-10 max-w-5xl mx-auto text-center space-y-5">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-japandi-moss/10 text-japandi-moss text-xs font-semibold uppercase tracking-wider">
        <span>Accessible Dental Care &middot; 2.4 km from Kothanur</span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-serif text-japandi-charcoal font-medium tracking-tight">
        Dentist near Kothanur
      </h1>

      <p class="text-sm sm:text-base text-japandi-earth font-light max-w-2xl mx-auto leading-relaxed">
        Providing reliable, conservative dentistry for Kothanur and the Hennur–Bagalur Road corridor. Conveniently situated on Horamavu Agara Road with evening walk-ins welcome until 9 PM.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <a 
          href={phoneCallUrl}
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-japandi-moss hover:bg-japandi-charcoal text-japandi-cream font-medium text-xs uppercase tracking-wider transition-all shadow-sm"
        >
          Call 073497 01002
        </a>
        <a 
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full border border-japandi-clay bg-japandi-sand/80 hover:bg-japandi-sand text-japandi-charcoal font-medium text-xs uppercase tracking-wider transition-all"
        >
          WhatsApp Us
        </a>
        <a 
          href={directionsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full border border-japandi-clay bg-japandi-sand/80 hover:bg-japandi-sand text-japandi-charcoal font-medium text-xs uppercase tracking-wider transition-all"
        >
          Get Directions
        </a>
      </div>

      {GOOGLE_RATING > 0 && GOOGLE_REVIEW_COUNT > 0 && (
        <div class="pt-2 flex items-center justify-center gap-2 text-xs text-japandi-earth">
          <span class="text-amber-500 tracking-tight">★ ★ ★ ★ ★</span>
          <span class="font-semibold text-japandi-charcoal">{GOOGLE_RATING.toFixed(1)}</span>
          <span>({GOOGLE_REVIEW_COUNT} Google Reviews)</span>
        </div>
      )}
    </section>

    <!-- Route from Kothanur -->
    <section class="py-10 px-4 sm:px-6 lg:px-24 max-w-4xl mx-auto border-t border-japandi-clay/20">
      <div class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-serif text-japandi-charcoal font-medium">
          Route from Kothanur and Hennur–Bagalur Road
        </h2>
        <div class="bg-japandi-sand/40 border border-japandi-clay/40 rounded-2xl p-6 sm:p-8 space-y-4">
          <p class="text-sm sm:text-base text-japandi-charcoal font-normal leading-relaxed">
            Reaching Aureva Dental from Kothanur is a brief drive along Hennur–Bagalur Main Road (New Airport Road) proceeding south towards Hennur Bande. Pass the local residential layouts and turn into Horamavu Agara Road, where our clinic is prominently located near Nayara Petrol Bunk, roughly 2.4 km away in about 14 minutes. Drive times change with traffic. Our dental clinic is located on the 2nd floor with lift access. Parking available for 4-wheelers and 2-wheelers.
          </p>
          <div class="pt-2 flex flex-wrap items-center justify-between gap-3 text-xs text-japandi-earth border-t border-japandi-clay/30">
            <span>Kothanur: 2.4 km &middot; about 14 min</span>
            <span>Via Hennur–Bagalur Main Road</span>
            <a 
              href={directionsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-japandi-moss font-semibold hover:underline"
            >
              Open Google Maps Route &rarr;
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- When people from Kothanur visit us -->
    <section class="py-10 px-4 sm:px-6 lg:px-24 max-w-4xl mx-auto border-t border-japandi-clay/20">
      <div class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-serif text-japandi-charcoal font-medium">
          When people from Kothanur visit us
        </h2>
        <div class="space-y-4 text-sm sm:text-base text-japandi-earth font-light leading-relaxed">
          <p>
            Homeowners, apartment residents, and long-standing locals from Kothanur and the rapidly expanding Hennur–Bagalur Road sector frequently choose our practice to avoid the exhausting traffic of traveling deeper into central Bengaluru. Because suburban living often involves commuting toward airport zones or tech parks during peak hours, having a fully equipped modern dental clinic just 2.4 km down the road offers immense everyday convenience. Our extended clinic schedule running until 9 PM on weekdays and through Sundays allows neighborhood residents to address dental concerns without disrupting daytime work commitments.
          </p>
          <p>
            Patients from Kothanur value the calm, personal nature of our clinical appointments. Rather than navigating a crowded hospital OPD, visitors step into a quiet, clean studio where doctors take adequate time to explain diagnoses thoroughly. We utilize digital imaging to illustrate clinical findings clearly, ensuring that all treatment recommendations are transparent, medically indicated, and accompanied by written price estimates.
          </p>
          <p>
            For those experiencing unexpected toothaches, chipped restorations, or localized gum swelling, our willingness to accept walk-ins up to 9:00 PM provides reassurance that emergency care is always close at hand. Residents across the Hennur Bande and Kothanur corridor rely on our team for honest assessments and steady clinical support. Families appreciate that both routine treatments and complex specialist procedures are managed right here without requiring multiple hospital referrals across town.
          </p>
        </div>
      </div>
    </section>

    <!-- Treatments people from Kothanur often ask about -->
    <section class="py-10 px-4 sm:px-6 lg:px-24 max-w-4xl mx-auto border-t border-japandi-clay/20">
      <div class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-serif text-japandi-charcoal font-medium">
          Treatments people from Kothanur often ask about
        </h2>
        <div class="space-y-4 text-sm sm:text-base text-japandi-earth font-light leading-relaxed">
          <p>
            Patients arriving from Kothanur commonly consult us for conservative root canal treatment, troublesome wisdom tooth discomfort, and immediate relief from acute toothache. Deep dental decay causing nighttime throbbing is evaluated using instant digital RVG radiography, allowing our clinicians to determine whether single-sitting or two-visit rotary endodontics is indicated, with root canal fees ranging from {CANONICAL_PRICES.rct_overall}. Impacted or partially erupted third molars that create recurrent gum flap swelling are diagnosed accurately, with surgical removal fees ranging between {CANONICAL_PRICES.wisdom_overall}.
          </p>
          <p>
            Emergency walk-in patients seeking immediate relief from cracked teeth or lost fillings benefit from same-day soothing dressings and biomimetic composite restorations ranging from {CANONICAL_PRICES.tooth_filling}. For fixed tooth replacements, we provide titanium dental implants from {CANONICAL_PRICES.implant_single_fixture} as well as full-coverage protective zirconia crowns from {CANONICAL_PRICES.crown_zirconia}. Initial consultations are {CANONICAL_PRICES.consultation}, include digital X-rays, and stay valid for six months so treatment can proceed at your chosen pace.
          </p>
          <p>
            We also accommodate routine hygiene scaling and polishing ranging from {CANONICAL_PRICES.scaling_routine} to resolve plaque retention and early gingivitis, ensuring long-term periodontal health for every patient who walks through our doors. Patients appreciate receiving straightforward advice on home hygiene practices that help prevent recurring dental troubles over time.
          </p>
        </div>
      </div>
    </section>

    <!-- Clinic Standards & Diagnostic Equipment -->
    <section class="py-10 px-4 sm:px-6 lg:px-24 max-w-4xl mx-auto border-t border-japandi-clay/20">
      <div class="space-y-5">
        <h2 class="text-2xl sm:text-3xl font-serif text-japandi-charcoal font-medium">
          Diagnostic technology and safety standards
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="p-5 rounded-2xl bg-japandi-sand/50 border border-japandi-clay/40 space-y-2">
            <h3 class="font-serif text-base font-medium text-japandi-charcoal">Low-Dose Digital RVG</h3>
            <p class="text-xs text-japandi-earth font-light leading-relaxed">
              Equipped with high-sensitivity digital sensors that minimize X-ray exposure while producing crystal-clear diagnostic views of periapical infections and bone density.
            </p>
          </div>
          <div class="p-5 rounded-2xl bg-japandi-sand/50 border border-japandi-clay/40 space-y-2">
            <h3 class="font-serif text-base font-medium text-japandi-charcoal">High-Definition Camera</h3>
            <p class="text-xs text-japandi-earth font-light leading-relaxed">
              Chairside intraoral optics display magnified live views of fractured margins, micro-cracks, and soft tissue health directly onto patient monitors.
            </p>
          </div>
          <div class="p-5 rounded-2xl bg-japandi-sand/50 border border-japandi-clay/40 space-y-2">
            <h3 class="font-serif text-base font-medium text-japandi-charcoal">Autoclave Sterilisation</h3>
            <p class="text-xs text-japandi-earth font-light leading-relaxed">
              Instruments are autoclaved between patients, with strict infection control.
            </p>
          </div>
        </div>
        <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
          To ensure comprehensive clinical breadth, visiting MDS specialists—including endodontists, oral and maxillofacial surgeons, orthodontists, periodontists, paedodontists, and prosthodontists—attend to specialized clinical treatments on a case-by-case basis at our Horamavu Agara Road clinic. These specialists coordinate closely with our resident team to oversee continuous post-operative healing and personalized follow-ups.
        </p>
      </div>
    </section>

    <!-- Treatments and Prices -->
    <section class="py-10 px-4 sm:px-6 lg:px-24 max-w-4xl mx-auto border-t border-japandi-clay/20">
      <div class="space-y-4">
        <div class="text-center sm:text-left space-y-1">
          <h2 class="text-2xl sm:text-3xl font-serif text-japandi-charcoal font-medium">
            Treatments and prices
          </h2>
          <p class="text-xs sm:text-sm text-japandi-earth font-light">
            Prices are published estimate ranges. You receive an itemized, written quote after clinical examination.
          </p>
        </div>

        <div class="bg-japandi-cream border border-japandi-clay/40 rounded-2xl divide-y divide-japandi-clay/20 overflow-hidden shadow-sm">
          {treatmentPricing.map((item) => (
            <div class="p-4 sm:px-6 sm:py-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-1 text-xs sm:text-sm">
              <div>
                <span class="font-medium text-japandi-charcoal block sm:inline">{item.name}</span>
                <span class="text-[11px] text-japandi-earth font-light sm:ml-2">({item.note})</span>
              </div>
              <span class="font-semibold text-japandi-moss shrink-0">{item.price}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- How your first visit works -->
    <section class="py-10 px-4 sm:px-6 lg:px-24 max-w-4xl mx-auto border-t border-japandi-clay/20">
      <div class="space-y-6">
        <div class="text-center sm:text-left space-y-1">
          <h2 class="text-2xl sm:text-3xl font-serif text-japandi-charcoal font-medium">
            How your first visit works
          </h2>
          <p class="text-xs sm:text-sm text-japandi-earth font-light">
            A structured, unhurried initial evaluation designed around your comfort and complete financial transparency.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="p-6 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/30 space-y-2">
            <span class="w-7 h-7 rounded-full bg-japandi-moss text-japandi-cream text-xs font-semibold flex items-center justify-center">1</span>
            <h3 class="font-serif text-base font-medium text-japandi-charcoal pt-1">Examination &amp; Digital X-Ray</h3>
            <p class="text-xs text-japandi-earth font-light leading-relaxed">
              We begin with a thorough examination of teeth, gums, and bite alignment. Low-radiation RVG digital X-rays are taken to inspect beneath the surface. Consultation is {CANONICAL_PRICES.consultation} and stays valid for 6 months.
            </p>
          </div>
          <div class="p-6 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/30 space-y-2">
            <span class="w-7 h-7 rounded-full bg-japandi-moss text-japandi-cream text-xs font-semibold flex items-center justify-center">2</span>
            <h3 class="font-serif text-base font-medium text-japandi-charcoal pt-1">Clear Explanation &amp; Written Plan</h3>
            <p class="text-xs text-japandi-earth font-light leading-relaxed">
              We review clinical findings on screen using intraoral camera photos and radiographs. You receive a clear, printed estimate detailing treatment steps, timelines, and exact pricing before anything starts.
            </p>
          </div>
          <div class="p-6 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/30 space-y-2">
            <span class="w-7 h-7 rounded-full bg-japandi-moss text-japandi-cream text-xs font-semibold flex items-center justify-center">3</span>
            <h3 class="font-serif text-base font-medium text-japandi-charcoal pt-1">Treatment at Your Pace</h3>
            <p class="text-xs text-japandi-earth font-light leading-relaxed">
              Begin necessary care on the same day if you wish, or schedule subsequent visits at times convenient for your calendar. There is never pressure to proceed until you feel fully prepared.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Questions people in Kothanur ask us -->
    <section class="py-10 px-4 sm:px-6 lg:px-24 max-w-4xl mx-auto border-t border-japandi-clay/20">
      <div class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-serif text-japandi-charcoal font-medium">
          Questions people in Kothanur ask us
        </h2>
        <div class="divide-y divide-japandi-clay/30 border border-japandi-clay/40 rounded-2xl bg-japandi-cream overflow-hidden">
          {faqs.map((faq) => (
            <div class="p-5 sm:p-6 space-y-2">
              <h3 class="font-serif text-base font-medium text-japandi-charcoal">
                {faq.q}
              </h3>
              <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
                {faq.a}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Find Us / Contact Block -->
    <section class="py-10 px-4 sm:px-6 lg:px-24 max-w-4xl mx-auto border-t border-japandi-clay/20">
      <div class="bg-japandi-sand/60 border border-japandi-clay/40 rounded-3xl p-6 sm:p-8 space-y-4">
        <h2 class="text-xl sm:text-2xl font-serif text-japandi-charcoal font-medium">
          Find Aureva Dental
        </h2>
        <div class="space-y-1.5 text-xs sm:text-sm text-japandi-earth font-light">
          <p><strong class="font-medium text-japandi-charcoal">Address:</strong> {canonicalAddress}</p>
          <p><strong class="font-medium text-japandi-charcoal">Landmark:</strong> Horamavu Agara Road, near Nayara Petrol Bunk, Hennur Bande (2nd floor with lift access).</p>
          <p><strong class="font-medium text-japandi-charcoal">Hours:</strong> Tuesday–Sunday 9:30 AM–9:00 PM &middot; Monday 4:00 PM–9:00 PM (Walk-ins welcome until 9 PM).</p>
          <p><strong class="font-medium text-japandi-charcoal">Parking:</strong> Parking available for 4-wheelers and 2-wheelers.</p>
        </div>
        <div class="pt-2 flex flex-wrap gap-3">
          <a href={phoneCallUrl} class="px-5 py-2.5 rounded-full bg-japandi-moss text-japandi-cream text-xs font-medium uppercase tracking-wider hover:bg-japandi-charcoal transition-colors">
            Call 073497 01002
          </a>
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 rounded-full border border-japandi-clay bg-japandi-sand text-japandi-charcoal text-xs font-medium uppercase tracking-wider hover:bg-japandi-cream transition-colors">
            WhatsApp
          </a>
          <a href={directionsUrl} target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 rounded-full border border-japandi-clay bg-japandi-sand text-japandi-charcoal text-xs font-medium uppercase tracking-wider hover:bg-japandi-cream transition-colors">
            Google Maps Directions
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
