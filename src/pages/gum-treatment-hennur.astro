---
import Layout from '../layouts/Layout.astro';
import { generateBreadcrumbSchema, generateFaqSchema, generateTreatmentServiceSchema } from '../utils/seoSchemas';

export const prerender = false;

const pageTitle = "Gum Treatment in Hennur Bangalore | Aureva Dental";
const pageDescription = "Gentle gum treatment in Hennur, Bangalore at Aureva Dental. Deep periodontal scaling, laser gum therapy & periodontist care. Call +91 73497 01002.";
const canonicalUrl = "https://aurevadental.com/gum-treatment-hennur";
const phoneCallUrl = "tel:+917349701002";
const whatsappUrl = "https://wa.me/917349701002?text=Hello%20Aureva%20Dental%2C%20I%20have%20bleeding%20or%20swollen%20gums%20and%20would%20like%20to%20consult%20for%20Gum%20Treatment%20in%20Hennur.";

const breadcrumbs = [
  { name: "Home", url: "https://aurevadental.com/" },
  { name: "Treatments", url: "https://aurevadental.com/treatments/scaling-and-polishing" },
  { name: "Gum Treatment Hennur", url: canonicalUrl }
];

const faqs = [
  {
    question: "What are the common warning signs of gum disease?",
    answer: "Early warning signs include bleeding gums when brushing or flossing, persistent redness, puffiness, chronic bad breath (halitosis), gum tenderness, and receding gum lines. If left unaddressed, infection can progress to loose teeth and changes in your bite."
  },
  {
    question: "What is pyorrhea, and how does it differ from gingivitis?",
    answer: "Gingivitis is the early, reversible stage of gum inflammation caused by surface plaque, causing red or bleeding gums without bone loss. Pyorrhea (periodontitis) is the advanced, chronic stage where bacteria migrate beneath the gum line, destroying the underlying jawbone and periodontal ligaments that anchor your teeth."
  },
  {
    question: "How does laser gum treatment help?",
    answer: "Laser gum treatment uses targeted laser light to gently decontaminate periodontal pockets, eliminate deep-seated bacteria, and remove infected pocket lining without cutting gums or placing sutures. This promotes faster tissue reattachment, minimal bleeding, and comfortable post-treatment recovery."
  },
  {
    question: "How much does deep gum treatment cost in Hennur?",
    answer: "At Aureva Dental, a comprehensive new patient consultation including digital RVG X-ray assessment is ₹600. Deep periodontal scaling and root planing across affected quadrants ranges from ₹8,000 to ₹15,000 based on pocket depth and bone involvement. Transparent written pricing is provided prior to commencing care."
  },
  {
    question: "Is there a gum specialist (periodontist) available at Aureva Dental?",
    answer: "Yes. In addition to our resident dental surgeons, we have experienced visiting periodontists (gum specialists) on call for advanced periodontal flap therapy, bone grafting, and regenerative gum procedures."
  },
  {
    question: "How do digital RVG X-rays help in gum disease diagnosis?",
    answer: "Digital RVG X-rays provide high-resolution, low-radiation views of the alveolar bone surrounding every tooth root. This allows us to accurately measure bone loss patterns, detect hidden subgingival tartar deposits, and establish a precise baseline to track bone stability after treatment."
  }
];

const breadcrumbSchema = JSON.stringify(generateBreadcrumbSchema(breadcrumbs));
const faqSchema = JSON.stringify(generateFaqSchema(faqs));
const serviceSchema = JSON.stringify(generateTreatmentServiceSchema({
  name: "Gum Treatment in Hennur",
  description: pageDescription,
  url: canonicalUrl,
  medicalSpecialty: "Periodontics"
}));

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogUrl: canonicalUrl,
  schemaMarkup: [breadcrumbSchema, faqSchema, serviceSchema]
};
---

<Layout {...seoProps}>
  <!-- Preload Critical Above-the-fold Hero Image -->
  <link rel="preload" as="image" href="/assets/clinic-exterior-800.webp" type="image/webp" slot="head" />

  <!-- Breadcrumb Navigation -->
  <nav class="bg-japandi-sand/30 border-b border-japandi-clay/20 py-3.5 px-6 lg:px-24 text-xs font-light text-japandi-earth" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <a href="/" class="hover:text-japandi-moss transition-colors">Home</a>
        <span>/</span>
        <a href="/treatments/scaling-and-polishing" class="hover:text-japandi-moss transition-colors">Treatments</a>
        <span>/</span>
        <span class="text-japandi-charcoal font-medium">Gum Treatment Hennur</span>
      </div>
      <!-- Near the top Prices quick link -->
      <a href="#pricing" class="inline-flex items-center gap-1 text-xs font-semibold text-japandi-moss hover:underline">
