---
import Layout from '../layouts/Layout.astro';
import { generateBreadcrumbSchema, generateFaqSchema, generateTreatmentServiceSchema } from '../utils/seoSchemas';
import { CANONICAL_PRICES } from '../data/prices';
import TreatmentDepartmentCard from '../components/TreatmentDepartmentCard.astro';
import TreatmentAftercare from '../components/TreatmentAftercare.astro';
import TreatmentActions from '../components/TreatmentActions.astro';

const pageTitle = "Emergency Dentist in Hennur Bande | Open Till 9 PM | Aureva Dental";
const pageDescription = "Same-day emergency dental treatment in Hennur Bande at Aureva Dental. Immediate relief for acute toothache, broken teeth & swelling. Walk in till 9 PM daily.";
const canonicalUrl = "https://aurevadental.com/emergency-dentist-hennur";
const phoneCallUrl = "tel:+917349701002";
const whatsappUrl = "https://wa.me/917349701002?text=EMERGENCY%3A%20I%20have%20an%20urgent%20dental%20emergency%20in%20Hennur%20and%20need%20immediate%20assistance.";

const faqs = [
  {
    question: "How quickly can I be seen for a dental emergency in Hennur Bande?",
    answer: "At Aureva Dental on Horamavu Agara Road in Hennur Bande, we prioritize emergency walk-ins for patients with acute pain, swelling, knocked-out teeth, or broken restorations during clinic hours. Call +91 73497 01002 or WhatsApp our emergency desk before arriving."
  },
  {
    question: "Are you open on Sundays for dental emergencies in Hennur?",
    answer: "Yes, Aureva Dental is open on Sundays from 9:30 AM to 9:00 PM. We understand that severe toothaches, broken teeth, and dental trauma frequently happen on weekends."
  },
  {
    question: "What should I do if my adult tooth is knocked out completely?",
    answer: "Handle the tooth only by the white crown—never touch the root. Rinse gently with cold milk or saline if dirty (do not scrub). If possible, reinsert it into the socket and bite gently on clean gauze. If not, store it in cold milk and come to our Hennur clinic immediately within 30 to 60 minutes."
  },
  {
    question: "How much does an emergency dental visit cost at Aureva Dental Hennur Bande?",
    answer: `An initial emergency consultation with digital RVG X-ray is ${CANONICAL_PRICES.consultation}. Temporary fillings are ${CANONICAL_PRICES.temporary_filling}, emergency pain-relief nerve dressings are ${CANONICAL_PRICES.emergency_pain_dressing}, and routine extractions range from ${CANONICAL_PRICES.extraction_overall}. Prices are ranges, confirmed after examination.`
  }
];

const breadcrumbs = [
  { name: "Home", url: "https://aurevadental.com/" },
  { name: "Treatments", url: "https://aurevadental.com/treatments/emergency-dentist" },
  { name: "Emergency Dentist in Hennur Bande", url: canonicalUrl }
];

const breadcrumbSchema = JSON.stringify(generateBreadcrumbSchema(breadcrumbs));
const faqSchema = JSON.stringify(generateFaqSchema(faqs));
const serviceSchema = JSON.stringify(generateTreatmentServiceSchema({
  name: "Emergency Dentist in Hennur Bande",
  description: pageDescription,
  url: canonicalUrl,
  medicalSpecialty: "Emergency Dental Service"
}));

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogUrl: canonicalUrl,
  schemaMarkup: [breadcrumbSchema, faqSchema, serviceSchema]
};
---

<Layout {...seoProps}>
  <!-- Breadcrumb Navigation -->
  <nav class="bg-japandi-sand/30 border-b border-japandi-clay/20 py-3.5 px-6 lg:px-24 text-xs font-light text-japandi-earth" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto flex items-center gap-2">
      <a href="/" class="hover:text-japandi-moss transition-colors">Home</a>
      <span>/</span>
      <a href="/treatments/emergency-dentist" class="hover:text-japandi-moss transition-colors">Emergency Dentist</a>
      <span>/</span>
      <span class="text-japandi-charcoal font-medium">Hennur Bande</span>
    </div>
  </nav>

  <!-- Urgent Emergency Top Banner -->
  <aside aria-label="Urgent Notice" class="bg-red-700 text-white py-3 px-6 lg:px-24 text-center text-xs sm:text-sm font-medium">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-6">
      <span class="flex items-center gap-1.5 font-semibold uppercase tracking-wider">
        <span class="w-2 h-2 rounded-full bg-white animate-ping"></span>
        Emergency Walk-ins Welcome &bull; Open Till 9 PM
      </span>
      <div class="flex items-center gap-4">
        <a href={phoneCallUrl} class="underline font-bold hover:text-red-100 transition-colors">Call: +91 73497 01002</a>
        <span>&bull;</span>
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="underline font-bold hover:text-red-100 transition-colors">WhatsApp Desk</a>
      </div>
    </div>
  </aside>

  <!-- 1. Hero / H1 Section -->
  <section class="py-16 md:py-24 px-6 lg:px-24 bg-transparent relative overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 flex flex-col items-start space-y-6 animate-slow-fade">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-red-200 bg-red-50 text-red-800 text-xs font-semibold tracking-wider">
          <span class="w-2 h-2 rounded-full bg-red-600 animate-pulse shrink-0"></span>
          <span>Same-Day Emergency Relief in Hennur Bande</span>
        </div>
        
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif text-japandi-charcoal leading-tight font-medium tracking-tight">
          Emergency dentist in Hennur Bande
        </h1>

        <p class="text-base sm:text-lg text-japandi-earth font-light leading-relaxed max-w-2xl">
          Severe dental pain, broken teeth, or facial swelling treated promptly. Walk in during clinic hours at Aureva Dental, 2nd floor, Horamavu Agara Road near Nayara Petrol Bunk. For first-aid advice and clinical triage protocols, see our <a href="/treatments/emergency-dentist" class="text-japandi-moss underline decoration-japandi-moss/50 hover:decoration-japandi-moss font-medium">Emergency Dental Care Guide</a>.
        </p>

        <!-- Hours Box -->
        <div class="p-4 rounded-2xl bg-amber-50/70 border border-amber-200 text-xs text-japandi-charcoal space-y-1">
          <p class="font-medium">Hours: Mon 4–9 PM, Tue–Sun 9:30 AM–9 PM. Walk-ins accepted till 9 PM.</p>
        </div>

        <!-- Action Buttons -->
        <div class="pt-2 flex flex-wrap items-center gap-4 w-full sm:w-auto">
          <a 
            href={phoneCallUrl}
            class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-red-700 text-white hover:bg-red-800 text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 shadow-md shadow-red-700/20 min-h-[48px]"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
            </svg>
            <span>Call Clinic: +91 73497 01002</span>
          </a>

          <a 
            href={whatsappUrl}
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-7 py-4 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 shadow min-h-[48px]"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-4 h-4">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            <span>WhatsApp Emergency Desk</span>
          </a>
        </div>
      </div>

      <!-- Quick Location Info -->
      <div class="lg:col-span-5 relative">
        <div class="rounded-3xl bg-japandi-sand/50 border border-japandi-clay/60 p-8 space-y-4">
          <span class="text-xs font-semibold uppercase tracking-widest text-japandi-moss">Hennur Bande Facility</span>
          <h3 class="font-serif text-xl font-medium text-japandi-charcoal">Reaching Aureva Dental</h3>
          <p class="text-xs text-japandi-earth leading-relaxed font-light">
            2nd floor, No.11, 4, Horamavu Agara Rd, near Nayara Petrol Bunk, Hennur Bande, Hennur Gardens, Bengaluru 560043.
          </p>
          <div class="pt-2 border-t border-japandi-clay/30 text-xs text-japandi-earth space-y-1">
            <p><strong>Building access:</strong> 2nd floor with lift.</p>
            <p><strong>Parking:</strong> Parking available for 4-wheelers and 2-wheelers.</p>
            <p><strong>Drive times:</strong> 3–5 min from Horamavu, 5 min from Hennur Main Rd, 10–12 min from Kalyan Nagar.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Who It's For (Symptoms in Plain Words) -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Emergency Symptoms</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Who emergency dental care is for
        </h2>
      </div>
      <p class="text-sm sm:text-base text-japandi-earth font-light leading-relaxed">
        We provide urgent care for children and adults experiencing:
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm text-japandi-earth font-light">
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Acute Toothache</h3>
          <p>Throbbing, sharp pain that does not respond to regular painkillers and disrupts normal activities.</p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Dental Abscess or Swelling</h3>
          <p>Visible facial swelling or a tender bump on the gums with warmth and tenderness.</p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Broken or Cracked Tooth</h3>
          <p>A tooth broken while eating or through accidental impact, causing sharp edge irritation or pulp sensitivity.</p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Knocked-Out Tooth</h3>
          <p>Permanent tooth dislodged by accident or fall—bring it immediately in cold milk within 60 minutes.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. What Happens, Visit by Visit, & Number of Sittings -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-8">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Clinical Protocol</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          What happens, visit by visit
        </h2>
        <p class="text-sm sm:text-base text-japandi-earth font-light mt-2">
          Emergency stabilization takes 1 visit. Any required definitive restoration is planned in follow-up visits.
        </p>
      </div>

      <div class="space-y-4 text-xs sm:text-sm text-japandi-earth font-light">
        <div class="p-6 rounded-2xl bg-japandi-sand/30 border border-japandi-clay/40 space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">Visit 1: Emergency Triage, X-ray &amp; Immediate Relief</h3>
            <span class="text-[10px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded bg-japandi-moss/10 text-japandi-moss">Sitting 1</span>
          </div>
          <p class="leading-relaxed">
            Clinical exam and low-radiation digital RVG X-ray. Local anaesthesia is administered to ensure comfort, followed by immediate pulpal relief, dressing, drainage, or temporary restoration.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-japandi-sand/30 border border-japandi-clay/40 space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">Follow-Up: Definitive Treatment</h3>
            <span class="text-[10px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded bg-japandi-moss/10 text-japandi-moss">1–2 Sittings</span>
          </div>
          <p class="leading-relaxed">
            Once acute inflammation subsides, permanent root canal obturation, crown placement, or composite reconstruction is completed by our dental team.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Price Table from Keys -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Transparent Pricing</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Emergency treatment fees
        </h2>
        <p class="text-xs sm:text-sm text-japandi-earth font-light mt-1">
          Prices are ranges, confirmed after examination.
        </p>
      </div>

      <div class="rounded-2xl border border-japandi-clay/40 overflow-hidden bg-japandi-cream/90 shadow-sm">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-japandi-sand/60 text-japandi-charcoal font-serif border-b border-japandi-clay/30">
            <tr>
              <th class="py-3 px-4">Procedure</th>
              <th class="py-3 px-4">Price Range</th>
              <th class="py-3 px-4 hidden sm:table-cell">Details</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-japandi-clay/20 text-japandi-earth font-light">
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">Emergency Consultation</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.consultation}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Includes clinical examination and digital RVG X-ray</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">Temporary Filling</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.temporary_filling}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Sedative dressing per tooth</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">Emergency Nerve Pain Dressing</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.emergency_pain_dressing}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Pulpal decompression for severe pain</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">Incision and Drainage</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.incision_drainage}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Abscess drainage and irrigation</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">Tooth Extraction (Simple)</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.extraction_simple}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Removal of non-restorable tooth</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-xs text-japandi-earth font-light">
        View complete fees for all procedures on our <a href="/prices" class="text-japandi-moss underline decoration-japandi-moss/40 hover:decoration-japandi-moss font-medium">treatment prices</a> page.
      </p>
    </div>
  </section>

  <!-- 5. Which Department Handles It -->
  <TreatmentDepartmentCard 
    department="Endodontics & Conservative Dentistry"
    link="/our-specialists#endodontics"
    description="Emergency pulpal decompressions, acute toothaches, and root canal therapy are managed by our visiting endodontists, while dental trauma and complex extractions are handled by our visiting oral and maxillofacial surgeons."
  />

  <!-- 6. Aftercare and When to Call Us -->
  <TreatmentAftercare 
    instructions={[
      "Take prescribed medications exactly as directed by your clinician.",
      "Avoid chewing on the treated tooth until local numbness wears off and permanent restoration is completed.",
      "Maintain gentle oral hygiene around the treated area without aggressive brushing or poking.",
      "Rinse gently with warm salt water after 24 hours if an extraction or drainage was performed."
    ]}
    whenToCall={[
      "Swelling worsens or spreads toward your eye, jawline, or neck.",
      "You experience difficulty swallowing, breathing, or fully opening your mouth.",
      "Pain continues with severe intensity 48 hours after treatment."
    ]}
  />

  <!-- 7. FAQs (with Schema) -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-8">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Common Questions</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Frequently asked questions
        </h2>
      </div>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <div class="bg-japandi-cream/90 border border-japandi-clay/40 rounded-2xl p-6 space-y-2">
            <h3 class="font-serif text-base sm:text-lg text-japandi-charcoal font-medium">
              {faq.question}
            </h3>
            <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. Related Treatments -->
  <section class="py-16 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <h2 class="text-xl sm:text-2xl font-serif text-japandi-charcoal font-medium">
        Related treatments
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
        <a href="/treatments/emergency-dentist" class="p-4 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 hover:border-japandi-moss transition-colors block space-y-1">
          <span class="font-serif text-sm text-japandi-charcoal font-medium block">Emergency Care Guide</span>
          <span class="text-japandi-earth font-light">First-aid guide and triage protocols</span>
        </a>
        <a href="/root-canal-treatment-hennur" class="p-4 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 hover:border-japandi-moss transition-colors block space-y-1">
          <span class="font-serif text-sm text-japandi-charcoal font-medium block">Root Canal Treatment</span>
          <span class="text-japandi-earth font-light">Definitive relief for inflamed pulp</span>
        </a>
        <a href="/treatments/tooth-extraction" class="p-4 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 hover:border-japandi-moss transition-colors block space-y-1">
          <span class="font-serif text-sm text-japandi-charcoal font-medium block">Tooth Extraction</span>
          <span class="text-japandi-earth font-light">Removal of non-restorable teeth</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 9. Book / WhatsApp / Call -->
  <TreatmentActions treatmentName="Emergency Dental Consultation" />
</Layout>
