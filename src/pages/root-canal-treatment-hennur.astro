---
import { CANONICAL_PRICES } from "../data/prices";
import Layout from "../layouts/Layout.astro";
import {
  generateBreadcrumbSchema,
  generateFaqSchema,
  generateTreatmentServiceSchema,
} from "../utils/seoSchemas";
import TreatmentDepartmentCard from "../components/TreatmentDepartmentCard.astro";
import TreatmentAftercare from "../components/TreatmentAftercare.astro";
import TreatmentActions from "../components/TreatmentActions.astro";

const pageTitle = "Root Canal Treatment in Hennur Bangalore | Aureva Dental";
const pageDescription =
  "Gentle root canal treatment, in a single-sitting where the case allows, in Hennur, Bangalore at Aureva Dental. Rotary endodontics, digital RVG & custom zirconia crowns. Call +91 73497 01002.";
const canonicalUrl = "https://aurevadental.com/root-canal-treatment-hennur";
const phoneCallUrl = "tel:+917349701002";
const whatsappUrl =
  "https://wa.me/917349701002?text=Hello%20Aureva%20Dental%2C%20I%20have%20tooth%20pain%20and%20would%20like%20to%20consult%20for%20Root%20Canal%20Treatment%20in%20Hennur.";

const breadcrumbs = [
  { name: "Home", url: "https://aurevadental.com/" },
  { name: "Root Canal Treatment in Hennur", url: canonicalUrl },
];

const faqs = [
  {
    question: "Is root canal treatment comfortable at your Hennur clinic?",
    answer:
      "Root canal treatment at Aureva Dental is designed for gentle comfort. We utilize local anaesthesia delivery and topical pre-numbing gels that minimize injection discomfort. With high-precision rotary nickel-titanium instruments and apex locators, we work to numb the tooth before treatment and gentle canal cleaning without pressure or sharp pain.",
  },
  {
    question: "Can a root canal be completed in a single sitting in Hennur?",
    answer:
      "Yes. In many cases where pulpal inflammation has not progressed to acute periapical abscess or active pus drainage, our clinical dental team can complete the root canal—cleaning, disinfecting, and hermetic sealing—in a single appointment. Severe or re-treatment infections may require a second visit with medicinal intracanal dressing to ensure complete healing.",
  },
  {
    question:
      "How much does a Root Canal Treatment (RCT) cost at Aureva Dental in Hennur?",
    answer: `At Aureva Dental, Root Canal Treatments range from ${CANONICAL_PRICES.rct_overall} based on tooth position and complexity: Anterior front teeth (single canal): ${CANONICAL_PRICES.rct_anterior}; Premolars (1–2 canals): ${CANONICAL_PRICES.rct_premolar}; Molars (3–4 canals): ${CANONICAL_PRICES.rct_molar}. Re-RCT of previously failed procedures ranges from ${CANONICAL_PRICES.rct_re_treatment}. Complete transparent pricing is provided in writing before treatment.`,
  },
  {
    question: "Why is a dental crown necessary after an RCT?",
    answer:
      "A root canal removes the infected nerve and vascular tissue from inside the tooth, leaving the remaining tooth structure brittle over time. A customized lab-milled Zirconia or ceramic crown encapsulates the tooth, restoring normal chewing force and preventing catastrophic tooth fractures or micro-leakage reinfection.",
  },
  {
    question: "What are the warning signs that I need an emergency root canal?",
    answer:
      "Key symptoms include persistent, throbbing toothache that worsens when lying down, intense lingering sensitivity to hot or cold drinks, pain while biting or chewing, localized swelling on the gums resembling a pimple (fistula), or darkened enamel discoloration following dental trauma.",
  },
];

const breadcrumbSchema = JSON.stringify(generateBreadcrumbSchema(breadcrumbs));
const faqSchema = JSON.stringify(generateFaqSchema(faqs));
const serviceSchema = JSON.stringify(
  generateTreatmentServiceSchema({
    name: "Root Canal Treatment in Hennur",
    description: pageDescription,
    url: canonicalUrl,
    medicalSpecialty: "Endodontics",
  }),
);

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogUrl: canonicalUrl,
  schemaMarkup: [breadcrumbSchema, faqSchema, serviceSchema],
};
---

<Layout {...seoProps}>
  <!-- Breadcrumb Navigation -->
  <nav
    class="bg-japandi-sand/30 border-b border-japandi-clay/20 py-3.5 px-6 lg:px-24 text-xs font-light text-japandi-earth"
    aria-label="Breadcrumb"
  >
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <a href="/" class="hover:text-japandi-moss transition-colors">
          Home
        </a>
        <span>/</span>
        <span class="text-japandi-charcoal font-medium">
          Root Canal Treatment Hennur
        </span>
      </div>
      <a
        href="#pricing"
        class="inline-flex items-center gap-1 text-xs font-semibold text-japandi-moss hover:underline"
      >
        Prices &darr;
      </a>
    </div>
  </nav>

  <!-- 1. Hero / H1 Section -->
  <section class="py-12 md:py-20 px-6 lg:px-24 bg-transparent relative overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <div class="lg:col-span-7 flex flex-col items-start space-y-4 md:space-y-6 animate-slow-fade">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-japandi-clay/60 bg-japandi-sand/70 text-[10px] font-semibold text-japandi-moss uppercase tracking-widest">
          Micro-Endodontics &bull; Hennur Bande, Bangalore
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif text-japandi-charcoal leading-tight font-medium tracking-tight">
          Root Canal Treatment in Hennur
        </h1>

        <div class="w-full bg-japandi-sand/40 border border-japandi-clay/30 rounded-2xl p-3.5 space-y-1.5 text-xs text-japandi-earth">
          <p class="flex items-center gap-2 font-medium text-japandi-charcoal">
            <span>Hours: Mon 4–9 PM, Tue–Sun 9:30 AM–9 PM</span>
          </p>
          <p>
            2nd Floor, Horamavu Agara Road, near Nayara Petrol Bunk, Hennur
            Bande. Lift and parking available.
          </p>
        </div>

        <p class="text-sm sm:text-base text-japandi-earth font-light leading-relaxed max-w-2xl">
          Relieve deep tooth pain and save your natural tooth. Managed by
          visiting MDS Endodontists with rotary instrumentation, electronic apex
          locators, and digital RVG imaging. Single-sitting completed where
          clinically suitable.
        </p>

        <!-- CTA Buttons -->
        <div class="pt-2 flex flex-wrap items-center gap-3 w-full sm:w-auto">
          <button
            type="button"
            data-open-booking
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-japandi-moss text-japandi-cream hover:bg-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 shadow-sm"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-4 h-4"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5"
              />
            </svg>
            <span>Book RCT Assessment</span>
          </button>

          <a
            href={phoneCallUrl}
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 border border-japandi-clay bg-japandi-sand/50 hover:bg-japandi-sand text-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-4 h-4 text-japandi-moss"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"
              />
            </svg>
            <span>Call: +91 73497 01002</span>
          </a>
        </div>
      </div>

      <!-- Quick Feature Card -->
      <div class="lg:col-span-5 relative">
        <div class="p-8 rounded-3xl bg-japandi-sand/50 border border-japandi-clay/40 shadow-sm space-y-4">
          <span class="text-xs uppercase font-semibold text-japandi-moss tracking-widest block">
            Clinical Precision
          </span>
          <h3 class="font-serif text-xl font-medium text-japandi-charcoal">
            Modern Endodontics
          </h3>
          <ul class="space-y-3 text-xs font-light text-japandi-earth">
            <li class="flex items-start gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-japandi-moss mt-1.5 shrink-0"></span>
              <div>
                <strong class="text-japandi-charcoal font-medium">
                  Digital Apex Locators:
                </strong>{" "}
                Millimeter-accurate canal length measurement avoiding
                over-instrumentation.
              </div>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-japandi-moss mt-1.5 shrink-0"></span>
              <div>
                <strong class="text-japandi-charcoal font-medium">
                  Rotary NiTi Files:
                </strong>{" "}
                Flexible alloy files that conform to curved root canals for
                smooth debridement.
              </div>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-japandi-moss mt-1.5 shrink-0"></span>
              <div>
                <strong class="text-japandi-charcoal font-medium">
                  Single-Sitting Completion:
                </strong>{" "}
                Efficient treatment in 1 visit when acute periapical swelling is
                absent.
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Who It's For (Symptoms in Plain Words) -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">
          Symptoms
        </span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Who root canal treatment is for
        </h2>
      </div>
      <p class="text-sm sm:text-base text-japandi-earth font-light leading-relaxed">
        A root canal is recommended when bacterial decay reaches the inner nerve
        tissue (pulp), indicated by:
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm text-japandi-earth font-light">
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">
            Spontaneous Throbbing Pain
          </h3>
          <p>
            Dull, throbbing toothache that occurs without provocation or wakes
            you up at night.
          </p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">
            Lingering Hot/Cold Sensitivity
          </h3>
          <p>
            Sharp pain when drinking hot tea or cold water that persists for
            more than 15 to 30 seconds.
          </p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">
            Pain When Chewing or Tapping
          </h3>
          <p>
            Tenderness when biting down on food, indicating inflammation in the
            ligament around the root tip.
          </p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">
            Gum Pimple or Discolored Tooth
          </h3>
          <p>
            A small pus-filled bump on the gums near the tooth, or a tooth
            turning dark grey after trauma.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. What Happens, Visit by Visit, & Number of Sittings -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-8">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">
          Clinical Protocol
        </span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          What happens, visit by visit
        </h2>
        <p class="text-sm sm:text-base text-japandi-earth font-light mt-2">
          RCT is completed in 1 sitting where suitable. Complex infections or
          re-treatments take 2 sittings.
        </p>
      </div>

      <div class="space-y-4 text-xs sm:text-sm text-japandi-earth font-light">
        <div class="p-6 rounded-2xl bg-japandi-sand/30 border border-japandi-clay/40 space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">
              Visit 1: Local Numbing, Cleaning &amp; Canal Obturation
            </h3>
            <span class="text-[10px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded bg-japandi-moss/10 text-japandi-moss">
              Sitting 1
            </span>
          </div>
          <p class="leading-relaxed">
            Local anesthesia is administered to ensure comfort. The decayed
            tissue is removed, canals are cleaned and disinfected with rotary
            NiTi files and antibacterial irrigants, and sealed hermetically with
            gutta-percha. A composite core build-up is placed.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-japandi-sand/30 border border-japandi-clay/40 space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">
              Visit 2: Crown Preparation &amp; Permanent Cap
            </h3>
            <span class="text-[10px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded bg-japandi-moss/10 text-japandi-moss">
              Follow-Up Sitting
            </span>
          </div>
          <p class="leading-relaxed">
            To prevent tooth fracture, the tooth is shaped for a protective
            custom crown (zirconia, ceramic, or PFM), scanned digitally, and
            cemented permanently.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Price Table from Keys -->
  <section
    id="pricing"
    class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30"
  >
    <div class="max-w-4xl mx-auto space-y-6">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">
          Transparent Pricing
        </span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Root canal treatment fees
        </h2>
        <p class="text-xs sm:text-sm text-japandi-earth font-light mt-1">
          Prices are ranges, confirmed after examination.
        </p>
      </div>

      <div class="rounded-2xl border border-japandi-clay/40 overflow-hidden bg-japandi-cream/90 shadow-sm">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-japandi-sand/60 text-japandi-charcoal font-serif border-b border-japandi-clay/30">
            <tr>
              <th class="py-3 px-4">Tooth Type</th>
              <th class="py-3 px-4">Price Range</th>
              <th class="py-3 px-4 hidden sm:table-cell">Canal Anatomy</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-japandi-clay/20 text-japandi-earth font-light">
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">
                Anterior / Front Tooth
              </td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">
                {CANONICAL_PRICES.rct_front_tooth}
              </td>
              <td class="py-3 px-4 hidden sm:table-cell">
                Single canal anterior incisor or canine
              </td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">
                Premolar Tooth
              </td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">
                {CANONICAL_PRICES.rct_premolar}
              </td>
              <td class="py-3 px-4 hidden sm:table-cell">1 to 2 root canals</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">
                Molar Tooth
              </td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">
                {CANONICAL_PRICES.rct_molar}
              </td>
              <td class="py-3 px-4 hidden sm:table-cell">
                3 to 4 complex root canals
              </td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">
                Root Canal Re-Treatment
              </td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">
                {CANONICAL_PRICES.rct_re_treatment}
              </td>
              <td class="py-3 px-4 hidden sm:table-cell">
                Revising previously treated tooth with persistent infection
              </td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">
                Consultation with Digital X-Ray
              </td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">
                {CANONICAL_PRICES.consultation}
              </td>
              <td class="py-3 px-4 hidden sm:table-cell">Valid for 6 months</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-xs text-japandi-earth font-light">
        See our complete pricing catalog on the{" "}
        <a
          href="/prices"
          class="text-japandi-moss underline decoration-japandi-moss/40 hover:decoration-japandi-moss font-medium"
        >
          treatment prices
        </a>{" "}
        page.
      </p>
    </div>
  </section>

  <!-- 5. Which Department Handles It -->
  <TreatmentDepartmentCard
    department="Endodontics & Conservative Dentistry"
    link="/our-specialists#endodontics"
    description="Rotary root canal therapy, complex canal negotiations, and endodontic re-treatments are led by our visiting MDS Endodontists."
  />

  <!-- 6. Aftercare and When to Call Us -->
  <TreatmentAftercare
    instructions={[
      "Avoid chewing hard or crunchy foods on the treated side until the permanent protective crown is placed.",
      "Mild tenderness when biting is normal for 24 to 48 hours and is easily managed with prescribed analgesics.",
      "Maintain gentle brushing and flossing around the tooth without dislodging the temporary filling.",
      "Return promptly for your scheduled crown appointment to protect the tooth from vertical fracture.",
    ]}
    whenToCall={[
      "Pain becomes intense, throbbing, or worsens significantly 48 hours after treatment.",
      "Visible facial or gum swelling develops around the treated tooth.",
      "The temporary filling between visits dislodges or feels completely hollow.",
    ]}
  />

  <!-- 7. FAQs (with Schema) -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-8">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">
          Common Questions
        </span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Frequently asked questions
        </h2>
      </div>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <div class="bg-japandi-cream/90 border border-japandi-clay/40 rounded-2xl p-6 space-y-2">
            <h3 class="font-serif text-base sm:text-lg text-japandi-charcoal font-medium">
              {faq.question}
            </h3>
            <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. Related Treatments -->
  <section class="py-16 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <h2 class="text-xl sm:text-2xl font-serif text-japandi-charcoal font-medium">
        Related treatments
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
        <a
          href="/dental-crowns-hennur"
          class="p-4 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 hover:border-japandi-moss transition-colors block space-y-1"
        >
          <span class="font-serif text-sm text-japandi-charcoal font-medium block">
            Dental Crowns
          </span>
          <span class="text-japandi-earth font-light">
            Protective zirconia and ceramic caps post-RCT
          </span>
        </a>
        <a
          href="/treatments/emergency-dentist"
          class="p-4 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 hover:border-japandi-moss transition-colors block space-y-1"
        >
          <span class="font-serif text-sm text-japandi-charcoal font-medium block">
            Emergency Dentist
          </span>
          <span class="text-japandi-earth font-light">
            Urgent pulp decompression and pain relief
          </span>
        </a>
        <a
          href="/treatments/dental-implants"
          class="p-4 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 hover:border-japandi-moss transition-colors block space-y-1"
        >
          <span class="font-serif text-sm text-japandi-charcoal font-medium block">
            Dental Implants
          </span>
          <span class="text-japandi-earth font-light">
            Replacement options when a tooth cannot be saved
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- 9. Book / WhatsApp / Call -->
  <TreatmentActions treatmentName="Root Canal Consultation" />
</Layout>
