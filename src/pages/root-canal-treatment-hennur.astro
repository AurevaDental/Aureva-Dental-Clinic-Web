---
import Layout from '../layouts/Layout.astro';
import { generateBreadcrumbSchema, generateFaqSchema, generateTreatmentServiceSchema } from '../utils/seoSchemas';

export const prerender = false;

const pageTitle = "Root Canal Treatment in Hennur Bangalore | Aureva Dental";
const pageDescription = "Gentle single-sitting root canal treatment in Hennur, Bangalore at Aureva Dental. Rotary endodontics, digital RVG & custom zirconia crowns. Call +91 73497 01002.";
const canonicalUrl = "https://aurevadental.com/root-canal-treatment-hennur";
const phoneCallUrl = "tel:+917349701002";
const whatsappUrl = "https://wa.me/917349701002?text=Hello%20Aureva%20Dental%2C%20I%20have%20tooth%20pain%20and%20would%20like%20to%20consult%20for%20Root%20Canal%20Treatment%20in%20Hennur.";

const breadcrumbs = [
  { name: "Home", url: "https://aurevadental.com/" },
  { name: "Treatments", url: "https://aurevadental.com/treatments/root-canal-treatment" },
  { name: "Root Canal Treatment Hennur", url: canonicalUrl }
];

const faqs = [
  {
    question: "Is root canal treatment comfortable at your Hennur clinic?",
    answer: "Root canal treatment at Aureva Dental is designed for gentle comfort. We utilize computerized local anesthesia delivery and topical pre-numbing gels that minimize injection discomfort. With high-precision rotary nickel-titanium instruments and apex locators, we ensure thorough pulpal numbness and gentle canal cleaning without pressure or sharp pain."
  },
  {
    question: "Can a root canal be completed in a single sitting in Hennur?",
    answer: "Yes. In approximately 70% to 80% of cases where pulpal inflammation has not progressed to acute periapical abscess or active pus drainage, our clinical dental team can complete the entire root canal—cleaning, disinfecting, and hermetic sealing—in a single 45 to 60-minute appointment. Severe or re-treatment infections may require a second visit with medicinal intracanal dressing to ensure complete sterile healing."
  },
  {
    question: "How much does a Root Canal Treatment (RCT) cost at Aureva Dental in Hennur?",
    answer: "At Aureva Dental, Root Canal Treatments range from Rs. 4,000 to Rs. 10,000 based on tooth position and complexity: Anterior front teeth (single canal): Rs. 4,000 to Rs. 6,000; Premolars (1–2 canals): Rs. 5,000 to Rs. 8,000; Molars (3–4 canals): Rs. 6,000 to Rs. 10,000. Re-RCT of previously failed procedures starts from Rs. 8,000. Complete transparent pricing is provided in writing before treatment."
  },
  {
    question: "Why is a dental crown necessary after an RCT?",
    answer: "A root canal removes the infected nerve and vascular tissue from inside the tooth, leaving the remaining tooth structure brittle over time. A customized CAD/CAM Zirconia or ceramic crown encapsulates the tooth, restoring normal chewing force and preventing catastrophic tooth fractures or micro-leakage reinfection."
  },
  {
    question: "What are the warning signs that I need an emergency root canal?",
    answer: "Key symptoms include persistent, throbbing toothache that worsens when lying down, intense lingering sensitivity to hot or cold drinks, pain while biting or chewing, localized swelling on the gums resembling a pimple (fistula), or darkened enamel discoloration following dental trauma."
  },
  {
    question: "How do I care for my tooth immediately after a root canal?",
    answer: "Avoid chewing hard or sticky foods on the treated side until your final permanent crown is cemented. Mild tenderness for 24 to 48 hours is completely normal and can be managed easily with standard anti-inflammatory medications prescribed by our dentists. Maintain gentle brushing and warm saline rinses."
  }
];

const breadcrumbSchema = JSON.stringify(generateBreadcrumbSchema(breadcrumbs));
const faqSchema = JSON.stringify(generateFaqSchema(faqs));
const serviceSchema = JSON.stringify(generateTreatmentServiceSchema({
  name: "Root Canal Treatment in Hennur",
  description: pageDescription,
  url: canonicalUrl,
  medicalSpecialty: "Endodontics"
}));

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogUrl: canonicalUrl,
  schemaMarkup: [breadcrumbSchema, faqSchema, serviceSchema]
};
---

<Layout {...seoProps}>
  <!-- Preload Critical Above-the-fold Hero Image -->
  <link rel="preload" as="image" href="/assets/clinic-exterior-800.webp" type="image/webp" slot="head" />

  <!-- Breadcrumb Navigation -->
  <nav class="bg-japandi-sand/30 border-b border-japandi-clay/20 py-3.5 px-6 lg:px-24 text-xs font-light text-japandi-earth" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <a href="/" class="hover:text-japandi-moss transition-colors">Home</a>
        <span>/</span>
        <a href="/treatments/root-canal-treatment" class="hover:text-japandi-moss transition-colors">Root Canal Treatment</a>
        <span>/</span>
        <span class="text-japandi-charcoal font-medium">Hennur</span>
      </div>
      <!-- Near the top Prices quick link -->
      <a href="#pricing" class="inline-flex items-center gap-1 text-xs font-semibold text-japandi-moss hover:underline">
