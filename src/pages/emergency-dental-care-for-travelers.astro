---
import Layout from '../layouts/Layout.astro';
import { generateBreadcrumbSchema, generateFaqSchema } from '../utils/seoSchemas';

export const prerender = false;

const pageTitle = "Emergency Dental Care for Travelers in Bangalore | Aureva Dental";
const pageDescription = "Emergency dental care for international travelers, business visitors, and tourists in North Bangalore. Same-day appointments may be available for toothaches, broken teeth, and lost crowns.";
const canonicalUrl = "https://aurevadental.com/emergency-dental-care-for-travelers";
const phoneCallUrl = "tel:+917349701002";
const whatsappUrl = `https://wa.me/917349701002?text=${encodeURIComponent("URGENT TRAVEL CARE: I am traveling in Bangalore and experiencing a dental problem (toothache / broken tooth / lost crown). Please advise appointment availability.")}`;

const breadcrumbs = [
  { name: "Home", url: "https://aurevadental.com/" },
  { name: "International Patients", url: "https://aurevadental.com/international-patients" },
  { name: "Emergency Care for Travelers", url: canonicalUrl }
];

const faqs = [
  {
    question: "How quickly can a traveler be seen for emergency dental care?",
    answer: "If you have a dental problem while travelling in Bangalore, contact the clinic as soon as practical. Same-day emergency appointments may be available depending on clinical urgency and appointment availability. You can call our direct clinic line at +91 73497 01002 or send a WhatsApp message to check the earliest available slot."
  },
  {
    question: "Is Aureva Dental open on Sundays for traveler emergencies?",
    answer: "Yes. Aureva Dental is open 7 days a week, including Sundays from 9:30 AM to 9:00 PM. We understand that travel dental issues often occur during weekends when standard clinics may be closed."
  },
  {
    question: "Can you re-cement or replace a crown that fell off while traveling?",
    answer: "Yes. If your crown or bridge has dislodged and is intact, bring it with you in a clean container. Our dental surgeons will clean the restoration, inspect the underlying tooth, and assess whether it can be re-cemented. If the crown is damaged or lost, we can discuss temporary or permanent restorative options."
  },
  {
    question: "What should I do if a tooth fractures or a filling breaks while in Bangalore?",
    answer: "Rinse your mouth gently with warm water to clear food debris. If there are sharp edges irritating your cheek or tongue, avoid chewing on that side. Contact Aureva Dental for an emergency assessment. We can smooth sharp contours, apply temporary or permanent composite restorations, and protect the tooth pulp."
  },
  {
    question: "Do you accept international credit cards and provide documentation for travel insurance?",
    answer: "Yes. International card payments are accepted through our available payment methods (Visa, MasterCard, American Express). Following treatment, we provide an itemized English clinical summary, digital X-rays where taken, and an official invoice that can be submitted to your travel insurance provider for reimbursement consideration."
  }
];

const breadcrumbSchema = JSON.stringify(generateBreadcrumbSchema(breadcrumbs));
const faqSchema = JSON.stringify(generateFaqSchema(faqs));

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogUrl: canonicalUrl,
  ogImage: "https://aurevadental.com/assets/og/emergency-travelers.svg",
  schemaMarkup: [breadcrumbSchema, faqSchema]
};
---

<Layout {...seoProps}>
  <!-- Breadcrumb Navigation -->
  <nav class="bg-japandi-sand/30 border-b border-japandi-clay/20 py-3.5 px-6 lg:px-24 text-xs font-light text-japandi-earth" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto flex items-center gap-2 flex-wrap">
      <a href="/" class="hover:text-japandi-moss transition-colors">Home</a>
      <span>/</span>
      <a href="/international-patients" class="hover:text-japandi-moss transition-colors">International Patients</a>
      <span>/</span>
      <span class="text-japandi-charcoal font-medium">Emergency Care for Travelers</span>
    </div>
  </nav>

  <!-- Notice Banner -->
  <div class="bg-red-800 text-white py-3 px-6 lg:px-24 text-xs sm:text-sm font-medium">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-white animate-ping shrink-0"></span>
        <span><strong>Traveler Dental Emergency:</strong> Experiencing acute pain or dental trauma while in Bangalore? Contact our clinic.</span>
      </div>
      <a 
        href={phoneCallUrl}
        onclick="if (typeof gtag_report_conversion !== 'undefined') gtag_report_conversion('tel:+917349701002');"
        class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-white text-red-900 text-xs font-semibold uppercase tracking-wider shrink-0 hover:bg-japandi-cream transition-colors"
      >
        <span>Call +91 73497 01002</span>
      </a>
    </div>
  </div>

  <!-- Hero Section -->
  <section class="py-16 md:py-24 px-6 lg:px-24 bg-transparent relative overflow-hidden border-b border-japandi-clay/20">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 space-y-6">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-japandi-clay/60 bg-japandi-sand/70 text-[11px] font-semibold text-japandi-moss uppercase tracking-widest">
          North Bangalore Dental Care
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif text-japandi-charcoal font-medium tracking-tight leading-[1.15]">
          Emergency Dental Care for <span class="italic text-red-800">Travelers</span> in Bangalore.
        </h1>

        <p class="text-base sm:text-lg text-japandi-earth font-light leading-relaxed">
          If you have a dental problem while travelling in Bangalore, contact the clinic as soon as practical. Same-day emergency appointments may be available depending on clinical urgency and appointment availability. Located in Hennur, North Bangalore, with convenient road access from Kempegowda International Airport.
        </p>

        <!-- Transit & Accuracy Anchor Banner -->
        <div class="p-4 rounded-2xl bg-japandi-sand/55 border border-japandi-clay/50 flex flex-col sm:flex-row items-start sm:items-center gap-4 text-xs text-japandi-charcoal">
          <div class="w-9 h-9 rounded-full bg-japandi-moss/10 text-japandi-moss flex items-center justify-center shrink-0 font-bold">
            📍
          </div>
          <div>
            <strong class="font-medium text-japandi-charcoal block">Location &amp; Airport Accessibility:</strong>
            <span class="text-japandi-earth font-light block">
              Located in Hennur, North Bangalore (approximately 24–31 km from Kempegowda International Airport). Travel time from the airport varies with traffic, route, and time of day.
            </span>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-2">
          <a 
            href={whatsappUrl}
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full bg-red-800 text-white hover:bg-japandi-charcoal text-xs font-semibold uppercase tracking-wider transition-all duration-300 shadow-md shadow-red-800/20"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-4 h-4">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            <span>WhatsApp Emergency Desk</span>
          </a>
          <a 
            href={phoneCallUrl}
            onclick="if (typeof gtag_report_conversion !== 'undefined') gtag_report_conversion('tel:+917349701002');"
            class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full border border-japandi-clay bg-japandi-sand/30 hover:bg-japandi-sand text-japandi-charcoal text-xs font-semibold uppercase tracking-wider transition-all"
          >
            <span>Direct Call: +91 73497 01002</span>
          </a>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="rounded-3xl border border-red-200 bg-red-50/40 dark:bg-red-950/20 p-6 sm:p-8 space-y-5">
          <span class="text-xs font-semibold text-red-800 dark:text-red-300 uppercase tracking-widest block">Operational Overview</span>
          <h3 class="font-serif text-xl font-medium text-japandi-charcoal">Traveler Emergency Protocols</h3>
          <ul class="space-y-3 text-xs sm:text-sm text-japandi-earth font-light">
            <li class="flex items-start gap-2.5">
              <span class="text-red-800 font-bold">&bull;</span>
              <span><strong>Same-Day Appointments:</strong> Subject to clinical urgency and chair availability.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-red-800 font-bold">&bull;</span>
              <span><strong>Digital RVG Radiography:</strong> Low-radiation imaging for immediate diagnostic evaluation.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-red-800 font-bold">&bull;</span>
              <span><strong>Open 7 Days Including Sundays:</strong> Regular clinical hours on weekends to assist travelers.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-red-800 font-bold">&bull;</span>
              <span><strong>Insurance Documentation:</strong> Itemized invoice and clinical summary in English.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Common Travel Dental Emergencies Breakdown -->
  <section class="py-20 px-6 lg:px-24 bg-japandi-sand/20 border-b border-japandi-clay/20">
    <div class="max-w-7xl mx-auto space-y-14">
      <div class="max-w-3xl space-y-4">
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block">Clinical Scope</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium">Common Travel Dental Emergencies We Address</h2>
        <p class="text-sm sm:text-base text-japandi-earth font-light leading-relaxed">
          Experiencing dental pain while away from home can disrupt your travel itinerary. Our clinical team provides assessment and emergency stabilization for visitor dental concerns:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Emergency 1: Severe Toothache -->
        <div class="p-7 rounded-3xl bg-japandi-cream border border-japandi-clay/40 space-y-4">
          <div class="w-10 h-10 rounded-xl bg-red-100 dark:bg-red-950/40 text-red-800 flex items-center justify-center font-bold text-base">01</div>
          <h3 class="font-serif text-lg font-medium text-japandi-charcoal">Severe Toothache While Travelling</h3>
          <p class="text-xs text-japandi-earth font-light leading-relaxed">
            Acute pulpitis caused by deep decay or failing restorations can cause throbbing, unprovoked pain. We perform digital imaging, local anesthesia, and pulpal stabilization or emergency pulpectomy as clinically indicated.
          </p>
        </div>

        <!-- Emergency 2: Broken or Chipped Tooth -->
        <div class="p-7 rounded-3xl bg-japandi-cream border border-japandi-clay/40 space-y-4">
          <div class="w-10 h-10 rounded-xl bg-red-100 dark:bg-red-950/40 text-red-800 flex items-center justify-center font-bold text-base">02</div>
          <h3 class="font-serif text-lg font-medium text-japandi-charcoal">Broken, Cracked, or Chipped Tooth</h3>
          <p class="text-xs text-japandi-earth font-light leading-relaxed">
            Biting on hard foods or minor accidents can fracture teeth. We smooth sharp edges that may injure your tongue, apply protective desensitizing agents, or restore the tooth with tooth-colored composite.
          </p>
        </div>

        <!-- Emergency 3: Lost Crown or Loose Bridge -->
        <div class="p-7 rounded-3xl bg-japandi-cream border border-japandi-clay/40 space-y-4">
          <div class="w-10 h-10 rounded-xl bg-red-100 dark:bg-red-950/40 text-red-800 flex items-center justify-center font-bold text-base">03</div>
          <h3 class="font-serif text-lg font-medium text-japandi-charcoal">Lost Crown or Broken Filling</h3>
          <p class="text-xs text-japandi-earth font-light leading-relaxed">
            If a permanent crown dislodges or a large filling falls out, exposed dentin can become sensitive to temperature. If the crown is undamaged, we can re-cement it; otherwise, a protective provisional restoration is placed.
          </p>
        </div>

        <!-- Emergency 4: Swelling & Infection -->
        <div class="p-7 rounded-3xl bg-japandi-cream border border-japandi-clay/40 space-y-4">
          <div class="w-10 h-10 rounded-xl bg-red-100 dark:bg-red-950/40 text-red-800 flex items-center justify-center font-bold text-base">04</div>
          <h3 class="font-serif text-lg font-medium text-japandi-charcoal">Dental Swelling &amp; Infection</h3>
          <p class="text-xs text-japandi-earth font-light leading-relaxed">
            Facial swelling or gum abscesses indicate active bacterial infection requiring urgent clinical evaluation. We assess the source, provide localized treatment, and prescribe appropriate medications.
          </p>
        </div>

        <!-- Emergency 5: Root Canal Urgency -->
        <div class="p-7 rounded-3xl bg-japandi-cream border border-japandi-clay/40 space-y-4">
          <div class="w-10 h-10 rounded-xl bg-red-100 dark:bg-red-950/40 text-red-800 flex items-center justify-center font-bold text-base">05</div>
          <h3 class="font-serif text-lg font-medium text-japandi-charcoal">Emergency Root Canal Assessment</h3>
          <p class="text-xs text-japandi-earth font-light leading-relaxed">
            When pulpal inflammation is irreversible, root canal therapy may be needed. Initial instrumentation relieves acute symptoms, followed by complete canal cleaning and sealing based on clinical requirements.
          </p>
        </div>

        <!-- Emergency 6: Dental Trauma -->
        <div class="p-7 rounded-3xl bg-japandi-cream border border-japandi-clay/40 space-y-4">
          <div class="w-10 h-10 rounded-xl bg-red-100 dark:bg-red-950/40 text-red-800 flex items-center justify-center font-bold text-base">06</div>
          <h3 class="font-serif text-lg font-medium text-japandi-charcoal">Dental Trauma &amp; Wisdom Tooth Pain</h3>
          <p class="text-xs text-japandi-earth font-light leading-relaxed">
            Sports collisions or acute inflammation around partially erupted wisdom teeth (pericoronitis) cause jaw stiffness and pain. We perform clinical debridement, irrigation, and trauma splinting if required.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Visitor Experience Section -->
  <section class="py-20 px-6 lg:px-24 bg-transparent border-b border-japandi-clay/20">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-6 space-y-6">
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block">Process</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium">What to Expect During Your Emergency Visit</h2>
        <p class="text-sm sm:text-base text-japandi-earth font-light leading-relaxed">
          We prioritize clear communication and clinical transparency so you know what to expect during your appointment:
        </p>

        <div class="space-y-4 text-xs sm:text-sm">
          <div class="p-4 rounded-2xl bg-japandi-sand/35 border border-japandi-clay/40 space-y-1">
            <strong class="font-medium text-japandi-charcoal block">1. Contact via WhatsApp or Phone</strong>
            <p class="text-japandi-earth font-light">Share your symptoms, location, and travel schedule. We check our schedule and advise on available appointment times.</p>
          </div>

          <div class="p-4 rounded-2xl bg-japandi-sand/35 border border-japandi-clay/40 space-y-1">
            <strong class="font-medium text-japandi-charcoal block">2. Clinical Examination &amp; Digital X-rays</strong>
            <p class="text-japandi-earth font-light">We take low-radiation digital RVG radiographs to identify the underlying tooth or bone condition accurately.</p>
          </div>

          <div class="p-4 rounded-2xl bg-japandi-sand/35 border border-japandi-clay/40 space-y-1">
            <strong class="font-medium text-japandi-charcoal block">3. Transparent Fee Discussion Before Care</strong>
            <p class="text-japandi-earth font-light">All recommended procedures and their published INR fees are explained in clear English before starting treatment.</p>
          </div>

          <div class="p-4 rounded-2xl bg-japandi-sand/35 border border-japandi-clay/40 space-y-1">
            <strong class="font-medium text-japandi-charcoal block">4. Insurance Summary Documentation</strong>
            <p class="text-japandi-earth font-light">We provide itemized clinical notes and payment receipts in English for submission to your travel insurance carrier.</p>
          </div>
        </div>
      </div>

      <div class="lg:col-span-6 space-y-6">
        <div class="rounded-3xl border border-japandi-clay/50 bg-japandi-sand/40 p-6 sm:p-8 space-y-5">
          <h3 class="font-serif text-xl font-medium text-japandi-charcoal">Location Coordinates</h3>
          <p class="text-xs text-japandi-earth font-light leading-relaxed">
            Copy and paste this address into ride-hailing apps (Uber or Ola) from anywhere in North Bangalore:
          </p>

          <div class="p-4 rounded-xl bg-japandi-cream border border-japandi-clay/60 text-xs font-mono text-japandi-charcoal space-y-1 select-all">
            <span class="font-semibold block font-sans text-japandi-moss">Aureva Dental</span>
            <span>2nd Floor, No. 11/4, SLV Nilaya, Horamavu Agara Road, Near Nayara Petrol Bunk, Hennur Bande, Bengaluru 560043</span>
          </div>

          <div class="text-xs text-japandi-earth font-light space-y-1">
            <p><strong>Landmark:</strong> Adjacent to Nayara Petrol Bunk on Horamavu Agara Road.</p>
            <p><strong>From Kempegowda Airport:</strong> Approximately 24–31 km via NH 44 / Hennur corridor.</p>
            <p><strong>From Manyata Tech Park:</strong> Approximately 12–15 minutes by road.</p>
          </div>

          <div class="pt-2">
            <a 
              href="https://maps.app.goo.gl/dhU4UySs9WFkHAzYA" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-japandi-moss hover:underline"
            >
              <span>Open Clinic in Google Maps &rarr;</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQs -->
  <section class="py-20 px-6 lg:px-24 bg-japandi-sand/20 border-b border-japandi-clay/20">
    <div class="max-w-4xl mx-auto space-y-10">
      <div class="text-center space-y-3">
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block">Frequently Asked Questions</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium">Common Questions From Travelers</h2>
      </div>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group rounded-2xl bg-japandi-cream border border-japandi-clay/50 p-5 open:bg-japandi-sand/30 transition-colors">
            <summary class="flex items-center justify-between font-serif text-base font-medium text-japandi-charcoal cursor-pointer list-none">
              <span>{faq.question}</span>
              <span class="text-japandi-moss text-xl group-open:rotate-45 transition-transform duration-200">+</span>
            </summary>
            <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed mt-3 pt-3 border-t border-japandi-clay/30">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Emergency Contact CTA -->
  <section class="py-20 px-6 lg:px-24 bg-red-900 text-white text-center">
    <div class="max-w-3xl mx-auto space-y-6">
      <span class="text-xs font-semibold text-red-200 uppercase tracking-widest block">Contact the Clinic</span>
      <h2 class="text-3xl sm:text-5xl font-serif font-medium leading-tight">
        Need Urgent Dental Assistance in Bangalore?
      </h2>
      <p class="text-sm sm:text-base text-red-100 font-light leading-relaxed">
        If you have a dental problem while travelling in Bangalore, contact the clinic as soon as practical. Same-day emergency appointments may be available depending on clinical urgency and appointment availability.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
        <a 
          href={whatsappUrl}
          target="_blank" 
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-full bg-white text-red-900 hover:bg-japandi-cream text-xs font-semibold uppercase tracking-wider transition-all duration-300 shadow-xl"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-4 h-4">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          <span>WhatsApp Emergency Desk</span>
        </a>
        <a 
          href={phoneCallUrl}
          onclick="if (typeof gtag_report_conversion !== 'undefined') gtag_report_conversion('tel:+917349701002');"
