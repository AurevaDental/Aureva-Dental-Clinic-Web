---
import Layout from '../layouts/Layout.astro';
import { GOOGLE_RATING, GOOGLE_REVIEW_COUNT, GOOGLE_REVIEWS_LABEL } from '../config/clinic';
import { CANONICAL_PRICES } from '../data/prices';

const pageTitle = "Dentist in Kalyan Nagar, Bengaluru | Aureva Dental, 2.7 km away";
const pageDescription = "Dentist near Kalyan Nagar & HRBR Layout, 2.7 km away. Open 7 days with ₹600 consultation including digital X-ray. Walk in or call to book.";
const canonicalUrl = "https://aurevadental.com/dentist-in-kalyan-nagar";
const phoneCallUrl = "tel:+917349701002";
const whatsappUrl = "https://wa.me/917349701002?text=Hi%20Aureva%20Dental%2C%20I%20am%20visiting%20from%20Kalyan%20Nagar%20and%20would%20like%20to%20consult.";
const directionsUrl = "https://www.google.com/maps/dir/?api=1&origin=Kalyan+Nagar,+Bengaluru&destination=Aureva+Dental,+Horamavu+Agara+Rd,+Hennur+Bande,+Bengaluru";
const canonicalAddress = "2nd floor, No.11, 4, Horamavu Agara Rd, near Nayara Petrol Bunk, Hennur Bande, Hennur Gardens, Bengaluru, Karnataka 560043";

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  robots: "index, follow",
  hideHeader: false,
  hideFooter: false,
  hideMobileBottomBar: false
};

const treatmentPricing = [
  { name: "Consultation & Digital RVG X-Ray", price: CANONICAL_PRICES.consultation, note: "Valid for 6 months" },
  { name: "Scaling & Polishing (Hygiene)", price: CANONICAL_PRICES.scaling_routine, note: "Ultrasonic tartar removal" },
  { name: "Composite Tooth Filling", price: CANONICAL_PRICES.tooth_filling, note: "Tooth-colored biomimetic resin" },
  { name: "Root Canal Treatment (Rotary RCT)", price: CANONICAL_PRICES.rct_overall, note: "Gentle single or multi-visit" },
  { name: "Crowns & Caps (PFM, Ceramic, Zirconia)", price: CANONICAL_PRICES.crown_overall, note: "Custom laboratory fabricated" },
  { name: "Wisdom Tooth Removal", price: CANONICAL_PRICES.wisdom_hennur_faq_overall, note: "Simple & surgical impactions" },
  { name: "Teeth Whitening", price: CANONICAL_PRICES.whitening_laser, note: "In-office LED brightening" },
  { name: "Kids Dentistry (Pediatric Care)", price: CANONICAL_PRICES.kids_dentistry_summary, note: "Gentle cavity care & sealants" },
  { name: "Dental Implants", price: CANONICAL_PRICES.implant_single_fixture, note: "Titanium replacement tooth" },
  { name: "Clear Aligners", price: CANONICAL_PRICES.clear_aligners_overall, note: "Custom 3D invisible trays" }
];

const faqs = [
  {
    q: "Is there a dental clinic in Kalyan Nagar open on Sunday?",
    a: "Yes. Aureva Dental operates a full dental clinic every Sunday from 9:30 AM to 9:00 PM, located just 2.7 km from Kalyan Nagar on Horamavu Agara Road. Families, school students, and working professionals from HRBR Layout and Kalyan Nagar frequently take advantage of our Sunday hours for routine preventive cleanings, check-ups, and dental procedures without having to rearrange their busy weekday schedules."
  },
  {
    q: "Looking for a dental clinic in Kalyan Nagar or HRBR Layout: how far are you?",
    a: "Our dental clinic is 2.7 km from Kalyan Nagar (about 12 minutes drive) and 3.0 km from HRBR Layout (about 13 minutes drive). To reach us, take Hennur Main Road towards Hennur Bande, then proceed onto Horamavu Agara Road until you see the clinic near Nayara Petrol Bunk. Drive times change with traffic. The clinic is on the 2nd floor with lift access. Parking available for 4-wheelers and 2-wheelers."
  },
  {
    q: "Do you have an orthodontic clinic near Kalyan Nagar for braces and aligners?",
    a: "Yes. An MDS orthodontist visits Aureva Dental on a scheduled case basis to consult on bite alignment, dental crowding, and spacing issues. We provide traditional metal braces starting from ₹30,000, aesthetic ceramic braces starting from ₹45,000, and removable clear aligners ranging from ₹80,000 to ₹2,50,000, as priced on our clinic price list. Every orthodontic evaluation includes digital imaging and a written estimate."
  },
  {
    q: "Are you easily accessible for residents coming from Kammanahalli?",
    a: "Yes. Patients from the Kammanahalli and HRBR Layout residential pockets easily travel north via Hennur Main Road to reach our Horamavu Agara Road studio in approximately 12 to 14 minutes. We offer comprehensive new-patient consultations for ₹600 including digital RVG X-rays valid for 6 months, and we welcome walk-ins until 9:00 PM every evening."
  },
  {
    q: "What are your check-up charges and walk-in policies?",
    a: "A new-patient consultation is ₹600, which includes a detailed clinical oral examination, low-radiation digital RVG X-rays as clinically indicated, and an itemized written estimate before any care begins. The consultation remains valid for 6 months. Walk-ins are always welcome until 9:00 PM, though calling or sending a WhatsApp message in advance helps reserve your preferred time slot."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};
---

<Layout {...seoProps} schemaMarkup={[faqSchema]}>
  <main class="min-h-screen bg-japandi-cream text-japandi-charcoal">
    <!-- Hero Section -->
    <section class="px-4 sm:px-6 lg:px-24 pt-12 pb-10 max-w-5xl mx-auto text-center space-y-5">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-japandi-moss/10 text-japandi-moss text-xs font-semibold uppercase tracking-wider">
        <span>Nearby Dental Care &middot; 2.7 km from Kalyan Nagar</span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-serif text-japandi-charcoal font-medium tracking-tight">
        Dentist near Kalyan Nagar
      </h1>

      <p class="text-sm sm:text-base text-japandi-earth font-light max-w-2xl mx-auto leading-relaxed">
        Serving Kalyan Nagar, HRBR Layout, and Kammanahalli from our modern Japandi-inspired dental studio on Horamavu Agara Road. Open 7 days a week with extended evening hours until 9 PM.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <a 
          href={phoneCallUrl}
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-japandi-moss hover:bg-japandi-charcoal text-japandi-cream font-medium text-xs uppercase tracking-wider transition-all shadow-sm"
        >
          Call 073497 01002
        </a>
        <a 
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full border border-japandi-clay bg-japandi-sand/80 hover:bg-japandi-sand text-japandi-charcoal font-medium text-xs uppercase tracking-wider transition-all"
        >
          WhatsApp Us
        </a>
        <a 
          href={directionsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full border border-japandi-clay bg-japandi-sand/80 hover:bg-japandi-sand text-japandi-charcoal font-medium text-xs uppercase tracking-wider transition-all"
        >
          Get Directions
        </a>
      </div>

      {GOOGLE_RATING > 0 && GOOGLE_REVIEW_COUNT > 0 && (
        <div class="pt-2 flex items-center justify-center gap-2 text-xs text-japandi-earth">
          <span class="text-amber-500 tracking-tight">★ ★ ★ ★ ★</span>
          <span class="font-semibold text-japandi-charcoal">{GOOGLE_RATING.toFixed(1)}</span>
          <span>({GOOGLE_REVIEW_COUNT} Google Reviews)</span>
        </div>
      )}
    </section>

    <!-- Route from Kalyan Nagar -->
    <section class="py-10 px-4 sm:px-6 lg:px-24 max-w-4xl mx-auto border-t border-japandi-clay/20">
      <div class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-serif text-japandi-charcoal font-medium">
          Route from Kalyan Nagar and HRBR Layout
        </h2>
        <div class="bg-japandi-sand/40 border border-japandi-clay/40 rounded-2xl p-6 sm:p-8 space-y-4">
          <p class="text-sm sm:text-base text-japandi-charcoal font-normal leading-relaxed">
            To reach Aureva Dental from Kalyan Nagar, head north along Hennur Main Road towards Hennur Bande, then turn right onto Horamavu Agara Road until you see our building near Nayara Petrol Bunk. Patients driving from HRBR Layout or the Kammanahalli side follow the same direct road past Hennur Cross, reaching our clinic in approximately 12 to 13 minutes across 2.7 km to 3.0 km. Drive times change with traffic. Our facility is conveniently situated on the 2nd floor with lift access. Parking available for 4-wheelers and 2-wheelers.
          </p>
          <div class="pt-2 flex flex-wrap items-center justify-between gap-3 text-xs text-japandi-earth border-t border-japandi-clay/30">
            <span>Kalyan Nagar: 2.7 km &middot; about 12 min</span>
            <span>HRBR Layout: 3.0 km &middot; about 13 min</span>
            <a 
              href={directionsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-japandi-moss font-semibold hover:underline"
            >
              Open Google Maps Route &rarr;
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- When people from Kalyan Nagar visit us -->
    <section class="py-10 px-4 sm:px-6 lg:px-24 max-w-4xl mx-auto border-t border-japandi-clay/20">
      <div class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-serif text-japandi-charcoal font-medium">
          When people from Kalyan Nagar visit us
        </h2>
        <div class="space-y-4 text-sm sm:text-base text-japandi-earth font-light leading-relaxed">
          <p>
            Families and working residents across Kalyan Nagar, HRBR Layout, and nearby Kammanahalli frequently visit our clinic when they seek unhurried, attentive dental care outside busy commercial high streets. Many households plan joint weekend appointments so working parents and school-going children can complete cleanings, fluoride treatments, and dental check-ups in a single organized outing. Because our studio stays open until 9 PM on weekdays and operates full shifts on Sundays, scheduling around busy academic routines, office deadlines, and evening commutes along Hennur Main Road remains stress-free.
          </p>
          <p>
            Patients from this neighborhood appreciate having access to clear diagnostic explanations without feeling hurried into immediate procedures. Every appointment begins with an attentive conversation regarding your past dental experiences, current sensitivities, and personal smile goals. We display digital images chairside and provide written cost estimates before initiating clinical work, ensuring complete clarity and peace of mind for every family member.
          </p>
          <p>
            Whether attending to an elderly family member requiring comfortable denture repairs or introducing a toddler to their very first friendly check-up, our quiet clinical setting provides an unhurried atmosphere. Residents choose to make the short 2.7 km journey from Kalyan Nagar because our practice combines neighbourhood accessibility with uncompromising clinical diligence. We take pride in building long-term doctor-patient relationships founded on clear diagnostic integrity and gentle, patient-centered care.
          </p>
        </div>
      </div>
    </section>

    <!-- Treatments people from Kalyan Nagar often ask about -->
    <section class="py-10 px-4 sm:px-6 lg:px-24 max-w-4xl mx-auto border-t border-japandi-clay/20">
      <div class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-serif text-japandi-charcoal font-medium">
          Treatments people from Kalyan Nagar often ask about
        </h2>
        <div class="space-y-4 text-sm sm:text-base text-japandi-earth font-light leading-relaxed">
          <p>
            Inquiries from Kalyan Nagar households often focus on multi-generational family dentistry, pediatric preventive care, and modern orthodontic alignment. Parents regularly bring young children for preventive fissure sealants and cavity check-ups, benefiting from visits with our visiting paedodontist who specializes in gentle, child-friendly care. Teenagers and adult working professionals routinely inquire about discreet alignment alternatives, consulting our visiting orthodontist to explore traditional metal braces starting at ₹30,000, subtle tooth-colored ceramic brackets starting at ₹45,000, or custom-fabricated clear aligners ranging from ₹80,000 to ₹2,50,000.
          </p>
          <p>
            For older adults and parents experiencing wear or missing teeth, our restorative options include tooth-colored composite restorations starting at ₹1,500, precision porcelain-fused-to-metal and zirconia crowns ranging from ₹4,000 to ₹18,000, and permanent titanium dental implants from ₹35,000 to ₹60,000. Routine preventive ultrasonic scaling and polishing ranges from ₹2,000 to ₹5,000, helping maintain periodontal health across all age brackets.
          </p>
          <p>
            Because our new-patient consultation is ₹600 including digital RVG X-rays and remains valid for six months, you have ample time to review your itemized treatment options comfortably at home before scheduling treatment appointments. We ensure that every treatment pathway is paced according to individual comfort and clinical necessity, giving households full control over their oral healthcare decisions.
          </p>
        </div>
      </div>
    </section>

    <!-- Clinic Standards & Diagnostic Equipment -->
    <section class="py-10 px-4 sm:px-6 lg:px-24 max-w-4xl mx-auto border-t border-japandi-clay/20">
      <div class="space-y-5">
        <h2 class="text-2xl sm:text-3xl font-serif text-japandi-charcoal font-medium">
          Clinical standards and diagnostic equipment
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="p-5 rounded-2xl bg-japandi-sand/50 border border-japandi-clay/40 space-y-2">
            <h3 class="font-serif text-base font-medium text-japandi-charcoal">Digital RVG Radiography</h3>
            <p class="text-xs text-japandi-earth font-light leading-relaxed">
              Ultra-low radiation digital sensors produce sharp, immediate radiographic views of root anatomy, hidden interdental decay, and bone levels directly on chairside screens.
            </p>
          </div>
          <div class="p-5 rounded-2xl bg-japandi-sand/50 border border-japandi-clay/40 space-y-2">
            <h3 class="font-serif text-base font-medium text-japandi-charcoal">Intraoral Visual Camera</h3>
            <p class="text-xs text-japandi-earth font-light leading-relaxed">
              High-magnification intraoral video cameras allow you to inspect cracked fillings, enamel wear, and gum margins alongside your clinician in real time.
            </p>
          </div>
          <div class="p-5 rounded-2xl bg-japandi-sand/50 border border-japandi-clay/40 space-y-2">
            <h3 class="font-serif text-base font-medium text-japandi-charcoal">Hospital-Grade Sterilisation</h3>
            <p class="text-xs text-japandi-earth font-light leading-relaxed">
              Strict multi-tier instrument processing utilizing high-vacuum autoclave sterilisation, individual surgical pouching, and clinical surface disinfection between every visit.
            </p>
          </div>
        </div>
        <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
          Specialized clinical care is delivered collaboratively: MDS specialists across orthodontics, endodontics, oral and maxillofacial surgery, periodontics, paedodontics, and prosthodontics visit our Horamavu Agara Road clinic on a scheduled case basis to manage complex clinical cases under one roof. Each visiting consultant works with our resident dental team to ensure cohesive treatment planning and uninterrupted aftercare.
        </p>
      </div>
    </section>

    <!-- Treatments and Prices -->
    <section class="py-10 px-4 sm:px-6 lg:px-24 max-w-4xl mx-auto border-t border-japandi-clay/20">
      <div class="space-y-4">
        <div class="text-center sm:text-left space-y-1">
          <h2 class="text-2xl sm:text-3xl font-serif text-japandi-charcoal font-medium">
            Treatments and prices
          </h2>
          <p class="text-xs sm:text-sm text-japandi-earth font-light">
            Prices are published estimate ranges. You receive an itemized, written quote after clinical examination.
          </p>
        </div>

        <div class="bg-japandi-cream border border-japandi-clay/40 rounded-2xl divide-y divide-japandi-clay/20 overflow-hidden shadow-sm">
          {treatmentPricing.map((item) => (
            <div class="p-4 sm:px-6 sm:py-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-1 text-xs sm:text-sm">
              <div>
                <span class="font-medium text-japandi-charcoal block sm:inline">{item.name}</span>
                <span class="text-[11px] text-japandi-earth font-light sm:ml-2">({item.note})</span>
              </div>
              <span class="font-semibold text-japandi-moss shrink-0">{item.price}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- How your first visit works -->
    <section class="py-10 px-4 sm:px-6 lg:px-24 max-w-4xl mx-auto border-t border-japandi-clay/20">
      <div class="space-y-6">
        <div class="text-center sm:text-left space-y-1">
          <h2 class="text-2xl sm:text-3xl font-serif text-japandi-charcoal font-medium">
            How your first visit works
          </h2>
          <p class="text-xs sm:text-sm text-japandi-earth font-light">
            A structured, unhurried initial evaluation designed around your comfort and complete financial transparency.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="p-6 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/30 space-y-2">
            <span class="w-7 h-7 rounded-full bg-japandi-moss text-japandi-cream text-xs font-semibold flex items-center justify-center">1</span>
            <h3 class="font-serif text-base font-medium text-japandi-charcoal pt-1">Examination &amp; Digital X-Ray</h3>
            <p class="text-xs text-japandi-earth font-light leading-relaxed">
              We begin with a thorough examination of teeth, gums, and bite alignment. Low-radiation RVG digital X-rays are taken to inspect beneath the surface. Consultation is ₹600 and stays valid for 6 months.
            </p>
          </div>
          <div class="p-6 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/30 space-y-2">
            <span class="w-7 h-7 rounded-full bg-japandi-moss text-japandi-cream text-xs font-semibold flex items-center justify-center">2</span>
            <h3 class="font-serif text-base font-medium text-japandi-charcoal pt-1">Clear Explanation &amp; Written Plan</h3>
            <p class="text-xs text-japandi-earth font-light leading-relaxed">
              We review clinical findings on screen using intraoral camera photos and radiographs. You receive a clear, printed estimate detailing treatment steps, timelines, and exact pricing before anything starts.
            </p>
          </div>
          <div class="p-6 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/30 space-y-2">
            <span class="w-7 h-7 rounded-full bg-japandi-moss text-japandi-cream text-xs font-semibold flex items-center justify-center">3</span>
            <h3 class="font-serif text-base font-medium text-japandi-charcoal pt-1">Treatment at Your Pace</h3>
            <p class="text-xs text-japandi-earth font-light leading-relaxed">
              Begin necessary care on the same day if you wish, or schedule subsequent visits at times convenient for your calendar. There is never pressure to proceed until you feel fully prepared.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Questions people in Kalyan Nagar ask us -->
    <section class="py-10 px-4 sm:px-6 lg:px-24 max-w-4xl mx-auto border-t border-japandi-clay/20">
      <div class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-serif text-japandi-charcoal font-medium">
          Questions people in Kalyan Nagar ask us
        </h2>
        <div class="divide-y divide-japandi-clay/30 border border-japandi-clay/40 rounded-2xl bg-japandi-cream overflow-hidden">
          {faqs.map((faq) => (
            <div class="p-5 sm:p-6 space-y-2">
              <h3 class="font-serif text-base font-medium text-japandi-charcoal">
                {faq.q}
              </h3>
              <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
                {faq.a}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Find Us / Contact Block -->
    <section class="py-10 px-4 sm:px-6 lg:px-24 max-w-4xl mx-auto border-t border-japandi-clay/20">
      <div class="bg-japandi-sand/60 border border-japandi-clay/40 rounded-3xl p-6 sm:p-8 space-y-4">
        <h2 class="text-xl sm:text-2xl font-serif text-japandi-charcoal font-medium">
          Find Aureva Dental
        </h2>
        <div class="space-y-1.5 text-xs sm:text-sm text-japandi-earth font-light">
          <p><strong class="font-medium text-japandi-charcoal">Address:</strong> {canonicalAddress}</p>
          <p><strong class="font-medium text-japandi-charcoal">Landmark:</strong> Horamavu Agara Road, near Nayara Petrol Bunk, Hennur Bande (2nd floor with lift access).</p>
          <p><strong class="font-medium text-japandi-charcoal">Hours:</strong> Tuesday–Sunday 9:30 AM–9:00 PM &middot; Monday 4:00 PM–9:00 PM (Walk-ins welcome until 9 PM).</p>
          <p><strong class="font-medium text-japandi-charcoal">Parking:</strong> Parking available for 4-wheelers and 2-wheelers.</p>
        </div>
        <div class="pt-2 flex flex-wrap gap-3">
          <a href={phoneCallUrl} class="px-5 py-2.5 rounded-full bg-japandi-moss text-japandi-cream text-xs font-medium uppercase tracking-wider hover:bg-japandi-charcoal transition-colors">
            Call 073497 01002
          </a>
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 rounded-full border border-japandi-clay bg-japandi-sand text-japandi-charcoal text-xs font-medium uppercase tracking-wider hover:bg-japandi-cream transition-colors">
            WhatsApp
          </a>
          <a href={directionsUrl} target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 rounded-full border border-japandi-clay bg-japandi-sand text-japandi-charcoal text-xs font-medium uppercase tracking-wider hover:bg-japandi-cream transition-colors">
            Google Maps Directions
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
