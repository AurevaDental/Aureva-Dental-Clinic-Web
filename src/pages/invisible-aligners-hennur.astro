---
import { CANONICAL_PRICES } from '../data/prices';
import Layout from '../layouts/Layout.astro';
import { generateBreadcrumbSchema, generateFaqSchema, generateTreatmentServiceSchema } from '../utils/seoSchemas';
import TreatmentDepartmentCard from '../components/TreatmentDepartmentCard.astro';
import TreatmentAftercare from '../components/TreatmentAftercare.astro';
import TreatmentActions from '../components/TreatmentActions.astro';

const pageTitle = "Invisible Aligners in Hennur Bande | Aureva Dental";
const pageDescription = "Discreet invisible aligners in Hennur Bande at Aureva Dental. Visiting MDS orthodontist, 3D digital planning, mild to complex tiers, open till 9 PM.";
const canonicalUrl = "https://aurevadental.com/invisible-aligners-hennur";

const faqs = [
  {
    question: "How do invisible aligners straighten teeth without metal wires?",
    answer: "Invisible aligners are custom-manufactured series of transparent, medical-grade thermoplastic trays. Using 3D computer-aided software, your treatment is mapped in advance. Each sequential aligner applies gentle, controlled biomechanical force to specific teeth, gradually shifting them until ideal alignment is achieved."
  },
  {
    question: "How many hours per day must I wear my clear aligners?",
    answer: "For optimal biological tooth movement, clear aligners must be worn for 20 to 22 hours per day. You only remove them while eating, drinking hot or sugary beverages, and brushing or flossing your teeth. Inconsistent wear delays tooth tracking and prolongs overall treatment duration."
  },
  {
    question: "What is the cost of invisible aligners in Hennur Bande, Bangalore?",
    answer: `At Aureva Dental in Hennur Bande, invisible aligner packages depend on case complexity: mild cases are ${CANONICAL_PRICES.aligners_mild}, moderate cases are ${CANONICAL_PRICES.aligners_moderate}, and complex corrections are ${CANONICAL_PRICES.aligners_complex}. Prices are ranges, confirmed after examination.`
  },
  {
    question: "Can invisible aligners fix severe crowding or overbites?",
    answer: "Yes. Clear aligner protocols utilize tooth-colored composite attachments (small grips bonded to enamel) and elastics to correct overbites, spacing, and severe crowding without metal brackets."
  },
  {
    question: "How do I get started with invisible aligners at Aureva Dental in Hennur Bande?",
    answer: `Getting started begins with an initial consultation at ${CANONICAL_PRICES.consultation} with digital X-ray. We perform an intraoral assessment, evaluate bite alignment, and initiate 3D digital treatment planning.`
  }
];

const breadcrumbs = [
  { name: "Home", url: "https://aurevadental.com/" },
  { name: "Treatments", url: "https://aurevadental.com/treatments/clear-aligners" },
  { name: "Invisible Aligners in Hennur Bande", url: canonicalUrl }
];

const breadcrumbSchema = JSON.stringify(generateBreadcrumbSchema(breadcrumbs));
const faqSchema = JSON.stringify(generateFaqSchema(faqs));
const serviceSchema = JSON.stringify(generateTreatmentServiceSchema({
  name: "Invisible Aligners in Hennur Bande",
  description: pageDescription,
  url: canonicalUrl,
  medicalSpecialty: "Orthodontics"
}));

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogUrl: canonicalUrl,
  schemaMarkup: [breadcrumbSchema, faqSchema, serviceSchema]
};
---

<Layout {...seoProps}>
  <!-- Breadcrumb Navigation -->
  <nav class="bg-japandi-sand/30 border-b border-japandi-clay/20 py-3.5 px-6 lg:px-24 text-xs font-light text-japandi-earth" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto flex items-center gap-2">
      <a href="/" class="hover:text-japandi-moss transition-colors">Home</a>
      <span>/</span>
      <a href="/treatments/clear-aligners" class="hover:text-japandi-moss transition-colors">Clear Aligners</a>
      <span>/</span>
      <span class="text-japandi-charcoal font-medium">Hennur Bande</span>
    </div>
  </nav>

  <!-- 1. Hero / H1 Section -->
  <section class="py-16 md:py-24 px-6 lg:px-24 bg-transparent relative overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 flex flex-col items-start space-y-6 animate-slow-fade">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-japandi-clay/60 bg-japandi-sand/70 text-[10px] font-semibold text-japandi-moss uppercase tracking-widest">
          Orthodontics &bull; Hennur Bande, Bangalore
        </div>
        
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif text-japandi-charcoal leading-tight font-medium tracking-tight">
          Invisible aligners in Hennur Bande
        </h1>

        <p class="text-base sm:text-lg text-japandi-earth font-light leading-relaxed max-w-2xl">
          Straighten your teeth with custom transparent aligner trays at Aureva Dental in Hennur Bande. Planned by our visiting MDS Orthodontist with precision 3D digital modeling. For full clinical specifications and wear protocols, see our detailed <a href="/treatments/clear-aligners" class="text-japandi-moss underline decoration-japandi-moss/50 hover:decoration-japandi-moss font-medium">Clear Aligners Guide</a>.
        </p>

        <!-- CTA Buttons -->
        <div class="pt-2 flex flex-wrap items-center gap-4 w-full sm:w-auto">
          <button 
            type="button"
            data-open-booking
            class="inline-flex items-center justify-center gap-2 px-7 py-4 bg-japandi-moss text-japandi-cream hover:bg-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 shadow-md shadow-japandi-moss/15 cursor-none"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
            </svg>
            <span>Book Consultation</span>
          </button>

          <a 
            href="tel:+917349701002"
            class="inline-flex items-center justify-center gap-2 px-6 py-4 border border-japandi-clay hover:border-japandi-moss text-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 bg-japandi-sand/40 hover:bg-japandi-sand cursor-none"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-japandi-moss">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
            </svg>
            <span>Call +91 73497 01002</span>
          </a>
        </div>
      </div>

      <!-- Quick Info Card -->
      <div class="lg:col-span-5 relative">
        <div class="relative rounded-3xl border border-japandi-clay/60 shadow-xl bg-japandi-sand/40 p-8 space-y-4">
          <span class="text-xs font-semibold uppercase tracking-widest text-japandi-moss">Clinic Details</span>
          <h3 class="text-xl font-serif text-japandi-charcoal font-medium">Hennur Bande Location</h3>
          <p class="text-xs text-japandi-earth leading-relaxed font-light">
            2nd floor, No.11, 4, Horamavu Agara Rd, near Nayara Petrol Bunk, Hennur Bande, Hennur Gardens, Bengaluru, Karnataka 560043.
          </p>
          <div class="pt-2 border-t border-japandi-clay/30 text-xs text-japandi-earth space-y-1">
            <p><strong>Hours:</strong> Mon 4–9 PM, Tue–Sun 9:30 AM–9 PM</p>
            <p><strong>Access:</strong> 2nd floor with lift. Parking available for 4-wheelers and 2-wheelers.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Who It's For (Symptoms in Plain Words) -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Candidates</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Who invisible aligners are for
        </h2>
      </div>
      <p class="text-sm sm:text-base text-japandi-earth font-light leading-relaxed">
        Invisible aligners are designed for teenagers and adults looking for discreet orthodontic alignment to correct:
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm text-japandi-earth font-light">
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Crowded Teeth</h3>
          <p>Teeth that overlap or twist because the jaw lacks sufficient space, making brushing and flossing difficult.</p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Spacing and Gaps</h3>
          <p>Noticeable spaces between front teeth or uneven spacing across the dental arch.</p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Overbite or Deep Bite</h3>
          <p>Upper front teeth overlapping the lower teeth excessively, causing accelerated enamel wear.</p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Mild Relapse</h3>
          <p>Teeth that have shifted slightly after previous orthodontic treatment when retainers were discontinued.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. What Happens, Visit by Visit, & Number of Sittings -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-8">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Clinical Protocol</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          What happens visit by visit
        </h2>
        <p class="text-sm sm:text-base text-japandi-earth font-light mt-2">
          Typically involves 3 initial sittings to plan and deliver aligners, followed by brief progress reviews every 6 to 8 weeks.
        </p>
      </div>

      <div class="space-y-4 text-xs sm:text-sm text-japandi-earth font-light">
        <div class="p-6 rounded-2xl bg-japandi-sand/30 border border-japandi-clay/40 space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">Visit 1: Clinical Assessment &amp; 3D Scan</h3>
            <span class="text-[10px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded bg-japandi-moss/10 text-japandi-moss">Sitting 1</span>
          </div>
          <p class="leading-relaxed">
            Our visiting MDS Orthodontist examines your dental arches, takes digital RVG X-rays, and performs an intraoral assessment to determine if clear aligners fit your clinical goals.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-japandi-sand/30 border border-japandi-clay/40 space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">Visit 2: 3D Simulation &amp; Treatment Plan Review</h3>
            <span class="text-[10px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded bg-japandi-moss/10 text-japandi-moss">Sitting 2</span>
          </div>
          <p class="leading-relaxed">
            Review your digital treatment plan and step-by-step movement simulation on screen. Confirm tray numbers, expected timeline, and case fee before fabrication begins.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-japandi-sand/30 border border-japandi-clay/40 space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">Visit 3: Tray Delivery &amp; Attachment Placement</h3>
            <span class="text-[10px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded bg-japandi-moss/10 text-japandi-moss">Sitting 3</span>
          </div>
          <p class="leading-relaxed">
            If required, small tooth-colored composite attachments are bonded to specific teeth. You receive your initial series of aligner trays with wear and hygiene instructions.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-japandi-sand/30 border border-japandi-clay/40 space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">Subsequent Visits: Progress Tracking &amp; Next Trays</h3>
            <span class="text-[10px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded bg-japandi-moss/10 text-japandi-moss">Every 6–8 Weeks</span>
          </div>
          <p class="leading-relaxed">
            Brief checkups to verify teeth are tracking according to the digital roadmap and dispense your next tray batches.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Price Table from Keys -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Transparent Pricing</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Clear aligner treatment fees
        </h2>
        <p class="text-xs sm:text-sm text-japandi-earth font-light mt-1">
          Prices are ranges, confirmed after examination.
        </p>
      </div>

      <div class="rounded-2xl border border-japandi-clay/40 overflow-hidden bg-japandi-cream/90 shadow-sm">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-japandi-sand/60 text-japandi-charcoal font-serif border-b border-japandi-clay/30">
            <tr>
              <th class="py-3 px-4">Case Complexity</th>
              <th class="py-3 px-4">Price Range</th>
              <th class="py-3 px-4 hidden sm:table-cell">Details</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-japandi-clay/20 text-japandi-earth font-light">
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">Mild Correction</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.aligners_mild}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Minor spacing, slight overlap, or mild relapse</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">Moderate Correction</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.aligners_moderate}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Moderate crowding, rotation, and bite correction</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">Complex / Severe Correction</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.aligners_complex}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Comprehensive multi-arch correction, deep bite, extractions</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">Initial Consultation</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.consultation}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Clinical exam with digital RVG X-ray</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-xs text-japandi-earth font-light">
        Flexible split-payment and EMI financing options are available. See all fees on our <a href="/prices" class="text-japandi-moss underline decoration-japandi-moss/40 hover:decoration-japandi-moss font-medium">treatment prices</a> page.
      </p>
    </div>
  </section>

  <!-- 5. Which Department Handles It -->
  <TreatmentDepartmentCard 
    department="Orthodontics & Dentofacial Orthopaedics"
    link="/our-specialists#orthodontics"
    description="Aligner treatment plans, digital biomechanical setups, and clinical supervision at Aureva Dental are led by visiting MDS Orthodontists."
  />

  <!-- 6. Aftercare and When to Call Us -->
  <TreatmentAftercare 
    instructions={[
      "Wear your aligners for 20 to 22 hours daily, removing them only for meals and oral hygiene.",
      "Clean your aligners by gently brushing with lukewarm water and mild soap; avoid hot water to prevent plastic distortion.",
      "Store aligners in their ventilated protective case whenever removed to prevent accidental loss.",
      "Brush and floss your teeth before re-inserting aligners after meals."
    ]}
    whenToCall={[
      "An aligner tray cracks, tears, or does not seat properly after 48 hours.",
      "A bonded composite attachment detaches from a tooth.",
      "You experience sharp gum abrasion or prolonged discomfort."
    ]}
  />

  <!-- 7. FAQs (with Schema) -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-8">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Common Questions</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Frequently asked questions
        </h2>
      </div>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <div class="bg-japandi-cream/90 border border-japandi-clay/40 rounded-2xl p-6 space-y-2">
            <h3 class="font-serif text-base sm:text-lg text-japandi-charcoal font-medium">
              {faq.question}
            </h3>
            <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. Related Treatments -->
  <section class="py-16 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <h2 class="text-xl sm:text-2xl font-serif text-japandi-charcoal font-medium">
        Related treatments
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
        <a href="/treatments/clear-aligners" class="p-4 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 hover:border-japandi-moss transition-colors block space-y-1">
          <span class="font-serif text-sm text-japandi-charcoal font-medium block">Clear Aligners Guide</span>
          <span class="text-japandi-earth font-light">Full clinical guide &amp; wear routines</span>
        </a>
        <a href="/teeth-whitening-hennur" class="p-4 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 hover:border-japandi-moss transition-colors block space-y-1">
          <span class="font-serif text-sm text-japandi-charcoal font-medium block">Teeth Whitening</span>
          <span class="text-japandi-earth font-light">Post-orthodontic smile brightening</span>
        </a>
        <a href="/treatments/cosmetic-dentistry" class="p-4 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 hover:border-japandi-moss transition-colors block space-y-1">
          <span class="font-serif text-sm text-japandi-charcoal font-medium block">Cosmetic Dentistry</span>
          <span class="text-japandi-earth font-light">Bonding, veneers &amp; smile design</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 9. Book / WhatsApp / Call -->
  <TreatmentActions treatmentName="Invisible Aligners Consultation" />
</Layout>
