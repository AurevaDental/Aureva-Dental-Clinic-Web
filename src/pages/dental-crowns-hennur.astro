---
import Layout from '../layouts/Layout.astro';
import { generateBreadcrumbSchema, generateFaqSchema, generateTreatmentServiceSchema } from '../utils/seoSchemas';
import { CANONICAL_PRICES } from '../data/prices';
import TreatmentDepartmentCard from '../components/TreatmentDepartmentCard.astro';
import TreatmentAftercare from '../components/TreatmentAftercare.astro';
import TreatmentActions from '../components/TreatmentActions.astro';

const pageTitle = "Dental Crowns & Caps in Hennur Bangalore | Aureva Dental";
const pageDescription = "Custom dental crowns & caps in Hennur, Bangalore at Aureva Dental. High-strength zirconia, E-max & ceramic crowns with digital scans. Call +91 73497 01002.";
const canonicalUrl = "https://aurevadental.com/dental-crowns-hennur";
const phoneCallUrl = "tel:+917349701002";
const whatsappUrl = "https://wa.me/917349701002?text=Hello%20Aureva%20Dental%2C%20I%20would%20like%20to%20consult%20for%20Dental%20Crowns%20or%20Caps%20in%20Hennur.";

const breadcrumbs = [
  { name: "Home", url: "https://aurevadental.com/" },
  { name: "Dental Crowns in Hennur", url: canonicalUrl }
];

const faqs = [
  {
    question: "What is the primary difference between a dental crown and a cap?",
    answer: "There is no clinical difference between a dental crown and a dental cap. 'Cap' is simply the familiar layperson term, while 'crown' is the professional dental term. Both refer to a custom-crafted restorative covering that completely encapsulates a damaged, root-treated, or worn tooth to restore its original shape, strength, and appearance."
  },
  {
    question: "Why is a crown strongly advised following a root canal treatment?",
    answer: "A root canal treatment removes the inflamed or infected pulp tissue from inside the tooth, which stops the blood supply to the tooth structure. Over time, the remaining tooth enamel and dentin become dehydrated and brittle. Chewing normal foods without a protective crown places extreme stress on the hollowed tooth walls. A custom zirconia or ceramic crown encases the tooth and absorbs chewing forces safely."
  },
  {
    question: "How long does a monolithic zirconia or E-max crown typically last?",
    answer: "With consistent twice-daily brushing, daily flossing around the crown margins, and routine biannual checkups, monolithic zirconia and E-max lithium disilicate crowns can last many years with good care and regular check-ups. Zirconia is exceptionally chip-resistant and withstands heavy posterior chewing pressures."
  },
  {
    question: "How much do dental crowns and caps cost in Hennur?",
    answer: `At Aureva Dental, a new patient clinical consultation including digital RVG X-ray assessment is ${CANONICAL_PRICES.consultation}. PFM (porcelain-fused-to-metal) crowns range from ${CANONICAL_PRICES.crown_pfm}, all-ceramic crowns range from ${CANONICAL_PRICES.crown_ceramic}, and premium monolithic lab-milled Zirconia or E-max lithium disilicate crowns range from ${CANONICAL_PRICES.crown_zirconia}. Transparent written pricing is provided before any tooth preparation begins.`
  }
];

const breadcrumbSchema = JSON.stringify(generateBreadcrumbSchema(breadcrumbs));
const faqSchema = JSON.stringify(generateFaqSchema(faqs));
const serviceSchema = JSON.stringify(generateTreatmentServiceSchema({
  name: "Dental Crowns & Caps in Hennur",
  description: pageDescription,
  url: canonicalUrl,
  medicalSpecialty: "Prosthodontics"
}));

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogUrl: canonicalUrl,
  schemaMarkup: [breadcrumbSchema, faqSchema, serviceSchema]
};
---

<Layout {...seoProps}>
  <!-- Breadcrumb Navigation -->
  <nav class="bg-japandi-sand/30 border-b border-japandi-clay/20 py-3.5 px-6 lg:px-24 text-xs font-light text-japandi-earth" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <a href="/" class="hover:text-japandi-moss transition-colors">Home</a>
        <span>/</span>
        <span class="text-japandi-charcoal font-medium">Dental Crowns in Hennur</span>
      </div>
      <a href="#pricing" class="inline-flex items-center gap-1 text-xs font-semibold text-japandi-moss hover:underline">
        Prices &darr;
      </a>
    </div>
  </nav>

  <!-- 1. Hero / H1 Section -->
  <section class="py-12 md:py-20 px-6 lg:px-24 bg-transparent relative overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <div class="lg:col-span-7 flex flex-col items-start space-y-4 md:space-y-6 animate-slow-fade">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-japandi-clay/60 bg-japandi-sand/70 text-[10px] font-semibold text-japandi-moss uppercase tracking-widest">
          Restorative Care &bull; Hennur Bande, Bangalore
        </div>
        
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif text-japandi-charcoal leading-tight font-medium tracking-tight">
          Dental Crowns (Caps) in Hennur
        </h1>

        <div class="w-full bg-japandi-sand/40 border border-japandi-clay/30 rounded-2xl p-3.5 space-y-1.5 text-xs text-japandi-earth">
          <p class="flex items-center gap-2 font-medium text-japandi-charcoal">
            <span>Hours: Mon 4–9 PM, Tue–Sun 9:30 AM–9 PM</span>
          </p>
          <p>2nd Floor, Horamavu Agara Road, near Nayara Petrol Bunk, Hennur Bande. Lift and parking available.</p>
        </div>

        <p class="text-sm sm:text-base text-japandi-earth font-light leading-relaxed max-w-2xl">
          Restore cracked, heavily decayed, or root-canal-treated teeth with custom-milled monolithic zirconia, all-ceramic, and E-max crowns. Built for lasting strength and natural aesthetics.
        </p>

        <!-- CTA Buttons -->
        <div class="pt-2 flex flex-wrap items-center gap-3 w-full sm:w-auto">
          <button 
            type="button"
            data-open-booking
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-japandi-moss text-japandi-cream hover:bg-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 shadow-sm"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
            </svg>
            <span>Book Consultation</span>
          </button>

          <a 
            href={phoneCallUrl}
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 border border-japandi-clay bg-japandi-sand/50 hover:bg-japandi-sand text-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-japandi-moss">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
            </svg>
            <span>Call: +91 73497 01002</span>
          </a>
        </div>
      </div>

      <!-- Quick Feature Card -->
      <div class="lg:col-span-5 relative">
        <div class="p-8 rounded-3xl bg-japandi-sand/50 border border-japandi-clay/40 shadow-sm space-y-4">
          <span class="text-xs uppercase font-semibold text-japandi-moss tracking-widest block">Restorative Materials</span>
          <h3 class="font-serif text-xl font-medium text-japandi-charcoal">Crown Options</h3>
          <ul class="space-y-3 text-xs font-light text-japandi-earth">
            <li class="flex items-start gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-japandi-moss mt-1.5 shrink-0"></span>
              <div><strong class="text-japandi-charcoal font-medium">Monolithic Zirconia:</strong> Chip-resistant, metal-free CAD/CAM crowns built for high chewing force on molars.</div>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-japandi-moss mt-1.5 shrink-0"></span>
              <div><strong class="text-japandi-charcoal font-medium">E-max Lithium Disilicate:</strong> Highly aesthetic glass ceramic with lifelike light transmission for front teeth.</div>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-japandi-moss mt-1.5 shrink-0"></span>
              <div><strong class="text-japandi-charcoal font-medium">PFM Crowns:</strong> Time-tested porcelain fused to metal for reliable strength and value.</div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Who It's For (Symptoms in Plain Words) -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Candidates</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Who dental crowns are for
        </h2>
      </div>
      <p class="text-sm sm:text-base text-japandi-earth font-light leading-relaxed">
        A custom dental crown is indicated when a tooth needs complete encasement and protection, such as:
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm text-japandi-earth font-light">
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">After Root Canal Treatment</h3>
          <p>Root-treated teeth become dehydrated and prone to fracture; crowns protect them from chewing stress.</p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Extensive Cavities</h3>
          <p>Teeth with large fillings where more than half of the natural tooth structure is missing.</p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Cracked or Broken Teeth</h3>
          <p>Teeth with structural cracks that hurt when chewing or release pressure.</p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Severe Tooth Wear</h3>
          <p>Teeth severely ground down by nighttime bruxism or acid erosion requiring restoration of height.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. What Happens, Visit by Visit, & Number of Sittings -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-8">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Clinical Protocol</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          What happens, visit by visit
        </h2>
        <p class="text-sm sm:text-base text-japandi-earth font-light mt-2">
          A custom dental crown is completed in 2 clinical sittings.
        </p>
      </div>

      <div class="space-y-4 text-xs sm:text-sm text-japandi-earth font-light">
        <div class="p-6 rounded-2xl bg-japandi-sand/30 border border-japandi-clay/40 space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">Visit 1: Tooth Preparation &amp; Optical Scan</h3>
            <span class="text-[10px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded bg-japandi-moss/10 text-japandi-moss">Sitting 1</span>
          </div>
          <p class="leading-relaxed">
            The tooth is gently prepared under local anesthesia to accommodate the crown. An optical digital scan is captured, tooth shade is selected, and a temporary crown is placed.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-japandi-sand/30 border border-japandi-clay/40 space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">Visit 2: Try-In &amp; Permanent Cementation</h3>
            <span class="text-[10px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded bg-japandi-moss/10 text-japandi-moss">Sitting 2</span>
          </div>
          <p class="leading-relaxed">
            Your custom-milled crown is checked for marginal adaptation, contact tightness, and bite harmony, then bonded with permanent dental cement.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Price Table from Keys -->
  <section id="pricing" class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Transparent Pricing</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Dental crown fees in Hennur
        </h2>
        <p class="text-xs sm:text-sm text-japandi-earth font-light mt-1">
          Prices are ranges, confirmed after examination.
        </p>
      </div>

      <div class="rounded-2xl border border-japandi-clay/40 overflow-hidden bg-japandi-cream/90 shadow-sm">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-japandi-sand/60 text-japandi-charcoal font-serif border-b border-japandi-clay/30">
            <tr>
              <th class="py-3 px-4">Crown Material</th>
              <th class="py-3 px-4">Price Range</th>
              <th class="py-3 px-4 hidden sm:table-cell">Features</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-japandi-clay/20 text-japandi-earth font-light">
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">PFM (Porcelain Fused to Metal)</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.crown_pfm}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Durable metal base with ceramic porcelain layer</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">All-Ceramic Crown</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.crown_ceramic}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Metal-free ceramic for anterior teeth</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">Monolithic Zirconia Crown</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.crown_zirconia}</td>
              <td class="py-3 px-4 hidden sm:table-cell">High-strength computer-milled zirconia for heavy bites</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">E-max Lithium Disilicate</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.crown_emax}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Translucent glass-ceramic for front aesthetic teeth</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">Consultation with Digital X-Ray</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.consultation}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Valid for 6 months</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-xs text-japandi-earth font-light">
        See our complete pricing catalog on the <a href="/prices" class="text-japandi-moss underline decoration-japandi-moss/40 hover:decoration-japandi-moss font-medium">treatment prices</a> page.
      </p>
    </div>
  </section>

  <!-- 5. Which Department Handles It -->
  <TreatmentDepartmentCard 
    department="Prosthodontics, Crown & Bridge"
    link="/our-specialists#prosthodontics"
    description="Crown preparation, digital impressions, margin verification, and occlusal equilibration are led by our visiting MDS Prosthodontists."
  />

  <!-- 6. Aftercare and When to Call Us -->
  <TreatmentAftercare 
    instructions={[
      "Brush twice daily and floss gently around the base of the crown to keep the margin free from plaque.",
      "Avoid chewing very hard, sticky, or brittle foods directly on the newly cemented crown for the first 24 hours.",
      "If you experience mild sensitivity to temperature changes, use a desensitizing toothpaste for a few days.",
      "Attend regular 6-month checkups so your dentist can inspect crown margins and gingival health."
    ]}
    whenToCall={[
      "Your bite feels high, uneven, or sore when chewing after local numbness has completely worn off.",
      "The crown feels loose, moves, or dislodges.",
      "You develop persistent throbbing pain around the crowned tooth."
    ]}
  />

  <!-- 7. FAQs (with Schema) -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-8">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Common Questions</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Frequently asked questions
        </h2>
      </div>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <div class="bg-japandi-cream/90 border border-japandi-clay/40 rounded-2xl p-6 space-y-2">
            <h3 class="font-serif text-base sm:text-lg text-japandi-charcoal font-medium">
              {faq.question}
            </h3>
            <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. Related Treatments -->
  <section class="py-16 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <h2 class="text-xl sm:text-2xl font-serif text-japandi-charcoal font-medium">
        Related treatments
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
        <a href="/root-canal-treatment-hennur" class="p-4 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 hover:border-japandi-moss transition-colors block space-y-1">
          <span class="font-serif text-sm text-japandi-charcoal font-medium block">Root Canal Treatment</span>
          <span class="text-japandi-earth font-light">Clearing nerve infection before crown placement</span>
        </a>
        <a href="/treatments/dental-bridges" class="p-4 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 hover:border-japandi-moss transition-colors block space-y-1">
          <span class="font-serif text-sm text-japandi-charcoal font-medium block">Dental Bridges</span>
          <span class="text-japandi-earth font-light">Replacing missing teeth using adjacent crowns</span>
        </a>
        <a href="/treatments/dental-implants" class="p-4 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 hover:border-japandi-moss transition-colors block space-y-1">
          <span class="font-serif text-sm text-japandi-charcoal font-medium block">Dental Implants</span>
          <span class="text-japandi-earth font-light">Custom implant crowns on titanium fixtures</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 9. Book / WhatsApp / Call -->
  <TreatmentActions treatmentName="Dental Crown Consultation" />
</Layout>
