---
import Layout from '../../layouts/Layout.astro';
import { generateBreadcrumbSchema, generateFaqSchema, generateTreatmentServiceSchema } from '../../utils/seoSchemas';
import { CANONICAL_PRICES } from '../../data/prices';
import TreatmentDepartmentCard from '../../components/TreatmentDepartmentCard.astro';
import TreatmentAftercare from '../../components/TreatmentAftercare.astro';
import TreatmentActions from '../../components/TreatmentActions.astro';

const denturePriceList = [
  { name: "Complete denture, one arch (upper or lower)", price: CANONICAL_PRICES.denture_complete_single_arch },
  { name: "Complete dentures, both arches", price: CANONICAL_PRICES.denture_complete_both_arches },
  { name: "Partial denture, acrylic", price: CANONICAL_PRICES.denture_partial_acrylic_table },
  { name: "Partial denture, cast metal framework", price: CANONICAL_PRICES.denture_partial_cast_metal },
  { name: "Flexible partial denture", price: CANONICAL_PRICES.denture_flexible_partial },
  { name: "Implant-supported overdenture (denture only; implants priced separately)", price: CANONICAL_PRICES.denture_implant_supported_overdenture },
  { name: "Denture reline or repair", price: CANONICAL_PRICES.denture_reline_repair },
  { name: "New-patient consultation with digital X-ray", price: `${CANONICAL_PRICES.consultation} (valid 6 months)` }
];

const pageTitle = "Custom Dentures in Bangalore | Full & Partial Dentures | Aureva Dental";
const pageDescription = "Custom complete, partial & flexible dentures in Bangalore at Aureva Dental. Natural aesthetics, comfortable fit and stable bite restoration.";
const canonicalUrl = "https://aurevadental.com/treatments/dentures";
const phoneCallUrl = "tel:+917349701002";
const whatsappUrl = "https://wa.me/917349701002?text=Hello%2C%20I%20would%20like%20to%20consult%20about%20Dentures%20at%20Aureva%20Dental.";

const faqs = [
  {
    question: "What types of dentures are available at Aureva Dental?",
    answer: "We offer complete dentures (for patients missing all teeth in an arch), cast partial dentures (with high-strength metal frameworks), ultra-lightweight flexible Valplast dentures (metal-free and tissue-blending), and implant-supported overdentures that snap firmly into titanium implants for secure stability."
  },
  {
    question: "Will my dentures slip or feel loose when speaking or eating?",
    answer: "No. We utilize multi-stage border molding and anatomical functional impressions to achieve an airtight peripheral seal against the gum tissues. For patients seeking maximum stability without adhesive pastes, implant-retained snap-on dentures offer dependable security."
  },
  {
    question: "How long does it take to get used to new dentures?",
    answer: "Most patients adapt within 1 to 3 weeks. During the first few days, speech and eating soft foods will feel slightly different as your facial muscles adjust. We schedule post-insertion follow-up reviews to make micro-adjustments and relieve any pressure points."
  },
  {
    question: "Should I wear my dentures while sleeping?",
    answer: "We advise removing your dentures at night to give your gum tissues and alveolar bone a rest from chewing pressure. Soaking them overnight in a clean, antimicrobial denture cleanser bath keeps them hydrated and free from bacterial plaque accumulation."
  },
  {
    question: "What is the cost of dentures in Hennur, Bangalore?",
    answer: `At Aureva Dental Hennur, complete dentures cost ${CANONICAL_PRICES.denture_complete_single_arch} per arch, or ${CANONICAL_PRICES.denture_complete_both_arches} for both arches. Partial dentures cost ${CANONICAL_PRICES.denture_partial_acrylic} in acrylic, ${CANONICAL_PRICES.denture_flexible_partial} flexible, and ${CANONICAL_PRICES.denture_partial_cast_metal} with a cast metal framework, depending on how many teeth they replace. Implant-supported overdentures cost ${CANONICAL_PRICES.denture_implant_supported_overdenture}, with the implants priced separately. Prices are confirmed after your consultation.`
  }
];

const breadcrumbs = [
  { name: "Home", url: "https://aurevadental.com/" },
  { name: "Treatments", url: "https://aurevadental.com/#services" },
  { name: "Dentures", url: canonicalUrl }
];

const breadcrumbSchema = JSON.stringify(generateBreadcrumbSchema(breadcrumbs));
const faqSchema = JSON.stringify(generateFaqSchema(faqs));
const serviceSchema = JSON.stringify(generateTreatmentServiceSchema({
  name: "Custom Full & Partial Dentures",
  description: pageDescription,
  url: canonicalUrl,
  medicalSpecialty: "Prosthodontics"
}));

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogUrl: canonicalUrl,
  schemaMarkup: [breadcrumbSchema, faqSchema, serviceSchema]
};
---

<Layout {...seoProps}>
  <!-- Breadcrumb Navigation -->
  <nav class="bg-japandi-sand/30 border-b border-japandi-clay/20 py-3.5 px-6 lg:px-24 text-xs font-light text-japandi-earth" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto flex items-center gap-2">
      <a href="/" class="hover:text-japandi-moss transition-colors">Home</a>
      <span>/</span>
      <a href="/#services" class="hover:text-japandi-moss transition-colors">Treatments</a>
      <span>/</span>
      <span class="text-japandi-charcoal font-medium">Dentures</span>
    </div>
  </nav>

  <!-- 1. Hero / H1 Section -->
  <section class="py-16 md:py-24 px-6 lg:px-24 bg-transparent relative overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 flex flex-col items-start space-y-6 animate-slow-fade">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-japandi-clay/60 bg-japandi-sand/70 text-[10px] font-semibold text-japandi-moss uppercase tracking-widest">
          Prosthodontics &bull; Hennur Bande, Bangalore
        </div>
        
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif text-japandi-charcoal leading-tight font-medium tracking-tight">
          Custom Full &amp; Partial Dentures
        </h1>

        <p class="text-base sm:text-lg text-japandi-earth font-light leading-relaxed max-w-2xl">
          Restore chewing function, natural lip support, and clear speech. Our custom complete, partial, and flexible dentures are crafted to match your unique oral anatomy with comfort.
        </p>

        <!-- CTA Buttons -->
        <div class="pt-2 flex flex-wrap items-center gap-4 w-full sm:w-auto">
          <button 
            type="button"
            data-open-booking
            class="inline-flex items-center justify-center gap-2 px-7 py-4 bg-japandi-moss text-japandi-cream hover:bg-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 shadow-md shadow-japandi-moss/15 cursor-none"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
            </svg>
            <span>Book Denture Consultation</span>
          </button>

          <a 
            href={phoneCallUrl}
            class="inline-flex items-center justify-center gap-2 px-7 py-4 border border-japandi-clay bg-japandi-sand/50 hover:bg-japandi-sand text-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 cursor-none"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-japandi-moss">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
            </svg>
            <span>Call +91 73497 01002</span>
          </a>
        </div>
      </div>

      <!-- Quick Feature Card -->
      <div class="lg:col-span-5 relative">
        <div class="p-8 rounded-3xl bg-japandi-sand/50 border border-japandi-clay/40 shadow-sm space-y-4">
          <span class="text-xs uppercase font-semibold text-japandi-moss tracking-widest block">Prosthetic Options</span>
          <h3 class="font-serif text-xl font-medium text-japandi-charcoal">Denture Varieties</h3>
          <ul class="space-y-3 text-xs font-light text-japandi-earth">
            <li class="flex items-start gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-japandi-moss mt-1.5 shrink-0"></span>
              <div><strong class="text-japandi-charcoal font-medium">Complete Dentures:</strong> Full upper or lower tooth replacement custom-molded to mucosal contours.</div>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-japandi-moss mt-1.5 shrink-0"></span>
              <div><strong class="text-japandi-charcoal font-medium">Flexible Partials:</strong> Metal-free nylon that blends naturally with surrounding gum tissues.</div>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-japandi-moss mt-1.5 shrink-0"></span>
              <div><strong class="text-japandi-charcoal font-medium">Cast Metal Framework:</strong> Rigid, thin cobalt-chromium frameworks providing high stability.</div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Who It's For (Symptoms in Plain Words) -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Candidates</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Who dentures are for
        </h2>
      </div>
      <p class="text-sm sm:text-base text-japandi-earth font-light leading-relaxed">
        Removable dentures provide an accessible and functional solution for patients experiencing:
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm text-japandi-earth font-light">
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Multiple Missing Teeth</h3>
          <p>Loss of several teeth in one arch making it difficult to chew comfortably on either side.</p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Complete Tooth Loss (Edentulism)</h3>
          <p>Missing all natural teeth in the upper or lower jaw requiring full arch rehabilitation.</p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Facial Sagging &amp; Lip Support</h3>
          <p>Loss of lip fullness and facial height caused by missing teeth and alveolar bone resorption.</p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Non-Surgical Preference</h3>
          <p>Patients seeking a cost-effective, non-invasive alternative to full-arch dental implant surgery.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. What Happens, Visit by Visit, & Number of Sittings -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-8">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Clinical Protocol</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          What happens, visit by visit
        </h2>
        <p class="text-sm sm:text-base text-japandi-earth font-light mt-2">
          Custom complete dentures typically require 4 to 5 sittings to verify jaw relations and aesthetics.
        </p>
      </div>

      <div class="space-y-4 text-xs sm:text-sm text-japandi-earth font-light">
        <div class="p-6 rounded-2xl bg-japandi-sand/30 border border-japandi-clay/40 space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">Visit 1: Primary Impressions &amp; Oral Exam</h3>
            <span class="text-[10px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded bg-japandi-moss/10 text-japandi-moss">Sitting 1</span>
          </div>
          <p class="leading-relaxed">
            Clinical examination of gum ridges and bone health. Initial anatomical impressions are made to fabricate custom impression trays.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-japandi-sand/30 border border-japandi-clay/40 space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">Visit 2: Border Molding &amp; Final Impression</h3>
            <span class="text-[10px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded bg-japandi-moss/10 text-japandi-moss">Sitting 2</span>
          </div>
          <p class="leading-relaxed">
            Detailed border molding to capture functional muscle movements, creating an airtight peripheral seal for stability.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-japandi-sand/30 border border-japandi-clay/40 space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">Visit 3: Jaw Relation &amp; Bite Registration</h3>
            <span class="text-[10px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded bg-japandi-moss/10 text-japandi-moss">Sitting 3</span>
          </div>
          <p class="leading-relaxed">
            Recording vertical jaw dimensions, lip line, and selecting tooth shape, shade, and mould matching your natural aesthetics.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-japandi-sand/30 border border-japandi-clay/40 space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">Visit 4: Wax Try-In &amp; Final Delivery</h3>
            <span class="text-[10px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded bg-japandi-moss/10 text-japandi-moss">Sittings 4 &amp; 5</span>
          </div>
          <p class="leading-relaxed">
            Preview the teeth in wax to confirm smile aesthetics, phonetics, and bite balance before final acrylic curing and insertion.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Price Table from Keys -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Transparent Pricing</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Denture treatment fees
        </h2>
        <p class="text-xs sm:text-sm text-japandi-earth font-light mt-1">
          Prices are ranges, confirmed after examination.
        </p>
      </div>

      <div class="rounded-2xl border border-japandi-clay/40 overflow-hidden bg-japandi-cream/90 shadow-sm">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-japandi-sand/60 text-japandi-charcoal font-serif border-b border-japandi-clay/30">
            <tr>
              <th class="py-3 px-4">Denture Type</th>
              <th class="py-3 px-4">Price Range</th>
              <th class="py-3 px-4 hidden sm:table-cell">Notes</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-japandi-clay/20 text-japandi-earth font-light">
            {denturePriceList.map((item) => (
              <tr>
                <td class="py-3 px-4 font-medium text-japandi-charcoal">{item.name}</td>
                <td class="py-3 px-4 text-japandi-moss font-semibold">{item.price}</td>
                <td class="py-3 px-4 hidden sm:table-cell">Confirmed after clinical assessment</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-xs text-japandi-earth font-light">
        See our complete pricing catalog on the <a href="/prices" class="text-japandi-moss underline decoration-japandi-moss/40 hover:decoration-japandi-moss font-medium">treatment prices</a> page.
      </p>
    </div>
  </section>

  <!-- 5. Which Department Handles It -->
  <TreatmentDepartmentCard 
    department="Prosthodontics, Crown & Bridge"
    link="/our-specialists#prosthodontics"
    description="Complete dentures, flexible partials, cast metal frameworks, and implant overdentures are planned and fitted by visiting MDS prosthodontists."
  />

  <!-- 6. Aftercare and When to Call Us -->
  <TreatmentAftercare 
    instructions={[
      "Remove dentures every night and soak in clean water or an effervescent denture cleanser solution.",
      "Rinse dentures under lukewarm running water after every meal to remove trapped food debris.",
      "Clean dentures daily with a soft denture brush; never use abrasive whitening toothpaste or boiling water.",
      "Gently brush your gums, tongue, and palate each morning with a soft-bristled toothbrush to stimulate circulation."
    ]}
    whenToCall={[
      "You develop persistent sore spots or ulceration on the gums beneath the denture base.",
      "A tooth chips or the denture base cracks or fractures.",
      "The denture becomes noticeably loose or loses suction when speaking."
    ]}
  />

  <!-- 7. FAQs (with Schema) -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-8">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Common Questions</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Frequently asked questions
        </h2>
      </div>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <div class="bg-japandi-cream/90 border border-japandi-clay/40 rounded-2xl p-6 space-y-2">
            <h3 class="font-serif text-base sm:text-lg text-japandi-charcoal font-medium">
              {faq.question}
            </h3>
            <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. Related Treatments -->
  <section class="py-16 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <h2 class="text-xl sm:text-2xl font-serif text-japandi-charcoal font-medium">
        Related treatments
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
        <a href="/treatments/dental-implants" class="p-4 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 hover:border-japandi-moss transition-colors block space-y-1">
          <span class="font-serif text-sm text-japandi-charcoal font-medium block">Dental Implants</span>
          <span class="text-japandi-earth font-light">Fixed tooth replacement &amp; implant overdentures</span>
        </a>
        <a href="/treatments/dental-bridges" class="p-4 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 hover:border-japandi-moss transition-colors block space-y-1">
          <span class="font-serif text-sm text-japandi-charcoal font-medium block">Dental Bridges</span>
          <span class="text-japandi-earth font-light">Fixed replacement for missing teeth</span>
        </a>
        <a href="/treatments/tooth-extraction" class="p-4 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 hover:border-japandi-moss transition-colors block space-y-1">
          <span class="font-serif text-sm text-japandi-charcoal font-medium block">Tooth Extraction</span>
          <span class="text-japandi-earth font-light">Comfortable removal of non-restorable teeth</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 9. Book / WhatsApp / Call -->
  <TreatmentActions treatmentName="Dentures Consultation" />
</Layout>
