---
import { CANONICAL_PRICES } from '../../data/prices';
import Layout from '../../layouts/Layout.astro';
import { generateBreadcrumbSchema, generateFaqSchema, generateTreatmentServiceSchema } from '../../utils/seoSchemas';
import TreatmentDepartmentCard from '../../components/TreatmentDepartmentCard.astro';
import TreatmentAftercare from '../../components/TreatmentAftercare.astro';
import TreatmentActions from '../../components/TreatmentActions.astro';

const pageTitle = "Dental Emergency Care Guide | Symptoms & Protocols | Aureva Dental";
const pageDescription = "Clinical guide to dental emergencies: what to do for severe toothache, knocked-out tooth, broken crown, swelling, urgent triage, and prices at Aureva Dental.";
const canonicalUrl = "https://aurevadental.com/treatments/emergency-dentist";
const phoneCallUrl = "tel:+917349701002";
const whatsappUrl = "https://wa.me/917349701002?text=EMERGENCY%3A%20I%20have%20an%20urgent%20dental%20emergency%20and%20need%20attention%20at%20Aureva%20Dental.";

const faqs = [
  {
    question: "How quickly should a dental emergency be treated?",
    answer: "Acute emergencies like a knocked-out permanent tooth should ideally be treated within 30 to 60 minutes for the highest chance of successful reimplantation. Severe toothaches and swelling should be seen the same day to prevent bacterial spread."
  },
  {
    question: "What should I do immediately if an adult tooth is completely knocked out?",
    answer: "Pick up the tooth by the smooth white crown only, never touching the root. If soiled, gently rinse with cold milk or saline without scrubbing. Attempt to gently place it back into its socket and bite softly on clean gauze. If unable to reinsert, place it in a container of cold milk and visit the clinic immediately."
  },
  {
    question: "What qualifies as an urgent dental emergency?",
    answer: "Urgent dental emergencies include acute, throbbing tooth pain that disrupts sleep, visible facial or gum swelling (abscess), knocked-out or loose permanent teeth from physical trauma, cracked teeth with exposed nerve tissue, and uncontrolled bleeding."
  },
  {
    question: "What is the cost of emergency dental care at Aureva Dental?",
    answer: `Emergency visits start with an initial consultation at ${CANONICAL_PRICES.consultation} (includes digital RVG X-ray). Specific treatments are priced transparently: temporary fillings are ${CANONICAL_PRICES.temporary_filling}, emergency pain-relief nerve dressings are ${CANONICAL_PRICES.emergency_pain_dressing}, incision and drainage is ${CANONICAL_PRICES.incision_drainage}, routine extractions are ${CANONICAL_PRICES.extraction_overall}, and root canal treatments range from ${CANONICAL_PRICES.rct_overall}. Prices are ranges, confirmed after examination.`
  }
];

const breadcrumbs = [
  { name: "Home", url: "https://aurevadental.com/" },
  { name: "Treatments", url: "https://aurevadental.com/#services" },
  { name: "Dental Emergency Guide", url: canonicalUrl }
];

const breadcrumbSchema = JSON.stringify(generateBreadcrumbSchema(breadcrumbs));
const faqSchema = JSON.stringify(generateFaqSchema(faqs));
const serviceSchema = JSON.stringify(generateTreatmentServiceSchema({
  name: "Dental Emergency Care Guide",
  description: pageDescription,
  url: canonicalUrl,
  medicalSpecialty: "Emergency Dental Service"
}));

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogUrl: canonicalUrl,
  schemaMarkup: [breadcrumbSchema, faqSchema, serviceSchema]
};
---

<Layout {...seoProps}>
  <!-- Breadcrumb Navigation -->
  <nav class="bg-japandi-sand/30 border-b border-japandi-clay/20 py-3.5 px-6 lg:px-24 text-xs font-light text-japandi-earth" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto flex items-center gap-2">
      <a href="/" class="hover:text-japandi-moss transition-colors">Home</a>
      <span>/</span>
      <a href="/#services" class="hover:text-japandi-moss transition-colors">Treatments</a>
      <span>/</span>
      <span class="text-japandi-charcoal font-medium">Emergency Care Guide</span>
    </div>
  </nav>

  <!-- 1. Hero / H1 Section -->
  <section class="py-16 md:py-24 px-6 lg:px-24 bg-transparent relative overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 flex flex-col items-start space-y-6 animate-slow-fade">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-red-200 bg-red-50 text-[10px] font-semibold text-red-700 uppercase tracking-widest">
          Clinical Emergency Protocol &bull; Aureva Dental
        </div>
        
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif text-japandi-charcoal leading-tight font-medium tracking-tight">
          Emergency Dental Care Guide
        </h1>

        <p class="text-base sm:text-lg text-japandi-earth font-light leading-relaxed max-w-2xl">
          Clinical guide to recognizing, triaging, and managing urgent dental emergencies. Learn what steps to take immediately for acute tooth pain, knocked-out teeth, facial swelling, and fractured restorations. Looking for same-day walk-in care in Hennur? See our <a href="/emergency-dentist-hennur" class="text-japandi-moss underline decoration-japandi-moss/50 hover:decoration-japandi-moss font-medium">Emergency Dentist in Hennur Bande</a> page.
        </p>

        <!-- Hours statement -->
        <div class="p-4 rounded-2xl bg-amber-50/70 border border-amber-200 text-xs text-japandi-charcoal space-y-1">
          <p class="font-medium">Emergencies are seen during normal clinic hours: Mon 4–9 PM, Tue–Sun 9:30 AM–9 PM. Walk-ins till 9 PM.</p>
        </div>

        <!-- Direct CTA Buttons -->
        <div class="pt-2 flex flex-wrap items-center gap-4 w-full sm:w-auto">
          <a 
            href={phoneCallUrl}
            class="inline-flex items-center justify-center gap-2 px-7 py-4 bg-red-700 text-white hover:bg-red-800 text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 shadow-md shadow-red-700/20 min-h-[48px]"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 shrink-0">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25z" />
            </svg>
            <span>Call Clinic: +91 73497 01002</span>
          </a>

          <a 
            href={whatsappUrl}
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-7 py-4 border border-japandi-clay hover:border-japandi-moss text-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 bg-japandi-sand/40 hover:bg-japandi-sand min-h-[48px]"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 24 24" class="w-4 h-4 text-emerald-600 shrink-0">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            <span>WhatsApp Emergency Alert</span>
          </a>
        </div>
      </div>

      <!-- Quick Triage Card -->
      <div class="lg:col-span-5 relative">
        <div class="p-8 rounded-3xl bg-japandi-sand/50 border border-japandi-clay/40 shadow-sm space-y-4">
          <span class="text-xs uppercase font-semibold text-red-700 tracking-widest block">Immediate Action Protocol</span>
          <h3 class="font-serif text-xl font-medium text-japandi-charcoal">Quick First-Aid Measures</h3>
          <ul class="space-y-3 text-xs font-light text-japandi-earth">
            <li class="flex items-start gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-red-600 mt-1.5 shrink-0"></span>
              <div><strong class="text-japandi-charcoal font-medium">Knocked-out tooth:</strong> Submerge in cold milk or saline. Do not let the root dry out. Seek treatment within 60 minutes.</div>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-red-600 mt-1.5 shrink-0"></span>
              <div><strong class="text-japandi-charcoal font-medium">Swelling or abscess:</strong> Apply an external cold compress. Do not place aspirin directly on the gums.</div>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-red-600 mt-1.5 shrink-0"></span>
              <div><strong class="text-japandi-charcoal font-medium">Lost filling or crown:</strong> Keep the area clean by gentle warm salt-water rinsing until seen.</div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Who It's For (Symptoms in Plain Words) -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Emergency Triage</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Who emergency dental care is for
        </h2>
      </div>
      <p class="text-sm sm:text-base text-japandi-earth font-light leading-relaxed">
        Immediate dental evaluation is recommended if you or a family member experience:
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm text-japandi-earth font-light">
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Acute, Throbbing Toothache</h3>
          <p>Intense, persistent tooth pain that radiates to the jaw, neck, or ear and disrupts sleeping or eating.</p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Facial or Gum Swelling</h3>
          <p>Puffy, tender swelling on the cheek, jawline, or gums indicating a localized bacterial infection or abscess.</p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Knocked-Out or Displaced Tooth</h3>
          <p>An adult tooth completely dislodged or shifted from its socket due to a sports injury, fall, or accident.</p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Broken Tooth or Lost Crown</h3>
          <p>A fractured cusp exposing sensitive dentin or pink pulp, or an unseated permanent dental crown.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. What Happens, Visit by Visit, & Number of Sittings -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-8">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Clinical Protocol</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          What happens during an emergency visit
        </h2>
        <p class="text-sm sm:text-base text-japandi-earth font-light mt-2">
          Emergency triage is typically completed in 1 sitting for immediate relief, with definitive restoration scheduled in 1 to 2 subsequent sittings if required.
        </p>
      </div>

      <div class="space-y-4 text-xs sm:text-sm text-japandi-earth font-light">
        <div class="p-6 rounded-2xl bg-japandi-sand/30 border border-japandi-clay/40 space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">Step 1: Rapid Triage &amp; Digital RVG Imaging</h3>
            <span class="text-[10px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded bg-japandi-moss/10 text-japandi-moss">Immediate</span>
          </div>
          <p class="leading-relaxed">
            The clinician conducts an urgent examination and takes low-radiation digital RVG X-rays to locate the infection source, root fracture, or nerve involvement.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-japandi-sand/30 border border-japandi-clay/40 space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">Step 2: Local Anaesthesia &amp; Pain Decompression</h3>
            <span class="text-[10px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded bg-japandi-moss/10 text-japandi-moss">Sitting 1</span>
          </div>
          <p class="leading-relaxed">
            Targeted local anaesthetic is administered to ensure comfort. Emergency treatment is performed to relieve pressure—such as pulpal extirpation, temporary dressing, or abscess drainage.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-japandi-sand/30 border border-japandi-clay/40 space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">Step 3: Stabilization &amp; Written Care Plan</h3>
            <span class="text-[10px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded bg-japandi-moss/10 text-japandi-moss">Sitting 1</span>
          </div>
          <p class="leading-relaxed">
            The tooth is stabilized with a temporary restoration. You receive prescriptions if necessary and a clear written plan outlining any follow-up steps (such as completing an RCT or placing a crown).
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Price Table from Keys -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Transparent Pricing</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Emergency treatment fees
        </h2>
        <p class="text-xs sm:text-sm text-japandi-earth font-light mt-1">
          Prices are ranges, confirmed after examination.
        </p>
      </div>

      <div class="rounded-2xl border border-japandi-clay/40 overflow-hidden bg-japandi-cream/90 shadow-sm">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-japandi-sand/60 text-japandi-charcoal font-serif border-b border-japandi-clay/30">
            <tr>
              <th class="py-3 px-4">Emergency Procedure</th>
              <th class="py-3 px-4">Price Range</th>
              <th class="py-3 px-4 hidden sm:table-cell">Notes</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-japandi-clay/20 text-japandi-earth font-light">
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">Emergency Consultation</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.consultation}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Includes clinical exam and digital RVG X-ray</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">Temporary Emergency Filling</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.temporary_filling}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Per tooth sedative dressing</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">Emergency Nerve Pain Dressing</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.emergency_pain_dressing}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Pulpal decompression for severe pain</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">Incision and Drainage</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.incision_drainage}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Abscess and infection drainage</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">Tooth Extraction (Simple)</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.extraction_simple}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Mobile or non-restorable tooth removal</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-xs text-japandi-earth font-light">
        See our full price index on the <a href="/prices" class="text-japandi-moss underline decoration-japandi-moss/40 hover:decoration-japandi-moss font-medium">treatment prices</a> page.
      </p>
    </div>
  </section>

  <!-- 5. Which Department Handles It -->
  <TreatmentDepartmentCard 
    department="Endodontics & Conservative Dentistry"
    link="/our-specialists#endodontics"
    description="Emergency pulpal decompressions, acute toothaches, and root canal therapy are managed by our visiting endodontists, while dental trauma and complex extractions are handled by our visiting oral and maxillofacial surgeons."
  />

  <!-- 6. Aftercare and When to Call Us -->
  <TreatmentAftercare 
    instructions={[
      "Take any prescribed antibiotics or pain relievers exactly according to the clinician's dosage instructions.",
      "Avoid chewing on the treated side until local numbness has completely worn off and definitive restoration is placed.",
      "Rinse gently with warm salt water starting 24 hours after an extraction or drainage procedure.",
      "Avoid hot, spicy, or crunchy foods for the first 24 to 48 hours."
    ]}
    whenToCall={[
      "Swelling increases or begins spreading toward your eye, neck, or throat.",
      "You develop a fever or experience difficulty swallowing or opening your mouth.",
      "A temporary filling or crown dislodges before your scheduled follow-up."
    ]}
  />

  <!-- 7. FAQs (with Schema) -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-8">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Common Questions</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Frequently asked questions
        </h2>
      </div>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <div class="bg-japandi-cream/90 border border-japandi-clay/40 rounded-2xl p-6 space-y-2">
            <h3 class="font-serif text-base sm:text-lg text-japandi-charcoal font-medium">
              {faq.question}
            </h3>
            <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. Related Treatments -->
  <section class="py-16 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <h2 class="text-xl sm:text-2xl font-serif text-japandi-charcoal font-medium">
        Related treatments
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
        <a href="/emergency-dentist-hennur" class="p-4 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 hover:border-japandi-moss transition-colors block space-y-1">
          <span class="font-serif text-sm text-japandi-charcoal font-medium block">Emergency Dentist Hennur</span>
          <span class="text-japandi-earth font-light">Walk-in emergency care in Hennur Bande</span>
        </a>
        <a href="/root-canal-treatment-hennur" class="p-4 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 hover:border-japandi-moss transition-colors block space-y-1">
          <span class="font-serif text-sm text-japandi-charcoal font-medium block">Root Canal Treatment</span>
          <span class="text-japandi-earth font-light">Definitive nerve infection relief</span>
        </a>
        <a href="/treatments/tooth-extraction" class="p-4 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 hover:border-japandi-moss transition-colors block space-y-1">
          <span class="font-serif text-sm text-japandi-charcoal font-medium block">Tooth Extraction</span>
          <span class="text-japandi-earth font-light">Safe removal of non-restorable teeth</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 9. Book / WhatsApp / Call -->
  <TreatmentActions treatmentName="Emergency Dental Consultation" />
</Layout>
