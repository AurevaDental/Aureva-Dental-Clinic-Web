---
import { CANONICAL_PRICES } from '../../data/prices';
import Layout from '../../layouts/Layout.astro';
import { generateBreadcrumbSchema, generateFaqSchema, generateTreatmentServiceSchema } from '../../utils/seoSchemas';
import TreatmentDepartmentCard from '../../components/TreatmentDepartmentCard.astro';
import TreatmentAftercare from '../../components/TreatmentAftercare.astro';
import TreatmentActions from '../../components/TreatmentActions.astro';

const pageTitle = "Teeth Cleaning & Scaling in Hennur Bangalore | Aureva Dental";
const pageDescription = "Gentle ultrasonic teeth cleaning, scaling & stain polishing in Hennur, Bangalore at Aureva Dental. Helps maintain healthy gums & refresh your breath. Call +91 73497 01002.";
const canonicalUrl = "https://aurevadental.com/treatments/scaling-and-polishing";
const phoneCallUrl = "tel:+917349701002";
const whatsappUrl = "https://wa.me/917349701002?text=Hello%2C%20I%20would%20like%20to%20book%20a%20Scaling%20and%20Polishing%20session%20at%20Aureva%20Dental.";

const faqs = [
  {
    question: "Does scaling weaken enamel or create gaps between teeth?",
    answer: "No, this is a common dental myth. Ultrasonic scaling uses high-frequency micro-vibrations and water spray where ultrasonic vibration breaks tartar off the tooth surface without scratching or eroding natural tooth enamel. The gaps patients sometimes feel after cleaning were previously packed with inflamed calculus deposits that caused gingival recession."
  },
  {
    question: "How often should I get professional scaling and polishing done?",
    answer: "Most dentists recommend a check-up and cleaning every 6 months. For patients undergoing orthodontic aligner treatment, smokers, or those with active periodontal gum disease, quarterly (every 3 to 4 months) hygiene reviews are advised."
  },
  {
    question: "Will my teeth be sensitive after the cleaning procedure?",
    answer: "Mild, transient sensitivity to cold water is common for 24 to 48 hours following removal of thick calculus sheets, especially if root surfaces were previously exposed. Applying a soothing desensitizing toothpaste helps relieve this quickly."
  },
  {
    question: "What is the difference between scaling and teeth whitening?",
    answer: "Scaling cleans the teeth by removing bacterial plaque, calcified tartar, and extrinsic surface stains caused by coffee, tea, and tobacco. Teeth whitening is a cosmetic bleaching treatment that penetrates deep inside enamel and dentin to lighten internal yellow discoloration by several shades."
  },
  {
    question: "What is the cost of teeth scaling and polishing in Hennur, Bangalore?",
    answer: `At Aureva Dental Hennur, routine ultrasonic scaling and prophy polishing ranges from ${CANONICAL_PRICES.scaling_routine}. Advanced deep subgingival scaling or periodontal root planing for heavy calculus and swollen bleeding gums ranges from ${CANONICAL_PRICES.scaling_deep} across all four quadrants.`
  }
];

const breadcrumbs = [
  { name: "Home", url: "https://aurevadental.com/" },
  { name: "Treatments", url: "https://aurevadental.com/#services" },
  { name: "Scaling & Polishing", url: canonicalUrl }
];

const breadcrumbSchema = JSON.stringify(generateBreadcrumbSchema(breadcrumbs));
const faqSchema = JSON.stringify(generateFaqSchema(faqs));
const serviceSchema = JSON.stringify(generateTreatmentServiceSchema({
  name: "Ultrasonic Scaling & Dental Polishing",
  description: pageDescription,
  url: canonicalUrl,
  medicalSpecialty: "Periodontics"
}));

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogUrl: canonicalUrl,
  schemaMarkup: [breadcrumbSchema, faqSchema, serviceSchema]
};
---

<Layout {...seoProps}>
  <!-- Breadcrumb Navigation -->
  <nav class="bg-japandi-sand/30 border-b border-japandi-clay/20 py-3.5 px-6 lg:px-24 text-xs font-light text-japandi-earth" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <a href="/" class="hover:text-japandi-moss transition-colors">Home</a>
        <span>/</span>
        <a href="/#services" class="hover:text-japandi-moss transition-colors">Treatments</a>
        <span>/</span>
        <span class="text-japandi-charcoal font-medium">Teeth Cleaning &amp; Scaling</span>
      </div>
      <a href="#pricing" class="inline-flex items-center gap-1 text-xs font-semibold text-japandi-moss hover:underline">
        Prices &darr;
      </a>
    </div>
  </nav>

  <!-- 1. Hero / H1 Section -->
  <section class="py-12 md:py-20 px-6 lg:px-24 bg-transparent relative overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-7 flex flex-col items-start space-y-4 animate-slow-fade">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-japandi-clay/60 bg-japandi-sand/70 text-[10px] font-semibold text-japandi-moss uppercase tracking-widest">
          Preventive Periodontics &bull; Hennur Bande, Bangalore
        </div>
        
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif text-japandi-charcoal leading-tight font-medium tracking-tight">
          Teeth Cleaning &amp; Scaling in Hennur
        </h1>

        <div class="w-full bg-japandi-sand/40 border border-japandi-clay/30 rounded-2xl p-3.5 space-y-1.5 text-xs text-japandi-earth">
          <p class="flex items-center gap-2 font-medium text-japandi-charcoal">
            <span>Hours: Mon 4–9 PM, Tue–Sun 9:30 AM–9 PM</span>
          </p>
          <p>2nd Floor, Horamavu Agara Road, near Nayara Petrol Bunk, Hennur Bande. Lift and parking available.</p>
        </div>

        <p class="text-sm sm:text-base text-japandi-earth font-light leading-relaxed max-w-2xl">
          Gentle ultrasonic scaling and prophy polishing to eliminate hardened calculus, plaque bio-films, and surface tea or coffee stains. Protect your gums and keep your breath fresh.
        </p>

        <!-- CTA Buttons -->
        <div class="pt-2 flex flex-wrap items-center gap-3 w-full sm:w-auto">
          <button 
            type="button"
            data-open-booking
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-japandi-moss text-japandi-cream hover:bg-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 shadow-sm"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
            </svg>
            <span>Book Cleaning Visit</span>
          </button>

          <a 
            href={phoneCallUrl}
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 border border-japandi-clay bg-japandi-sand/50 hover:bg-japandi-sand text-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-japandi-moss">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
            </svg>
            <span>Call: +91 73497 01002</span>
          </a>
        </div>
      </div>

      <!-- Quick Feature Card -->
      <div class="lg:col-span-5 relative">
        <div class="p-8 rounded-3xl bg-japandi-sand/50 border border-japandi-clay/40 shadow-sm space-y-4">
          <span class="text-xs uppercase font-semibold text-japandi-moss tracking-widest block">Preventive Care</span>
          <h3 class="font-serif text-xl font-medium text-japandi-charcoal">Why Cleanings Matter</h3>
          <ul class="space-y-3 text-xs font-light text-japandi-earth">
            <li class="flex items-start gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-japandi-moss mt-1.5 shrink-0"></span>
              <div><strong class="text-japandi-charcoal font-medium">Ultrasonic Precision:</strong> High-frequency vibrations safely dislodge calcified tartar without damaging enamel.</div>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-japandi-moss mt-1.5 shrink-0"></span>
              <div><strong class="text-japandi-charcoal font-medium">Stain Removal:</strong> Fine polishing paste removes external discolorations from coffee, tea, and food pigments.</div>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-japandi-moss mt-1.5 shrink-0"></span>
              <div><strong class="text-japandi-charcoal font-medium">Gum Health:</strong> Stops early gingivitis before it progresses to irreversible bone loss.</div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Who It's For (Symptoms in Plain Words) -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Indications</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Who teeth cleaning is for
        </h2>
      </div>
      <p class="text-sm sm:text-base text-japandi-earth font-light leading-relaxed">
        Professional scaling and polishing is recommended every 6 months for everyone, and specifically for:
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm text-japandi-earth font-light">
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Bleeding Gums</h3>
          <p>Gums that bleed when brushing or flossing, signalling bacterial accumulation and gingivitis.</p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Persistent Bad Breath</h3>
          <p>Chronic bad breath (halitosis) caused by sulfur-producing bacteria trapped in hard tartar.</p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Yellow Calculus Deposits</h3>
          <p>Hardened yellow, brown, or black mineral crusts visible behind the lower front teeth.</p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Surface Tea/Coffee Stains</h3>
          <p>External stains from everyday dietary habits that dull the natural brightness of your enamel.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. What Happens, Visit by Visit, & Number of Sittings -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-8">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Clinical Protocol</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          What happens, visit by visit
        </h2>
        <p class="text-sm sm:text-base text-japandi-earth font-light mt-2">
          Routine scaling and polishing is completed in 1 sitting (about 30 to 45 minutes). Severe periodontal disease may require 2 sittings for deep quadrant curettage.
        </p>
      </div>

      <div class="space-y-4 text-xs sm:text-sm text-japandi-earth font-light">
        <div class="p-6 rounded-2xl bg-japandi-sand/30 border border-japandi-clay/40 space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">Step 1: Periodontal Evaluation &amp; Ultrasonic Scaling</h3>
            <span class="text-[10px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded bg-japandi-moss/10 text-japandi-moss">Sitting 1</span>
          </div>
          <p class="leading-relaxed">
            The clinician inspects gum pocket depths and uses an ultrasonic scaler with cooling water spray to break down supragingival and subgingival tartar gently.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-japandi-sand/30 border border-japandi-clay/40 space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">Step 2: Prophy Polishing &amp; Fluoride Rinse</h3>
            <span class="text-[10px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded bg-japandi-moss/10 text-japandi-moss">Sitting 1</span>
          </div>
          <p class="leading-relaxed">
            A gentle rotating cup with fine polishing paste smooths enamel surfaces, removing micro-roughness and stains. A soothing desensitizing rinse is applied.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Price Table from Keys -->
  <section id="pricing" class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Transparent Pricing</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Teeth cleaning treatment fees
        </h2>
        <p class="text-xs sm:text-sm text-japandi-earth font-light mt-1">
          Prices are ranges, confirmed after examination.
        </p>
      </div>

      <div class="rounded-2xl border border-japandi-clay/40 overflow-hidden bg-japandi-cream/90 shadow-sm">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-japandi-sand/60 text-japandi-charcoal font-serif border-b border-japandi-clay/30">
            <tr>
              <th class="py-3 px-4">Procedure</th>
              <th class="py-3 px-4">Price Range</th>
              <th class="py-3 px-4 hidden sm:table-cell">Notes</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-japandi-clay/20 text-japandi-earth font-light">
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">Routine Scaling &amp; Polishing</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.scaling_routine}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Full mouth ultrasonic cleaning and polishing</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">Deep Scaling / Periodontal Curettage</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.scaling_deep}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Subgingival root planing for moderate to severe gum disease</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">Consultation with Digital X-Ray</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.consultation}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Valid for 6 months</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-xs text-japandi-earth font-light">
        See our complete pricing catalog on the <a href="/prices" class="text-japandi-moss underline decoration-japandi-moss/40 hover:decoration-japandi-moss font-medium">treatment prices</a> page.
      </p>
    </div>
  </section>

  <!-- 5. Which Department Handles It -->
  <TreatmentDepartmentCard 
    department="Periodontics & Implantology"
    link="/our-specialists#periodontics"
    description="Routine ultrasonic scaling, deep periodontal curettage, and gum health maintenance are managed by visiting MDS periodontists."
  />

  <!-- 6. Aftercare and When to Call Us -->
  <TreatmentAftercare 
    instructions={[
      "Brush teeth gently twice daily with a soft-bristled toothbrush, particularly along the gumline.",
      "Use a desensitizing or fluoridated toothpaste if you experience mild sensitivity to cold temperatures for a day or two.",
      "Floss daily to prevent plaque from calcifying into hard calculus between teeth.",
      "Avoid smoking or tobacco use, which heavily accelerates calculus formation and periodontal inflammation."
    ]}
    whenToCall={[
      "Gums bleed heavily or continuously more than 24 hours after a deep scaling procedure.",
      "You notice increasing swelling, heat, or throbbing pain in the gums.",
      "A tooth feels loose or painful when chewing."
    ]}
  />

  <!-- 7. FAQs (with Schema) -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-8">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Common Questions</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Frequently asked questions
        </h2>
      </div>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <div class="bg-japandi-cream/90 border border-japandi-clay/40 rounded-2xl p-6 space-y-2">
            <h3 class="font-serif text-base sm:text-lg text-japandi-charcoal font-medium">
              {faq.question}
            </h3>
            <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. Related Treatments -->
  <section class="py-16 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <h2 class="text-xl sm:text-2xl font-serif text-japandi-charcoal font-medium">
        Related treatments
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
        <a href="/gum-treatment-hennur" class="p-4 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 hover:border-japandi-moss transition-colors block space-y-1">
          <span class="font-serif text-sm text-japandi-charcoal font-medium block">Gum Treatment Hennur</span>
          <span class="text-japandi-earth font-light">Deep periodontal therapy and pocket care</span>
        </a>
        <a href="/teeth-whitening-hennur" class="p-4 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 hover:border-japandi-moss transition-colors block space-y-1">
          <span class="font-serif text-sm text-japandi-charcoal font-medium block">Teeth Whitening</span>
          <span class="text-japandi-earth font-light">Professional in-clinic teeth brightening</span>
        </a>
        <a href="/treatments/clear-aligners" class="p-4 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 hover:border-japandi-moss transition-colors block space-y-1">
          <span class="font-serif text-sm text-japandi-charcoal font-medium block">Clear Aligners</span>
          <span class="text-japandi-earth font-light">Straightening crowded teeth to ease hygiene</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 9. Book / WhatsApp / Call -->
  <TreatmentActions treatmentName="Scaling & Polishing Consultation" />
</Layout>
