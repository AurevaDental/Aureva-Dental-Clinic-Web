---
import Layout from '../../layouts/Layout.astro';
import { generateBreadcrumbSchema, generateFaqSchema, generateTreatmentServiceSchema } from '../../utils/seoSchemas';
import { CANONICAL_PRICES } from '../../data/prices';
import TreatmentDepartmentCard from '../../components/TreatmentDepartmentCard.astro';
import TreatmentAftercare from '../../components/TreatmentAftercare.astro';
import TreatmentActions from '../../components/TreatmentActions.astro';

const pageTitle = "Kids Dentist in Hennur Bangalore | Aureva Dental";
const pageDescription = "Gentle kids dentist in Hennur, Bangalore at Aureva Dental. Child-friendly pediatric dentistry, cavity prevention, fluoride & gentle care. Call +91 73497 01002.";
const canonicalUrl = "https://aurevadental.com/treatments/pediatric-dentistry";
const phoneCallUrl = "tel:+917349701002";
const whatsappUrl = "https://wa.me/917349701002?text=Hello%2C%20I%20would%20like%20to%20consult%20for%20Kids%20Dentistry%20at%20Aureva%20Dental.";

const faqs = [
  {
    question: "At what age should my child first visit the dentist?",
    answer: "The Indian Dental Association (IDA) and pediatric dental academies recommend bringing your child for their first check-up when their first baby tooth erupts or by their first birthday. Early visits normalize the dental clinic environment, establish proper oral hygiene habits, and detect early enamel demineralization before cavities develop."
  },
  {
    question: "How do you help children who have dental anxiety or fear?",
    answer: "Our Japandi studio is intentionally designed without scary medical odors or loud hospital noise. We practice 'Tell-Show-Do' communication, introduce dental instruments as fun, friendly tools, and maintain an unhurried, compassionate pace. Kids receive gentle care without intimidation."
  },
  {
    question: "What are pit and fissure sealants and why are they recommended?",
    answer: "Pit and fissure sealants are protective, biocompatible tooth-colored coatings painted into the deep chewing grooves of your child's adult back molars. Sealants help protect the grooves of back teeth from cavities during the critical cavity-prone elementary school years."
  },
  {
    question: "What is the cost of pediatric dental treatments at Aureva Dental?",
    answer: `Kids' consultations are ${CANONICAL_PRICES.kids_checkup}. Preventive fluoride varnishes range between ${CANONICAL_PRICES.kids_fluoride}. Pit and fissure sealants cost ${CANONICAL_PRICES.kids_sealant}. Tooth fillings are ${CANONICAL_PRICES.kids_filling}. Complete cost outlines are provided upfront to parents before any treatment begins.`
  }
];

const breadcrumbs = [
  { name: "Home", url: "https://aurevadental.com/" },
  { name: "Treatments", url: "https://aurevadental.com/#services" },
  { name: "Pediatric Dentistry", url: canonicalUrl }
];

const breadcrumbSchema = JSON.stringify(generateBreadcrumbSchema(breadcrumbs));
const faqSchema = JSON.stringify(generateFaqSchema(faqs));
const serviceSchema = JSON.stringify(generateTreatmentServiceSchema({
  name: "Pediatric & Kids Dentistry",
  description: pageDescription,
  url: canonicalUrl,
  medicalSpecialty: "PediatricDentistry"
}));

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  keywords: "pediatric dentist hennur, kids dentistry bangalore, children dental clinic, pit and fissure sealants, fluoride treatment kids, pediatric dentist near me",
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogUrl: canonicalUrl,
  schemaMarkup: [breadcrumbSchema, faqSchema, serviceSchema]
};
---

<Layout {...seoProps}>
  <!-- Breadcrumb Navigation -->
  <nav class="bg-japandi-sand/30 border-b border-japandi-clay/20 py-3.5 px-6 lg:px-24 text-xs font-light text-japandi-earth" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <a href="/" class="hover:text-japandi-moss transition-colors">Home</a>
        <span>/</span>
        <a href="/#services" class="hover:text-japandi-moss transition-colors">Treatments</a>
        <span>/</span>
        <span class="text-japandi-charcoal font-medium">Pediatric Dentistry</span>
      </div>
      <a href="#pricing" class="inline-flex items-center gap-1 text-xs font-semibold text-japandi-moss hover:underline">
        Prices &darr;
      </a>
    </div>
  </nav>

  <!-- 1. Hero / H1 Section -->
  <section class="py-12 md:py-20 px-6 lg:px-24 bg-transparent relative overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-7 flex flex-col items-start space-y-4 animate-slow-fade">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-japandi-clay/60 bg-japandi-sand/70 text-[10px] font-semibold text-japandi-moss uppercase tracking-widest">
          Gentle Child Care &bull; Hennur, Bangalore
        </div>
        
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif text-japandi-charcoal leading-tight font-medium tracking-tight">
          Pediatric Dentistry in Hennur
        </h1>

        <div class="w-full bg-japandi-sand/40 border border-japandi-clay/30 rounded-2xl p-3.5 space-y-1.5 text-xs text-japandi-earth">
          <p class="flex items-center gap-2 font-medium text-japandi-charcoal">
            <span>Hours: Mon 4–9 PM, Tue–Sun 9:30 AM–9 PM</span>
          </p>
          <p>2nd Floor, Horamavu Agara Road, near Nayara Petrol Bunk, Hennur Bande. Lift and parking available.</p>
        </div>

        <p class="text-sm sm:text-base text-japandi-earth font-light leading-relaxed max-w-2xl">
          Nurturing healthy childhood smiles through kindness, patience, and prevention. Our calm clinic setting transforms dental checkups into positive, comfortable experiences for toddlers, children, and teens.
        </p>

        <!-- CTA Buttons -->
        <div class="pt-2 flex flex-wrap items-center gap-3 w-full sm:w-auto">
          <button 
            type="button"
            data-open-booking
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-japandi-moss text-japandi-cream hover:bg-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 shadow-sm"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
            </svg>
            <span>Book Child Visit</span>
          </button>

          <a 
            href={phoneCallUrl}
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 border border-japandi-clay bg-japandi-sand/50 hover:bg-japandi-sand text-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-japandi-moss">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
            </svg>
            <span>Call: +91 73497 01002</span>
          </a>
        </div>
      </div>

      <!-- Quick Feature Card -->
      <div class="lg:col-span-5 relative">
        <div class="p-8 rounded-3xl bg-japandi-sand/50 border border-japandi-clay/40 shadow-sm space-y-4">
          <span class="text-xs uppercase font-semibold text-japandi-moss tracking-widest block">Child-Centred Care</span>
          <h3 class="font-serif text-xl font-medium text-japandi-charcoal">Child-Friendly Dentistry</h3>
          <ul class="space-y-3 text-xs font-light text-japandi-earth">
            <li class="flex items-start gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-japandi-moss mt-1.5 shrink-0"></span>
              <div><strong class="text-japandi-charcoal font-medium">Tell-Show-Do Method:</strong> Explaining and demonstrating procedures playfully before gentle treatment.</div>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-japandi-moss mt-1.5 shrink-0"></span>
              <div><strong class="text-japandi-charcoal font-medium">Preventive Fluoride &amp; Sealants:</strong> Strengthening enamel and sealing deep grooves to prevent cavities.</div>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-japandi-moss mt-1.5 shrink-0"></span>
              <div><strong class="text-japandi-charcoal font-medium">Visiting Pedodontist:</strong> Specialist pediatric dental care tailored to developing jaws.</div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Who It's For (Symptoms in Plain Words) -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Young Patients</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Who pediatric dentistry is for
        </h2>
      </div>
      <p class="text-sm sm:text-base text-japandi-earth font-light leading-relaxed">
        We care for infants, toddlers, children, and young teenagers with:
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm text-japandi-earth font-light">
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">First Dental Visits</h3>
          <p>Infants and toddlers reaching their first birthday or getting their first primary teeth.</p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Tooth Pain or Food Lodging</h3>
          <p>Children complaining of tooth sensitivity, discomfort when eating sweets, or trapped food.</p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Cavity Prevention</h3>
          <p>Deep chewing grooves in newly erupted permanent molars that require protective sealants.</p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Dental Trauma</h3>
          <p>Chipped or displaced teeth resulting from playground falls, cycling accidents, or sports.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. What Happens, Visit by Visit, & Number of Sittings -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-8">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Clinical Protocol</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          What happens, visit by visit
        </h2>
        <p class="text-sm sm:text-base text-japandi-earth font-light mt-2">
          Routine checkups and preventive fluoride applications take 1 sitting. Restorations or pulpal care are completed in 1 to 2 sittings.
        </p>
      </div>

      <div class="space-y-4 text-xs sm:text-sm text-japandi-earth font-light">
        <div class="p-6 rounded-2xl bg-japandi-sand/30 border border-japandi-clay/40 space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">Visit 1: Gentle Introduction &amp; Examination</h3>
            <span class="text-[10px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded bg-japandi-moss/10 text-japandi-moss">Sitting 1</span>
          </div>
          <p class="leading-relaxed">
            The pedodontist meets your child, counts their teeth using a small dental mirror, examines bite development, and discusses brushing habits with parents.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-japandi-sand/30 border border-japandi-clay/40 space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">Preventive Care: Fluoride &amp; Sealants</h3>
            <span class="text-[10px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded bg-japandi-moss/10 text-japandi-moss">Same Visit or Sitting 2</span>
          </div>
          <p class="leading-relaxed">
            Biocompatible fluoride varnish or resin pit-and-fissure sealants are brushed onto cleaned enamel to safeguard against decay.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Price Table from Keys -->
  <section id="pricing" class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Transparent Pricing</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Pediatric dental fees
        </h2>
        <p class="text-xs sm:text-sm text-japandi-earth font-light mt-1">
          Prices are ranges, confirmed after examination.
        </p>
      </div>

      <div class="rounded-2xl border border-japandi-clay/40 overflow-hidden bg-japandi-cream/90 shadow-sm">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-japandi-sand/60 text-japandi-charcoal font-serif border-b border-japandi-clay/30">
            <tr>
              <th class="py-3 px-4">Treatment</th>
              <th class="py-3 px-4">Price Range</th>
              <th class="py-3 px-4 hidden sm:table-cell">Notes</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-japandi-clay/20 text-japandi-earth font-light">
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">Child Dental Checkup</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.kids_checkup}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Exam and oral hygiene coaching</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">Fluoride Varnish Application</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.kids_fluoride}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Enamel remineralization</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">Pit and Fissure Sealant</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.kids_sealant}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Per tooth protective barrier</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">Child Tooth Filling</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.kids_filling}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Tooth-colored filling for primary teeth</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">Consultation with Digital X-Ray</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.consultation}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Valid for 6 months</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-xs text-japandi-earth font-light">
        See our complete pricing catalog on the <a href="/prices" class="text-japandi-moss underline decoration-japandi-moss/40 hover:decoration-japandi-moss font-medium">treatment prices</a> page.
      </p>
    </div>
  </section>

  <!-- 5. Which Department Handles It -->
  <TreatmentDepartmentCard 
    department="Paediatric & Preventive Dentistry"
    link="/our-specialists#pediatric"
    description="Child checkups, fluoride applications, pit and fissure sealants, and gentle primary tooth restorations are provided by our visiting MDS Pedodontists."
  />

  <!-- 6. Aftercare and When to Call Us -->
  <TreatmentAftercare 
    instructions={[
      "Supervise brushing twice daily using an age-appropriate soft toothbrush and a pea-sized amount of fluoride toothpaste.",
      "If fluoride varnish was applied, avoid hot drinks and hard or crunchy foods for 4 to 6 hours to allow full absorption.",
      "Limit sticky sweets, fruit candies, and sodas between meals.",
      "Schedule routine dental checkups every 6 months to monitor tooth eruption and jaw development."
    ]}
    whenToCall={[
      "Your child complains of persistent or throbbing toothache that disturbs sleep.",
      "There is visible swelling on the gums, cheek, or lip.",
      "A primary or adult tooth is damaged or loosened during a fall or sports collision."
    ]}
  />

  <!-- 7. FAQs (with Schema) -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-8">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Common Questions</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Frequently asked questions
        </h2>
      </div>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <div class="bg-japandi-cream/90 border border-japandi-clay/40 rounded-2xl p-6 space-y-2">
            <h3 class="font-serif text-base sm:text-lg text-japandi-charcoal font-medium">
              {faq.question}
            </h3>
            <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. Related Treatments -->
  <section class="py-16 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <h2 class="text-xl sm:text-2xl font-serif text-japandi-charcoal font-medium">
        Related treatments
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
        <a href="/treatments/scaling-and-polishing" class="p-4 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 hover:border-japandi-moss transition-colors block space-y-1">
          <span class="font-serif text-sm text-japandi-charcoal font-medium block">Scaling &amp; Polishing</span>
          <span class="text-japandi-earth font-light">Routine teeth cleaning and tartar removal</span>
        </a>
        <a href="/treatments/clear-aligners" class="p-4 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 hover:border-japandi-moss transition-colors block space-y-1">
          <span class="font-serif text-sm text-japandi-charcoal font-medium block">Clear Aligners</span>
          <span class="text-japandi-earth font-light">Discreet orthodontic alignment for teens</span>
        </a>
        <a href="/treatments/emergency-dentist" class="p-4 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 hover:border-japandi-moss transition-colors block space-y-1">
          <span class="font-serif text-sm text-japandi-charcoal font-medium block">Emergency Dentist</span>
          <span class="text-japandi-earth font-light">Urgent care for dental trauma and pain</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 9. Book / WhatsApp / Call -->
  <TreatmentActions treatmentName="Pediatric Dental Consultation" />
</Layout>
