---
import { CANONICAL_PRICES } from '../../data/prices';
import Layout from '../../layouts/Layout.astro';
import { generateBreadcrumbSchema, generateFaqSchema, generateTreatmentServiceSchema } from '../../utils/seoSchemas';
import TreatmentDepartmentCard from '../../components/TreatmentDepartmentCard.astro';
import TreatmentAftercare from '../../components/TreatmentAftercare.astro';
import TreatmentActions from '../../components/TreatmentActions.astro';

const pageTitle = "Dental Implants Guide | Types, Steps & Costs | Aureva Dental";
const pageDescription = "Complete guide to dental implants: single implants, implant-supported bridges, full-arch All-on-4/6, surgical steps, aftercare, and transparent pricing in Bangalore.";
const canonicalUrl = "https://aurevadental.com/treatments/dental-implants";
const phoneCallUrl = "tel:+917349701002";
const whatsappUrl = "https://wa.me/917349701002?text=Hello%2C%20I%20would%20like%20to%20consult%20about%20Dental%20Implants%20at%20Aureva%20Dental.";

const faqs = [
  {
    question: "How long do dental implants last?",
    answer: "With routine oral hygiene and regular dental check-ups, dental implants provide a reliable, long-term solution. The biocompatible titanium or zirconia post fuses directly with your living jawbone through osseointegration to support a stable crown."
  },
  {
    question: "Is dental implant surgery painful?",
    answer: "No. The procedure is performed under precise local anesthesia, ensuring complete numbness throughout placement. Most patients report that implant placement involves less post-operative discomfort than a standard tooth extraction, manageable with mild pain relief for 1–2 days."
  },
  {
    question: "What is the difference between titanium and zirconia implants?",
    answer: "Titanium implants are the gold standard with over 50 years of clinical evidence, offering immense tensile strength and rapid osseointegration. Zirconia implants are fully ceramic and metal-free, making them ideal for patients with metal sensitivities or thin gum biotypes where complete ceramic aesthetics are prioritized."
  },
  {
    question: "What is the cost of dental implants at Aureva Dental in Bangalore?",
    answer: `At Aureva Dental, single dental implant fixtures range from ${CANONICAL_PRICES.implant_single_fixture} depending on the implant brand system and surgical requirements. An implant with a custom lab-milled zirconia crown ranges between ${CANONICAL_PRICES.implant_with_crown}. Full-mouth rehabilitations start from ${CANONICAL_PRICES.full_mouth_implants_from}. Prices are ranges, confirmed after examination.`
  }
];

const breadcrumbs = [
  { name: "Home", url: "https://aurevadental.com/" },
  { name: "Treatments", url: "https://aurevadental.com/#services" },
  { name: "Dental Implants Guide", url: canonicalUrl }
];

const breadcrumbSchema = JSON.stringify(generateBreadcrumbSchema(breadcrumbs));
const faqSchema = JSON.stringify(generateFaqSchema(faqs));
const serviceSchema = JSON.stringify(generateTreatmentServiceSchema({
  name: "Dental Implants Clinical Guide",
  description: pageDescription,
  url: canonicalUrl,
  medicalSpecialty: "OralSurgery",
  isSurgical: true
}));

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogUrl: canonicalUrl,
  schemaMarkup: [breadcrumbSchema, faqSchema, serviceSchema]
};
---

<Layout {...seoProps}>
  <!-- Breadcrumb Navigation -->
  <nav class="bg-japandi-sand/30 border-b border-japandi-clay/20 py-3.5 px-6 lg:px-24 text-xs font-light text-japandi-earth" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto flex items-center gap-2">
      <a href="/" class="hover:text-japandi-moss transition-colors">Home</a>
      <span>/</span>
      <a href="/#services" class="hover:text-japandi-moss transition-colors">Treatments</a>
      <span>/</span>
      <span class="text-japandi-charcoal font-medium">Dental Implants Guide</span>
    </div>
  </nav>

  <!-- 1. Hero / H1 Section -->
  <section class="py-16 md:py-24 px-6 lg:px-24 bg-transparent relative overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 flex flex-col items-start space-y-6 animate-slow-fade">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-japandi-clay/60 bg-japandi-sand/70 text-[10px] font-semibold text-japandi-moss uppercase tracking-widest">
          Clinical Implantology Guide &bull; Aureva Dental
        </div>
        
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif text-japandi-charcoal leading-tight font-medium tracking-tight">
          Dental Implants: Complete Clinical Guide
        </h1>

        <p class="text-base sm:text-lg text-japandi-earth font-light leading-relaxed max-w-2xl">
          An in-depth guide to fixed tooth replacement with biocompatible titanium and zirconia dental implants. Learn about bone osseointegration, single and multi-unit solutions, and surgical recovery protocols. Looking specifically for local clinic visits in Hennur Bande? See our <a href="/dental-implants-hennur" class="text-japandi-moss underline decoration-japandi-moss/50 hover:decoration-japandi-moss font-medium">Dental Implants in Hennur Bande</a> page.
        </p>

        <!-- CTA Action Buttons -->
        <div class="pt-2 flex flex-wrap items-center gap-4 w-full sm:w-auto">
          <button 
            type="button"
            data-open-booking
            class="inline-flex items-center justify-center gap-2 px-7 py-4 bg-japandi-moss text-japandi-cream hover:bg-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 shadow-md shadow-japandi-moss/15 cursor-none"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
            </svg>
            <span>Book Implant Consultation</span>
          </button>

          <a 
            href={phoneCallUrl}
            class="inline-flex items-center justify-center gap-2 px-7 py-4 border border-japandi-clay bg-japandi-sand/50 hover:bg-japandi-sand text-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 cursor-none"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-japandi-moss">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
            </svg>
            <span>Call +91 73497 01002</span>
          </a>
        </div>
      </div>

      <!-- Quick Highlights Card -->
      <div class="lg:col-span-5 animate-slow-fade">
        <div class="bg-japandi-sand/60 border border-japandi-clay/50 rounded-[2.5rem] p-8 sm:p-10 shadow-lg shadow-japandi-charcoal/5 relative">
          <h3 class="text-xl font-serif text-japandi-charcoal font-medium mb-4">Biological Implant Principles</h3>
          <ul class="space-y-4 text-xs sm:text-sm text-japandi-earth font-light">
            <li class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-japandi-moss/15 text-japandi-moss flex items-center justify-center shrink-0 mt-0.5 font-semibold text-[10px]">&check;</div>
              <div><strong class="text-japandi-charcoal font-medium">Osseointegration:</strong> Biocompatible post fuses directly with jawbone, mimicking a natural root.</div>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-japandi-moss/15 text-japandi-moss flex items-center justify-center shrink-0 mt-0.5 font-semibold text-[10px]">&check;</div>
              <div><strong class="text-japandi-charcoal font-medium">Bone Preservation:</strong> Chewing forces stimulate alveolar bone, helping prevent facial bone shrinkage.</div>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-japandi-moss/15 text-japandi-moss flex items-center justify-center shrink-0 mt-0.5 font-semibold text-[10px]">&check;</div>
              <div><strong class="text-japandi-charcoal font-medium">Adjacent Tooth Protection:</strong> Unlike bridges, no filing down of healthy neighbouring teeth is needed.</div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Who It's For (Symptoms in Plain Words) -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Clinical Candidacy</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Who dental implants are for
        </h2>
      </div>
      <p class="text-sm sm:text-base text-japandi-earth font-light leading-relaxed">
        Dental implants are the clinically recommended solution if you experience any of the following situations:
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm text-japandi-earth font-light">
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Missing One or More Teeth</h3>
          <p>You have gaps in your smile from extractions, severe decay, or sports injuries and want a permanently fixed tooth replacement.</p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Difficulty Chewing Food</h3>
          <p>You avoid hard or fibrous foods because chewing on empty gum ridges or broken molars causes strain and discomfort.</p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Loose, Slipping Dentures</h3>
          <p>Your removable partial or complete denture moves while speaking or eating, creating gum irritation and insecurity.</p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Severely Fractured Tooth</h3>
          <p>A root has split vertically or suffered extensive subgingival damage where root canal treatment cannot restore structural integrity.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. What Happens, Visit by Visit, & Number of Sittings -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-8">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Step-by-Step Pathway</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          What happens, visit by visit
        </h2>
        <p class="text-sm sm:text-base text-japandi-earth font-light mt-2 leading-relaxed">
          Dental implant treatment typically requires 3 to 4 clinical sittings spanning 8 to 12 weeks for biological bone integration.
        </p>
      </div>

      <div class="space-y-4 text-xs sm:text-sm text-japandi-earth font-light">
        <div class="p-6 rounded-2xl bg-japandi-sand/55 border border-japandi-clay/50 space-y-2">
          <div class="flex items-center gap-3">
            <span class="w-7 h-7 rounded-full bg-japandi-moss text-japandi-cream text-xs font-bold flex items-center justify-center shrink-0">1</span>
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">Sitting 1: Examination, Digital RVG Mapping &amp; Written Plan</h3>
          </div>
          <p class="leading-relaxed pl-10">
            We evaluate bone height, nerve proximity, and gum thickness with digital radiography. You receive an itemized written treatment plan with prices valid for 6 months.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-japandi-sand/55 border border-japandi-clay/50 space-y-2">
          <div class="flex items-center gap-3">
            <span class="w-7 h-7 rounded-full bg-japandi-moss text-japandi-cream text-xs font-bold flex items-center justify-center shrink-0">2</span>
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">Sitting 2: Guided Implant Placement Under Local Anaesthesia</h3>
          </div>
          <p class="leading-relaxed pl-10">
            The treatment area is numbed completely with gentle local anaesthesia. The medical-grade titanium or zirconia fixture is placed into the jawbone with keyhole depth control. Dissolvable sutures are placed if required.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-japandi-sand/55 border border-japandi-clay/50 space-y-2">
          <div class="flex items-center gap-3">
            <span class="w-7 h-7 rounded-full bg-japandi-moss text-japandi-cream text-xs font-bold flex items-center justify-center shrink-0">3</span>
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">Sitting 3 (8–12 Weeks Later): Osseointegration Check &amp; 3D Scan</h3>
          </div>
          <p class="leading-relaxed pl-10">
            Once biological osseointegration is confirmed on X-ray, an intraoral digital 3D impression is captured to mill your custom monolithic zirconia crown.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-japandi-sand/55 border border-japandi-clay/50 space-y-2">
          <div class="flex items-center gap-3">
            <span class="w-7 h-7 rounded-full bg-japandi-moss text-japandi-cream text-xs font-bold flex items-center justify-center shrink-0">4</span>
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">Sitting 4: Crown Delivery &amp; Final Bite Calibration</h3>
          </div>
          <p class="leading-relaxed pl-10">
            Your lab-milled zirconia crown is securely torqued and checked against your opposing bite. You receive complete chewing function and lifelong maintenance advice.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Price Table From Keys -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-8">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Transparent Pricing</span>
        <h2 class="text-2xl sm:text-3xl font-serif text-japandi-charcoal font-medium">
          Dental implant treatment prices
        </h2>
        <p class="text-xs sm:text-sm text-japandi-earth font-light mt-1">
          The price depends on the implant brand (we place Nobel Biocare, Straumann and other systems) and on the case; a single implant is {CANONICAL_PRICES.implant_single_fixture}.
        </p>
      </div>

      <div class="bg-japandi-sand/40 border border-japandi-clay/50 rounded-2xl overflow-hidden shadow-sm">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-japandi-sand/80 text-japandi-earth uppercase text-[10px] tracking-wider border-b border-japandi-clay/30">
            <tr>
              <th scope="col" class="py-3 px-6 font-semibold w-2/3">Implant Procedure</th>
              <th scope="col" class="py-3 px-6 font-semibold w-1/3">Price Range</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-japandi-clay/20 text-japandi-charcoal font-light">
            <tr class="hover:bg-japandi-sand/60">
              <td class="py-3.5 px-6 font-medium">New Patient Consultation &amp; Digital RVG</td>
              <td class="py-3.5 px-6 font-semibold text-japandi-moss">{CANONICAL_PRICES.consultation}</td>
            </tr>
            <tr class="hover:bg-japandi-sand/60">
              <td class="py-3.5 px-6 font-medium">Single Dental Implant Fixture</td>
              <td class="py-3.5 px-6 font-semibold text-japandi-moss">{CANONICAL_PRICES.implant_single_fixture}</td>
            </tr>
            <tr class="hover:bg-japandi-sand/60">
              <td class="py-3.5 px-6 font-medium">Dental Implant with Custom Crown</td>
              <td class="py-3.5 px-6 font-semibold text-japandi-moss">{CANONICAL_PRICES.implant_with_crown}</td>
            </tr>
            <tr class="hover:bg-japandi-sand/60">
              <td class="py-3.5 px-6 font-medium">Full Mouth Implants (Per Arch)</td>
              <td class="py-3.5 px-6 font-semibold text-japandi-moss">{CANONICAL_PRICES.full_mouth_implants_from}</td>
            </tr>
            <tr class="hover:bg-japandi-sand/60">
              <td class="py-3.5 px-6 font-medium">All-on-4 Full Arch Restoration</td>
              <td class="py-3.5 px-6 font-semibold text-japandi-moss">{CANONICAL_PRICES.all_on_4}</td>
            </tr>
            <tr class="hover:bg-japandi-sand/60">
              <td class="py-3.5 px-6 font-medium">All-on-6 Full Arch Restoration</td>
              <td class="py-3.5 px-6 font-semibold text-japandi-moss">{CANONICAL_PRICES.all_on_6}</td>
            </tr>
            <tr class="hover:bg-japandi-sand/60">
              <td class="py-3.5 px-6 font-medium">Bone Grafting (When Required)</td>
              <td class="py-3.5 px-6 font-semibold text-japandi-moss">{CANONICAL_PRICES.bone_graft}</td>
            </tr>
            <tr class="hover:bg-japandi-sand/60">
              <td class="py-3.5 px-6 font-medium">Sinus Lift Augmentation (When Required)</td>
              <td class="py-3.5 px-6 font-semibold text-japandi-moss">{CANONICAL_PRICES.sinus_lift}</td>
            </tr>
            <tr class="hover:bg-japandi-sand/60">
              <td class="py-3.5 px-6 font-medium">PRP / PRF Biological Healing Therapy</td>
              <td class="py-3.5 px-6 font-semibold text-japandi-moss">{CANONICAL_PRICES.prp_prf}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="p-5 rounded-2xl bg-japandi-sand/50 border border-japandi-clay/40 text-center space-y-2">
        <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
          Prices are ranges, confirmed after examination. Itemized written plans valid for 6 months. Flexible EMI options available via major bank cards.
        </p>
      </div>
    </div>
  </section>

  <!-- 5. Which Department Handles It -->
  <TreatmentDepartmentCard 
    department="Oral and Maxillofacial Surgery and Prosthodontics" 
    description="Implant surgery and bone regeneration are planned and performed by visiting Oral and Maxillofacial Surgeons, while permanent custom abutments and zirconia crowns are designed by visiting Prosthodontists."
  />

  <!-- 6. Aftercare and When to Call Us -->
  <TreatmentAftercare 
    aftercare={[
      "Bite firmly on the sterile gauze pack placed over the implant site for 45 minutes to encourage stable clot formation.",
      "Avoid spitting, vigorous rinsing, or drinking through straws for the first 24 hours to prevent dislodging the blood clot.",
      "Stick to a soft, cool diet (yogurt, smoothies, soft rice, khichdi) for the first 2 to 3 days; avoid chewing directly on the implant site.",
      "Take prescribed analgesics and antibiotic medications exactly as directed with meals.",
      "Begin gentle warm salt-water rinses after 24 hours to keep the surgical area clean."
    ]}
    whenToCall={[
      "Active bleeding that continuously pools in your mouth and does not stop after 45 minutes of firm biting on gauze.",
      "Severe throbbing discomfort that is not relieved by the prescribed pain medication.",
      "Noticeable facial swelling that progressively worsens after 48 hours.",
      "An unexpected fever above 100.4°F (38°C) or persistent numbness in the chin or lip."
    ]}
  />

  <!-- 7. FAQs (with Schema) -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/20 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-8">
      <div>
        <h2 class="text-2xl sm:text-3xl font-serif text-japandi-charcoal font-medium">
          Frequently asked questions about dental implants
        </h2>
      </div>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <div class="p-6 rounded-2xl bg-japandi-sand/60 border border-japandi-clay/50 space-y-2">
            <h3 class="text-sm sm:text-base font-serif font-medium text-japandi-charcoal">
              {faq.question}
            </h3>
            <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. Related Treatments -->
  <section class="py-12 md:py-16 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <div class="space-y-1">
        <h3 class="text-lg font-serif font-medium text-japandi-charcoal">Related treatments &amp; local care</h3>
        <p class="text-xs text-japandi-earth font-light">Explore associated restorative and surgical dental options:</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs font-light">
        <a href="/dental-implants-hennur" class="p-4 rounded-2xl bg-japandi-sand/50 border border-japandi-clay/40 hover:border-japandi-moss transition-all group">
          <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-1">Hennur Implant Guide &rarr;</span>
          <span class="text-japandi-earth text-[11px]">Local clinic visits, transit directions &amp; consultations in Hennur Bande.</span>
        </a>
        <a href="/root-canal-treatment-hennur" class="p-4 rounded-2xl bg-japandi-sand/50 border border-japandi-clay/40 hover:border-japandi-moss transition-all group">
          <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-1">Root Canal Treatment &rarr;</span>
          <span class="text-japandi-earth text-[11px]">Save restorable natural teeth with gentle rotary endodontics.</span>
        </a>
        <a href="/dental-crowns-hennur" class="p-4 rounded-2xl bg-japandi-sand/50 border border-japandi-clay/40 hover:border-japandi-moss transition-all group">
          <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-1">Dental Crowns &rarr;</span>
          <span class="text-japandi-earth text-[11px]">Custom lab-milled zirconia, ceramic, and E-max crowns.</span>
        </a>
        <a href="/treatments/dentures" class="p-4 rounded-2xl bg-japandi-sand/50 border border-japandi-clay/40 hover:border-japandi-moss transition-all group">
          <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-1">Custom Dentures &rarr;</span>
          <span class="text-japandi-earth text-[11px]">Complete, partial, and implant-supported overdentures.</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 9. Book / WhatsApp / Call Buttons -->
  <TreatmentActions treatmentName="Dental Implants" />
</Layout>
