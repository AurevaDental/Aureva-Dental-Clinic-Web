---
import { CANONICAL_PRICES } from '../../data/prices';
import Layout from '../../layouts/Layout.astro';
import { generateBreadcrumbSchema, generateFaqSchema, generateTreatmentServiceSchema } from '../../utils/seoSchemas';
import TreatmentDepartmentCard from '../../components/TreatmentDepartmentCard.astro';
import TreatmentAftercare from '../../components/TreatmentAftercare.astro';
import TreatmentActions from '../../components/TreatmentActions.astro';

const pageTitle = "Digital Smile Makeover in Bangalore | Porcelain Veneers | Aureva Dental";
const pageDescription = "Digital Smile Design, porcelain veneers & aesthetic bonding in Bangalore at Aureva Dental. Plan your dream smile with our experienced cosmetic dentists.";
const canonicalUrl = "https://aurevadental.com/treatments/smile-makeover";
const phoneCallUrl = "tel:+917349701002";
const whatsappUrl = "https://wa.me/917349701002?text=Hello%2C%20I%20would%20like%20to%20consult%20about%20a%20Smile%20Makeover%20at%20Aureva%20Dental.";

const faqs = [
  {
    question: "What is a Digital Smile Makeover and what does it include?",
    answer: "A smile makeover is a comprehensive, customized aesthetic plan combining multiple cosmetic dental treatments tailored to your facial proportions. It may include Digital Smile Design (DSD), ultra-thin porcelain or composite veneers, teeth whitening, and subtle orthodontic alignment."
  },
  {
    question: "Can I preview my new smile before committing to treatment?",
    answer: "Yes. With 3D Digital Smile Design technology, we capture facial photographs and 3D intraoral scans to create a digital simulation and physical aesthetic mockup. You can preview the tooth shape, length, and shade in your own mouth before permanent preparation begins."
  },
  {
    question: "What is the difference between composite and porcelain veneers?",
    answer: "Composite veneers are sculpted directly using aesthetic nano-hybrid resins in a single visit. Porcelain and E-Max ceramic veneers are custom-fabricated in specialized dental labs, offering superior natural translucency and stain resistance."
  },
  {
    question: "What is the cost of a smile makeover in Hennur, Bangalore?",
    answer: `At Aureva Dental Hennur, direct composite veneers range from ${CANONICAL_PRICES.composite_veneers}. Hand-crafted porcelain and E-Max ceramic veneers range from ${CANONICAL_PRICES.veneers_porcelain} per tooth. Complete aesthetic rehabilitations start from ${CANONICAL_PRICES.smile_makeover}. All fees are confirmed during your consultation.`
  }
];

const breadcrumbs = [
  { name: "Home", url: "https://aurevadental.com/" },
  { name: "Treatments", url: "https://aurevadental.com/#services" },
  { name: "Smile Makeover", url: canonicalUrl }
];

const breadcrumbSchema = JSON.stringify(generateBreadcrumbSchema(breadcrumbs));
const faqSchema = JSON.stringify(generateFaqSchema(faqs));
const serviceSchema = JSON.stringify(generateTreatmentServiceSchema({
  name: "Digital Smile Makeover & Veneers",
  description: pageDescription,
  url: canonicalUrl,
  medicalSpecialty: "CosmeticDentistry"
}));

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogUrl: canonicalUrl,
  schemaMarkup: [breadcrumbSchema, faqSchema, serviceSchema]
};
---

<Layout {...seoProps}>
  <!-- Breadcrumb Navigation -->
  <nav class="bg-japandi-sand/30 border-b border-japandi-clay/20 py-3.5 px-6 lg:px-24 text-xs font-light text-japandi-earth" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto flex items-center gap-2">
      <a href="/" class="hover:text-japandi-moss transition-colors">Home</a>
      <span>/</span>
      <a href="/#services" class="hover:text-japandi-moss transition-colors">Treatments</a>
      <span>/</span>
      <span class="text-japandi-charcoal font-medium">Smile Makeover</span>
    </div>
  </nav>

  <!-- 1. Hero / H1 Section -->
  <section class="py-16 md:py-24 px-6 lg:px-24 bg-transparent relative overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 flex flex-col items-start space-y-6 animate-slow-fade">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-japandi-clay/60 bg-japandi-sand/70 text-[10px] font-semibold text-japandi-moss uppercase tracking-widest">
          Aesthetic Architecture &bull; Hennur Bande, Bangalore
        </div>
        
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif text-japandi-charcoal leading-tight font-medium tracking-tight">
          Digital Smile Makeover in Bangalore
        </h1>

        <p class="text-base sm:text-lg text-japandi-earth font-light leading-relaxed max-w-2xl">
          Comprehensive smile transformations planned with Digital Smile Design, custom porcelain veneers, and artistic enamel contouring to suit your unique facial symmetry.
        </p>

        <!-- CTA Buttons -->
        <div class="pt-2 flex flex-wrap items-center gap-4 w-full sm:w-auto">
          <button 
            type="button"
            data-open-booking
            class="inline-flex items-center justify-center gap-2 px-7 py-4 bg-japandi-moss text-japandi-cream hover:bg-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 shadow-md shadow-japandi-moss/15 cursor-none"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
            </svg>
            <span>Book Smile Consultation</span>
          </button>

          <a 
            href={phoneCallUrl}
            class="inline-flex items-center justify-center gap-2 px-7 py-4 border border-japandi-clay bg-japandi-sand/50 hover:bg-japandi-sand text-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 cursor-none"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-japandi-moss">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
            </svg>
            <span>Call +91 73497 01002</span>
          </a>
        </div>
      </div>

      <!-- Quick Feature Card -->
      <div class="lg:col-span-5 relative">
        <div class="p-8 rounded-3xl bg-japandi-sand/50 border border-japandi-clay/40 shadow-sm space-y-4">
          <span class="text-xs uppercase font-semibold text-japandi-moss tracking-widest block">Digital Workflow</span>
          <h3 class="font-serif text-xl font-medium text-japandi-charcoal">Preview Your Smile</h3>
          <ul class="space-y-3 text-xs font-light text-japandi-earth">
            <li class="flex items-start gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-japandi-moss mt-1.5 shrink-0"></span>
              <div><strong class="text-japandi-charcoal font-medium">Digital 3D Mockup:</strong> Test-drive the planned smile contours directly in your mouth before permanent bonding.</div>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-japandi-moss mt-1.5 shrink-0"></span>
              <div><strong class="text-japandi-charcoal font-medium">Bespoke Ceramic Art:</strong> Custom-crafted E.max ceramic shells tailored to your lip line and tooth shade.</div>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-japandi-moss mt-1.5 shrink-0"></span>
              <div><strong class="text-japandi-charcoal font-medium">Comprehensive Packages:</strong> Tailored options for weddings, graduations, and restorative makeovers.</div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Who It's For (Symptoms in Plain Words) -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Candidates</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Who a smile makeover is for
        </h2>
      </div>
      <p class="text-sm sm:text-base text-japandi-earth font-light leading-relaxed">
        A smile makeover addresses complex, multi-factor aesthetic concerns, such as:
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm text-japandi-earth font-light">
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Multiple Worn or Chipped Teeth</h3>
          <p>Teeth shortened or fractured by clenching, grinding, or long-term wear.</p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Severe Discoloration</h3>
          <p>Tetracycline staining, advanced fluorosis, or uneven coloring across multiple teeth.</p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Irregular Spacing and Gaps</h3>
          <p>Multiple gaps or uneven spacing affecting the entire upper smile zone.</p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Bridal &amp; Special Events</h3>
          <p>Curated timelines for brides, grooms, and working professionals prior to key life events.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. What Happens, Visit by Visit, & Number of Sittings -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-8">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Clinical Protocol</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          What happens, visit by visit
        </h2>
        <p class="text-sm sm:text-base text-japandi-earth font-light mt-2">
          A comprehensive smile makeover is typically accomplished in 2 to 3 sittings.
        </p>
      </div>

      <div class="space-y-4 text-xs sm:text-sm text-japandi-earth font-light">
        <div class="p-6 rounded-2xl bg-japandi-sand/30 border border-japandi-clay/40 space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">Visit 1: Digital Smile Design &amp; Mockup</h3>
            <span class="text-[10px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded bg-japandi-moss/10 text-japandi-moss">Sitting 1</span>
          </div>
          <p class="leading-relaxed">
            High-resolution facial photography, 3D optical scanning, and shade analysis. A temporary intraoral mockup is placed so you can see and review your proposed smile directly in the mirror.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-japandi-sand/30 border border-japandi-clay/40 space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">Visit 2: Preparation &amp; Master Impressions</h3>
            <span class="text-[10px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded bg-japandi-moss/10 text-japandi-moss">Sitting 2</span>
          </div>
          <p class="leading-relaxed">
            Minimal, conservative enamel preparation is performed. High-precision optical impressions are captured for the dental ceramic laboratory, and temporary veneers are placed.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-japandi-sand/30 border border-japandi-clay/40 space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">Visit 3: Final Bonding &amp; Bite Verification</h3>
            <span class="text-[10px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded bg-japandi-moss/10 text-japandi-moss">Sitting 3</span>
          </div>
          <p class="leading-relaxed">
            Each ceramic unit is individually evaluated for fit, translucency, and margin seal, then bonded with resin cement. Bite mechanics are verified for complete stability.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Price Table from Keys -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Transparent Pricing</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Smile makeover fees
        </h2>
        <p class="text-xs sm:text-sm text-japandi-earth font-light mt-1">
          Prices are ranges, confirmed after examination.
        </p>
      </div>

      <div class="rounded-2xl border border-japandi-clay/40 overflow-hidden bg-japandi-cream/90 shadow-sm">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-japandi-sand/60 text-japandi-charcoal font-serif border-b border-japandi-clay/30">
            <tr>
              <th class="py-3 px-4">Procedure</th>
              <th class="py-3 px-4">Price Range</th>
              <th class="py-3 px-4 hidden sm:table-cell">Notes</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-japandi-clay/20 text-japandi-earth font-light">
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">Composite Veneers</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.composite_veneers}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Direct composite resin per tooth</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">Porcelain / E-max Veneers</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.veneers_porcelain}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Lab-milled ceramic per tooth</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">In-Office Teeth Whitening</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.whitening_in_clinic}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Clinical LED whitening session</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">Smile Makeover Rehabilitation</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.smile_makeover}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Comprehensive multi-tooth rehabilitation</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">Smile Consultation</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.consultation}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Exam with digital RVG X-ray (valid 6 months)</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-xs text-japandi-earth font-light">
        See our complete pricing catalog on the <a href="/prices" class="text-japandi-moss underline decoration-japandi-moss/40 hover:decoration-japandi-moss font-medium">treatment prices</a> page.
      </p>
    </div>
  </section>

  <!-- 5. Which Department Handles It -->
  <TreatmentDepartmentCard 
    department="Aesthetic & Restorative Dentistry"
    link="/our-specialists#aesthetic"
    description="Smile designs, porcelain veneers, and composite restorations are planned and executed by visiting MDS prosthodontists and aesthetic dental specialists."
  />

  <!-- 6. Aftercare and When to Call Us -->
  <TreatmentAftercare 
    instructions={[
      "Avoid chewing very hard objects, ice, or using teeth to open packaging.",
      "Brush twice daily with a non-abrasive fluoride toothpaste and floss carefully between all restored teeth.",
      "Wear a custom protective nightguard if you clench or grind your teeth in your sleep.",
      "Attend scheduled biannual dental reviews and prophy cleanings to maintain gingival health around veneer margins."
    ]}
    whenToCall={[
      "A veneer chips, fractures, or feels unbonded.",
      "Your bite feels uneven or uncomfortable when chewing.",
      "You develop persistent tooth sensitivity to temperature changes."
    ]}
  />

  <!-- 7. FAQs (with Schema) -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-8">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Common Questions</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Frequently asked questions
        </h2>
      </div>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <div class="bg-japandi-cream/90 border border-japandi-clay/40 rounded-2xl p-6 space-y-2">
            <h3 class="font-serif text-base sm:text-lg text-japandi-charcoal font-medium">
              {faq.question}
            </h3>
            <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. Related Treatments -->
  <section class="py-16 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <h2 class="text-xl sm:text-2xl font-serif text-japandi-charcoal font-medium">
        Related treatments
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
        <a href="/treatments/cosmetic-dentistry" class="p-4 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 hover:border-japandi-moss transition-colors block space-y-1">
          <span class="font-serif text-sm text-japandi-charcoal font-medium block">Cosmetic Dentistry</span>
          <span class="text-japandi-earth font-light">Veneers, bonding &amp; aesthetic tooth contouring</span>
        </a>
        <a href="/treatments/clear-aligners" class="p-4 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 hover:border-japandi-moss transition-colors block space-y-1">
          <span class="font-serif text-sm text-japandi-charcoal font-medium block">Clear Aligners</span>
          <span class="text-japandi-earth font-light">Discreet orthodontic alignment before bonding</span>
        </a>
        <a href="/teeth-whitening-hennur" class="p-4 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 hover:border-japandi-moss transition-colors block space-y-1">
          <span class="font-serif text-sm text-japandi-charcoal font-medium block">Teeth Whitening</span>
          <span class="text-japandi-earth font-light">In-office LED &amp; take-home whitening</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 9. Book / WhatsApp / Call -->
  <TreatmentActions treatmentName="Smile Makeover Consultation" />
</Layout>
