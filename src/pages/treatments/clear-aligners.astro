---
import { CANONICAL_PRICES } from '../../data/prices';
import Layout from '../../layouts/Layout.astro';
import { generateBreadcrumbSchema, generateFaqSchema, generateTreatmentServiceSchema } from '../../utils/seoSchemas';
import TreatmentDepartmentCard from '../../components/TreatmentDepartmentCard.astro';
import TreatmentAftercare from '../../components/TreatmentAftercare.astro';
import TreatmentActions from '../../components/TreatmentActions.astro';

const pageTitle = "Clear Aligners Guide | Types, Wear & Pricing | Aureva Dental";
const pageDescription = "Complete guide to clear aligners in Bangalore: mild to complex crowding, 3D smile design, daily wear routine, retainers, and transparent pricing at Aureva Dental.";
const canonicalUrl = "https://aurevadental.com/treatments/clear-aligners";
const phoneCallUrl = "tel:+917349701002";
const whatsappUrl = "https://wa.me/917349701002?text=Hello%2C%20I%20would%20like%20to%20consult%20about%20Clear%20Aligners%20at%20Aureva%20Dental.";

const faqs = [
  {
    question: "How do clear aligners work compared to traditional braces?",
    answer: "Clear aligners use a sequence of custom-manufactured, transparent medical-grade polymer trays that exert gentle, calibrated forces to shift teeth incrementally into ideal alignment. Unlike traditional metal braces with brackets and wires, clear aligners are virtually invisible and removable for eating and brushing."
  },
  {
    question: "How many hours a day do I need to wear my clear aligners?",
    answer: "For optimal biological tooth movement, aligners must be worn for 20 to 22 hours each day. You only remove them during meals, drinking hot or colored beverages, and when brushing or flossing your teeth. Each tray set is typically worn for 7 to 14 days before advancing to the next series."
  },
  {
    question: "Are clear aligners painful to wear?",
    answer: "Clear aligners are vastly more comfortable than traditional metal brackets. You may feel mild pressure or snugness during the first 24 to 48 hours of switching to a new tray set, which indicates that controlled tooth movement is underway. There are no sharp metal edges to irritate cheeks or lips."
  },
  {
    question: "What is the cost of clear aligners at Aureva Dental?",
    answer: `At Aureva Dental, clear aligners are tiered by case complexity: mild cases are ${CANONICAL_PRICES.aligners_mild}, moderate cases are ${CANONICAL_PRICES.aligners_moderate}, and complex corrections are ${CANONICAL_PRICES.aligners_complex}. Prices are ranges, confirmed after examination.`
  }
];

const breadcrumbs = [
  { name: "Home", url: "https://aurevadental.com/" },
  { name: "Treatments", url: "https://aurevadental.com/#services" },
  { name: "Clear Aligners Guide", url: canonicalUrl }
];

const breadcrumbSchema = JSON.stringify(generateBreadcrumbSchema(breadcrumbs));
const faqSchema = JSON.stringify(generateFaqSchema(faqs));
const serviceSchema = JSON.stringify(generateTreatmentServiceSchema({
  name: "Clear Aligners Clinical Guide",
  description: pageDescription,
  url: canonicalUrl,
  medicalSpecialty: "Orthodontics"
}));

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogUrl: canonicalUrl,
  schemaMarkup: [breadcrumbSchema, faqSchema, serviceSchema]
};
---

<Layout {...seoProps}>
  <!-- Breadcrumb Navigation -->
  <nav class="bg-japandi-sand/30 border-b border-japandi-clay/20 py-3.5 px-6 lg:px-24 text-xs font-light text-japandi-earth" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto flex items-center gap-2">
      <a href="/" class="hover:text-japandi-moss transition-colors">Home</a>
      <span>/</span>
      <a href="/#services" class="hover:text-japandi-moss transition-colors">Treatments</a>
      <span>/</span>
      <span class="text-japandi-charcoal font-medium">Clear Aligners Guide</span>
    </div>
  </nav>

  <!-- 1. Hero / H1 Section -->
  <section class="py-16 md:py-24 px-6 lg:px-24 bg-transparent relative overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 flex flex-col items-start space-y-6 animate-slow-fade">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-japandi-clay/60 bg-japandi-sand/70 text-[10px] font-semibold text-japandi-moss uppercase tracking-widest">
          Orthodontic Clinical Guide &bull; Aureva Dental
        </div>
        
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif text-japandi-charcoal leading-tight font-medium tracking-tight">
          Clear Aligners: Complete Clinical Guide
        </h1>

        <p class="text-base sm:text-lg text-japandi-earth font-light leading-relaxed max-w-2xl">
          A comprehensive clinical guide to clear aligners and orthodontic straightening at Aureva Dental. Discover how custom thermoformed transparent trays correct crowding, spacing, and bite irregularities without bonded metal brackets. Looking for local consultations in Hennur Bande? See our <a href="/invisible-aligners-hennur" class="text-japandi-moss underline decoration-japandi-moss/50 hover:decoration-japandi-moss font-medium">Invisible Aligners in Hennur Bande</a> page.
        </p>

        <!-- CTA Action Buttons -->
        <div class="pt-2 flex flex-wrap items-center gap-4 w-full sm:w-auto">
          <button 
            type="button"
            data-open-booking
            class="inline-flex items-center justify-center gap-2 px-7 py-4 bg-japandi-moss text-japandi-cream hover:bg-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 shadow-md shadow-japandi-moss/15 cursor-none"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
            </svg>
            <span>Book 3D Smile Scan</span>
          </button>

          <a 
            href={phoneCallUrl}
            class="inline-flex items-center justify-center gap-2 px-7 py-4 border border-japandi-clay bg-japandi-sand/50 hover:bg-japandi-sand text-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 cursor-none"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-japandi-moss">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
            </svg>
            <span>Call +91 73497 01002</span>
          </a>
        </div>
      </div>

      <!-- Quick Highlights Card -->
      <div class="lg:col-span-5 animate-slow-fade">
        <div class="bg-japandi-sand/60 border border-japandi-clay/50 rounded-[2.5rem] p-8 sm:p-10 shadow-lg shadow-japandi-charcoal/5 relative">
          <h3 class="text-xl font-serif text-japandi-charcoal font-medium mb-4">Clear Aligner Features</h3>
          <ul class="space-y-4 text-xs sm:text-sm text-japandi-earth font-light">
            <li class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-japandi-moss/15 text-japandi-moss flex items-center justify-center shrink-0 mt-0.5 font-semibold text-[10px]">&check;</div>
              <div><strong class="text-japandi-charcoal font-medium">Virtually Invisible:</strong> Medical-grade transparent polyurethane trays fit closely over teeth.</div>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-japandi-moss/15 text-japandi-moss flex items-center justify-center shrink-0 mt-0.5 font-semibold text-[10px]">&check;</div>
              <div><strong class="text-japandi-charcoal font-medium">Fully Removable:</strong> Remove trays for eating, brushing, flossing, and important meetings.</div>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-japandi-moss/15 text-japandi-moss flex items-center justify-center shrink-0 mt-0.5 font-semibold text-[10px]">&check;</div>
              <div><strong class="text-japandi-charcoal font-medium">Zero Food Restrictions:</strong> Eat your normal diet without fear of dislodging brackets or wires.</div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Who It's For (Symptoms in Plain Words) -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Orthodontic Candidates</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Who clear aligners are for
        </h2>
      </div>
      <p class="text-sm sm:text-base text-japandi-earth font-light leading-relaxed">
        Clear aligners provide effective, discreet correction for patients with:
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm text-japandi-earth font-light">
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Crowded or Overlapping Teeth</h3>
          <p>Teeth bunch together or twist because of dental arch crowding, making thorough flossing difficult.</p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Gaps and Spacing</h3>
          <p>Visible spaces or diastemas between front teeth that affect smile appearance and trap food particles.</p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Orthodontic Relapse</h3>
          <p>Adults who wore metal braces in youth but whose teeth shifted because retainers were discontinued.</p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Bite Misalignment (Overbite / Crossbite)</h3>
          <p>Deep bites or crossbites where upper and lower teeth meet unevenly, causing abnormal enamel wear.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. What Happens, Visit by Visit, & Number of Sittings -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-8">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Clinical Pathway</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          What happens, visit by visit
        </h2>
        <p class="text-sm sm:text-base text-japandi-earth font-light mt-2 leading-relaxed">
          The clear aligner workflow consists of 4 to 6 planned check-ins over a 6 to 18 month treatment course:
        </p>
      </div>

      <div class="space-y-4 text-xs sm:text-sm text-japandi-earth font-light">
        <div class="p-6 rounded-2xl bg-japandi-sand/55 border border-japandi-clay/50 space-y-2">
          <div class="flex items-center gap-3">
            <span class="w-7 h-7 rounded-full bg-japandi-moss text-japandi-cream text-xs font-bold flex items-center justify-center shrink-0">1</span>
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">Sitting 1: Examination &amp; 3D Digital Intraoral Scan</h3>
          </div>
          <p class="leading-relaxed pl-10">
            Our visiting orthodontist records high-definition 3D digital scans of your teeth, reviewing your occlusion and mapping digital movements.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-japandi-sand/55 border border-japandi-clay/50 space-y-2">
          <div class="flex items-center gap-3">
            <span class="w-7 h-7 rounded-full bg-japandi-moss text-japandi-cream text-xs font-bold flex items-center justify-center shrink-0">2</span>
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">Sitting 2: Treatment Simulation Review &amp; Tray Delivery</h3>
          </div>
          <p class="leading-relaxed pl-10">
            You review your 3D tooth movement simulation. Small tooth-coloured composite attachments are placed if needed, and you receive your first sets of custom aligner trays.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-japandi-sand/55 border border-japandi-clay/50 space-y-2">
          <div class="flex items-center gap-3">
            <span class="w-7 h-7 rounded-full bg-japandi-moss text-japandi-cream text-xs font-bold flex items-center justify-center shrink-0">3</span>
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">Sitting 3 to 5: Progress Check-Ins (Every 6 to 8 Weeks)</h3>
          </div>
          <p class="leading-relaxed pl-10">
            Quick 15-minute visits to ensure teeth are tracking accurately to digital software predictions and pick up your next batch of sequential trays.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-japandi-sand/55 border border-japandi-clay/50 space-y-2">
          <div class="flex items-center gap-3">
            <span class="w-7 h-7 rounded-full bg-japandi-moss text-japandi-cream text-xs font-bold flex items-center justify-center shrink-0">4</span>
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">Final Sitting: Retention Delivery</h3>
          </div>
          <p class="leading-relaxed pl-10">
            Attachments are polished off, and custom retainers (clear night retainers or bonded lingual retainers) are fitted to keep your alignment permanently stable.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Price Table From Keys -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-8">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Transparent Pricing</span>
        <h2 class="text-2xl sm:text-3xl font-serif text-japandi-charcoal font-medium">
          Orthodontic treatment prices
        </h2>
        <p class="text-xs sm:text-sm text-japandi-earth font-light mt-1">
          Clear aligner treatment is priced according to clinical movement requirements:
        </p>
      </div>

      <div class="bg-japandi-sand/40 border border-japandi-clay/50 rounded-2xl overflow-hidden shadow-sm">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-japandi-sand/80 text-japandi-earth uppercase text-[10px] tracking-wider border-b border-japandi-clay/30">
            <tr>
              <th scope="col" class="py-3 px-6 font-semibold w-2/3">Orthodontic Option</th>
              <th scope="col" class="py-3 px-6 font-semibold w-1/3">Price Range</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-japandi-clay/20 text-japandi-charcoal font-light">
            <tr class="hover:bg-japandi-sand/60">
              <td class="py-3.5 px-6 font-medium">Orthodontic Consultation &amp; Digital X-ray</td>
              <td class="py-3.5 px-6 font-semibold text-japandi-moss">{CANONICAL_PRICES.consultation}</td>
            </tr>
            <tr class="hover:bg-japandi-sand/60">
              <td class="py-3.5 px-6 font-medium">Clear Aligners (Mild Crowding / Spacing)</td>
              <td class="py-3.5 px-6 font-semibold text-japandi-moss">{CANONICAL_PRICES.aligners_mild}</td>
            </tr>
            <tr class="hover:bg-japandi-sand/60">
              <td class="py-3.5 px-6 font-medium">Clear Aligners (Moderate Correction)</td>
              <td class="py-3.5 px-6 font-semibold text-japandi-moss">{CANONICAL_PRICES.aligners_moderate}</td>
            </tr>
            <tr class="hover:bg-japandi-sand/60">
              <td class="py-3.5 px-6 font-medium">Clear Aligners (Complex Malocclusion)</td>
              <td class="py-3.5 px-6 font-semibold text-japandi-moss">{CANONICAL_PRICES.aligners_complex}</td>
            </tr>
            <tr class="hover:bg-japandi-sand/60">
              <td class="py-3.5 px-6 font-medium">Traditional Metal Braces</td>
              <td class="py-3.5 px-6 font-semibold text-japandi-moss">{CANONICAL_PRICES.braces_metal}</td>
            </tr>
            <tr class="hover:bg-japandi-sand/60">
              <td class="py-3.5 px-6 font-medium">Aesthetic Ceramic Braces</td>
              <td class="py-3.5 px-6 font-semibold text-japandi-moss">{CANONICAL_PRICES.braces_ceramic}</td>
            </tr>
            <tr class="hover:bg-japandi-sand/60">
              <td class="py-3.5 px-6 font-medium">Self-Ligating Braces</td>
              <td class="py-3.5 px-6 font-semibold text-japandi-moss">{CANONICAL_PRICES.braces_self_ligating}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="p-5 rounded-2xl bg-japandi-sand/50 border border-japandi-clay/40 text-center space-y-2">
        <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
          Prices are ranges, confirmed after examination. Itemized written estimates valid for 6 months. Flexible EMI options available via bank cards.
        </p>
      </div>
    </div>
  </section>

  <!-- 5. Which Department Handles It -->
  <TreatmentDepartmentCard 
    department="Orthodontics" 
    description="All orthodontic assessments, 3D digital tooth movements, clear aligner staging, and retention plans are handled by our visiting MDS Orthodontist."
  />

  <!-- 6. Aftercare and When to Call Us -->
  <TreatmentAftercare 
    aftercare={[
      "Wear your aligners for 20 to 22 hours every single day; inconsistent wear will slow tooth tracking.",
      "Remove aligners only when eating, drinking hot or pigmented drinks, and brushing your teeth.",
      "Clean trays with cool tap water and a soft-bristled toothbrush; never use hot water as it warps thermoformed plastic.",
      "Store aligners safely inside their protective case whenever removed to prevent accidental loss or damage.",
      "Advance to the next sequential aligner set only according to the wear schedule prescribed by your orthodontist."
    ]}
    whenToCall={[
      "An aligner tray cracks, tears, or is accidentally lost or damaged.",
      "A bonded composite attachment comes off an enamel surface.",
      "An aligner causes sharp pain or persistent soft-tissue abrasion that does not settle.",
      "A new tray set fails to seat completely over your teeth after 3 to 4 days of continuous wear."
    ]}
  />

  <!-- 7. FAQs (with Schema) -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/20 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-8">
      <div>
        <h2 class="text-2xl sm:text-3xl font-serif text-japandi-charcoal font-medium">
          Frequently asked questions about clear aligners
        </h2>
      </div>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <div class="p-6 rounded-2xl bg-japandi-sand/60 border border-japandi-clay/50 space-y-2">
            <h3 class="text-sm sm:text-base font-serif font-medium text-japandi-charcoal">
              {faq.question}
            </h3>
            <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. Related Treatments -->
  <section class="py-12 md:py-16 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <div class="space-y-1">
        <h3 class="text-lg font-serif font-medium text-japandi-charcoal">Related treatments &amp; orthodontic care</h3>
        <p class="text-xs text-japandi-earth font-light">Explore associated cosmetic and corrective smile services:</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs font-light">
        <a href="/invisible-aligners-hennur" class="p-4 rounded-2xl bg-japandi-sand/50 border border-japandi-clay/40 hover:border-japandi-moss transition-all group">
          <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-1">Hennur Aligners Page &rarr;</span>
          <span class="text-japandi-earth text-[11px]">Local clinic consultations and 3D smile scans in Hennur Bande.</span>
        </a>
        <a href="/teeth-whitening-hennur" class="p-4 rounded-2xl bg-japandi-sand/50 border border-japandi-clay/40 hover:border-japandi-moss transition-all group">
          <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-1">Teeth Whitening &rarr;</span>
          <span class="text-japandi-earth text-[11px]">Brighten tooth shade after completing orthodontic alignment.</span>
        </a>
        <a href="/treatments/cosmetic-dentistry" class="p-4 rounded-2xl bg-japandi-sand/50 border border-japandi-clay/40 hover:border-japandi-moss transition-all group">
          <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-1">Cosmetic Dentistry &rarr;</span>
          <span class="text-japandi-earth text-[11px]">Composite edge bonding and veneers for post-alignment smile finishing.</span>
        </a>
        <a href="/treatments/pediatric-dentistry" class="p-4 rounded-2xl bg-japandi-sand/50 border border-japandi-clay/40 hover:border-japandi-moss transition-all group">
          <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-1">Pediatric Dentistry &rarr;</span>
          <span class="text-japandi-earth text-[11px]">Early orthodontic interceptive assessments for children and teens.</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 9. Book / WhatsApp / Call Buttons -->
  <TreatmentActions treatmentName="Clear Aligners" />
</Layout>
