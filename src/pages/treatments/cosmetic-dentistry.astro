---
import { CANONICAL_PRICES } from '../../data/prices';
import Layout from '../../layouts/Layout.astro';
import { generateBreadcrumbSchema, generateFaqSchema, generateTreatmentServiceSchema } from '../../utils/seoSchemas';
import TreatmentDepartmentCard from '../../components/TreatmentDepartmentCard.astro';
import TreatmentAftercare from '../../components/TreatmentAftercare.astro';
import TreatmentActions from '../../components/TreatmentActions.astro';

const pageTitle = "Cosmetic Dentistry in Bangalore | Veneers & Smile Design | Aureva Dental";
const pageDescription = "Transform your smile with porcelain veneers, composite bonding & smile makeovers at Aureva Dental in Bangalore. Schedule your smile consultation.";
const canonicalUrl = "https://aurevadental.com/treatments/cosmetic-dentistry";
const phoneCallUrl = "tel:+917349701002";
const whatsappUrl = "https://wa.me/917349701002?text=Hello%2C%20I%20would%20like%20to%20consult%20about%20Cosmetic%20Dentistry%20and%20Smile%20Design%20at%20Aureva%20Dental.";

const faqs = [
  {
    question: "How long do porcelain veneers last?",
    answer: "High-grade porcelain and lithium disilicate (E.max) veneers provide durable aesthetic smile enhancements with proper oral hygiene and regular dental checkups. Because porcelain is non-porous and ultra-glazed, it resists stains from coffee, tea, and red wine far better than natural enamel."
  },
  {
    question: "Will professional teeth whitening damage my dental enamel?",
    answer: "No. Our clinic uses professional, pH-neutral hydrogen peroxide and carbamide peroxide formulations combined with low-heat LED/laser acceleration. This process releases oxygen molecules to safely dissolve deep microscopic discolored stains inside the enamel without eroding or weakening the tooth structure."
  },
  {
    question: "What is the difference between composite bonding and porcelain veneers?",
    answer: `Composite bonding involves direct, hand-sculpted resin applied in a single visit without removing enamel, ideal for minor chips, gaps, or small shape corrections (${CANONICAL_PRICES.composite_bonding}). Porcelain veneers are ultra-thin, custom-fabricated ceramic shells bonded to the front tooth surface, offering superior natural translucency, longevity, and stain resistance (${CANONICAL_PRICES.veneers_porcelain}).`
  },
  {
    question: "How much does a complete smile makeover cost in Bangalore?",
    answer: `Smile makeover investments vary based on the combination of treatments required. Digital Smile Design planning is ${CANONICAL_PRICES.digital_smile_design}. In-office LED/Laser teeth whitening ranges from ${CANONICAL_PRICES.whitening_in_clinic}. Full smile aesthetic rehabilitations start from ${CANONICAL_PRICES.smile_makeover}. All fees are confirmed during your consultation.`
  }
];

const breadcrumbs = [
  { name: "Home", url: "https://aurevadental.com/" },
  { name: "Treatments", url: "https://aurevadental.com/#services" },
  { name: "Cosmetic Dentistry", url: canonicalUrl }
];

const breadcrumbSchema = JSON.stringify(generateBreadcrumbSchema(breadcrumbs));
const faqSchema = JSON.stringify(generateFaqSchema(faqs));
const serviceSchema = JSON.stringify(generateTreatmentServiceSchema({
  name: "Cosmetic Dentistry & Smile Design",
  description: pageDescription,
  url: canonicalUrl,
  medicalSpecialty: "CosmeticDentistry"
}));

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogUrl: canonicalUrl,
  schemaMarkup: [breadcrumbSchema, faqSchema, serviceSchema]
};
---

<Layout {...seoProps}>
  <!-- Breadcrumb Navigation -->
  <nav class="bg-japandi-sand/30 border-b border-japandi-clay/20 py-3.5 px-6 lg:px-24 text-xs font-light text-japandi-earth" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto flex items-center gap-2">
      <a href="/" class="hover:text-japandi-moss transition-colors">Home</a>
      <span>/</span>
      <a href="/#services" class="hover:text-japandi-moss transition-colors">Treatments</a>
      <span>/</span>
      <span class="text-japandi-charcoal font-medium">Cosmetic Dentistry</span>
    </div>
  </nav>

  <!-- 1. Hero / H1 Section -->
  <section class="py-16 md:py-24 px-6 lg:px-24 bg-transparent relative overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 flex flex-col items-start space-y-6 animate-slow-fade">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-japandi-clay/60 bg-japandi-sand/70 text-[10px] font-semibold text-japandi-moss uppercase tracking-widest">
          Aesthetic Dentistry &bull; Hennur, Bangalore
        </div>
        
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif text-japandi-charcoal leading-tight font-medium tracking-tight">
          Cosmetic Dentistry &amp; Veneers
        </h1>

        <p class="text-base sm:text-lg text-japandi-earth font-light leading-relaxed max-w-2xl">
          Where biological dental precision meets facial harmony. Enhance your smile with ultra-thin porcelain veneers, composite edge bonding, and professional teeth whitening planned with Digital Smile Design.
        </p>

        <!-- CTA Buttons -->
        <div class="pt-2 flex flex-wrap items-center gap-4 w-full sm:w-auto">
          <button 
            type="button"
            data-open-booking
            class="inline-flex items-center justify-center gap-2 px-7 py-4 bg-japandi-moss text-japandi-cream hover:bg-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 shadow-md shadow-japandi-moss/15 cursor-none"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
            </svg>
            <span>Book Smile Consultation</span>
          </button>

          <a 
            href={phoneCallUrl}
            class="inline-flex items-center justify-center gap-2 px-7 py-4 border border-japandi-clay bg-japandi-sand/50 hover:bg-japandi-sand text-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 cursor-none"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-japandi-moss">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
            </svg>
            <span>Call +91 73497 01002</span>
          </a>
        </div>
      </div>

      <!-- Quick Feature Card -->
      <div class="lg:col-span-5 relative">
        <div class="bg-japandi-sand/60 border border-japandi-clay/50 rounded-[2.5rem] p-8 space-y-4">
          <span class="text-xs font-semibold uppercase tracking-widest text-japandi-moss">Aesthetic Principles</span>
          <h3 class="text-xl font-serif text-japandi-charcoal font-medium">Digital Smile Design</h3>
          <ul class="space-y-3 text-xs text-japandi-earth font-light">
            <li class="flex items-start gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-japandi-moss mt-1.5 shrink-0"></span>
              <div><strong class="text-japandi-charcoal font-medium">Facial Symmetry Planning:</strong> Analyzing lip dynamics and facial proportion to shape natural contours.</div>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-japandi-moss mt-1.5 shrink-0"></span>
              <div><strong class="text-japandi-charcoal font-medium">Enamel Preservation:</strong> Conservative preparation keeping as much natural tooth structure as possible.</div>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-japandi-moss mt-1.5 shrink-0"></span>
              <div><strong class="text-japandi-charcoal font-medium">Stain Resistance:</strong> Premium ceramic materials that resist staining from coffee, tea, and turmeric.</div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Who It's For (Symptoms in Plain Words) -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Candidates</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Who cosmetic dentistry is for
        </h2>
      </div>
      <p class="text-sm sm:text-base text-japandi-earth font-light leading-relaxed">
        Cosmetic dental treatments are suitable for patients looking to improve:
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm text-japandi-earth font-light">
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Chipped or Jagged Teeth</h3>
          <p>Front teeth with rough edges, small fractures, or chips from accidental wear.</p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Deep Stains or Discoloration</h3>
          <p>Intrinsic enamel yellowing, fluorosis, or discoloration that does not respond to regular brushing.</p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Gaps Between Teeth</h3>
          <p>Unwanted spaces (diastemas) between front teeth that can be closed with bonding or veneers.</p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Uneven Tooth Lengths</h3>
          <p>Teeth that appear disproportionately short, worn down, or asymmetrical when smiling.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. What Happens, Visit by Visit, & Number of Sittings -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-8">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Clinical Protocol</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          What happens, visit by visit
        </h2>
        <p class="text-sm sm:text-base text-japandi-earth font-light mt-2">
          Composite bonding and teeth whitening are completed in 1 sitting. Custom porcelain veneers require 2 to 3 sittings.
        </p>
      </div>

      <div class="space-y-4 text-xs sm:text-sm text-japandi-earth font-light">
        <div class="p-6 rounded-2xl bg-japandi-sand/30 border border-japandi-clay/40 space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">Visit 1: Aesthetic Examination &amp; Digital Planning</h3>
            <span class="text-[10px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded bg-japandi-moss/10 text-japandi-moss">Sitting 1</span>
          </div>
          <p class="leading-relaxed">
            Clinical exam with digital X-ray and photography. For composite bonding, treatment can be completed in this sitting. For veneers, shade matching and digital scanning are performed.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-japandi-sand/30 border border-japandi-clay/40 space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">Visit 2: Tooth Preparation &amp; Temporary Mockup</h3>
            <span class="text-[10px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded bg-japandi-moss/10 text-japandi-moss">Sitting 2 (Veneers)</span>
          </div>
          <p class="leading-relaxed">
            Conservative tooth preparation is carried out under local anesthesia if required. A high-resolution impression or 3D scan is sent to the lab, and temporary veneers are placed.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-japandi-sand/30 border border-japandi-clay/40 space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">Visit 3: Final Bonding &amp; Occlusal Check</h3>
            <span class="text-[10px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded bg-japandi-moss/10 text-japandi-moss">Sitting 3 (Veneers)</span>
          </div>
          <p class="leading-relaxed">
            Permanent porcelain veneers are tried in, checked for fit, color harmony, and bite balance, and adhesively bonded to the enamel.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Price Table from Keys -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Transparent Pricing</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Cosmetic treatment fees
        </h2>
        <p class="text-xs sm:text-sm text-japandi-earth font-light mt-1">
          Prices are ranges, confirmed after examination.
        </p>
      </div>

      <div class="rounded-2xl border border-japandi-clay/40 overflow-hidden bg-japandi-cream/90 shadow-sm">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-japandi-sand/60 text-japandi-charcoal font-serif border-b border-japandi-clay/30">
            <tr>
              <th class="py-3 px-4">Treatment</th>
              <th class="py-3 px-4">Price Range</th>
              <th class="py-3 px-4 hidden sm:table-cell">Details</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-japandi-clay/20 text-japandi-earth font-light">
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">Composite Edge Bonding</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.composite_edge_bonding}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Direct composite resin per tooth</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">Composite Veneers</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.veneers_composite}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Full composite facing per tooth</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">Porcelain / E-max Veneers</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.veneers_porcelain}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Lab-milled ceramic per tooth</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">In-Office Teeth Whitening</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.whitening_in_clinic}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Single clinical whitening session</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">Smile Consultation</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.consultation}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Clinical exam and digital RVG X-ray</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-xs text-japandi-earth font-light">
        View complete treatment pricing on our <a href="/prices" class="text-japandi-moss underline decoration-japandi-moss/40 hover:decoration-japandi-moss font-medium">treatment prices</a> page.
      </p>
    </div>
  </section>

  <!-- 5. Which Department Handles It -->
  <TreatmentDepartmentCard 
    department="Aesthetic & Restorative Dentistry"
    link="/our-specialists#aesthetic"
    description="Smile designs, porcelain veneers, and composite restorations are planned and executed by visiting MDS prosthodontists and aesthetic dental specialists."
  />

  <!-- 6. Aftercare and When to Call Us -->
  <TreatmentAftercare 
    instructions={[
      "Avoid biting into hard objects, ice, or opening packages with front veneers or composite restorations.",
      "Maintain gentle daily brushing with non-abrasive fluoride toothpaste and daily flossing.",
      "If you clench or grind your teeth while sleeping, wear a custom nightguard to protect porcelain from shear forces.",
      "Minimize consumption of strongly staining liquids (black coffee, dark tea) for 48 hours following whitening or bonding."
    ]}
    whenToCall={[
      "A veneer or composite edge chips, fractures, or feels loose.",
      "Your bite feels uneven or hits high when closing your teeth.",
      "You develop persistent or severe sensitivity to cold or hot temperatures."
    ]}
  />

  <!-- 7. FAQs (with Schema) -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-8">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Common Questions</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Frequently asked questions
        </h2>
      </div>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <div class="bg-japandi-cream/90 border border-japandi-clay/40 rounded-2xl p-6 space-y-2">
            <h3 class="font-serif text-base sm:text-lg text-japandi-charcoal font-medium">
              {faq.question}
            </h3>
            <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. Related Treatments -->
  <section class="py-16 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <h2 class="text-xl sm:text-2xl font-serif text-japandi-charcoal font-medium">
        Related treatments
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
        <a href="/treatments/smile-makeover" class="p-4 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 hover:border-japandi-moss transition-colors block space-y-1">
          <span class="font-serif text-sm text-japandi-charcoal font-medium block">Smile Makeover</span>
          <span class="text-japandi-earth font-light">Comprehensive digital smile transformations</span>
        </a>
        <a href="/teeth-whitening-hennur" class="p-4 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 hover:border-japandi-moss transition-colors block space-y-1">
          <span class="font-serif text-sm text-japandi-charcoal font-medium block">Teeth Whitening</span>
          <span class="text-japandi-earth font-light">In-office LED &amp; take-home whitening</span>
        </a>
        <a href="/dental-crowns-hennur" class="p-4 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 hover:border-japandi-moss transition-colors block space-y-1">
          <span class="font-serif text-sm text-japandi-charcoal font-medium block">Dental Crowns</span>
          <span class="text-japandi-earth font-light">Full-coverage zirconia &amp; E-max caps</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 9. Book / WhatsApp / Call -->
  <TreatmentActions treatmentName="Cosmetic Dentistry Consultation" />
</Layout>
