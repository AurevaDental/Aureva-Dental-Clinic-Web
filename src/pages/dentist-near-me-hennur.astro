        </h2>
        <p class="text-xs text-japandi-earth font-light">
          Calm, modern Japandi studio designed for your comfort.
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
        <div class="col-span-2 md:col-span-1 rounded-2xl overflow-hidden border border-japandi-clay/40 bg-japandi-sand/30 shadow-sm">
          <img 
            src="/assets/near-me/clinic_signage_exterior.webp" 
            alt="Aureva Dental clinic exterior signage, Hennur Bande" 
            width="900" 
            height="506" 
            loading="lazy" 
            decoding="async"
            class="w-full h-44 sm:h-52 object-cover" 
          />
        </div>

        <div class="rounded-2xl overflow-hidden border border-japandi-clay/40 bg-japandi-sand/30 shadow-sm">
          <img 
            src="/assets/near-me/reception_desk_aureva.webp" 
            alt="Aureva Dental reception desk, Hennur Bande" 
            width="675" 
            height="900" 
            loading="lazy" 
            decoding="async"
            class="w-full h-44 sm:h-52 object-cover" 
          />
        </div>

        <div class="rounded-2xl overflow-hidden border border-japandi-clay/40 bg-japandi-sand/30 shadow-sm">
          <img 
            src="/assets/near-me/treatment_operatory_chair.webp" 
            alt="Modern dental operatory treatment chair with window view at Aureva Dental" 
            width="900" 
            height="675" 
            loading="lazy" 
            decoding="async"
            class="w-full h-44 sm:h-52 object-cover" 
          />
        </div>

        <div class="rounded-2xl overflow-hidden border border-japandi-clay/40 bg-japandi-sand/30 shadow-sm">
          <img 
            src="/assets/near-me/waiting_lounge_sofa.webp" 
            alt="Calm Japandi waiting lounge sofa at Aureva Dental" 
            width="675" 
            height="900" 
            loading="lazy" 
            decoding="async"
            class="w-full h-44 sm:h-52 object-cover" 
          />
        </div>

        <div class="col-span-2 md:col-span-2 rounded-2xl overflow-hidden border border-japandi-clay/40 bg-japandi-sand/30 shadow-sm">
          <img 
            src="/assets/near-me/corridor_arch_tooth_sign.webp" 
            alt="Clinic corridor with illuminated tooth arch sign at Aureva Dental" 
            width="675" 
            height="900" 
            loading="lazy" 
            decoding="async"
            class="w-full h-44 sm:h-52 object-cover" 
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Find us Section -->
  <section class="py-10 px-4 max-w-4xl mx-auto border-t border-japandi-clay/20">
    <div class="space-y-6">
      <h2 class="text-xl sm:text-2xl font-serif text-japandi-charcoal font-medium text-center">
        Find us
      </h2>

      <div class="p-6 rounded-3xl bg-japandi-cream border border-japandi-clay/40 space-y-4">
        <div class="space-y-1.5 text-xs text-japandi-earth font-light">
          <p class="font-medium text-japandi-charcoal">
            {canonicalAddress}
          </p>
          <p>
            <strong class="text-japandi-charcoal font-medium">Hours:</strong> Monday 4–9 PM; Tuesday to Sunday 9:30 AM–9 PM; walk-ins till 9 PM.
          </p>
          <p>
            2nd floor with lift. Parking available for 4-wheelers and 2-wheelers.
          </p>
        </div>

        <!-- Lightweight Map Card with Open in Google Maps button -->
        <div class="p-4 rounded-2xl bg-japandi-sand/50 border border-japandi-clay/40 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
          <div class="text-xs">
            <span class="font-medium text-japandi-charcoal block">Horamavu Agara Road · Near Nayara Petrol Bunk</span>
            <span class="text-[11px] text-japandi-earth font-light">Direct route from Hennur, Horamavu &amp; Kalyan Nagar</span>
          </div>

          <a 
            href={mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-japandi-charcoal hover:bg-japandi-moss text-japandi-cream text-xs font-semibold uppercase tracking-wider transition-colors min-h-[44px]"
