<script>
  function setupStickyBar() {
    const heroActions = document.getElementById('hero-actions');
    const stickyBar = document.getElementById('near-me-sticky-bar');
    if (!heroActions || !stickyBar) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        // When hero action buttons are visible, hide sticky bar; when scrolled away, show it
        if (entry.isIntersecting) {
          stickyBar.classList.add('translate-y-full');
        } else {
          stickyBar.classList.remove('translate-y-full');
        }
      });
    }, {
      rootMargin: '0px',
      threshold: 0
    });

    observer.observe(heroActions);
  }

  setupStickyBar();
  document.addEventListener('astro:after-swap', setupStickyBar);
</script>
