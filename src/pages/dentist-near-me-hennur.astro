---
import Layout from '../layouts/Layout.astro';
import OpenStatusChip from '../components/OpenStatusChip';
import { clinicConfig } from '../config/clinic';

export const prerender = false;

const pageTitle = "Dental Clinic in Hennur | Open Till 9 PM | Aureva Dental";
const pageDescription = "Dental clinic on Horamavu Agara Road, Hennur Bande. Open till 9 PM, Sundays included. Walk in or book by call or WhatsApp.";
const canonicalUrl = "https://aurevadental.com/dentist-near-me-hennur";
const phoneCallUrl = "tel:+917349701002";
const whatsappUrl = "https://wa.me/917349701002?text=Hi%20Aureva%20Dental%2C%20I%27d%20like%20to%20book%20a%20visit.";
const mapsUrl = "https://maps.app.goo.gl/dhU4UySs9WFkHAzYA";
const canonicalAddress = "2nd floor, No.11, 4, Horamavu Agara Rd, near Nayara Petrol Bunk, Hennur Bande, Hennur Gardens, Bengaluru, Karnataka 560043";

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  robots: "noindex, follow",
  hideHeader: true,
  hideFooter: true,
  hideMobileBottomBar: true
};

const treatmentTiles = [
  {
    title: "Consultation",
    fee: "₹600 · includes digital X-ray · valid 6 months",
    isModal: true,
    treatmentParam: "Consultation"
  },
  {
    title: "Cleaning",
    fee: "₹2,000 – ₹5,000",
    url: "/treatments/scaling-and-polishing"
  },
  {
    title: "Root canal",
    fee: "₹4,000 – ₹10,000, depending on the tooth",
    url: "/root-canal-treatment-hennur"
  },
  {
    title: "Crowns and caps",
    fee: "₹4,000 – ₹18,000, depending on material",
    url: "/dental-crowns-hennur"
  },
  {
    title: "Wisdom tooth",
    fee: "₹4,000 – ₹10,000, depending on the case",
    url: "/wisdom-tooth-removal-hennur"
  },
  {
    title: "Whitening",
    fee: "₹8,000 – ₹15,000",
    url: "/teeth-whitening-hennur"
  },
  {
    title: "Gum treatment",
    fee: "Deep scaling ₹8,000 – ₹15,000",
    url: "/gum-treatment-hennur"
  },
  {
    title: "Kids dentistry",
    fee: "Check-up ₹600 · fillings ₹1,000 – ₹3,000",
    url: "/treatments/pediatric-dentistry"
  },
  {
    title: "Implants",
    fee: "Plan after consultation",
    url: "/dental-implants-hennur"
  },
  {
    title: "Aligners and braces",
    fee: "Plan after consultation",
    url: "/invisible-aligners-hennur"
  },
  {
    title: "Tooth pain or broken tooth",
    fee: "Consultation ₹600 + treatment · walk in till 9 PM",
    url: "/treatments/emergency-dentist"
  }
];

const faqs = [
  {
    q: "Are you open on Sundays?",
    a: "Yes. Tuesday to Sunday 9:30 AM–9 PM, Monday 4–9 PM."
  },
  {
    q: "Do I need an appointment?",
    a: "Walk-ins are welcome until 9 PM. Booking by call or WhatsApp helps us keep your slot ready."
  },
  {
    q: "How much is a consultation?",
    a: "₹600. It includes your digital X-ray and stays valid for 6 months. Treatment prices are listed above, and you get a written estimate before treatment starts."
  },
  {
    q: "Where do I park?",
    a: "There is free parking downstairs (2 cars, 5–8 bikes). The clinic is on the 2nd floor with a lift."
  },
  {
    q: "What if I need a specialist?",
    a: "MDS specialists across all dental specialties come in on a case basis, so we can arrange the right one for your case."
  }
];
---

<Layout {...seoProps}>
  <!-- Minimal Top Header: Logo + Call Button -->
  <header class="w-full bg-japandi-cream/95 backdrop-blur-sm border-b border-japandi-clay/30 sticky top-0 z-30">
    <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <img 
          src="/logo.webp" 
          alt="Aureva Dental logo" 
          width="130" 
          height="36" 
          class="h-8 w-auto object-contain" 
        />
      </div>

      <a 
        href={phoneCallUrl}
        class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-full bg-japandi-moss text-japandi-cream text-xs font-semibold uppercase tracking-wider hover:bg-japandi-charcoal transition-colors min-h-[48px] min-w-[48px]"
        aria-label="Call Aureva Dental Reception"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 shrink-0">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25z" />
        </svg>
        <span>Call</span>
      </a>
    </div>
  </header>

  <!-- First Screen Section (fits 390 x 844 px without scrolling) -->
  <section id="first-screen" class="px-4 pt-6 pb-8 max-w-xl mx-auto flex flex-col items-center text-center space-y-3.5">
    <div class="text-[11px] font-medium text-japandi-earth tracking-wide">
      Aureva Dental &middot; Hennur Bande, Bangalore
    </div>

    <h1 class="text-3xl sm:text-4xl font-serif text-japandi-charcoal font-medium leading-tight">
      Dental Clinic in Hennur
    </h1>

    <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed max-w-md">
      Open till 9 PM, Sundays included. 2nd floor with lift, free parking downstairs, near Nayara Petrol Bunk.
    </p>

    <!-- Open Status Chip (client island) -->
    <div class="pt-0.5">
      <OpenStatusChip client:idle />
    </div>

    <!-- Primary Action CTA Buttons (side-by-side) -->
    <div id="hero-actions" class="w-full grid grid-cols-2 gap-3 pt-1">
      <a 
        href={phoneCallUrl}
        class="flex items-center justify-center gap-2 py-3.5 px-4 rounded-full bg-japandi-moss hover:bg-japandi-charcoal text-japandi-cream font-semibold text-xs uppercase tracking-wider transition-all shadow-sm min-h-[48px]"
        aria-label="Call Aureva Dental"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 shrink-0">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25z" />
        </svg>
        <span>Call now</span>
      </a>

      <a 
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2 py-3.5 px-4 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs uppercase tracking-wider transition-all shadow-sm min-h-[48px]"
        aria-label="Chat on WhatsApp"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-4 h-4 shrink-0">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        <span>WhatsApp</span>
      </a>
    </div>

    <!-- Get Directions Link -->
    <div class="pt-0.5">
      <a 
        href={mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-xs font-medium text-japandi-moss hover:text-japandi-charcoal underline underline-offset-4 min-h-[48px] px-2"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
        </svg>
        <span>Get directions</span>
      </a>
    </div>

    <!-- Rating Label -->
    <div class="inline-flex items-center gap-1.5 pt-0.5 text-xs text-japandi-earth">
      <div class="flex text-amber-500 text-sm tracking-tight" aria-hidden="true">★★★★★</div>
      <span class="font-medium text-japandi-charcoal">5.0 (47 Google Reviews)</span>
    </div>
  </section>

  <!-- Treatments and Prices Grid Section -->
  <section class="py-10 px-4 max-w-4xl mx-auto border-t border-japandi-clay/20">
    <div class="text-center space-y-1.5 mb-6">
      <h2 class="text-2xl sm:text-3xl font-serif text-japandi-charcoal font-medium">
        Treatments and prices
      </h2>
      <p class="text-xs sm:text-sm text-japandi-earth font-light max-w-lg mx-auto">
        Prices are estimate ranges. You get your final quote in writing after examination.
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 sm:gap-4">
      {treatmentTiles.map((tile) => {
        if (tile.isModal) {
          return (
            <button 
              type="button"
              data-open-booking
              data-treatment={tile.treatmentParam}
              class="col-span-2 md:col-span-3 p-4 sm:p-5 rounded-2xl bg-japandi-sand/60 hover:bg-japandi-sand border-2 border-japandi-moss/40 hover:border-japandi-moss transition-all text-left flex flex-col justify-between shadow-sm group min-h-[48px]"
            >
              <div>
                <div class="flex items-center justify-between gap-2">
                  <span class="font-serif text-base sm:text-lg font-medium text-japandi-charcoal group-hover:text-japandi-moss">
                    {tile.title}
                  </span>
                  <span class="text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded-full bg-japandi-moss text-japandi-cream">
                    Book Visit &rarr;
                  </span>
                </div>
                <p class="text-xs sm:text-sm font-semibold text-japandi-moss mt-1">
                  {tile.fee}
                </p>
              </div>
              <span class="text-[11px] text-japandi-earth font-light mt-2 block">
                Tap to select your preferred appointment slot
              </span>
            </button>
          );
        }

        return (
          <a 
            href={tile.url}
            class="p-4 rounded-2xl bg-japandi-cream border border-japandi-clay/40 hover:border-japandi-moss transition-all flex flex-col justify-between group shadow-sm min-h-[48px]"
          >
            <div>
              <div class="flex items-center justify-between gap-1">
                <span class="font-serif text-xs sm:text-sm font-medium text-japandi-charcoal group-hover:text-japandi-moss line-clamp-1">
                  {tile.title}
                </span>
                <span class="text-xs text-japandi-earth group-hover:text-japandi-moss" aria-hidden="true">&rarr;</span>
              </div>
              <p class="text-[11px] sm:text-xs text-japandi-moss font-semibold mt-1">
                {tile.fee}
              </p>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- Copy Block: How Your First Visit Works -->
  <section class="py-10 px-4 max-w-4xl mx-auto border-t border-japandi-clay/20">
    <div class="space-y-6">
      <h2 class="text-xl sm:text-2xl font-serif text-japandi-charcoal font-medium text-center">
        How your first visit works
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="p-5 rounded-2xl bg-japandi-cream border border-japandi-clay/40 space-y-2">
          <div class="w-7 h-7 rounded-full bg-japandi-sand text-japandi-moss font-serif font-bold flex items-center justify-center text-xs">
            1
          </div>
          <h3 class="font-serif text-sm font-medium text-japandi-charcoal">
            Call, WhatsApp or walk in
          </h3>
          <p class="text-xs text-japandi-earth font-light leading-relaxed">
            Book a slot, or walk in any day until 9 PM.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-japandi-cream border border-japandi-clay/40 space-y-2">
          <div class="w-7 h-7 rounded-full bg-japandi-sand text-japandi-moss font-serif font-bold flex items-center justify-center text-xs">
            2
          </div>
          <h3 class="font-serif text-sm font-medium text-japandi-charcoal">
            Consultation (₹600)
          </h3>
          <p class="text-xs text-japandi-earth font-light leading-relaxed">
            Your dentist examines you. The consultation includes your digital X-ray and stays valid for 6 months.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-japandi-cream border border-japandi-clay/40 space-y-2">
          <div class="w-7 h-7 rounded-full bg-japandi-sand text-japandi-moss font-serif font-bold flex items-center justify-center text-xs">
            3
          </div>
          <h3 class="font-serif text-sm font-medium text-japandi-charcoal">
            A written estimate
          </h3>
          <p class="text-xs text-japandi-earth font-light leading-relaxed">
            You get the plan and fee range in writing before any treatment begins.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Copy Block: The Right Specialist For Your Case -->
  <section class="py-10 px-4 max-w-4xl mx-auto border-t border-japandi-clay/20">
    <div class="p-6 sm:p-8 rounded-3xl bg-japandi-sand/40 border border-japandi-clay/40 space-y-3">
      <h2 class="text-lg sm:text-xl font-serif text-japandi-charcoal font-medium">
        The right specialist for your case
      </h2>
      <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
        MDS specialists across all dental specialties come in on a case basis, so you get the right specialist without going elsewhere. For example an endodontist for complex root canals, an oral surgeon for wisdom teeth, a periodontist with laser for gum care, and a pedodontist for children. Sedation can be arranged for suitable cases. Talk to us on WhatsApp first.
      </p>
    </div>
  </section>

  <!-- Copy Block: One Standard on Every Visit -->
  <section class="py-10 px-4 max-w-4xl mx-auto border-t border-japandi-clay/20">
    <div class="space-y-6">
      <h2 class="text-xl sm:text-2xl font-serif text-japandi-charcoal font-medium text-center">
        One standard on every visit
      </h2>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
        <div class="p-4 rounded-2xl bg-japandi-cream border border-japandi-clay/40 flex flex-col items-center text-center space-y-2">
          <div class="w-8 h-8 rounded-full bg-japandi-sand flex items-center justify-center text-japandi-moss">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
            </svg>
          </div>
          <span class="text-xs font-medium text-japandi-charcoal">
            Strict sterilisation protocol
          </span>
        </div>

        <div class="p-4 rounded-2xl bg-japandi-cream border border-japandi-clay/40 flex flex-col items-center text-center space-y-2">
          <div class="w-8 h-8 rounded-full bg-japandi-sand flex items-center justify-center text-japandi-moss">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
            </svg>
          </div>
          <span class="text-xs font-medium text-japandi-charcoal">
            Prices quoted before treatment
          </span>
        </div>

        <div class="p-4 rounded-2xl bg-japandi-cream border border-japandi-clay/40 flex flex-col items-center text-center space-y-2">
          <div class="w-8 h-8 rounded-full bg-japandi-sand flex items-center justify-center text-japandi-moss">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
          </div>
          <span class="text-xs font-medium text-japandi-charcoal">
            Open evenings and Sundays
          </span>
        </div>

        <div class="p-4 rounded-2xl bg-japandi-cream border border-japandi-clay/40 flex flex-col items-center text-center space-y-2">
          <div class="w-8 h-8 rounded-full bg-japandi-sand flex items-center justify-center text-japandi-moss">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="m15.75 10.5 4.72-4.72a.75.75 0 0 1 1.28.53v11.38a.75.75 0 0 1-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 0 0 2.25-2.25v-9a2.25 2.25 0 0 0-2.25-2.25h-9A2.25 2.25 0 0 0 2.25 7.5v9a2.25 2.25 0 0 0 2.25 2.25Z" />
            </svg>
          </div>
          <span class="text-xs font-medium text-japandi-charcoal">
            Digital RVG X-ray and intraoral camera in the clinic
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Clinic Photos Gallery Section (5 photos, below fold, lazy loaded) -->
  <section class="py-10 px-4 max-w-4xl mx-auto border-t border-japandi-clay/20">
    <div class="space-y-6">
      <div class="text-center space-y-1">
        <h2 class="text-xl sm:text-2xl font-serif text-japandi-charcoal font-medium">
          Inside Aureva Dental
        </h2>
        <p class="text-xs text-japandi-earth font-light">
          Calm, modern Japandi studio designed for your comfort.
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
        <div class="col-span-2 md:col-span-1 rounded-2xl overflow-hidden border border-japandi-clay/40 bg-japandi-sand/30 shadow-sm">
          <img 
            src="/assets/near-me/clinic_signage_exterior.webp" 
            alt="Aureva Dental clinic exterior signage, Hennur Bande" 
            width="900" 
            height="506" 
            loading="lazy" 
            decoding="async"
            class="w-full h-44 sm:h-52 object-cover" 
          />
        </div>

        <div class="rounded-2xl overflow-hidden border border-japandi-clay/40 bg-japandi-sand/30 shadow-sm">
          <img 
            src="/assets/near-me/reception_desk_aureva.webp" 
            alt="Aureva Dental reception desk, Hennur Bande" 
            width="675" 
            height="900" 
            loading="lazy" 
            decoding="async"
            class="w-full h-44 sm:h-52 object-cover" 
          />
        </div>

        <div class="rounded-2xl overflow-hidden border border-japandi-clay/40 bg-japandi-sand/30 shadow-sm">
          <img 
            src="/assets/near-me/treatment_operatory_chair.webp" 
            alt="Modern dental operatory treatment chair with window view at Aureva Dental" 
            width="900" 
            height="675" 
            loading="lazy" 
            decoding="async"
            class="w-full h-44 sm:h-52 object-cover" 
          />
        </div>

        <div class="rounded-2xl overflow-hidden border border-japandi-clay/40 bg-japandi-sand/30 shadow-sm">
          <img 
            src="/assets/near-me/waiting_lounge_sofa.webp" 
            alt="Calm Japandi waiting lounge sofa at Aureva Dental" 
            width="675" 
            height="900" 
            loading="lazy" 
            decoding="async"
            class="w-full h-44 sm:h-52 object-cover" 
          />
        </div>

