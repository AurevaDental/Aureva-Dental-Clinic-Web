        </div>
      </div>
    </div>
  </section>

  <!-- 5. Inside Aureva Dental Section (Real clinic photos from /assets/near-me/ only) -->
  <section class="py-10 px-4 max-w-4xl mx-auto border-t border-japandi-clay/20">
