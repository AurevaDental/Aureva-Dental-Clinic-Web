    <div class="max-w-xl mx-auto space-y-2">
      <p class="font-serif text-base text-japandi-charcoal font-medium">Aureva Dental</p>
      <p>{canonicalAddress}</p>
      <p>
        Phone: <a href={phoneCallUrl} class="text-japandi-moss hover:underline font-medium">+91 73497 01002</a>
      </p>
      <div class="flex items-center justify-center gap-4 pt-2">
        <a href="/privacy-policy" class="hover:text-japandi-moss underline underline-offset-2">Privacy Policy</a>
        <span>&bull;</span>
        <a href="/terms-and-conditions" class="hover:text-japandi-moss underline underline-offset-2">Terms &amp; Conditions</a>
      </div>
      <p class="text-[11px] text-japandi-clay pt-2">
