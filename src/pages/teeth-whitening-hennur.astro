---
import { CANONICAL_PRICES } from '../data/prices';
import Layout from '../layouts/Layout.astro';
import { generateBreadcrumbSchema, generateFaqSchema, generateTreatmentServiceSchema } from '../utils/seoSchemas';
import TreatmentDepartmentCard from '../components/TreatmentDepartmentCard.astro';
import TreatmentAftercare from '../components/TreatmentAftercare.astro';
import TreatmentActions from '../components/TreatmentActions.astro';

const pageTitle = "Teeth Whitening in Hennur Bangalore | Aureva Dental";
const pageDescription = "Professional LED/Laser whitening: LED as standard, laser available depending on the case, in Hennur, Bangalore at Aureva Dental. Gentle enamel care and visible shade brightening. Call +91 73497 01002.";
const canonicalUrl = "https://aurevadental.com/teeth-whitening-hennur";
const phoneCallUrl = "tel:+917349701002";
const whatsappUrl = "https://wa.me/917349701002?text=Hello%20Aureva%20Dental%2C%20I%20would%20like%20to%20book%20a%20consultation%20for%20Teeth%20Whitening%20in%20Hennur.";

const breadcrumbs = [
  { name: "Home", url: "https://aurevadental.com/" },
  { name: "Teeth Whitening in Hennur", url: canonicalUrl }
];

const faqs = [
  {
    question: "Does professional teeth whitening damage enamel?",
    answer: "No. Professional teeth whitening performed at Aureva Dental uses pH-neutral formulations with built-in desensitizers. LED light activates the oxygenating gel to gently dissolve deep chromogens embedded inside enamel micro-pores without softening, etching, or weakening the enamel matrix."
  },
  {
    question: "How long does an in-office teeth whitening session take?",
    answer: "A complete in-office whitening session takes about 45 to 60 minutes. Results vary depending on your starting enamel shade and dietary habits; your clinician will guide you on realistic outcomes."
  },
  {
    question: "How long do professional teeth whitening results last?",
    answer: "Whitening outcomes typically last 1 to 3 years. Maintaining good oral hygiene, limiting deeply pigmented beverages like tea and coffee, avoiding tobacco smoking, and receiving routine 6-month cleanings will preserve your results."
  },
  {
    question: "What is the cost of professional teeth whitening in Hennur, Bangalore?",
    answer: `At Aureva Dental, in-office LED/Laser whitening sessions range from ${CANONICAL_PRICES.whitening_in_clinic}. Take-home customized whitening trays range from ${CANONICAL_PRICES.whitening_take_home}. Transparent pricing is confirmed during your consultation.`
  }
];

const breadcrumbSchema = JSON.stringify(generateBreadcrumbSchema(breadcrumbs));
const faqSchema = JSON.stringify(generateFaqSchema(faqs));
const serviceSchema = JSON.stringify(generateTreatmentServiceSchema({
  name: "Teeth Whitening in Hennur",
  description: pageDescription,
  url: canonicalUrl,
  medicalSpecialty: "CosmeticDentistry"
}));

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogUrl: canonicalUrl,
  schemaMarkup: [breadcrumbSchema, faqSchema, serviceSchema]
};
---

<Layout {...seoProps}>
  <!-- Breadcrumb Navigation -->
  <nav class="bg-japandi-sand/30 border-b border-japandi-clay/20 py-3.5 px-6 lg:px-24 text-xs font-light text-japandi-earth" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <a href="/" class="hover:text-japandi-moss transition-colors">Home</a>
        <span>/</span>
        <span class="text-japandi-charcoal font-medium">Teeth Whitening in Hennur</span>
      </div>
      <a href="#pricing" class="inline-flex items-center gap-1 text-xs font-semibold text-japandi-moss hover:underline">
        Prices &darr;
      </a>
    </div>
  </nav>

  <!-- 1. Hero / H1 Section -->
  <section class="py-12 md:py-20 px-6 lg:px-24 bg-transparent relative overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <div class="lg:col-span-7 flex flex-col items-start space-y-4 md:space-y-6 animate-slow-fade">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-japandi-clay/60 bg-japandi-sand/70 text-[10px] font-semibold text-japandi-moss uppercase tracking-widest">
          Aesthetic Dentistry &bull; Hennur Bande, Bangalore
        </div>
        
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif text-japandi-charcoal leading-tight font-medium tracking-tight">
          Teeth Whitening in Hennur
        </h1>

        <div class="w-full bg-japandi-sand/40 border border-japandi-clay/30 rounded-2xl p-3.5 space-y-1.5 text-xs text-japandi-earth">
          <p class="flex items-center gap-2 font-medium text-japandi-charcoal">
            <span>Hours: Mon 4–9 PM, Tue–Sun 9:30 AM–9 PM</span>
          </p>
          <p>2nd Floor, Horamavu Agara Road, near Nayara Petrol Bunk, Hennur Bande. Lift and parking available.</p>
        </div>

        <p class="text-sm sm:text-base text-japandi-earth font-light leading-relaxed max-w-2xl">
          Professional in-clinic teeth brightening using light-activated whitening gels with integrated desensitizing agents. Gentle on enamel, visibly brighter in a single 60-minute visit.
        </p>

        <!-- CTA Buttons -->
        <div class="pt-2 flex flex-wrap items-center gap-3 w-full sm:w-auto">
          <button 
            type="button"
            data-open-booking
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-japandi-moss text-japandi-cream hover:bg-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 shadow-sm"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
            </svg>
            <span>Book Whitening Visit</span>
          </button>

          <a 
            href={phoneCallUrl}
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 border border-japandi-clay bg-japandi-sand/50 hover:bg-japandi-sand text-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-japandi-moss">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
            </svg>
            <span>Call: +91 73497 01002</span>
          </a>
        </div>
      </div>

      <!-- Quick Feature Card -->
      <div class="lg:col-span-5 relative">
        <div class="p-8 rounded-3xl bg-japandi-sand/50 border border-japandi-clay/40 shadow-sm space-y-4">
          <span class="text-xs uppercase font-semibold text-japandi-moss tracking-widest block">Clinical Care</span>
          <h3 class="font-serif text-xl font-medium text-japandi-charcoal">Safe Whitening Process</h3>
          <ul class="space-y-3 text-xs font-light text-japandi-earth">
            <li class="flex items-start gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-japandi-moss mt-1.5 shrink-0"></span>
              <div><strong class="text-japandi-charcoal font-medium">Gingival Barrier Protection:</strong> Gum tissues are protected with a light-cured barrier before gel application.</div>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-japandi-moss mt-1.5 shrink-0"></span>
              <div><strong class="text-japandi-charcoal font-medium">pH-Neutral Formula:</strong> Formulations that preserve enamel micro-hardness and mineral density.</div>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-japandi-moss mt-1.5 shrink-0"></span>
              <div><strong class="text-japandi-charcoal font-medium">Special Occasion Ready:</strong> Ideal for pre-wedding radiance, milestone photos, and professional events.</div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Who It's For (Symptoms in Plain Words) -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Candidates</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Who teeth whitening is for
        </h2>
      </div>
      <p class="text-sm sm:text-base text-japandi-earth font-light leading-relaxed">
        Professional teeth whitening is recommended for healthy adult smiles with:
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm text-japandi-earth font-light">
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Coffee, Tea &amp; Food Stains</h3>
          <p>Deeper stains caused by years of drinking chai, black coffee, or eating spiced foods.</p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Tobacco &amp; Smoking Discoloration</h3>
          <p>Yellow or brownish tar and nicotine stains embedded into outer enamel layers.</p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Natural Age-Related Yellowing</h3>
          <p>Thinning enamel revealing darker underlying yellowish dentin as part of natural aging.</p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Post-Orthodontic Brightening</h3>
          <p>Brightening the entire smile zone after completing clear aligners or fixed braces.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. What Happens, Visit by Visit, & Number of Sittings -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-8">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Clinical Protocol</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          What happens, visit by visit
        </h2>
        <p class="text-sm sm:text-base text-japandi-earth font-light mt-2">
          In-office teeth whitening is completed in 1 single sitting (about 60 minutes).
        </p>
      </div>

      <div class="space-y-4 text-xs sm:text-sm text-japandi-earth font-light">
        <div class="p-6 rounded-2xl bg-japandi-sand/30 border border-japandi-clay/40 space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">Step 1: Shade Baseline &amp; Gum Isolation</h3>
            <span class="text-[10px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded bg-japandi-moss/10 text-japandi-moss">Sitting 1</span>
          </div>
          <p class="leading-relaxed">
            Starting shade is recorded with a dental shade guide. Teeth are cleaned of superficial plaque, lips are retracted, and a light-cured resin barrier is placed over the gums.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-japandi-sand/30 border border-japandi-clay/40 space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">Step 2: Whitening Gel Cycles &amp; Desensitizing Care</h3>
            <span class="text-[10px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded bg-japandi-moss/10 text-japandi-moss">Sitting 1</span>
          </div>
          <p class="leading-relaxed">
            Professional whitening gel is applied to the teeth and activated with an LED light for two to three 15-minute cycles. Finally, a remineralizing desensitizing paste is applied.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Price Table from Keys -->
  <section id="pricing" class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Transparent Pricing</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Teeth whitening fees
        </h2>
        <p class="text-xs sm:text-sm text-japandi-earth font-light mt-1">
          Prices are ranges, confirmed after examination.
        </p>
      </div>

      <div class="rounded-2xl border border-japandi-clay/40 overflow-hidden bg-japandi-cream/90 shadow-sm">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-japandi-sand/60 text-japandi-charcoal font-serif border-b border-japandi-clay/30">
            <tr>
              <th class="py-3 px-4">Treatment</th>
              <th class="py-3 px-4">Price Range</th>
              <th class="py-3 px-4 hidden sm:table-cell">Details</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-japandi-clay/20 text-japandi-earth font-light">
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">In-Office LED Whitening</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.whitening_in_clinic}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Single clinical whitening session</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">Take-Home Custom Whitening Trays</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.whitening_take_home}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Custom-molded trays with whitening syringe kit</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">Consultation with Digital X-Ray</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.consultation}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Valid for 6 months</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-xs text-japandi-earth font-light">
        See our complete pricing catalog on the <a href="/prices" class="text-japandi-moss underline decoration-japandi-moss/40 hover:decoration-japandi-moss font-medium">treatment prices</a> page.
      </p>
    </div>
  </section>

  <!-- 5. Which Department Handles It -->
  <TreatmentDepartmentCard 
    department="Aesthetic & Restorative Dentistry"
    link="/our-specialists#aesthetic"
    description="Professional shade diagnostics, in-office LED whitening, and custom take-home whitening plans are directed by visiting aesthetic dental specialists."
  />

  <!-- 6. Aftercare and When to Call Us -->
  <TreatmentAftercare 
    instructions={[
      "Follow the 'White Diet' for 48 hours: choose white poultry, steamed rice, milk, paneer, and clear liquids; avoid dark curries, turmeric, tea, coffee, and berries.",
      "Avoid smoking or tobacco use for at least 48 hours while enamel pores are rehydrating.",
      "Use a potassium nitrate or fluoridated desensitizing toothpaste if you experience mild temperature sensitivity.",
      "Maintain twice-daily brushing and routine 6-month cleanings to extend your brighter shade."
    ]}
    whenToCall={[
      "Tooth sensitivity is intense and does not improve with desensitizing toothpaste after 48 hours.",
      "You notice persistent irritation or a burning sensation on the gums."
    ]}
  />

  <!-- 7. FAQs (with Schema) -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-8">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Common Questions</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Frequently asked questions
        </h2>
      </div>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <div class="bg-japandi-cream/90 border border-japandi-clay/40 rounded-2xl p-6 space-y-2">
            <h3 class="font-serif text-base sm:text-lg text-japandi-charcoal font-medium">
              {faq.question}
            </h3>
            <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. Related Treatments -->
  <section class="py-16 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <h2 class="text-xl sm:text-2xl font-serif text-japandi-charcoal font-medium">
        Related treatments
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
        <a href="/treatments/cosmetic-dentistry" class="p-4 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 hover:border-japandi-moss transition-colors block space-y-1">
          <span class="font-serif text-sm text-japandi-charcoal font-medium block">Cosmetic Dentistry</span>
          <span class="text-japandi-earth font-light">Veneers, bonding &amp; smile design</span>
        </a>
        <a href="/treatments/scaling-and-polishing" class="p-4 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 hover:border-japandi-moss transition-colors block space-y-1">
          <span class="font-serif text-sm text-japandi-charcoal font-medium block">Scaling &amp; Polishing</span>
          <span class="text-japandi-earth font-light">Surface tartar and stain removal</span>
        </a>
        <a href="/treatments/clear-aligners" class="p-4 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 hover:border-japandi-moss transition-colors block space-y-1">
          <span class="font-serif text-sm text-japandi-charcoal font-medium block">Clear Aligners</span>
          <span class="text-japandi-earth font-light">Discreet teeth alignment before whitening</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 9. Book / WhatsApp / Call -->
  <TreatmentActions treatmentName="Teeth Whitening Consultation" />
</Layout>
