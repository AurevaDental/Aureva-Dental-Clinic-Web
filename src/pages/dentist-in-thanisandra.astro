---
import Layout from '../layouts/Layout.astro';
import { GOOGLE_RATING, GOOGLE_REVIEW_COUNT, GOOGLE_REVIEWS_LABEL } from '../config/clinic';
import { CANONICAL_PRICES } from '../data/prices';

const pageTitle = "Dentist in Thanisandra, Bengaluru | Aureva Dental, 3.7 km away";
const pageDescription = "Dentist near Thanisandra & Nagawara, 3.7 km away. Open 7 days with ₹600 consultation including digital X-ray. Walk in or call to book.";
const canonicalUrl = "https://aurevadental.com/dentist-in-thanisandra";
const phoneCallUrl = "tel:+917349701002";
const whatsappUrl = "https://wa.me/917349701002?text=Hi%20Aureva%20Dental%2C%20I%20am%20visiting%20from%20Thanisandra%20and%20would%20like%20to%20consult.";
const directionsUrl = "https://www.google.com/maps/dir/?api=1&origin=Thanisandra,+Bengaluru&destination=Aureva+Dental,+Horamavu+Agara+Rd,+Hennur+Bande,+Bengaluru";
const canonicalAddress = "2nd floor, No.11, 4, Horamavu Agara Rd, near Nayara Petrol Bunk, Hennur Bande, Hennur Gardens, Bengaluru, Karnataka 560043";

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  robots: "index, follow",
  hideHeader: false,
  hideFooter: false,
  hideMobileBottomBar: false
};

const treatmentPricing = [
  { name: "Consultation & Digital RVG X-Ray", price: CANONICAL_PRICES.consultation, note: "Valid for 6 months" },
  { name: "Scaling & Polishing (Hygiene)", price: CANONICAL_PRICES.scaling_routine, note: "Ultrasonic tartar removal" },
  { name: "Composite Tooth Filling", price: CANONICAL_PRICES.tooth_filling, note: "Tooth-colored biomimetic resin" },
  { name: "Root Canal Treatment (Rotary RCT)", price: CANONICAL_PRICES.rct_overall, note: "Gentle single or multi-visit" },
  { name: "Crowns & Caps (PFM, Ceramic, Zirconia)", price: CANONICAL_PRICES.crown_overall, note: "Custom laboratory fabricated" },
  { name: "Wisdom Tooth Removal", price: CANONICAL_PRICES.wisdom_hennur_faq_overall, note: "Simple & surgical impactions" },
  { name: "Teeth Whitening", price: CANONICAL_PRICES.whitening_laser, note: "In-office LED brightening" },
  { name: "Kids Dentistry (Pediatric Care)", price: CANONICAL_PRICES.kids_dentistry_summary, note: "Gentle cavity care & sealants" },
  { name: "Dental Implants", price: CANONICAL_PRICES.implant_single_fixture, note: "Titanium replacement tooth" },
  { name: "Clear Aligners", price: CANONICAL_PRICES.clear_aligners_overall, note: "Custom 3D invisible trays" }
];

const faqs = [
  {
    q: "Is there a dental clinic near Manyata Tech Park open after office hours?",
    a: "Yes. Aureva Dental is located just 3.5 km from Manyata Tech Park (about 15 minutes away) and stays open until 9:00 PM Tuesday through Sunday, as well as Monday from 4:00 PM to 9:00 PM. Many software engineers, managers, and corporate employees working in Manyata schedule late consultations after their work shifts to address dental health without taking leave during the day."
  },
  {
    q: "Can I schedule a dental appointment on Sunday near Thanisandra?",
    a: "Yes. We operate a full Sunday dental clinic from 9:30 AM to 9:00 PM every single week. This makes it effortless for residents in Thanisandra, Nagawara, and nearby residential societies to complete routine hygiene cleanings, orthodontic evaluations, and restorative procedures on weekends without rushing."
  },
  {
    q: "How far is the clinic from Thanisandra and Nagawara?",
    a: "Aureva Dental is 3.7 km from Thanisandra (about 13 minutes via Thanisandra Main Road and Hennur Main Road) and 3.6 km from Nagawara (about 16 minutes via Hennur Main Road). Drive times change with traffic. Our dental clinic is situated on the 2nd floor with lift access. Parking available for 4-wheelers and 2-wheelers."
  },
  {
    q: "What is the teeth cleaning cost at Aureva Dental?",
    a: "Routine ultrasonic scaling and prophy polishing ranges from ₹2,000 to ₹5,000, depending on the presence of stubborn tea, coffee, or smoke stains and calculus buildup. The procedure gently removes bacterial plaque and surface stains while preserving natural tooth enamel."
  },
  {
    q: "What are your consultation fees and scheduling options?",
    a: "Our comprehensive new-patient consultation is ₹600 and includes low-radiation digital RVG X-rays as clinically indicated, staying valid for 6 months. Walk-ins are welcomed until 9:00 PM, or you can reserve a prioritized slot by phone call or WhatsApp message."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};
---

<Layout {...seoProps} schemaMarkup={[JSON.stringify(faqSchema)]}>
  <main class="min-h-screen bg-japandi-cream text-japandi-charcoal">
    <!-- Hero Section -->
    <section class="px-4 sm:px-6 lg:px-24 pt-12 pb-10 max-w-5xl mx-auto text-center space-y-5">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-japandi-moss/10 text-japandi-moss text-xs font-semibold uppercase tracking-wider">
        <span>Convenient Dental Care &middot; 3.7 km from Thanisandra</span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-serif text-japandi-charcoal font-medium tracking-tight">
        Dentist near Thanisandra
      </h1>

      <p class="text-sm sm:text-base text-japandi-earth font-light max-w-2xl mx-auto leading-relaxed">
        Modern, gentle dentistry for working professionals and families in Thanisandra, Nagawara, and Manyata Tech Park. Open late until 9 PM and full days on Sunday.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <a 
          href={phoneCallUrl}
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-japandi-moss hover:bg-japandi-charcoal text-japandi-cream font-medium text-xs uppercase tracking-wider transition-all shadow-sm"
        >
          Call 073497 01002
        </a>
        <a 
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full border border-japandi-clay bg-japandi-sand/80 hover:bg-japandi-sand text-japandi-charcoal font-medium text-xs uppercase tracking-wider transition-all"
        >
          WhatsApp Us
        </a>
        <a 
          href={directionsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full border border-japandi-clay bg-japandi-sand/80 hover:bg-japandi-sand text-japandi-charcoal font-medium text-xs uppercase tracking-wider transition-all"
        >
          Get Directions
        </a>
      </div>

      {GOOGLE_RATING > 0 && GOOGLE_REVIEW_COUNT > 0 && (
        <div class="pt-2 flex items-center justify-center gap-2 text-xs text-japandi-earth">
          <span class="text-amber-500 tracking-tight">★ ★ ★ ★ ★</span>
          <span class="font-semibold text-japandi-charcoal">{GOOGLE_RATING.toFixed(1)}</span>
          <span>({GOOGLE_REVIEW_COUNT} Google Reviews)</span>
        </div>
      )}
    </section>

    <!-- Route from Thanisandra and Nagawara -->
    <section class="py-10 px-4 sm:px-6 lg:px-24 max-w-4xl mx-auto border-t border-japandi-clay/20">
      <div class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-serif text-japandi-charcoal font-medium">
          Route from Thanisandra and Nagawara
        </h2>
        <div class="bg-japandi-sand/40 border border-japandi-clay/40 rounded-2xl p-6 sm:p-8 space-y-4">
          <p class="text-sm sm:text-base text-japandi-charcoal font-normal leading-relaxed">
            From Thanisandra, head southeast along Thanisandra Main Road and connect via Hennur Main Road towards Hennur Bande, turning onto Horamavu Agara Road near Nayara Petrol Bunk in about 13 minutes over 3.7 km. Patients traveling from Nagawara take Hennur Main Road directly for roughly 16 minutes across 3.6 km, while professionals departing Manyata Tech Park arrive within 15 minutes across 3.5 km. Drive times change with traffic. Our clinic is positioned on the 2nd floor with lift access. Parking available for 4-wheelers and 2-wheelers.
          </p>
          <div class="pt-2 flex flex-wrap items-center justify-between gap-3 text-xs text-japandi-earth border-t border-japandi-clay/30">
            <span>Thanisandra: 3.7 km &middot; about 13 min</span>
            <span>Nagawara: 3.6 km &middot; about 16 min</span>
            <span>Manyata Tech Park: 3.5 km &middot; about 15 min</span>
            <a 
              href={directionsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-japandi-moss font-semibold hover:underline"
            >
              Open Google Maps Route &rarr;
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- When people from Thanisandra visit us -->
    <section class="py-10 px-4 sm:px-6 lg:px-24 max-w-4xl mx-auto border-t border-japandi-clay/20">
      <div class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-serif text-japandi-charcoal font-medium">
          When people from Thanisandra visit us
        </h2>
        <div class="space-y-4 text-sm sm:text-base text-japandi-earth font-light leading-relaxed">
          <p>
            Working professionals and tech campus employees from Thanisandra, Nagawara, and Manyata Tech Park routinely choose our clinic because standard nine-to-five clinic hours conflict with corporate project sprints, team standups, and evening traffic. Taking leave for routine dental check-ups is inconvenient, which is why our late evening appointments until 9 PM and full-day Sunday scheduling provide a welcome alternative. Many corporate workers drop in right after logging off or after commuting from Manyata Gates 1 and 2, taking advantage of a calm Japandi lounge environment to unwind.
          </p>
          <p>
            Apartment dwellers and young families residing across Thanisandra Main Road appreciate our commitment to punctual scheduling and complete treatment transparency. We respect professional calendars by avoiding long waiting room delays. In addition, our clinicians explain every procedure with intraoral imagery and provide written cost estimates beforehand, eliminating unexpected financial surprises and ensuring a predictable, relaxed experience.
          </p>
          <p>
            Whether coming in for an evening consultation following a busy office shift or scheduling a relaxed Sunday family hygiene check-up, visitors from Nagawara and Thanisandra find our nearby location on Horamavu Agara Road exceptionally practical and easy to reach. By offering late consultations and Sunday slots, we ensure that comprehensive dental care fits naturally into intense tech work schedules without compromise.
          </p>
        </div>
      </div>
    </section>

    <!-- Treatments people from Thanisandra often ask about -->
    <section class="py-10 px-4 sm:px-6 lg:px-24 max-w-4xl mx-auto border-t border-japandi-clay/20">
      <div class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-serif text-japandi-charcoal font-medium">
          Treatments people from Thanisandra often ask about
        </h2>
        <div class="space-y-4 text-sm sm:text-base text-japandi-earth font-light leading-relaxed">
          <p>
            Tech employees and residents from Thanisandra and Nagawara frequently schedule appointments for comprehensive dental hygiene, aesthetic brightening, and durable crown restorations. Routine ultrasonic scaling and prophy polishing ranges from ₹2,000 to ₹5,000, effectively removing stubborn coffee, tea, and tobacco discoloration accumulated during long work hours. In-office laser teeth whitening sessions ranging from ₹8,000 to ₹15,000 are popular among professionals preparing for weddings, client presentations, or social milestones.
          </p>
          <p>
            For fractured, cracked, or root-treated teeth, durable all-ceramic and zirconia crowns ranging from ₹4,000 to ₹18,000 provide lasting chewing stability and natural appearance. Working adults seeking teeth straightening without visible metal wires regularly consult our visiting orthodontist regarding removable clear aligners ranging from ₹80,000 to ₹2,50,000.
          </p>
          <p>
            If sudden dental pain arises, our walk-in emergency protocols until 9:00 PM accommodate immediate clinical relief, single or two-visit rotary root canals ranging from ₹4,000 to ₹10,000, and tooth extractions starting at ₹1,500. New-patient consultations are ₹600, including digital RVG X-rays, and remain active for six months so you can review options on your own schedule. With clear written breakdowns provided before treatment starts, professionals can manage healthcare expenditures with full transparency.
          </p>
        </div>
      </div>
    </section>

    <!-- Clinic Standards & Diagnostic Equipment -->
    <section class="py-10 px-4 sm:px-6 lg:px-24 max-w-4xl mx-auto border-t border-japandi-clay/20">
      <div class="space-y-5">
        <h2 class="text-2xl sm:text-3xl font-serif text-japandi-charcoal font-medium">
          Modern technology and hygiene protocols
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="p-5 rounded-2xl bg-japandi-sand/50 border border-japandi-clay/40 space-y-2">
            <h3 class="font-serif text-base font-medium text-japandi-charcoal">Digital RVG Sensor</h3>
            <p class="text-xs text-japandi-earth font-light leading-relaxed">
              Provides instantaneous digital radiographic diagnostic images with minimal radiation exposure, displaying deep tooth structures directly on chairside screens.
            </p>
          </div>
          <div class="p-5 rounded-2xl bg-japandi-sand/50 border border-japandi-clay/40 space-y-2">
            <h3 class="font-serif text-base font-medium text-japandi-charcoal">Intraoral Video Camera</h3>
            <p class="text-xs text-japandi-earth font-light leading-relaxed">
              High-resolution intraoral optics stream live magnified views of tooth surfaces and margins so you inspect what needs treatment with complete transparency.
            </p>
          </div>
          <div class="p-5 rounded-2xl bg-japandi-sand/50 border border-japandi-clay/40 space-y-2">
            <h3 class="font-serif text-base font-medium text-japandi-charcoal">Rigorous Autoclaving</h3>
            <p class="text-xs text-japandi-earth font-light leading-relaxed">
              Complete multi-stage instrument sterilisation using medical autoclaves, single-use barriers, and hospital-grade sanitization between every consultation.
            </p>
          </div>
        </div>
        <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
          For specialized clinical interventions, visiting MDS specialists—spanning prosthodontics, endodontics, orthodontics, periodontics, oral and maxillofacial surgery, and paedodontics—visit our Horamavu Agara Road clinic on a case basis to deliver targeted multidisciplinary care. This visiting specialist model ensures that technical orthodontic adjustments, surgical impactions, or specialized gum therapies receive experienced clinical oversight in an environment designed around patient safety.
        </p>
      </div>
    </section>

    <!-- Treatments and Prices -->
    <section class="py-10 px-4 sm:px-6 lg:px-24 max-w-4xl mx-auto border-t border-japandi-clay/20">
      <div class="space-y-4">
        <div class="text-center sm:text-left space-y-1">
          <h2 class="text-2xl sm:text-3xl font-serif text-japandi-charcoal font-medium">
            Treatments and prices
          </h2>
          <p class="text-xs sm:text-sm text-japandi-earth font-light">
            Prices are published estimate ranges. You receive an itemized, written quote after clinical examination.
          </p>
        </div>

        <div class="bg-japandi-cream border border-japandi-clay/40 rounded-2xl divide-y divide-japandi-clay/20 overflow-hidden shadow-sm">
          {treatmentPricing.map((item) => (
            <div class="p-4 sm:px-6 sm:py-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-1 text-xs sm:text-sm">
              <div>
                <span class="font-medium text-japandi-charcoal block sm:inline">{item.name}</span>
                <span class="text-[11px] text-japandi-earth font-light sm:ml-2">({item.note})</span>
              </div>
              <span class="font-semibold text-japandi-moss shrink-0">{item.price}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- How your first visit works -->
    <section class="py-10 px-4 sm:px-6 lg:px-24 max-w-4xl mx-auto border-t border-japandi-clay/20">
      <div class="space-y-6">
        <div class="text-center sm:text-left space-y-1">
          <h2 class="text-2xl sm:text-3xl font-serif text-japandi-charcoal font-medium">
            How your first visit works
          </h2>
          <p class="text-xs sm:text-sm text-japandi-earth font-light">
            A structured, unhurried initial evaluation designed around your comfort and complete financial transparency.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="p-6 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/30 space-y-2">
            <span class="w-7 h-7 rounded-full bg-japandi-moss text-japandi-cream text-xs font-semibold flex items-center justify-center">1</span>
            <h3 class="font-serif text-base font-medium text-japandi-charcoal pt-1">Examination &amp; Digital X-Ray</h3>
            <p class="text-xs text-japandi-earth font-light leading-relaxed">
              We begin with a thorough examination of teeth, gums, and bite alignment. Low-radiation RVG digital X-rays are taken to inspect beneath the surface. Consultation is ₹600 and stays valid for 6 months.
            </p>
          </div>
          <div class="p-6 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/30 space-y-2">
            <span class="w-7 h-7 rounded-full bg-japandi-moss text-japandi-cream text-xs font-semibold flex items-center justify-center">2</span>
            <h3 class="font-serif text-base font-medium text-japandi-charcoal pt-1">Clear Explanation &amp; Written Plan</h3>
            <p class="text-xs text-japandi-earth font-light leading-relaxed">
              We review clinical findings on screen using intraoral camera photos and radiographs. You receive a clear, printed estimate detailing treatment steps, timelines, and exact pricing before anything starts.
            </p>
          </div>
          <div class="p-6 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/30 space-y-2">
            <span class="w-7 h-7 rounded-full bg-japandi-moss text-japandi-cream text-xs font-semibold flex items-center justify-center">3</span>
            <h3 class="font-serif text-base font-medium text-japandi-charcoal pt-1">Treatment at Your Pace</h3>
            <p class="text-xs text-japandi-earth font-light leading-relaxed">
              Begin necessary care on the same day if you wish, or schedule subsequent visits at times convenient for your calendar. There is never pressure to proceed until you feel fully prepared.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Questions people in Thanisandra ask us -->
    <section class="py-10 px-4 sm:px-6 lg:px-24 max-w-4xl mx-auto border-t border-japandi-clay/20">
      <div class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-serif text-japandi-charcoal font-medium">
          Questions people in Thanisandra ask us
        </h2>
        <div class="divide-y divide-japandi-clay/30 border border-japandi-clay/40 rounded-2xl bg-japandi-cream overflow-hidden">
          {faqs.map((faq) => (
            <div class="p-5 sm:p-6 space-y-2">
              <h3 class="font-serif text-base font-medium text-japandi-charcoal">
                {faq.q}
              </h3>
              <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
                {faq.a}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Find Us / Contact Block -->
    <section class="py-10 px-4 sm:px-6 lg:px-24 max-w-4xl mx-auto border-t border-japandi-clay/20">
      <div class="bg-japandi-sand/60 border border-japandi-clay/40 rounded-3xl p-6 sm:p-8 space-y-4">
        <h2 class="text-xl sm:text-2xl font-serif text-japandi-charcoal font-medium">
          Find Aureva Dental
        </h2>
        <div class="space-y-1.5 text-xs sm:text-sm text-japandi-earth font-light">
          <p><strong class="font-medium text-japandi-charcoal">Address:</strong> {canonicalAddress}</p>
          <p><strong class="font-medium text-japandi-charcoal">Landmark:</strong> Horamavu Agara Road, near Nayara Petrol Bunk, Hennur Bande (2nd floor with lift access).</p>
          <p><strong class="font-medium text-japandi-charcoal">Hours:</strong> Tuesday–Sunday 9:30 AM–9:00 PM &middot; Monday 4:00 PM–9:00 PM (Walk-ins welcome until 9 PM).</p>
          <p><strong class="font-medium text-japandi-charcoal">Parking:</strong> Parking available for 4-wheelers and 2-wheelers.</p>
        </div>
        <div class="pt-2 flex flex-wrap gap-3">
          <a href={phoneCallUrl} class="px-5 py-2.5 rounded-full bg-japandi-moss text-japandi-cream text-xs font-medium uppercase tracking-wider hover:bg-japandi-charcoal transition-colors">
            Call 073497 01002
          </a>
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 rounded-full border border-japandi-clay bg-japandi-sand text-japandi-charcoal text-xs font-medium uppercase tracking-wider hover:bg-japandi-cream transition-colors">
            WhatsApp
          </a>
          <a href={directionsUrl} target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 rounded-full border border-japandi-clay bg-japandi-sand text-japandi-charcoal text-xs font-medium uppercase tracking-wider hover:bg-japandi-cream transition-colors">
            Google Maps Directions
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
