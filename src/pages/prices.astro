---
import Layout from '../layouts/Layout.astro';
import { generateBreadcrumbSchema } from '../utils/seoSchemas';
import { CANONICAL_PRICES } from '../data/prices';

const pageTitle = "Dental Treatment Prices in Hennur, Bangalore | Aureva Dental";
const pageDescription = `Every treatment price at Aureva Dental, Hennur Bande, in one list. ${CANONICAL_PRICES.consultation} consultation with digital X-ray. Prices are ranges, confirmed after clinical assessment.`;
const canonicalUrl = "https://aurevadental.com/prices";
const phoneCallUrl = "tel:+917349701002";
const whatsappUrl = "https://wa.me/917349701002?text=Hello%20Aureva%20Dental%2C%20I%20would%20like%20to%20inquire%20about%20treatment%20prices.";

const breadcrumbs = [
  { name: "Home", url: "https://aurevadental.com/" },
  { name: "Prices", url: canonicalUrl }
];

const breadcrumbSchema = JSON.stringify(generateBreadcrumbSchema(breadcrumbs));

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogUrl: canonicalUrl,
  schemaMarkup: [breadcrumbSchema]
};

const PACE = "Price after clinic examination";

interface PriceRow {
  treatment: string;
  price: string;
  url?: string;
  notes?: string;
}

interface PriceGroup {
  name: string;
  rows: PriceRow[];
}

const priceGroups: PriceGroup[] = [
  {
    name: "General and preventive",
    rows: [
      { treatment: "Consultation and check-up with digital X-ray (RVG)", price: CANONICAL_PRICES.consultation_home },
      { treatment: "Intraoral camera walkthrough", price: `Included in the ${CANONICAL_PRICES.consultation} consultation` },
      { treatment: "3D smile scan", price: PACE },
      { treatment: "Scaling and polishing", price: CANONICAL_PRICES.scaling_routine, url: "/treatments/scaling-and-polishing" },
      { treatment: "Tooth-coloured (composite) filling", price: CANONICAL_PRICES.tooth_filling },
      { treatment: "Temporary filling", price: CANONICAL_PRICES.temporary_filling },
