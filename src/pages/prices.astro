      { treatment: "Clear aligners, moderate", price: CANONICAL_PRICES.aligners_moderate, url: "/treatments/clear-aligners" },
      { treatment: "Clear aligners, complex", price: CANONICAL_PRICES.aligners_complex, url: "/treatments/clear-aligners" },
      { treatment: "Lingual braces", price: PACE, url: "/invisible-aligners-hennur" },
      { treatment: "Retainers (Hawley, clear, fixed lingual)", price: PACE, url: "/treatments/clear-aligners" },
      { treatment: "Early orthodontics for children", price: PACE, url: "/treatments/pediatric-dentistry" },
      { treatment: "Functional / jaw-growth appliances", price: PACE },
      { treatment: "Pre-surgical orthodontics", price: PACE }
    ]
  },
  {
    name: "Children's dentistry",
    rows: [
      { treatment: "Kids dental check-up", price: CANONICAL_PRICES.kids_checkup, url: "/treatments/pediatric-dentistry" },
      { treatment: "Fluoride application", price: CANONICAL_PRICES.kids_fluoride, url: "/treatments/pediatric-dentistry" },
