      { treatment: "Full mouth implants", price: CANONICAL_PRICES.full_mouth_implants_from, url: "/dental-implants-hennur" },
      { treatment: "All-on-4", price: CANONICAL_PRICES.all_on_4, url: "/treatments/dental-implants" },
      { treatment: "All-on-6", price: CANONICAL_PRICES.all_on_6, url: "/treatments/dental-implants" },
