      { treatment: "Custom sports mouthguard", price: PACE }
    ]
  },
  {
    name: "Root canal and tooth repair",
    rows: [
      { treatment: "Root canal, front tooth", price: CANONICAL_PRICES.rct_anterior, url: "/root-canal-treatment-hennur" },
      { treatment: "Root canal, premolar", price: CANONICAL_PRICES.rct_premolar, url: "/root-canal-treatment-hennur" },
      { treatment: "Root canal, molar", price: CANONICAL_PRICES.rct_molar, url: "/root-canal-treatment-hennur" },
      { treatment: "Re-root canal", price: CANONICAL_PRICES.rct_re_treatment, url: "/root-canal-treatment-hennur" },
      { treatment: "Emergency pain dressing / pulpectomy", price: CANONICAL_PRICES.emergency_pain_dressing, url: "/treatments/emergency-dentist" },
      { treatment: "Post and core", price: PACE },
      { treatment: "Inlays and onlays", price: PACE },
      { treatment: "Apicoectomy", price: PACE }
    ]
  },
  {
    name: "Gum treatment",
    rows: [
      { treatment: "Deep cleaning (scaling and root planing, all four quadrants)", price: CANONICAL_PRICES.scaling_deep, url: "/gum-treatment-hennur" },
      { treatment: "Gum disease treatment beyond deep cleaning", price: PACE, url: "/gum-treatment-hennur" },
      { treatment: "Laser gum treatment", price: PACE, url: "/gum-treatment-hennur" },
      { treatment: "Laser gum depigmentation", price: PACE, url: "/gum-treatment-hennur" },
      { treatment: "Flap surgery", price: PACE, url: "/gum-treatment-hennur" },
      { treatment: "Gingivectomy", price: PACE, url: "/gum-treatment-hennur" },
      { treatment: "Gum contouring / gummy smile correction", price: PACE, url: "/gum-treatment-hennur" },
      { treatment: "Gum grafting for recession", price: PACE, url: "/gum-treatment-hennur" },
      { treatment: "Bone and tissue regeneration for gum disease", price: PACE, url: "/gum-treatment-hennur" },
