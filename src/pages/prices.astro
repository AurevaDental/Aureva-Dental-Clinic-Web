      { treatment: "Partial dentures, acrylic", price: CANONICAL_PRICES.denture_partial_acrylic, url: "/treatments/dentures" },
      { treatment: "Partial dentures, cast metal", price: CANONICAL_PRICES.denture_partial_cast_metal, url: "/treatments/dentures" },
