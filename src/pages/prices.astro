      { treatment: "Bottle decay treatment", price: PACE, url: "/treatments/pediatric-dentistry" },
      { treatment: "Care for anxious children", price: PACE, url: "/treatments/pediatric-dentistry" },
      { treatment: "Kids preventive annual plan", price: PACE, url: "/treatments/pediatric-dentistry" }
    ]
  },
  {
    name: "Extractions and oral surgery",
    rows: [
      { treatment: "Extraction, front or loose tooth", price: CANONICAL_PRICES.extraction_front_loose, url: "/treatments/tooth-extraction" },
      { treatment: "Extraction, back tooth", price: CANONICAL_PRICES.extraction_back_tooth, url: "/treatments/tooth-extraction" },
      { treatment: "Surgical extraction / broken root", price: CANONICAL_PRICES.extraction_surgical, url: "/treatments/tooth-extraction" },
