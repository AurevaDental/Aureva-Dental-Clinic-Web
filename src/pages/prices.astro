---

<Layout seo={seoProps}>
  <section class="py-16 md:py-24 px-6 lg:px-24 bg-transparent border-b border-japandi-clay/30">
    <div class="max-w-5xl mx-auto space-y-6">
      <nav aria-label="Breadcrumb" class="text-xs text-japandi-earth font-light">
        <ol class="flex items-center gap-2">
          {breadcrumbs.map((b, i) => (
            <li class="flex items-center gap-2">
              {i > 0 && <span>/</span>}
              {i === breadcrumbs.length - 1 ? (
                <span class="text-japandi-charcoal font-medium">{b.name}</span>
              ) : (
                <a href={b.url} class="hover:text-japandi-moss transition-colors">{b.name}</a>
              )}
            </li>
          ))}
        </ol>
      </nav>

      <div class="space-y-4">
        <h1 class="text-3xl sm:text-5xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Treatment prices
        </h1>
        <p class="text-sm sm:text-base text-japandi-earth font-light leading-relaxed max-w-3xl">
          Every price at Aureva Dental in one place. Prices are ranges and are confirmed in a written plan after your examination. Treatments marked 'Price after clinic examination' depend on your case; book the {CANONICAL_PRICES.consultation} consultation (digital X-ray included, valid for 6 months) and we'll give you the exact price before anything starts.
        </p>
      </div>
    </div>
  </section>

  <!-- Price Tables by Category -->
  <section class="py-12 md:py-16 px-6 lg:px-24">
    <div class="max-w-5xl mx-auto space-y-12">
      {priceGroups.map((group) => (
        <div class="bg-japandi-sand/40 border border-japandi-clay/50 rounded-2xl overflow-hidden shadow-sm">
          <div class="px-6 py-4 bg-japandi-sand/80 border-b border-japandi-clay/40">
            <h2 class="text-lg sm:text-xl font-serif text-japandi-charcoal font-medium">
              {group.name}
            </h2>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs sm:text-sm">
              <thead class="bg-japandi-sand/30 text-japandi-earth uppercase text-[10px] tracking-wider border-b border-japandi-clay/30">
                <tr>
                  <th scope="col" class="py-3 px-6 font-semibold w-2/3">Treatment</th>
                  <th scope="col" class="py-3 px-6 font-semibold w-1/3">Price</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-japandi-clay/20 text-japandi-charcoal font-light">
                {group.rows.map((row) => (
                  <tr class="hover:bg-japandi-sand/60 transition-colors">
                    <td class="py-3.5 px-6 font-medium">
                      {row.url ? (
                        <a href={row.url} class="text-japandi-charcoal hover:text-japandi-moss transition-colors underline decoration-japandi-clay/60 hover:decoration-japandi-moss">
                          {row.treatment}
                        </a>
                      ) : (
                        <span>{row.treatment}</span>
                      )}
                      {row.notes && (
                        <span class="block text-[11px] text-japandi-earth font-normal mt-0.5">{row.notes}</span>
                      )}
                    </td>
                    <td class={`py-3.5 px-6 font-medium ${row.price === PACE ? 'text-japandi-earth italic' : 'text-japandi-moss'}`}>
                      {row.price}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))}

      <!-- Under Tables Note -->
      <div class="p-6 rounded-2xl bg-japandi-sand/50 border border-japandi-clay/40 text-center space-y-3">
        <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed max-w-2xl mx-auto">
          All prices are in Indian rupees and are ranges. Your exact price is confirmed in a written plan after examination. EMI options are available.
        </p>
        <p class="text-xs text-japandi-earth font-light">
          Parking available for 4-wheelers and 2-wheelers.
        </p>
      </div>

      <!-- Call / WhatsApp / Book Action Buttons -->
      <div class="pt-6 flex flex-wrap items-center justify-center gap-4">
        <a 
          href={phoneCallUrl}
          class="px-6 py-3.5 rounded-full border border-japandi-moss text-japandi-moss text-xs font-semibold uppercase tracking-wider hover:bg-japandi-moss/10 transition-colors inline-flex items-center gap-2"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
          </svg>
          <span>Call: +91 73497 01002</span>
        </a>
        <a 
          href={whatsappUrl}
          target="_blank" 
          rel="noopener noreferrer"
          class="px-6 py-3.5 rounded-full bg-emerald-600 text-white text-xs font-semibold uppercase tracking-wider hover:bg-emerald-700 transition-colors shadow-sm inline-flex items-center gap-2"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-4 h-4">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.275.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.158.57 4.187 1.564 5.945l-1.664 6.083 6.223-1.632c1.7 1.002 3.69 1.574 5.82 1.574 6.627 0 12-5.373 12-12 0-6.627-5.373-12-12-12z"/>
          </svg>
          <span>Book on WhatsApp</span>
        </a>
        <button 
          type="button"
          data-open-booking
          class="px-6 py-3.5 rounded-full bg-japandi-moss text-japandi-cream text-xs font-semibold uppercase tracking-wider hover:bg-japandi-charcoal transition-colors shadow-sm"
        >
          Book Appointment
        </button>
      </div>
    </div>
  </section>
</Layout>
