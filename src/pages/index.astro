---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import WhatBringsYouIn from '../components/WhatBringsYouIn.astro';
import PricesTeaser from '../components/PricesTeaser.astro';
import SpecialistsTeaser from '../components/SpecialistsTeaser.astro';
import YourFirstVisitTeaser from '../components/YourFirstVisitTeaser.astro';
import TheClinicTeaser from '../components/TheClinicTeaser.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import Membership from '../components/Membership.astro';
import LocalFAQ from '../components/LocalFAQ.astro';
import { generateFaqSchema, generateBreadcrumbSchema } from '../utils/seoSchemas';

const faqSchema = JSON.stringify(generateFaqSchema());
const breadcrumbSchema = JSON.stringify(generateBreadcrumbSchema([
  { name: "Home", url: "https://aurevadental.com/" }
]));

const schemaMarkup = [faqSchema, breadcrumbSchema];

const seoProps = {
  title: "Dental Clinic in Hennur Bangalore | Aureva Dental",
  description: "Aureva Dental is a modern dental clinic in Hennur, Bangalore. Gentle root canals, dental implants, clear aligners & teeth whitening. Call +91 73497 01002.",
  keywords: "dental clinic in hennur bangalore, dentist in hennur, dental clinic horamavu, dentist near me, root canal treatment bangalore, clear aligners hennur bangalore, dental implants, teeth whitening, emergency dentist hennur",
  canonical: "https://aurevadental.com/",
  ogType: "website",
  ogTitle: "Dental Clinic in Hennur Bangalore | Aureva Dental",
  ogDescription: "Aureva Dental is a modern dental clinic in Hennur, Bangalore. Gentle root canals, dental implants, clear aligners & teeth whitening. Call +91 73497 01002.",
  ogUrl: "https://aurevadental.com/",
  ogImage: "https://aurevadental.com/assets/og-image.jpg",
  schemaMarkup
};
---

<Layout {...seoProps}>
  <!-- 1. Hero: H1 "Specialist dental clinic in Hennur Bande", subline, 3 facts, action buttons -->
  <Hero />

  <!-- 2. "What brings you in?": 6 large tappable cards -->
  <WhatBringsYouIn />

  <!-- 3. Prices teaser: 6 common treatments with key prices + "See all prices" button -->
  <PricesTeaser />

  <!-- 4. Specialists: 7 department names from /our-specialists as compact grid -->
  <SpecialistsTeaser />

  <!-- 5. "Your first visit": 4 numbered steps, link to /your-first-visit -->
  <YourFirstVisitTeaser />

  <!-- 6. The clinic: photos, parking line, lift, hours, map embed, link to /dental-clinic-in-hennur -->
  <TheClinicTeaser />

  <!-- 7. Reviews: verified Google reviews block -->
  <ReviewsSection />

  <!-- 8. Memberships and bridal packages: moved below reviews -->
  <Membership />

  <!-- 9. FAQ: patient questions & schema -->
  <LocalFAQ />
</Layout>
