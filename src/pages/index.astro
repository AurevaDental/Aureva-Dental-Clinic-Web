---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import StatsCounter from '../components/StatsCounter.astro';
import Services from '../components/Services.astro';
import SpecializedServices from '../components/SpecializedServices.astro';
import WhyUs from '../components/WhyUs.astro';
import DoctorsGallery from '../components/DoctorsGallery.astro';
import VirtualTour from '../components/VirtualTour.astro';
import ImageSlider from '../components/ImageSlider.astro';
import LocationsAndReviews from '../components/LocationsAndReviews.astro';
import { getConfig } from '../utils/getConfig';

export const prerender = true;

const config = getConfig();
const { social_media } = config;

// Simple icon mapper for social media
const socialIcons = {
  instagram: `<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-5 h-5"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>`,
  facebook: `<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-5 h-5"><path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/></svg>`,
  twitter: `<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-5 h-5"><path d="M24 4.557a9.83 9.83 0 01-2.828.775 4.932 4.932 0 002.165-2.724 9.864 9.864 0 01-3.127 1.195 4.916 4.916 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.557z"/></svg>`
}
---

<Layout>
	<!-- Hero Section -->
	<Hero />

  <!-- Stats Counter Section -->
  <StatsCounter />

	<!-- Services Grid -->
	<Services />

  <!-- Specialized Services Section -->
  <SpecializedServices />

  <!-- Why Choose Us -->
  <WhyUs />

  <!-- Image Slider / Gallery -->
  <ImageSlider />

	<!-- Doctors Horizontal Scroll Gallery -->
	<DoctorsGallery />

  <!-- Virtual Tour Placeholder -->
  <VirtualTour />

	<!-- Locations Deep Map Links & Social Proof Reviews -->
	<LocationsAndReviews />

	<!-- Sergeant/Minimalist Footer -->
	<footer class="bg-japandi-sand/80 border-t border-japandi-clay/50 py-12 px-6 lg:px-24">
		<div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6 text-xs text-japandi-earth font-light">
			<div class="flex items-center gap-2.5">
				<img 
					src="/logo.png" 
					alt="Aureva Dental Logo" 
					class="h-20 w-auto object-contain transition-all duration-300 dark:invert dark:brightness-125 dark:hue-rotate-180" 
				/>
			</div>
			
			<div class="flex gap-8">
				<a href="#services" class="hover:text-japandi-charcoal transition-colors">Services</a>
				<a href="#team" class="hover:text-japandi-charcoal transition-colors">Artisans</a>
				<a href="#locations" class="hover:text-japandi-charcoal transition-colors">Sanctuaries</a>
			</div>
			
      <div class="flex items-center gap-4">
        {social_media.map(social => (
          <a 
            href={social.url} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="text-japandi-earth hover:text-japandi-moss transition-colors"
            aria-label={`Follow us on ${social.platform}`}
            set:html={socialIcons[social.icon as keyof typeof socialIcons] || socialIcons.instagram}
          >
          </a>
        ))}
      </div>

			<div>
				<p>&copy; {new Date().getFullYear()} Aureva Dental. All rights reserved.</p>
			</div>
		</div>
	</footer>
</Layout>
