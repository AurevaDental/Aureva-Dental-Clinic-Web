---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import StatsCounter from '../components/StatsCounter.astro';
import HolisticServices from '../components/HolisticServices.astro';
import SpecializedExpertise from '../components/SpecializedExpertise.astro';
import ClinicalTrust from '../components/ClinicalTrust.astro';
import Membership from '../components/Membership.astro';
import WhyUs from '../components/WhyUs.astro';
import DoctorsGallery from '../components/DoctorsGallery.astro';
import VirtualTour from '../components/VirtualTour.astro';
import ImageSlider from '../components/ImageSlider.astro';
import LocalFAQ from '../components/LocalFAQ.astro';
import LocationsAndReviews from '../components/LocationsAndReviews.astro';
import { getConfig } from '../utils/getConfig';
import { generateDentistSchema, generateFaqSchema, generateBreadcrumbSchema } from '../utils/seoSchemas';

export const prerender = false;

const config = getConfig();
const { social_media, show_stats_section, show_gallery_slider } = config;

// Generate Google Rich Results-compliant JSON-LD schemas
const dentistSchema = JSON.stringify(generateDentistSchema(config));
const faqSchema = JSON.stringify(generateFaqSchema());
const breadcrumbSchema = JSON.stringify(generateBreadcrumbSchema([
  { name: "Home", url: "https://aurevadental.com/" }
]));

const schemaMarkup = [dentistSchema, faqSchema, breadcrumbSchema];

const seoProps = {
  title: "Aureva Dental | Premium Dental Clinic & Smile Studio in Hennur, Bangalore",
  description: "Aureva Dental is a modern dental clinic & smile studio in Hennur Bande, Horamavu Agara Road, Bengaluru. Painless root canal, dental implants, aligners & cosmetic dentistry. Call +91 73497 01002.",
  keywords: "dentist in hennur, dental clinic horamavu, best dentist near me, root canal treatment bengaluru, clear aligners hennur bangalore, dental implants, teeth whitening, smile makeover bengaluru, kalyan nagar dentist, babusapalya dental clinic, emergency dentist hennur",
  canonical: "https://aurevadental.com/",
  ogType: "website",
  ogTitle: "Aureva Dental | Premium Dental Clinic & Smile Studio in Hennur, Bangalore",
  ogDescription: "Aureva Dental is a modern dental clinic & smile studio in Hennur Bande, Horamavu Agara Road, Bengaluru. Painless root canal, dental implants, aligners & cosmetic dentistry. Call +91 73497 01002.",
  ogUrl: "https://aurevadental.com/",
  ogImage: "https://aurevadental.com/og-image.jpg",
  schemaMarkup
};

// Simple icon mapper for social media
const socialIcons = {
  instagram: `<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-5 h-5"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>`,
  facebook: `<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-5 h-5"><path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/></svg>`,
  twitter: `<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-5 h-5"><path d="M24 4.557a9.83 9.83 0 01-2.828.775 4.932 4.932 0 002.165-2.724 9.864 9.864 0 01-3.127 1.195 4.916 4.916 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.557z"/></svg>`
};
---

<Layout {...seoProps}>
	<!-- Hero Section -->
	<Hero />

  <!-- Stats Counter Section -->
  {show_stats_section !== false && <StatsCounter />}

	<!-- Holistic Services Grid -->
	<HolisticServices />

  <!-- Specialized Expertise Section -->
  <SpecializedExpertise />

  <!-- Clinical Hygiene, Safety, & Payments -->
  <ClinicalTrust />

  <!-- Membership Plans Section -->
  <Membership />

  <!-- Why Choose Us -->
  <WhyUs />

  <!-- Image Slider / Gallery -->
  {show_gallery_slider !== false && <ImageSlider />}

	<!-- Doctors Horizontal Scroll Gallery -->
	<DoctorsGallery />

  <!-- Virtual Tour Placeholder -->
  <VirtualTour />

  <!-- Local SEO & Patient Questions FAQ Accordion -->
  <LocalFAQ />

	<!-- Locations Deep Map Links & Social Proof Reviews -->
	<LocationsAndReviews />

	<!-- Premium Japandi Footer with Canonical NAP -->
	<footer class="bg-japandi-sand/80 border-t border-japandi-clay/50 pt-16 pb-12 px-6 lg:px-24">
		<div class="max-w-7xl mx-auto">
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 pb-12 border-b border-japandi-clay/30 text-xs">
				<!-- Brand Column -->
				<div class="space-y-4">
					<img 
						src="/logo.png" 
						alt="Aureva Dental Logo" 
						class="h-20 w-auto object-contain transition-all duration-300 dark:invert dark:brightness-125 dark:hue-rotate-180" 
					/>
					<p class="text-japandi-earth font-light leading-relaxed">
						Calm Mind. Healthy Smile. A modern Japandi dental studio and sanctuary committed to clinical precision, transparent pricing, and gentle patient care.
					</p>
					<div class="flex items-center gap-3 pt-1">
						{social_media.map(social => (
							<a 
								href={social.url} 
								target="_blank" 
								rel="noopener noreferrer" 
								class="text-japandi-earth hover:text-japandi-moss transition-colors"
								aria-label={`Follow us on ${social.platform}`}
								set:html={socialIcons[social.icon as keyof typeof socialIcons] || socialIcons.instagram}
							>
							</a>
						))}
					</div>
				</div>

				<!-- Dedicated Treatments Column -->
				<div class="space-y-3">
					<h4 class="font-serif text-sm font-medium text-japandi-charcoal">Treatments</h4>
					<ul class="space-y-2 text-japandi-earth font-light">
						<li><a href="/treatments/clear-aligners" class="hover:text-japandi-moss transition-colors">Clear Aligners</a></li>
						<li><a href="/treatments/dental-implants" class="hover:text-japandi-moss transition-colors">Dental Implants</a></li>
						<li><a href="/treatments/root-canal-treatment" class="hover:text-japandi-moss transition-colors">Root Canal Treatment (RCT)</a></li>
						<li><a href="/treatments/cosmetic-dentistry" class="hover:text-japandi-moss transition-colors">Cosmetic Dentistry & Veneers</a></li>
						<li><a href="#services" class="hover:text-japandi-moss transition-colors">All Services & Pricing</a></li>
					</ul>
				</div>

				<!-- Quick Links Column -->
				<div class="space-y-3">
					<h4 class="font-serif text-sm font-medium text-japandi-charcoal">Studio & Navigation</h4>
					<ul class="space-y-2 text-japandi-earth font-light">
						<li><a href="#team" class="hover:text-japandi-moss transition-colors">Our Artisans</a></li>
						<li><a href="#locations" class="hover:text-japandi-moss transition-colors">Sanctuary Location</a></li>
						<li><a href="#faq" class="hover:text-japandi-moss transition-colors">FAQ & Patient Guide</a></li>
						<li><a href="/feedback" class="hover:text-japandi-moss transition-colors">Patient Feedback</a></li>
						<li><a href="https://maps.app.goo.gl/sNdjoUAWePyoXd8g9" target="_blank" rel="noopener noreferrer" class="hover:text-japandi-moss transition-colors">Google Maps Listing</a></li>
					</ul>
				</div>

				<!-- Canonical Contact Column -->
				<div class="space-y-3">
					<h4 class="font-serif text-sm font-medium text-japandi-charcoal">Aureva Dental</h4>
					<p class="text-japandi-earth font-light leading-relaxed">
						2nd Floor, No. 11/4, Horamavu Agara Road, Near Nayara Petrol Bunk, Hennur Bande, Bengaluru, Karnataka 560043
					</p>
					<div class="pt-1 flex flex-col gap-1.5 font-medium">
						<a href="tel:+917349701002" class="text-japandi-charcoal hover:text-japandi-moss transition-colors">
							Phone: +91 73497 01002
						</a>
						<a href="https://wa.me/917349701002" target="_blank" rel="noopener noreferrer" class="text-japandi-moss hover:text-japandi-charcoal transition-colors">
							WhatsApp: +91 73497 01002
						</a>
					</div>
					<div class="pt-2 text-[11px] text-japandi-earth font-light leading-relaxed">
						<span class="font-medium text-japandi-charcoal block">Operating Hours:</span>
						<span>Monday: 4:00 PM – 9:00 PM</span><br/>
						<span>Tuesday – Sunday: 9:30 AM – 9:00 PM</span>
					</div>
				</div>
			</div>

			<!-- Catchment Note & Copyright -->
			<div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-japandi-earth font-light text-center md:text-left">
				<p class="max-w-2xl">
					Conveniently located for patients across Hennur Bande, Horamavu Agara Road, Kalyan Nagar, Kothanur, and North Bengaluru.
				</p>
				<p>&copy; {new Date().getFullYear()} Aureva Dental. All rights reserved.</p>
			</div>
		</div>
	</footer>
</Layout>
