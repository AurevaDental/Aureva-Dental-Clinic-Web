---
import { CANONICAL_PRICES } from '../data/prices';
import Layout from '../layouts/Layout.astro';
import { generateBreadcrumbSchema, generateFaqSchema, generateTreatmentServiceSchema } from '../utils/seoSchemas';
import TreatmentDepartmentCard from '../components/TreatmentDepartmentCard.astro';
import TreatmentAftercare from '../components/TreatmentAftercare.astro';
import TreatmentActions from '../components/TreatmentActions.astro';

const pageTitle = "Wisdom Tooth Removal in Hennur | Aureva Dental";
const pageDescription = "Comfortable wisdom tooth removal in Hennur, Bangalore at Aureva Dental. Gentle oral surgery, digital RVG diagnostics & walk in for an assessment.";
const canonicalUrl = "https://aurevadental.com/wisdom-tooth-removal-hennur";
const phoneCallUrl = "tel:+917349701002";
const whatsappUrl = "https://wa.me/917349701002?text=Hello%20Aureva%20Dental%2C%20I%20have%20wisdom%20tooth%20pain%20and%20would%20like%20to%20consult%20for%20Removal%20in%20Hennur.";

const breadcrumbs = [
  { name: "Home", url: "https://aurevadental.com/" },
  { name: "Wisdom Tooth Removal in Hennur", url: canonicalUrl }
];

const faqs = [
  {
    question: "Is wisdom tooth removal comfortable at Aureva Dental?",
    answer: "Yes, modern wisdom tooth extraction at Aureva Dental is comfortable and gentle. We use local anaesthesia. You may feel pressure during the procedure, and we pause whenever you need."
  },
  {
    question: "What is the recovery time after a wisdom tooth extraction in Hennur?",
    answer: "Most patients return to school or normal desk work within 24 to 48 hours. Soft tissue gum healing occurs over 7 to 10 days. We provide a customized recovery regimen with targeted anti-inflammatory medications and a soft-food guide."
  },
  {
    question: "What is the cost of wisdom tooth removal at your Hennur clinic?",
    answer: `At Aureva Dental, wisdom tooth extraction fees range from ${CANONICAL_PRICES.wisdom_overall} per tooth based on surgical complexity: Simple non-impacted erupted wisdom teeth: ${CANONICAL_PRICES.wisdom_erupted}; Soft-tissue impactions: ${CANONICAL_PRICES.wisdom_soft_tissue}; Partial bony impactions: ${CANONICAL_PRICES.wisdom_partial_bony}; Deep horizontal, angular, or complex bony impactions requiring micro-bone sectioning: ${CANONICAL_PRICES.wisdom_deep_bony}. All surgical costs are quoted in writing upfront.`
  },
  {
    question: "Do all four wisdom teeth need to be extracted at once?",
    answer: "No. We only recommend removing wisdom teeth that are actively symptomatic, impacted against adjacent healthy molars, triggering recurrent gum infection (pericoronitis), or threatening cyst formation. Depending on your clinical status and personal comfort, we can treat one tooth at a time or address both teeth on one side in a single appointment."
  },
  {
    question: "How do I prevent dry socket after a wisdom tooth extraction?",
    answer: "Dry socket (alveolar osteitis) occurs when the protective blood clot in the extraction socket dislodges prematurely. To prevent dry socket, avoid smoking or tobacco use for at least 72 hours, do not use drinking straws, refrain from vigorous spitting or swishing, and consume only soft, lukewarm foods for the first two to three days."
  }
];

const breadcrumbSchema = JSON.stringify(generateBreadcrumbSchema(breadcrumbs));
const faqSchema = JSON.stringify(generateFaqSchema(faqs));
const serviceSchema = JSON.stringify(generateTreatmentServiceSchema({
  name: "Wisdom Tooth Removal in Hennur",
  description: pageDescription,
  url: canonicalUrl,
  medicalSpecialty: "OralSurgery",
  isSurgical: true
}));

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogUrl: canonicalUrl,
  schemaMarkup: [breadcrumbSchema, faqSchema, serviceSchema]
};
---

<Layout {...seoProps}>
  <!-- Breadcrumb Navigation -->
  <nav class="bg-japandi-sand/30 border-b border-japandi-clay/20 py-3.5 px-6 lg:px-24 text-xs font-light text-japandi-earth" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <a href="/" class="hover:text-japandi-moss transition-colors">Home</a>
        <span>/</span>
        <span class="text-japandi-charcoal font-medium">Wisdom Tooth Removal Hennur</span>
      </div>
      <a href="#pricing" class="inline-flex items-center gap-1 text-xs font-semibold text-japandi-moss hover:underline">
        Prices &darr;
      </a>
    </div>
  </nav>

  <!-- 1. Hero / H1 Section -->
  <section class="py-12 md:py-20 px-6 lg:px-24 bg-transparent relative overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-7 flex flex-col items-start space-y-4 animate-slow-fade">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-japandi-clay/60 bg-japandi-sand/70 text-[10px] font-semibold text-japandi-moss uppercase tracking-widest">
          Oral &amp; Maxillofacial Surgery &bull; Hennur Bande, Bangalore
        </div>
        
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif text-japandi-charcoal leading-tight font-medium tracking-tight">
          Wisdom Tooth Removal in Hennur
        </h1>

        <div class="w-full bg-japandi-sand/40 border border-japandi-clay/30 rounded-2xl p-3.5 space-y-1.5 text-xs text-japandi-earth">
          <p class="flex items-center gap-2 font-medium text-japandi-charcoal">
            <span>Hours: Mon 4–9 PM, Tue–Sun 9:30 AM–9 PM</span>
          </p>
          <p>2nd Floor, Horamavu Agara Road, near Nayara Petrol Bunk, Hennur Bande. Lift and parking available.</p>
        </div>

        <p class="text-sm sm:text-base text-japandi-earth font-light leading-relaxed max-w-2xl">
          Relieve pain from impacted third molars, cheek biting, and recurrent gum inflammation (pericoronitis). Performed by visiting MDS Oral &amp; Maxillofacial Surgeons with gentle local anesthesia and digital RVG diagnostics.
        </p>

        <!-- CTA Buttons -->
        <div class="pt-2 flex flex-wrap items-center gap-3 w-full sm:w-auto">
          <button 
            type="button"
            data-open-booking
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-japandi-moss text-japandi-cream hover:bg-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 shadow-sm"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
            </svg>
            <span>Book Consultation</span>
          </button>

          <a 
            href={phoneCallUrl}
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 border border-japandi-clay bg-japandi-sand/50 hover:bg-japandi-sand text-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-japandi-moss">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
            </svg>
            <span>Call: +91 73497 01002</span>
          </a>
        </div>
      </div>

      <!-- Quick Feature Card -->
      <div class="lg:col-span-5 relative">
        <div class="p-8 rounded-3xl bg-japandi-sand/50 border border-japandi-clay/40 shadow-sm space-y-4">
          <span class="text-xs uppercase font-semibold text-japandi-moss tracking-widest block">Surgical Expertise</span>
          <h3 class="font-serif text-xl font-medium text-japandi-charcoal">Atraumatic Surgery</h3>
          <ul class="space-y-3 text-xs font-light text-japandi-earth">
            <li class="flex items-start gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-japandi-moss mt-1.5 shrink-0"></span>
              <div><strong class="text-japandi-charcoal font-medium">Digital RVG Mapping:</strong> Verifying root angulation and distance from the inferior alveolar nerve.</div>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-japandi-moss mt-1.5 shrink-0"></span>
              <div><strong class="text-japandi-charcoal font-medium">Visiting Maxillofacial Surgeon:</strong> Expertise in horizontal, vertical, and deep bone impactions.</div>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-japandi-moss mt-1.5 shrink-0"></span>
              <div><strong class="text-japandi-charcoal font-medium">Rapid Recovery Protocol:</strong> Cold compress guide and targeted medications to manage swelling.</div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Who It's For (Symptoms in Plain Words) -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Symptoms</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Who wisdom tooth removal is for
        </h2>
      </div>
      <p class="text-sm sm:text-base text-japandi-earth font-light leading-relaxed">
        Wisdom tooth extraction is recommended if you experience:
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm text-japandi-earth font-light">
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Swollen, Painful Gums (Pericoronitis)</h3>
          <p>An inflamed gum flap over a partially erupted wisdom tooth that traps food and bacteria.</p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Cheek Biting &amp; Jaw Stiffness</h3>
          <p>A tilted wisdom tooth constantly biting the inner cheek or causing difficulty opening the mouth.</p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Decay on Adjacent Molars</h3>
          <p>Food impaction between the wisdom tooth and the second molar causing cavities on both teeth.</p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Horizontal or Bony Impaction</h3>
          <p>A wisdom tooth growing sideways into the jawbone, threatening tooth roots or cyst formation.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. What Happens, Visit by Visit, & Number of Sittings -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-8">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Clinical Protocol</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          What happens, visit by visit
        </h2>
        <p class="text-sm sm:text-base text-japandi-earth font-light mt-2">
          Wisdom tooth removal is completed in 1 sitting, with an optional suture check at 7 days.
        </p>
      </div>

      <div class="space-y-4 text-xs sm:text-sm text-japandi-earth font-light">
        <div class="p-6 rounded-2xl bg-japandi-sand/30 border border-japandi-clay/40 space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">Step 1: Digital X-Ray &amp; Local Numbing</h3>
            <span class="text-[10px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded bg-japandi-moss/10 text-japandi-moss">Sitting 1</span>
          </div>
          <p class="leading-relaxed">
            High-resolution digital RVG imaging determines the precise root configuration. Local anesthesia is administered to ensure complete numbness of the tooth, bone, and cheek.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-japandi-sand/30 border border-japandi-clay/40 space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">Step 2: Gentle Elevation &amp; Suture Placement</h3>
            <span class="text-[10px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded bg-japandi-moss/10 text-japandi-moss">Sitting 1</span>
          </div>
          <p class="leading-relaxed">
            The surgeon accesses and gently lifts the tooth using micro-surgical instruments. If needed, the tooth is sectioned for atraumatic removal. Dissolvable or removable sutures are placed.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Price Table from Keys -->
  <section id="pricing" class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Transparent Pricing</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Wisdom tooth removal fees
        </h2>
        <p class="text-xs sm:text-sm text-japandi-earth font-light mt-1">
          Prices are ranges, confirmed after examination.
        </p>
      </div>

      <div class="rounded-2xl border border-japandi-clay/40 overflow-hidden bg-japandi-cream/90 shadow-sm">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-japandi-sand/60 text-japandi-charcoal font-serif border-b border-japandi-clay/30">
            <tr>
              <th class="py-3 px-4">Extraction Type</th>
              <th class="py-3 px-4">Price Range</th>
              <th class="py-3 px-4 hidden sm:table-cell">Complexity</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-japandi-clay/20 text-japandi-earth font-light">
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">Erupted Wisdom Tooth</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.wisdom_erupted}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Fully erupted upper or lower third molar</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">Soft-Tissue Impaction</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.wisdom_soft_tissue}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Tooth beneath gum flap (operculum)</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">Partial Bony Impaction</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.wisdom_partial_bony}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Tooth partially embedded in alveolar bone</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">Deep Bony / Complex Impaction</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.wisdom_deep_bony}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Horizontal, angular, or roots close to nerve</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-japandi-charcoal">Consultation with Digital X-Ray</td>
              <td class="py-3 px-4 text-japandi-moss font-semibold">{CANONICAL_PRICES.consultation}</td>
              <td class="py-3 px-4 hidden sm:table-cell">Valid for 6 months</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-xs text-japandi-earth font-light">
        See our complete pricing catalog on the <a href="/prices" class="text-japandi-moss underline decoration-japandi-moss/40 hover:decoration-japandi-moss font-medium">treatment prices</a> page.
      </p>
    </div>
  </section>

  <!-- 5. Which Department Handles It -->
  <TreatmentDepartmentCard 
    department="Oral & Maxillofacial Surgery"
    link="/our-specialists#surgery"
    description="Complex surgical extractions, fractured root retrievals, and socket preservation are led by our visiting MDS Oral & Maxillofacial Surgeons."
  />

  <!-- 6. Aftercare and When to Call Us -->
  <TreatmentAftercare 
    instructions={[
      "Maintain firm biting pressure on the cotton gauze pad for 45 to 60 minutes after your appointment.",
      "Apply an external ice pack to the cheek in 15-minute intervals for the first 24 hours to minimize swelling.",
      "Do not spit, rinse vigorously, drink through a straw, or smoke for at least 72 hours to prevent dry socket.",
      "Consume cool, soft foods (smoothies, curd rice, soup) and stay well-hydrated."
    ]}
    whenToCall={[
      "Bleeding continues heavily after biting on a fresh gauze pad for 45 minutes.",
      "You develop severe, throbbing pain radiating toward your temple or ear 3 to 4 days post-op.",
      "You develop a high fever or experience difficulty opening your mouth after 3 days."
    ]}
  />

  <!-- 7. FAQs (with Schema) -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-8">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Common Questions</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Frequently asked questions
        </h2>
      </div>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <div class="bg-japandi-cream/90 border border-japandi-clay/40 rounded-2xl p-6 space-y-2">
            <h3 class="font-serif text-base sm:text-lg text-japandi-charcoal font-medium">
              {faq.question}
            </h3>
            <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. Related Treatments -->
  <section class="py-16 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <h2 class="text-xl sm:text-2xl font-serif text-japandi-charcoal font-medium">
        Related treatments
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
        <a href="/treatments/tooth-extraction" class="p-4 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 hover:border-japandi-moss transition-colors block space-y-1">
          <span class="font-serif text-sm text-japandi-charcoal font-medium block">Tooth Extraction</span>
          <span class="text-japandi-earth font-light">Routine extraction of front and back teeth</span>
        </a>
        <a href="/treatments/emergency-dentist" class="p-4 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 hover:border-japandi-moss transition-colors block space-y-1">
          <span class="font-serif text-sm text-japandi-charcoal font-medium block">Emergency Dentist</span>
          <span class="text-japandi-earth font-light">Same-day relief for acute wisdom tooth pain</span>
        </a>
        <a href="/root-canal-treatment-hennur" class="p-4 rounded-2xl bg-japandi-sand/40 border border-japandi-clay/40 hover:border-japandi-moss transition-colors block space-y-1">
          <span class="font-serif text-sm text-japandi-charcoal font-medium block">Root Canal Treatment</span>
          <span class="text-japandi-earth font-light">Treating decay on adjacent molars</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 9. Book / WhatsApp / Call -->
  <TreatmentActions treatmentName="Wisdom Tooth Consultation" />
</Layout>
