---
import { CANONICAL_PRICES } from '../data/prices';
import Layout from '../layouts/Layout.astro';
import { generateBreadcrumbSchema, generateFaqSchema, generateTreatmentServiceSchema } from '../utils/seoSchemas';
import TreatmentDepartmentCard from '../components/TreatmentDepartmentCard.astro';
import TreatmentAftercare from '../components/TreatmentAftercare.astro';
import TreatmentActions from '../components/TreatmentActions.astro';

const pageTitle = "Dental Implants in Hennur Bande | Aureva Dental";
const pageDescription = "Dental implants in Hennur Bande at Aureva Dental: single implants, crowns, visiting MDS implant specialists, transparent pricing, directions & parking.";
const canonicalUrl = "https://aurevadental.com/dental-implants-hennur";
const phoneCallUrl = "tel:+917349701002";
const whatsappUrl = "https://wa.me/917349701002?text=Hello%20Aureva%20Dental%2C%20I%20would%20like%20to%20consult%20for%20Dental%20Implants%20in%20Hennur%20Bande.";

const breadcrumbs = [
  { name: "Home", url: "https://aurevadental.com/" },
  { name: "Treatments", url: "https://aurevadental.com/treatments/dental-implants" },
  { name: "Dental Implants in Hennur Bande", url: canonicalUrl }
];

const faqs = [
  {
    question: "What is the cost of a dental implant at your Hennur Bande clinic?",
    answer: `The price depends on the implant brand (we place Nobel Biocare, Straumann and other systems) and on the case; a single implant is ${CANONICAL_PRICES.implant_single_fixture}. An implant with a custom zirconia crown ranges between ${CANONICAL_PRICES.implant_with_crown}. Prices are ranges, confirmed after examination.`
  },
  {
    question: "How long does the dental implant treatment process take?",
    answer: "The complete process typically spans 8 to 12 weeks for biological osseointegration. Once the implant post bonds firmly with the jawbone, a digital 3D impression is taken to fabricate and place your permanent zirconia crown."
  },
  {
    question: "Is there vehicle parking and lift access at the clinic?",
    answer: "Yes. Our clinic is on the 2nd floor with lift. Parking available for 4-wheelers and 2-wheelers."
  },
  {
    question: "Do you offer flexible EMI payment options?",
    answer: "Yes. You can convert treatment payments into monthly EMIs through all major bank credit cards directly at our reception."
  }
];

const breadcrumbSchema = JSON.stringify(generateBreadcrumbSchema(breadcrumbs));
const faqSchema = JSON.stringify(generateFaqSchema(faqs));
const serviceSchema = JSON.stringify(generateTreatmentServiceSchema({
  name: "Dental Implants in Hennur Bande",
  description: pageDescription,
  url: canonicalUrl,
  medicalSpecialty: "Implantology",
  isSurgical: true
}));

const seoProps = {
  title: pageTitle,
  description: pageDescription,
  canonical: canonicalUrl,
  ogTitle: pageTitle,
  ogDescription: pageDescription,
  ogUrl: canonicalUrl,
  schemaMarkup: [breadcrumbSchema, faqSchema, serviceSchema]
};
---

<Layout {...seoProps}>
  <!-- Breadcrumb Navigation -->
  <nav class="bg-japandi-sand/30 border-b border-japandi-clay/20 py-3.5 px-6 lg:px-24 text-xs font-light text-japandi-earth" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto flex items-center gap-2">
      <a href="/" class="hover:text-japandi-moss transition-colors">Home</a>
      <span>/</span>
      <a href="/treatments/dental-implants" class="hover:text-japandi-moss transition-colors">Dental Implants</a>
      <span>/</span>
      <span class="text-japandi-charcoal font-medium">Hennur Bande</span>
    </div>
  </nav>

  <!-- 1. Hero / H1 Section -->
  <section class="py-16 md:py-24 px-6 lg:px-24 bg-transparent relative overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 flex flex-col items-start space-y-6 animate-slow-fade">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-japandi-clay/60 bg-japandi-sand/70 text-[10px] font-semibold text-japandi-moss uppercase tracking-widest">
          Hennur Bande Studio &bull; Bangalore
        </div>
        
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif text-japandi-charcoal leading-tight font-medium tracking-tight">
          Dental implants in Hennur Bande
        </h1>

        <p class="text-base sm:text-lg text-japandi-earth font-light leading-relaxed max-w-2xl">
          Fixed, natural-looking tooth replacement for patients living in Hennur Bande, Horamavu, and Kalyan Nagar. At Aureva Dental, our visiting implant specialists restore missing teeth with digital RVG planning and published pricing. For an exhaustive clinical guide on surgical techniques and implant systems, read our <a href="/treatments/dental-implants" class="text-japandi-moss underline decoration-japandi-moss/50 hover:decoration-japandi-moss font-medium">Complete Dental Implants Guide</a>.
        </p>

        <!-- CTA Action Buttons -->
        <div class="pt-2 flex flex-wrap items-center gap-4 w-full sm:w-auto">
          <button 
            type="button"
            data-open-booking
            class="inline-flex items-center justify-center gap-2 px-7 py-4 bg-japandi-moss text-japandi-cream hover:bg-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 shadow-md shadow-japandi-moss/15 cursor-none"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
            </svg>
            <span>Book Implant Consultation</span>
          </button>

          <a 
            href={phoneCallUrl}
            class="inline-flex items-center justify-center gap-2 px-7 py-4 border border-japandi-clay bg-japandi-sand/50 hover:bg-japandi-sand text-japandi-charcoal text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-300 cursor-none"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-japandi-moss">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
            </svg>
            <span>Call +91 73497 01002</span>
          </a>
        </div>
      </div>

      <!-- Clinic Fact Card -->
      <div class="lg:col-span-5 animate-slow-fade">
        <div class="bg-japandi-sand/60 border border-japandi-clay/50 rounded-[2.5rem] p-8 sm:p-10 shadow-lg shadow-japandi-charcoal/5 space-y-4">
          <span class="text-xs font-semibold uppercase tracking-widest text-japandi-moss block">Hennur Clinic Details</span>
          <h3 class="text-xl font-serif text-japandi-charcoal font-medium">Aureva Dental Studio</h3>
          <div class="space-y-3 text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
            <p class="text-japandi-charcoal font-medium">
              2nd floor, No.11, 4, Horamavu Agara Rd, near Nayara Petrol Bunk, Hennur Bande, Bengaluru 560043
            </p>
            <p class="flex items-center gap-2 text-japandi-moss font-semibold">
              <span class="w-2 h-2 rounded-full bg-japandi-moss shrink-0"></span>
              Parking available for 4-wheelers and 2-wheelers.
            </p>
            <p class="flex items-center gap-2 text-japandi-charcoal">
              <span class="w-2 h-2 rounded-full bg-japandi-moss shrink-0"></span>
              2nd floor with lift
            </p>
            <p class="flex items-center gap-2 text-japandi-charcoal">
              <span class="w-2 h-2 rounded-full bg-japandi-moss shrink-0"></span>
              Mon 4–9 PM, Tue–Sun 9:30 AM–9 PM
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Who It's For (Symptoms in Plain Words) -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Patient Indications</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          Who dental implants are for
        </h2>
      </div>
      <p class="text-sm sm:text-base text-japandi-earth font-light leading-relaxed">
        Dental implants at our Hennur Bande clinic are ideal for individuals experiencing:
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm text-japandi-earth font-light">
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Gaps from Missing Teeth</h3>
          <p>Unfilled spaces after extractions that make chewing difficult or cause adjacent teeth to tilt inward.</p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Loose or Unstable Dentures</h3>
          <p>Partial or full dentures that shift while talking or eating, requiring messy adhesive pastes.</p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Broken Tooth Past Repair</h3>
          <p>A decayed or cracked tooth with root damage that cannot be safely restored with a root canal or crown.</p>
        </div>
        <div class="p-5 rounded-2xl bg-japandi-cream/90 border border-japandi-clay/40 space-y-1.5">
          <h3 class="font-serif text-base text-japandi-charcoal font-medium">Wanting to Avoid Grinding Healthy Teeth</h3>
          <p>Preferring a standalone implant over a dental bridge that requires filing down two healthy neighboring teeth.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. What Happens, Visit by Visit, & Number of Sittings -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-8">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Treatment Journey</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-japandi-charcoal font-medium tracking-tight">
          What happens, visit by visit
        </h2>
        <p class="text-sm sm:text-base text-japandi-earth font-light mt-2 leading-relaxed">
          Typically completed over 3 to 4 clinical visits in our calm Hennur Bande operatories:
        </p>
      </div>

      <div class="space-y-4 text-xs sm:text-sm text-japandi-earth font-light">
        <div class="p-6 rounded-2xl bg-japandi-sand/55 border border-japandi-clay/50 space-y-2">
          <div class="flex items-center gap-3">
            <span class="w-7 h-7 rounded-full bg-japandi-moss text-japandi-cream text-xs font-bold flex items-center justify-center shrink-0">1</span>
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">Visit 1: Initial Assessment &amp; Digital RVG Diagnostics</h3>
          </div>
          <p class="leading-relaxed pl-10">
            We evaluate bone depth and soft tissue health with low-radiation RVG imaging and intraoral camera views, generating an itemized written estimate valid for 6 months.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-japandi-sand/55 border border-japandi-clay/50 space-y-2">
          <div class="flex items-center gap-3">
            <span class="w-7 h-7 rounded-full bg-japandi-moss text-japandi-cream text-xs font-bold flex items-center justify-center shrink-0">2</span>
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">Visit 2: Planned Implant Placement Under Local Anaesthesia</h3>
          </div>
          <p class="leading-relaxed pl-10">
            The titanium fixture is gently placed into the jawbone under complete local numbness. Patients return home comfortably with complete recovery guidance.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-japandi-sand/55 border border-japandi-clay/50 space-y-2">
          <div class="flex items-center gap-3">
            <span class="w-7 h-7 rounded-full bg-japandi-moss text-japandi-cream text-xs font-bold flex items-center justify-center shrink-0">3</span>
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">Visit 3: Osseointegration Assessment &amp; Digital 3D Impression</h3>
          </div>
          <p class="leading-relaxed pl-10">
            After 8 to 12 weeks of bone healing, an intraoral digital scan is recorded to custom-mill your high-translucency Zirconia crown.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-japandi-sand/55 border border-japandi-clay/50 space-y-2">
          <div class="flex items-center gap-3">
            <span class="w-7 h-7 rounded-full bg-japandi-moss text-japandi-cream text-xs font-bold flex items-center justify-center shrink-0">4</span>
            <h3 class="font-serif text-base text-japandi-charcoal font-medium">Visit 4: Final Crown Placement &amp; Bite Calibration</h3>
          </div>
          <p class="leading-relaxed pl-10">
            Your custom crown is precision-fixed to the abutment, matched to your natural tooth colour and chewing balance.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Price Table From Keys -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/25 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-8">
      <div>
        <span class="text-xs font-semibold text-japandi-moss uppercase tracking-widest block mb-2">Hennur Bande Pricing</span>
        <h2 class="text-2xl sm:text-3xl font-serif text-japandi-charcoal font-medium">
          Dental implant prices
        </h2>
        <p class="text-xs sm:text-sm text-japandi-earth font-light mt-1">
          The price depends on the implant brand (we place Nobel Biocare, Straumann and other systems) and on the case; a single implant is {CANONICAL_PRICES.implant_single_fixture}.
        </p>
      </div>

      <div class="bg-japandi-sand/40 border border-japandi-clay/50 rounded-2xl overflow-hidden shadow-sm">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-japandi-sand/80 text-japandi-earth uppercase text-[10px] tracking-wider border-b border-japandi-clay/30">
            <tr>
              <th scope="col" class="py-3 px-6 font-semibold w-2/3">Implant Procedure</th>
              <th scope="col" class="py-3 px-6 font-semibold w-1/3">Price Range</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-japandi-clay/20 text-japandi-charcoal font-light">
            <tr class="hover:bg-japandi-sand/60">
              <td class="py-3.5 px-6 font-medium">Consultation &amp; Digital RVG X-ray</td>
              <td class="py-3.5 px-6 font-semibold text-japandi-moss">{CANONICAL_PRICES.consultation}</td>
            </tr>
            <tr class="hover:bg-japandi-sand/60">
              <td class="py-3.5 px-6 font-medium">Single Dental Implant Fixture</td>
              <td class="py-3.5 px-6 font-semibold text-japandi-moss">{CANONICAL_PRICES.implant_single_fixture}</td>
            </tr>
            <tr class="hover:bg-japandi-sand/60">
              <td class="py-3.5 px-6 font-medium">Dental Implant with Custom Crown</td>
              <td class="py-3.5 px-6 font-semibold text-japandi-moss">{CANONICAL_PRICES.implant_with_crown}</td>
            </tr>
            <tr class="hover:bg-japandi-sand/60">
              <td class="py-3.5 px-6 font-medium">Full Mouth Implants (Per Arch)</td>
              <td class="py-3.5 px-6 font-semibold text-japandi-moss">{CANONICAL_PRICES.full_mouth_implants_from}</td>
            </tr>
            <tr class="hover:bg-japandi-sand/60">
              <td class="py-3.5 px-6 font-medium">Bone Grafting (When Required)</td>
              <td class="py-3.5 px-6 font-semibold text-japandi-moss">{CANONICAL_PRICES.bone_graft}</td>
            </tr>
            <tr class="hover:bg-japandi-sand/60">
              <td class="py-3.5 px-6 font-medium">Sinus Lift Augmentation (When Required)</td>
              <td class="py-3.5 px-6 font-semibold text-japandi-moss">{CANONICAL_PRICES.sinus_lift}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="p-5 rounded-2xl bg-japandi-sand/50 border border-japandi-clay/40 text-center space-y-2">
        <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
          Prices are ranges, confirmed after examination. Itemized written estimates valid for 6 months. Flexible EMI options available via bank cards.
        </p>
      </div>
    </div>
  </section>

  <!-- 5. Which Department Handles It -->
  <TreatmentDepartmentCard 
    department="Oral and Maxillofacial Surgery and Prosthodontics" 
    description="Surgical implant placement is handled by our visiting Oral and Maxillofacial Surgeon, and prosthetic crown fabrication by our visiting Prosthodontist."
  />

  <!-- 6. Aftercare and When to Call Us -->
  <TreatmentAftercare 
    aftercare={[
      "Maintain gentle biting pressure on the sterile gauze pad placed over the surgical area for 45 minutes.",
      "Avoid rinsing, spitting, or drinking through straws for 24 hours to protect the healing clot.",
      "Eat soft, cool foods (curd rice, smoothies, dal) for the first 48 hours; do not chew on the implant side.",
      "Take prescribed medicines on time after meals as instructed by your dentist.",
      "Begin warm salt water rinses after 24 hours to keep the area clean."
    ]}
    whenToCall={[
      "Active, bright red bleeding continues after 45 minutes of firm biting on fresh gauze.",
      "Severe pain that is not alleviated by the prescribed pain medication.",
      "Swelling that worsens or continues to increase after day 2.",
      "Fever above 100.4°F (38°C) or persistent numbness in lips or chin."
    ]}
  />

  <!-- 7. Directions, Clinic Access & FAQs -->
  <section class="py-16 md:py-20 px-6 lg:px-24 bg-japandi-sand/20 border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-10">
      
      <!-- Clinic Access Summary -->
      <div class="p-6 sm:p-8 rounded-3xl bg-japandi-sand/60 border border-japandi-clay/50 space-y-4">
        <h3 class="text-lg font-serif text-japandi-charcoal font-medium">Visiting Aureva Dental in Hennur Bande</h3>
        <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
          Conveniently located for patients across Hennur Bande, Horamavu, and Kalyan Nagar. 2nd floor, No.11, 4, Horamavu Agara Rd, near Nayara Petrol Bunk, Hennur Bande, Hennur Gardens, Bengaluru 560043.
        </p>
        <p class="text-xs sm:text-sm text-japandi-moss font-semibold">
          Parking available for 4-wheelers and 2-wheelers. 2nd floor with lift. Open Mon 4–9 PM, Tue–Sun 9:30 AM–9 PM.
        </p>
      </div>

      <div>
        <h2 class="text-2xl sm:text-3xl font-serif text-japandi-charcoal font-medium mb-6">
          Frequently asked questions about implants in Hennur
        </h2>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <div class="p-6 rounded-2xl bg-japandi-sand/60 border border-japandi-clay/50 space-y-2">
              <h3 class="text-sm sm:text-base font-serif font-medium text-japandi-charcoal">
                {faq.question}
              </h3>
              <p class="text-xs sm:text-sm text-japandi-earth font-light leading-relaxed">
                {faq.answer}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 8. Related Treatments -->
  <section class="py-12 md:py-16 px-6 lg:px-24 bg-transparent border-t border-japandi-clay/30">
    <div class="max-w-4xl mx-auto space-y-6">
      <div class="space-y-1">
        <h3 class="text-lg font-serif font-medium text-japandi-charcoal">Related treatments &amp; services</h3>
        <p class="text-xs text-japandi-earth font-light">Explore complementary dental services at our Hennur studio:</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs font-light">
        <a href="/treatments/dental-implants" class="p-4 rounded-2xl bg-japandi-sand/50 border border-japandi-clay/40 hover:border-japandi-moss transition-all group">
          <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-1">Clinical Implant Guide &rarr;</span>
          <span class="text-japandi-earth text-[11px]">Comprehensive guide to implantology types, bone biology &amp; recovery.</span>
        </a>
        <a href="/root-canal-treatment-hennur" class="p-4 rounded-2xl bg-japandi-sand/50 border border-japandi-clay/40 hover:border-japandi-moss transition-all group">
          <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-1">Root Canal Treatment &rarr;</span>
          <span class="text-japandi-earth text-[11px]">Save restorable natural teeth with gentle rotary endodontics.</span>
        </a>
        <a href="/dental-crowns-hennur" class="p-4 rounded-2xl bg-japandi-sand/50 border border-japandi-clay/40 hover:border-japandi-moss transition-all group">
          <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-1">Dental Crowns &rarr;</span>
          <span class="text-japandi-earth text-[11px]">Zirconia and ceramic dental crowns in Hennur.</span>
        </a>
        <a href="/treatments/dentures" class="p-4 rounded-2xl bg-japandi-sand/50 border border-japandi-clay/40 hover:border-japandi-moss transition-all group">
          <span class="font-medium text-japandi-charcoal group-hover:text-japandi-moss block mb-1">Custom Dentures &rarr;</span>
          <span class="text-japandi-earth text-[11px]">Full, partial, and implant-supported overdentures.</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 9. Book / WhatsApp / Call Buttons -->
  <TreatmentActions treatmentName="Dental Implants" />
</Layout>
